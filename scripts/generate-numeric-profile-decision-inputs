#!/usr/bin/env python3
"""Generate publication-safe S5-T2-A numeric profile decision inputs."""

from __future__ import annotations

import argparse
import json
from collections import Counter
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / "spec/evidence/numeric-profile-decision-inputs.json"
PUBLIC_REPOSITORY = "https://github.com/hw-native-sys/pto-isa"
# Numeric implementation evidence remains at its separately audited snapshot.
# The public predicate/mask reconciliation advances independently because two
# numeric implementation files changed at the newer public commit and have not
# been re-audited as part of that version-boundary checkpoint.
PUBLIC_COMMIT = "712cbe9f23df5d5362be5e8327599f4285317473"
CURRENT_RECONCILIATION_COMMIT = "1f61a9a28b375e5113761defdc66fd03554b5e0d"


def source(
    source_id: str, path: str, role: str, sha256: str, layer: str
) -> dict[str, str]:
    return {
        "id": source_id,
        "path": path,
        "role": role,
        "layer": layer,
        "sha256": sha256,
        "url": f"{PUBLIC_REPOSITORY}/blob/{PUBLIC_COMMIT}/{path}",
    }


