def load(relative: str) -> dict[str, Any]:
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"numeric profile decision-input generation failed: {message}")


def generate() -> dict[str, Any]:
    contracts = load("spec/evidence/numeric-contracts.json")
    readiness = load("spec/evidence/numeric-conformance-readiness.json")
    reconciliation = load("spec/evidence/public-source-reconciliation.json")
    comparison = load("spec/evidence/executable-model-comparison.json")
    require(
        reconciliation["public_repository"] == PUBLIC_REPOSITORY,
        "public repository drift",
    )
    require(
        reconciliation["public_commit"] == CURRENT_RECONCILIATION_COMMIT,
        "current public reconciliation commit drift",
    )
    require(readiness["target"] == "S5-T2", "readiness target drift")
    require(
        comparison["target"] == "S5-T3"
        and comparison["closure_judgment"]["can_close_s5_t3"] is True
        and comparison["closure_judgment"]["remaining_blockers"] == [],
        "comparison boundary is not closed",
    )

    sources_by_id = {row["id"]: row for row in SOURCES}
    require(len(sources_by_id) == len(SOURCES), "duplicate source identity")
    questions_by_id = {row["id"]: row for row in QUESTION_SPECS}
    require(len(questions_by_id) == len(QUESTION_SPECS), "duplicate question identity")
    domains_by_id = {row["id"]: row for row in contracts["contract_domains"]}
    require(
        set(DOMAIN_QUESTIONS) == set(domains_by_id), "domain decision mapping drift"
    )
    lanes_by_domain = {
        domain_id: lane["id"]
        for lane in readiness["lanes"]
        for domain_id in lane["contract_domains"]
    }
    operations_by_domain: dict[str, list[dict[str, Any]]] = {
        domain_id: [] for domain_id in domains_by_id
    }
    for operation in contracts["operations"]:
        operations_by_domain[operation["numeric_contract"]].append(operation)

    question_domain_membership: Counter[str] = Counter()
    source_membership: Counter[str] = Counter()
    questions = []
    for spec in QUESTION_SPECS:
        unknown_sources = sorted(set(spec["source_ids"]) - set(sources_by_id))
        require(
            not unknown_sources, f"{spec['id']} has unknown sources {unknown_sources}"
        )
        domains = sorted(
            domain_id
            for domain_id, question_ids in DOMAIN_QUESTIONS.items()
            if spec["id"] in question_ids
        )
        require(domains, f"{spec['id']} has no affected domain")
        question_domain_membership.update(domains)
        source_membership.update(spec["source_ids"])
        disposition = ACCEPTED_DECISIONS.get(
            spec["id"],
            {
                "status": "decision-required",
                "selected_disposition": None,
                "decision_record": None,
            },
        )
        questions.append({**spec, "domains": domains, **disposition})
    require(
        set(source_membership) == set(sources_by_id),
        "unreferenced public evidence source",
    )
    require(
        set(question_domain_membership) == set(domains_by_id),
        "uncovered numeric domain",
    )

    domain_matrix = []
    for domain_id in domains_by_id:
        operation_rows = operations_by_domain[domain_id]
        hook_names = sorted(
            {
                name
                for operation in operation_rows
                for name in operation["primary_hooks"] + operation["reference_helpers"]
            }
        )
        question_ids = DOMAIN_QUESTIONS[domain_id]
        source_ids = sorted(
            {
                source_id
                for question_id in question_ids
                for source_id in questions_by_id[question_id]["source_ids"]
            }
        )
        domain_matrix.append(
            {
                "domain": domain_id,
                "lane": lanes_by_domain[domain_id],
                "operation_count": len(operation_rows),
                "operation_keys": sorted(row["key"] for row in operation_rows),
                "hooks": hook_names,
                "open_numeric_dimensions": domains_by_id[domain_id][
                    "open_numeric_dimensions"
                ],
                "decision_question_ids": question_ids,
                "source_ids": source_ids,
                "status": "profile-rule-required",
                "selected_profile_rule": None,
            }
        )

    return {
        "schema_version": 1,
        "target": "S5-T2-A",
        "status": "decision-inputs-and-identities-closed-profile-decisions-open",
        "public_repository": PUBLIC_REPOSITORY,
        "public_commit": PUBLIC_COMMIT,
        "policy": {
            "authority": "PTO ASL and accepted architecture decisions define numeric semantics; public implementation evidence exposes choices but cannot select them.",
            "profile_boundary": "Support restrictions, portable result rules, named target result rules, and bounded implementation-defined behavior must be classified separately.",
            "cpu_role": "CPU simulation is an implementation under test and host arithmetic is not a target oracle.",
            "independent_comparison_role": "The closed executable-ISA comparison validates identities and bounded structural semantics but does not provide S5-T2 numeric differential results.",
            "no_implicit_choice": "A missing profile rule remains open; the generator never chooses the most convenient backend behavior.",
        },
        "profile_partition_inputs": [
            {
                "id": "portable-numeric",
                "role": "portable result contract",
                "status": "identity-accepted-rules-required",
            },
            {
                "id": "cpu-observation",
                "role": "implementation-under-test observation only",
                "status": "identity-accepted-observation-schema-required-not-an-oracle",
            },
            {
                "id": "a2a3-target",
                "role": "named target profile candidate",
                "status": "identity-accepted-rules-required",
            },
            {
                "id": "a5-target",
                "role": "named target profile candidate",
                "status": "identity-accepted-rules-required",
            },
        ],
        "sources": list(SOURCES),
        "decision_questions": questions,
        "domain_matrix": domain_matrix,
        "summary": {
            "source_count": len(SOURCES),
            "public_contract_source_count": sum(
                row["layer"] == "public-contract" for row in SOURCES
            ),
            "implementation_evidence_source_count": sum(
                row["layer"] == "implementation-evidence" for row in SOURCES
            ),
            "decision_question_count": len(questions),
            "open_decision_question_count": sum(
                row["status"] == "decision-required" for row in questions
            ),
            "numeric_domain_count": len(domain_matrix),
            "open_numeric_domain_count": len(domain_matrix),
            "selected_profile_rule_count": 0,
            "profile_identity_count": 4,
        },
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    args = parser.parse_args()
    expected = serialized()
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.exists() or OUTPUT.read_text(encoding="utf-8") != expected:
        raise SystemExit(
            "numeric profile decision inputs are stale; run scripts/generate-numeric-profile-decision-inputs --write"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
