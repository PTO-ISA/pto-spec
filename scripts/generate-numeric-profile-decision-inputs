ACCEPTED_DECISIONS = {
    "PD-03": {
        "status": "accepted",
        "selected_disposition": "portable-normative-rule",
        "decision_record": "docs/architecture-decisions/0047-numeric-rounding-semantics.md",
    },
    "PD-04": {
        "status": "accepted",
