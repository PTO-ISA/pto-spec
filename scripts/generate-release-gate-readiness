def load(path: str) -> dict[str, Any]:
    return json.loads((ROOT / path).read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"release-gate readiness generation failed: {message}")


def require_paths(paths: list[str], label: str) -> None:
    missing = [path for path in paths if not (ROOT / path).is_file()]
    require(not missing, f"{label} names missing paths {missing}")


def sha256(path: str) -> str:
    return hashlib.sha256((ROOT / path).read_bytes()).hexdigest()


def maturity_target_key(target: str) -> tuple[int, int]:
    match = re.fullmatch(r"S([0-6])-T(10|[1-9])", target)
    require(match is not None, f"invalid maturity target identity {target}")
    return int(match.group(1)), int(match.group(2))


def validate_makefile() -> None:
    body = (ROOT / "Makefile").read_text(encoding="utf-8")
    required_targets = {
        "clean",
        "repo-check",
        "toolchain-check",
        "check",
        "test-parallel",
        "release-check",
        "pr-check",
        "release-prepare",
        "release-verify",
        "ci",
        "print-asl-sources",
        "print-asl-tests",
        "check-asl-tests",
    }
    defined_targets = set(re.findall(r"^([A-Za-z][A-Za-z0-9_-]*):", body, re.MULTILINE))
    require(required_targets <= defined_targets, "Makefile release target drift")
    require("ci: pr-check" in body, "make ci must remain the lightweight PR alias")
    require(
        "release-verify: release-check" in body,
        "make release-verify no longer composes every strict release gate",
    )
    require(
        "release-prepare:" in body
        and "./scripts/generate-release-manifest" in body
        and "./scripts/check-release-manifest" in body
        and "git diff --exit-code -- spec/release-manifest.json spec/evidence" in body,
        "make release-prepare no longer proves reproducible release evidence",
    )
    require(
        './scripts/run-asl-release-suite --commit "$(RELEASE_COMMIT)"' in body,
        "independent release-suite recipe drift",
    )


def validate_workflow() -> dict[str, Any]:
    body = (ROOT / ".github/workflows/release.yml").read_text(encoding="utf-8")
    result = subprocess.run(
        [str(ROOT / "scripts/check-release-workflow")],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    require(
        result.returncode == 0, result.stderr.strip() or "release workflow policy drift"
    )
    action_uses = [
        {"action": action, "commit": commit}
        for action, commit in re.findall(r"uses:\s+([^@\s]+)@([0-9A-Za-z._-]+)", body)
    ]
    actions = list(
        {(row["action"], row["commit"]): row for row in action_uses}.values()
    )
    require(
        {row["action"] for row in actions}
        == {
            "actions/checkout",
            "actions/download-artifact",
            "actions/upload-artifact",
            "ocaml/setup-ocaml",
        },
        "release workflow action inventory drift",
    )
    require(
        all(re.fullmatch(r"[0-9a-f]{40}", row["commit"]) for row in action_uses),
        "every hosted action must use a full commit pin",
    )
    return {
        "workflow": ".github/workflows/release.yml",
        "workflow_name": "Release verification",
        "trigger": "workflow_dispatch with exact commit input",
        "required_check": "Release / validate",
        "permissions": {"contents": "read"},
        "concurrency_cancel_in_progress": False,
        "timeout_minutes": 360,
        "matrix_fail_fast": False,
        "matrix_max_parallel": 8,
        "protected_aggregator_needs": [
            "plan",
            "strict-model",
            "asl-page",
            "release-evidence",
        ],
        "actions": actions,
        "contract_status": "closed",
    }


def validate_independent_tests() -> dict[str, Any]:
    result = subprocess.run(
        [str(ROOT / "scripts/check-asl-tests")],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    require(
        result.returncode == 0, result.stderr.strip() or "ASL test validation failed"
    )
    document = json.loads(
        subprocess.check_output(
            [
                str(ROOT / "scripts/print-asl-test-matrix"),
                "--page-size",
                "10000",
                "--page",
                "0",
            ],
            cwd=ROOT,
            text=True,
        )
    )
    entries = document["include"]
    test_count = document["test_count"]
    test_ids = [entry["id"] for entry in entries]
    require(
        len(test_ids) == len(set(test_ids)) == test_count, "ASL test identity drift"
    )
    require(
        test_count == EXPECTED_COUNTS["asl_test_count"],
        "independent ASL test count drift",
    )
    page_size = EXPECTED_COUNTS["asl_test_page_size"]
    page_count = (test_count + page_size - 1) // page_size
    require(
        page_count == EXPECTED_COUNTS["asl_test_page_count"],
        "ASL test page count drift",
    )
    return {
        "test_count": test_count,
        "page_size": page_size,
        "page_count": page_count,
        "matrix_fields": ["id", "kind", "path", "requirements", "sha256", "source"],
        "default_parallel_jobs_per_page": 8,
        "set_equality_status": "closed",
        "candidate_runtime_result": None,
    }


def build_evidence() -> dict[str, Any]:
    require_paths(list(SOURCE_PATHS), "release-gate source inventory")
    validate_makefile()
    workflow = validate_workflow()
    parallel_topology = validate_independent_tests()

    maturity = load("spec/evidence/maturity-closure.json")
    targets = {row["id"]: row["status"] for row in maturity["targets"]}
    require(
        len(targets) == len(maturity["targets"]) == 31,
        "maturity target inventory drift",
    )
    closed_targets = sorted(
        (target for target, status in targets.items() if status == "closed"),
        key=maturity_target_key,
    )
    require(
        len(closed_targets) == EXPECTED_COUNTS["closed_target_count"],
        "closed target count drift",
    )
    require(
        targets.get("S5-T2") == "open"
        and targets.get("S6-T1") == "open"
        and targets.get("S6-T2") == "open",
        "release prerequisite status changed; revise S6-T2 readiness",
    )
    required_prerequisites = sorted(
        (
            target
            for target in targets
            if target.startswith(tuple(f"S{stage}-" for stage in range(6)))
        ),
        key=maturity_target_key,
    ) + ["S6-T1"]
    open_prerequisites = [
        target for target in required_prerequisites if targets[target] != "closed"
    ]
    require(open_prerequisites == ["S5-T2", "S6-T1"], "release prerequisite gap drift")

    traceability = load("spec/evidence/release-traceability-readiness.json")
    require(
        traceability["status"] == "inventory-and-links-closed-promotion-open"
        and traceability["summary"]["traceability_item_count"] == 925
        and traceability["summary"]["release_traceability_status"] == "open:S6-T1",
        "S6-T1 readiness contract drift",
    )
    specification = (ROOT / "specification.toml").read_text(encoding="utf-8")
    require(
        'status = "draft"' in specification, "release metadata no longer reports draft"
    )
    require(
        'architectural_completion = "open"' in specification,
        "architectural completion metadata changed without S6 closure",
    )

    gates = []
    for spec in GATE_SPECS:
        require_paths(spec["evidence"], f"release gate {spec['id']}")
        gates.append(
            {
                **spec,
                "contract_status": "closed",
                "candidate_commit": None,
                "candidate_result": None,
                "result_evidence": None,
            }
        )
    require(len(gates) == EXPECTED_COUNTS["gate_count"], "release gate count drift")

    controls = [
        {
            **row,
            "verification_method": "GitHub repository and branch-protection API snapshot at the immutable candidate commit",
            "observed_at": None,
            "observed_state": None,
            "evidence_url": None,
            "verification_status": "candidate-snapshot-required",
        }
        for row in EXTERNAL_CONTROLS
    ]
    approvals = [
        {
            **row,
            "reviewer_identity": None,
            "reviewed_commit": None,
            "review_date": None,
            "disposition": None,
            "evidence_url": None,
            "status": "candidate-review-required",
        }
        for row in APPROVAL_SPECS
    ]
    require(
        len(controls) == EXPECTED_COUNTS["required_external_control_count"],
        "external control count drift",
    )
    require(
        len(approvals) == EXPECTED_COUNTS["required_approval_count"],
        "approval perspective count drift",
    )

    return {
        "schema_version": 1,
        "target": "S6-T2",
        "status": "gate-contract-closed-promotion-open",
        "policy": {
            "authority": "The frozen PTO candidate, clone-verifiable gates, hosted validation, protected-branch state, and recorded architecture/formal approvals must agree before M6 promotion.",
            "no_live_branch_evidence": "A passing run on a moving draft branch is useful feedback but is not architecturally-complete release evidence.",
            "long_running_policy": "Long runtime gates execute only through the manually dispatched exact-head independent-test page topology; readiness generation validates the contract without waiting for it.",
            "closure_rule": "S6-T2 closes only after cumulative S0 through S6-T1 closure, one immutable signed candidate, every local and hosted gate passing at that commit, all external controls verified, and both review perspectives accepted.",
        },
        "sources": [{"path": path, "sha256": sha256(path)} for path in SOURCE_PATHS],
        "sub_stages": [
            {
                "id": "S6-T2-A",
                "status": "closed",
                "target": "freeze the exact clone-verifiable and external release-gate contract",
                "blocked_by": [],
            },
            {
                "id": "S6-T2-B",
                "status": "closed",
                "target": "prove manual exact-head workflow pinning and exact independent-test topology",
                "blocked_by": [],
            },
            {
                "id": "S6-T2-C",
                "status": "blocked-by-prerequisite",
                "target": "freeze one signed architecturally-complete candidate commit",
                "blocked_by": ["S5-T2", "S6-T1"],
            },
            {
                "id": "S6-T2-D",
                "status": "waiting-on-prerequisite",
                "target": "reproduce every local and hosted gate at the candidate commit",
                "blocked_by": ["S6-T2-C"],
            },
            {
                "id": "S6-T2-E",
                "status": "waiting-on-prerequisite",
                "target": "verify protected-branch controls and obtain both independent approvals",
                "blocked_by": ["S6-T2-C", "S6-T2-D"],
            },
            {
                "id": "S6-T2-F",
                "status": "waiting-on-prerequisite",
                "target": "promote metadata and release the M6 candidate",
                "blocked_by": ["S6-T2-C", "S6-T2-D", "S6-T2-E"],
            },
        ],
        "blocking_gaps": [
            {
                "id": "S6-T2-G1",
                "classification": "release-governance",
                "statement": "S5-T2 and S6-T1 are open, so no immutable architecturally-complete candidate may be frozen.",
                "acceptance_evidence": [
                    "closed S5-T2",
                    "closed S6-T1",
                    "signed immutable candidate commit",
                ],
            },
            {
                "id": "S6-T2-G2",
                "classification": "release-governance",
                "statement": "No frozen candidate has complete clean-tree local and hosted gate results.",
                "acceptance_evidence": [
                    "clean make release-verify and make release-prepare",
                    "git diff --check",
                    "passing Release / validate at the same candidate commit",
                ],
            },
            {
                "id": "S6-T2-G3",
                "classification": "release-governance",
                "statement": "Candidate-specific protected-branch evidence and PTO architecture/formal-model approvals are unrecorded.",
                "acceptance_evidence": [
                    "content-addressed GitHub control snapshot",
                    "accepted PTO architecture review",
                    "accepted formal-model review",
                ],
            },
        ],
        "prerequisites": {
            "required_targets": required_prerequisites,
            "closed_targets": [
                target
                for target in required_prerequisites
                if targets[target] == "closed"
            ],
            "open_targets": open_prerequisites,
            "traceability_status": traceability["status"],
            "candidate_freeze_status": "blocked",
        },
        "workflow_contract": workflow,
        "parallel_topology": parallel_topology,
        "gates": gates,
        "external_controls": controls,
        "approvals": approvals,
        "candidate": {
            "commit": None,
            "source_tree_sha256": None,
            "signed_commit_evidence": None,
            "clean_tree_evidence": None,
            "hosted_run_id": None,
            "hosted_run_url": None,
            "hosted_conclusion": None,
            "promotion_commit": None,
        },
        "summary": {
            **EXPECTED_COUNTS,
            "open_prerequisite_targets": open_prerequisites,
            "closed_gate_contract_count": len(gates),
            "candidate_gate_result_count": 0,
            "verified_external_control_count": 0,
            "accepted_approval_count": 0,
            "gate_contract_status": "closed",
            "candidate_execution_status": "not-started",
            "release_gate_status": "open:S6-T2",
        },
    }


def render(document: dict[str, Any]) -> str:
    return json.dumps(document, indent=2, ensure_ascii=False) + "\n"


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()
    generated = render(build_evidence())
    if args.check:
        require(args.output.is_file(), f"missing generated artifact {args.output}")
        require(
            args.output.read_text(encoding="utf-8") == generated,
            f"stale generated artifact {args.output}",
        )
        return
    args.output.write_text(generated, encoding="utf-8")


if __name__ == "__main__":
    main()
