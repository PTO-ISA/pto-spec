#!/usr/bin/env python3
"""Project the manual release gate from current exact-head contracts."""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_OUTPUT = ROOT / "spec/evidence/release-gate-readiness.json"
PAGE_SIZE = 100
SOURCE_PATHS = (
    ".aslref-version",
    ".github/workflows/asl.yml",
    ".github/workflows/release.yml",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "Makefile",
    "scripts/asl_release_suite.py",
    "scripts/check-active-paths",
    "scripts/check-asl-layout",
    "scripts/check-asl-tests",
    "scripts/check-binary-closure",
    "scripts/check-ndf",
    "scripts/check-pr",
    "scripts/check-release-closure",
    "scripts/check-release-manifest",
    "scripts/check-release-workflow",
    "scripts/check-repository",
    "scripts/check-script-entrypoints",
    "scripts/check-toolchain",
    "scripts/instruction_docs.py",
    "scripts/print-asl-test-matrix",
    "scripts/project_asl_catalogs.py",
    "scripts/run-asl-release-suite",
    "scripts/run-asl-test",
    "spec/evidence/release-traceability-readiness.json",
    "spec/release-inputs.json",
)
GATES = (
    {
        "id": "RG-01",
        "name": "lightweight pull-request contract",
        "command": "make pr-check",
        "evidence": ["Makefile", ".github/workflows/asl.yml"],
    },
    {
        "id": "RG-02",
        "name": "active four-surface repository closure",
        "command": "make repo-check",
        "evidence": ["scripts/check-repository", "scripts/check-active-paths"],
    },
    {
        "id": "RG-03",
        "name": "pinned ASLRef canaries",
        "command": "make toolchain-check",
        "evidence": [".aslref-version", "scripts/check-toolchain"],
    },
    {
        "id": "RG-04",
        "name": "strict normative type check",
        "command": "make check",
        "evidence": ["Makefile", "scripts/aslref"],
    },
    {
        "id": "RG-05",
        "name": "independent exact-head AVS matrix",
        "command": "make release-check RELEASE_COMMIT=<exact-head>",
        "evidence": ["scripts/run-asl-release-suite", "scripts/run-asl-test"],
    },
    {
        "id": "RG-06",
        "name": "fail-closed release provenance",
        "command": "scripts/check-release-closure",
        "evidence": ["spec/release-inputs.json", "scripts/check-release-closure"],
    },
    {
        "id": "RG-07",
        "name": "binary encoding closure",
        "command": "scripts/check-binary-closure",
        "evidence": ["scripts/check-binary-closure"],
    },
    {
        "id": "RG-08",
        "name": "release manifest reproducibility",
        "command": "scripts/check-release-manifest",
        "evidence": ["scripts/check-release-manifest", "spec/release-manifest.json"],
    },
    {
        "id": "RG-09",
        "name": "clean exact commit identity",
        "command": 'test -z "$(git status --porcelain=v1 --untracked-files=all)"',
        "evidence": ["scripts/asl_release_suite.py"],
    },
)


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def build_document(root: Path = ROOT) -> dict[str, object]:
    trace_path = root / "spec/evidence/release-traceability-readiness.json"
    trace = json.loads(trace_path.read_text(encoding="utf-8"))
    if trace.get("schema") != "pto.release-traceability.v2":
        raise ValueError("release traceability projection has the wrong schema")
    summary = trace["summary"]
    if summary["status"] != "closed":
        raise ValueError("release traceability projection is not closed")
    for relative in SOURCE_PATHS:
        if "docs/status/legacy/" in relative or not (root / relative).is_file():
            raise ValueError(f"invalid release gate source: {relative}")
    for gate in GATES:
        for relative in gate["evidence"]:
            if not (root / relative).is_file():
                raise ValueError(f"missing release gate evidence: {relative}")
    return {
        "schema": "pto.release-gate.v2",
        "sources": {relative: _sha256(root / relative) for relative in SOURCE_PATHS},
        "gates": list(GATES),
        "summary": {
            "gate_count": len(GATES),
            "unit_count": summary["unit_count"],
            "documentation_page_count": summary["documentation_page_count"],
            "mnemonic_count": summary["mnemonic_count"],
            "test_count": summary["test_count"],
            "test_page_size": PAGE_SIZE,
            "test_page_count": math.ceil(summary["test_count"] / PAGE_SIZE),
            "executable_requirement_count": summary["executable_requirement_count"],
            "uncovered_unit_count": summary["uncovered_unit_count"],
            "uncovered_executable_requirement_count": summary[
                "uncovered_executable_requirement_count"
            ],
            "status": "ready-for-exact-head-verification",
        },
    }


def render(document: dict[str, object]) -> str:
    return json.dumps(document, indent=2, sort_keys=True) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    arguments = parser.parse_args()
    try:
        generated = render(build_document())
        if arguments.check:
            if not arguments.output.is_file():
                raise ValueError(f"missing generated artifact {arguments.output}")
            if arguments.output.read_text(encoding="utf-8") != generated:
                raise ValueError(f"stale generated artifact {arguments.output}")
        else:
            arguments.output.write_text(generated, encoding="utf-8")
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    if arguments.check:
        print("release gate projection passed")
    else:
        print(f"wrote {arguments.output.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
