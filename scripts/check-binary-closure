#!/usr/bin/env python3
"""Validate the current encoded-form envelope and optional release linkage."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.current_source_form_inventory import (  # noqa: E402
    check_current_source_binary,
    check_release_binary,
)

EXPECTED_RELEASE = "0.59.0"
EXPECTED_ENCODING_ABI = "pto-isa-0.59.0-mode-function-v1"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--release",
        action="store_true",
        help="also require the published release manifest to match current encodings",
    )
    return parser.parse_args()


def check_release_linkage() -> str:
    manifest = json.loads(
        (ROOT / "spec/release-manifest.json").read_text(encoding="utf-8")
    )
    if manifest.get("release") != EXPECTED_RELEASE:
        raise SystemExit(f"release manifest must identify PTO ISA {EXPECTED_RELEASE}")
    if manifest.get("encoding_abi") != EXPECTED_ENCODING_ABI:
        raise SystemExit(
            f"release manifest must identify encoding ABI {EXPECTED_ENCODING_ABI}"
        )
    computed_encoding_hash = subprocess.run(
        [
            str(ROOT / "scripts/generate-release-manifest"),
            "--print-encoding-hash",
        ],
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    ).stdout.strip()
    manifest_encoding_hash = manifest.get("encoding_projection_sha256")
    if manifest_encoding_hash != computed_encoding_hash:
        raise SystemExit(
            "release encoding projection drift: manifest has "
            f"{manifest_encoding_hash}, computed {computed_encoding_hash}"
        )
    counts = manifest.get("catalog_counts", {})
    if counts.get("scalar_forms") != 473 or counts.get("command_forms") != 105:
        raise SystemExit(
            "release manifest scalar/command closure must remain exactly 473/105"
        )
    if counts.get("command_form_families") != {"CMD": 101, "BBD": 4}:
        raise SystemExit(
            "release manifest command families must remain exactly CMD=101/BBD=4"
        )
    if counts.get("extension_encoding_reservations") != 50:
        raise SystemExit("release manifest reservation closure must be exactly 50")
    if counts.get("tile_operations") != {"TEPL": 79, "TLSU": 28, "CUBE": 12}:
        raise SystemExit("release manifest tile closure must be exactly 79/28/12")
    if counts.get("tile_operations_total") != 119:
        raise SystemExit("release manifest tile operation total must be exactly 119")
    if counts.get("pending_base_operations") != 0:
        raise SystemExit("release manifest must have zero pending base operations")
    if counts.get("contract_status_counts") != {"reviewed-complete": 119}:
        raise SystemExit("release manifest must close all 119 operation contracts")
    return computed_encoding_hash


def main() -> int:
    args = parse_args()
    try:
        current_count, current_fingerprint = check_current_source_binary(ROOT)
    except ValueError as error:
        raise SystemExit(str(error)) from error
    if args.release:
        try:
            release_count, release_fingerprint = check_release_binary(ROOT)
        except ValueError as error:
            raise SystemExit(str(error)) from error
        release_encoding = check_release_linkage()
        print(
            f"release binary closure passed: {current_count} current accepted forms, "
            f"published identity {release_count} forms ({release_fingerprint}), "
            f"release encoding {release_encoding}"
        )
    else:
        print(
            f"architecture binary closure passed: {current_count} current accepted forms, "
            f"fingerprint {current_fingerprint}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
