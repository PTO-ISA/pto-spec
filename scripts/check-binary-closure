#!/usr/bin/env python3
"""Validate the current encoded-form envelope and optional release linkage."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import subprocess


ROOT = Path(__file__).resolve().parent.parent
EXPECTED_FORM_COUNT = 540
EXPECTED_FINGERPRINT = (
    "346a0c85ac884bdc291bd156ac2347c1b7d3c147879127c9c1d88da54c3ab5ea"
)
EXPECTED_RELEASE = "0.58.3"
EXPECTED_ENCODING_ABI = "pto-isa-0.58.3-mode-function-v1"
PROJECTION_KEYS = (
    "form_id",
    "mnemonic",
    "asm",
    "length_bits",
    "encoding_kind",
    "encoding",
    "fields",
    "constraints",
)


def load_forms(relative: str) -> list[dict]:
    catalog = json.loads((ROOT / relative).read_text(encoding="utf-8"))
    return catalog["forms"]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--release",
        action="store_true",
        help="also require the published release manifest to match current encodings",
    )
    return parser.parse_args()


def check_architecture_binary() -> str:
    forms = load_forms("spec/catalog/scalar-forms.json")
    forms += load_forms("spec/catalog/command-forms.json")
    if len(forms) != EXPECTED_FORM_COUNT:
        raise SystemExit(
            f"encoded-form count drift: expected {EXPECTED_FORM_COUNT}, got {len(forms)}"
        )
    ids = [row["form_id"] for row in forms]
    if len(ids) != len(set(ids)):
        raise SystemExit("encoded-form IDs are not globally unique")
    projection = [
        {key: row[key] for key in PROJECTION_KEYS}
        for row in sorted(forms, key=lambda row: row["form_id"])
    ]
    payload = json.dumps(projection, sort_keys=True, separators=(",", ":")).encode(
        "utf-8"
    )
    fingerprint = hashlib.sha256(payload).hexdigest()
    if fingerprint != EXPECTED_FINGERPRINT:
        raise SystemExit(
            "encoded-form fingerprint drift: update the normative review before "
            f"changing {EXPECTED_FINGERPRINT} to {fingerprint}"
        )
    return fingerprint


def check_release_linkage() -> str:
    manifest = json.loads(
        (ROOT / "spec/release-manifest.json").read_text(encoding="utf-8")
    )
    if manifest.get("release") != EXPECTED_RELEASE:
        raise SystemExit(f"release manifest must identify PTO ISA {EXPECTED_RELEASE}")
    if manifest.get("encoding_abi") != EXPECTED_ENCODING_ABI:
        raise SystemExit(
            f"release manifest must identify encoding ABI {EXPECTED_ENCODING_ABI}"
        )
    computed_encoding_hash = subprocess.run(
        [
            str(ROOT / "scripts/generate-release-manifest"),
            "--print-encoding-hash",
        ],
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    ).stdout.strip()
    manifest_encoding_hash = manifest.get("encoding_projection_sha256")
    if manifest_encoding_hash != computed_encoding_hash:
        raise SystemExit(
            "release encoding projection drift: manifest has "
            f"{manifest_encoding_hash}, computed {computed_encoding_hash}"
        )
    counts = manifest.get("catalog_counts", {})
    if counts.get("scalar_forms") != 466 or counts.get("command_forms") != 74:
        raise SystemExit(
            "release manifest scalar/command closure must remain exactly 466/74"
        )
    if counts.get("command_form_families") != {"CMD": 69, "BBD": 5}:
        raise SystemExit(
            "release manifest command families must remain exactly CMD=69/BBD=5"
        )
    if counts.get("tile_operations") != {"TEPL": 87, "TLSU": 10, "CUBE": 12}:
        raise SystemExit("release manifest tile closure must be exactly 87/10/12")
    if counts.get("tile_operations_total") != 109:
        raise SystemExit("release manifest tile operation total must be exactly 109")
    if counts.get("pending_base_operations") != 0:
        raise SystemExit("release manifest must have zero pending base operations")
    if counts.get("contract_status_counts") != {"reviewed-complete": 109}:
        raise SystemExit("release manifest must close all 109 operation contracts")
    return computed_encoding_hash


def main() -> int:
    args = parse_args()
    fingerprint = check_architecture_binary()
    if args.release:
        release_encoding = check_release_linkage()
        print(
            f"release binary closure passed: {EXPECTED_FORM_COUNT} encoded forms, "
            f"fingerprint {fingerprint}, release encoding {release_encoding}"
        )
    else:
        print(
            f"architecture binary closure passed: {EXPECTED_FORM_COUNT} encoded forms, "
            f"fingerprint {fingerprint}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
