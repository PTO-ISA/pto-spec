def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(message)


def source(path: str) -> dict[str, str]:
    absolute = ROOT / path
    return {
        "path": path,
        "sha256": hashlib.sha256(absolute.read_bytes()).hexdigest(),
    }


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def normalized_body(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip()


def asl_units(path: str, body: str) -> list[dict[str, str]]:
    headers = list(
        re.finditer(
            r"(?m)^(?:(?:readonly|pure|impdef|implementation)\s+)*(?:func|procedure)\s+([A-Za-z_][A-Za-z0-9_]*)\s*\(",
            body,
        )
    )
    units: list[dict[str, str]] = []
    if not headers and body.strip():
        return [{"path": path, "function": "<global>", "body": body}]
    if headers and body[: headers[0].start()].strip():
        units.append(
            {"path": path, "function": "<global>", "body": body[: headers[0].start()]}
        )
    for index, header in enumerate(headers):
        end = headers[index + 1].start() if index + 1 < len(headers) else len(body)
        units.append(
            {
                "path": path,
                "function": header.group(1),
                "body": body[header.start() : end],
            }
        )
    return units


def without_line_comments(body: str) -> str:
    return re.sub(r"(?m)//.*$", "", body)


def called_functions(body: str) -> set[str]:
    return set(
        re.findall(
            r"\b([A-Za-z_][A-Za-z0-9_]*)\s*\(",
            without_line_comments(body),
        )
    )


def exact_function_body(path: str, body: str, function: str) -> str:
    matches = [
        unit["body"] for unit in asl_units(path, body) if unit["function"] == function
    ]
    require(
        len(matches) == 1, f"expected exactly one function body: {path}::{function}"
    )
    return matches[0]


def normative_asl_sources() -> dict[str, str]:
    return {
        str(path.relative_to(ROOT)): path.read_text(encoding="utf-8")
        for path in sorted((ROOT / "asl").rglob("*.asl"))
    }


def unit_inventory(
    sources: dict[str, str], symbols: set[str], numbers: set[int] | None = None
) -> list[dict[str, str]]:
    units = [
        unit for path, body in sorted(sources.items()) for unit in asl_units(path, body)
    ]
    number_pattern = re.compile(
        r"(?<![A-Za-z0-9_])(?:0x[0-9a-fA-F]+|[0-9]+)(?![A-Za-z0-9_])"
    )
    normalized = [normalized_body(unit["body"]) for unit in units]
    tainted = {
        index
        for index, value in enumerate(normalized)
        if any(re.search(rf"\b{re.escape(symbol)}\b", value) for symbol in symbols)
        or (
            numbers is not None
            and not {
                int(token, 16) if token.lower().startswith("0x") else int(token, 10)
                for token in number_pattern.findall(value)
            }.isdisjoint(numbers)
        )
    }
    callers: dict[str, set[int]] = {}
    for index, unit in enumerate(units):
        for target in called_functions(unit["body"]):
            callers.setdefault(target, set()).add(index)
    pending = [
        units[index]["function"]
        for index in tainted
        if units[index]["function"] != "<global>"
    ]
    seen_names = set(pending)
    while pending:
        target = pending.pop()
        for index in callers.get(target, set()):
            if index in tainted:
                continue
            tainted.add(index)
            caller = units[index]["function"]
            if caller != "<global>" and caller not in seen_names:
                seen_names.add(caller)
                pending.append(caller)
    return [
        {
            "path": units[index]["path"],
            "function": units[index]["function"],
            "sha256": sha256_text(normalized[index]),
        }
        for index in sorted(
            tainted,
            key=lambda current: (units[current]["path"], units[current]["function"]),
        )
    ]


def inventory_sha256(rows: list[dict[str, str]]) -> str:
    return sha256_text(json.dumps(rows, sort_keys=True, separators=(",", ":")))


def require_inventory(
    name: str, rows: list[dict[str, str]], expected_sha256: str
) -> str:
    actual = inventory_sha256(rows)
    require(
        actual == expected_sha256,
        f"{name} inventory drift: expected {expected_sha256}, got {actual}",
    )
    return actual


def expanded_storage_only_addresses(catalog: dict[str, Any]) -> dict[int, list[str]]:
    expanded: dict[int, list[str]] = {}
    for row in storage_only_rows(catalog):
        low_index = int(row["low_index"], 0)
        contexts = [row["fixed_context"]] if "fixed_context" in row else range(16)
        for context in contexts:
            expanded.setdefault((context * 4096) + low_index, []).append(row["name"])
    return {address: sorted(names) for address, names in sorted(expanded.items())}


def slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


def generated_decoder() -> str:
    result = subprocess.run(
        [str(ROOT / "scripts/generate-asl-decoders")],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    require(result.returncode == 0, result.stderr or "ASL decoder generation failed")
    return result.stdout


def statement_after_marker(body: str, marker: str) -> str:
    matches = list(re.finditer(rf"(?m)^\s*//\s*{re.escape(marker)}\s*$", body))
    require(len(matches) == 1, f"witness marker must occur exactly once: {marker}")
    lines = body[matches[0].end() :].splitlines()
    assertion: list[str] = []
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("//"):
            continue
        assertion.append(stripped)
        if stripped.endswith(";"):
            return " ".join(assertion)
    raise SystemExit(f"unterminated statement after witness marker: {marker}")


def assertion_after_marker(body: str, marker: str) -> str:
    statement = statement_after_marker(body, marker)
    require(
        statement.startswith("assert "),
        f"witness marker does not bind an assertion: {marker}",
    )
    return statement


def test_reachability(
    decoder: str, overrides: dict[str, str] | None = None
) -> tuple[set[str], set[str]]:
    overrides = overrides or {}
    test_paths = subprocess.check_output(
        ["make", "--no-print-directory", "print-asl-tests"],
        cwd=ROOT,
        text=True,
    ).splitlines()
    library_sources = {
        path: overrides.get(path, (ROOT / path).read_text(encoding="utf-8"))
        for path in test_paths
        if path != "tests/asl/main.asl"
    }
    library_sources["generated:build/decoders.asl"] = overrides.get(
        "generated:build/decoders.asl", decoder
    )
    definitions: dict[str, str] = {}
    for path, body in library_sources.items():
        for unit in asl_units(path, body):
            if unit["function"] == "<global>":
                continue
            require(
                unit["function"] not in definitions,
                f"duplicate test function definition: {unit['function']}",
            )
            definitions[unit["function"]] = unit["body"]
    graph = {
        function: called_functions(body) & definitions.keys()
        for function, body in definitions.items()
    }

    def main_calls(path: str) -> set[str]:
        body = overrides.get(path, (ROOT / path).read_text(encoding="utf-8"))
        return called_functions(exact_function_body(path, body, "main")) - {"main"}

    def closure(roots: set[str]) -> set[str]:
        reachable = set(roots)
        pending = list(roots)
        while pending:
            current = pending.pop()
            for target in graph.get(current, set()):
                if target not in reachable:
                    reachable.add(target)
                    pending.append(target)
        return reachable

    canonical = closure(main_calls("tests/asl/main.asl"))
    shard_paths = subprocess.check_output(
        ["make", "--no-print-directory", "print-asl-test-shards"],
        cwd=ROOT,
        text=True,
    ).splitlines()
    sharded = closure(set().union(*(main_calls(path) for path in shard_paths)))
    return canonical, sharded


def bound_assertion(
    path: str,
    body: str,
    function: str,
    marker: str,
    reachability: tuple[set[str], set[str]],
) -> str:
    canonical, sharded = reachability
    require(
        function in canonical,
        f"witness function is not reachable from canonical main: {function}",
    )
    require(
        function in sharded,
        f"witness function is not reachable from sharded mains: {function}",
    )
    return assertion_after_marker(exact_function_body(path, body, function), marker)


def witness_binding_negative_canaries(
    decoder: str, state_tests: str
) -> list[dict[str, str]]:
    reachability = test_reachability(decoder)
    marker = "TRAP-WITNESS envelope/assert-number"
    relocated = state_tests.replace(f"    // {marker}\n", "", 1)
    relocated += f"\nfunc CanaryRelocatedWitness()\nbegin\n    // {marker}\n    assert TRUE;\nend;\n"
    try:
        bound_assertion(
            "tests/asl/state-tests.asl",
            relocated,
            "CheckSynchronousTrapMapping",
            marker,
            reachability,
        )
    except SystemExit as error:
        require(
            "witness marker must occur exactly once" in str(error),
            f"relocation canary failed for the wrong reason: {error}",
        )
    else:
        raise SystemExit("negative canary was accepted: witness-marker-relocation")

    shard_path = "tests/asl/shards/core-bundle.asl"
    shard_body = (ROOT / shard_path).read_text(encoding="utf-8")
    mutated_shard = shard_body.replace(
        "    TestCompleteTrapEnvelope();",
        "    // TestCompleteTrapEnvelope();",
        1,
    )
    require(mutated_shard != shard_body, "commented-call canary target drift")
    try:
        canonical, sharded = test_reachability(decoder, {shard_path: mutated_shard})
        require(
            "TestCompleteTrapEnvelope" in canonical,
            "commented-call canary lost canonical reachability",
        )
        require(
            "TestCompleteTrapEnvelope" in sharded,
            "witness function is not reachable from sharded mains: TestCompleteTrapEnvelope",
        )
    except SystemExit as error:
        require(
            "not reachable from sharded mains" in str(error),
            f"commented-call canary failed for the wrong reason: {error}",
        )
    else:
        raise SystemExit("negative canary was accepted: witness-commented-shard-call")
    return [
        {
            "canary_id": "witness-marker-relocation",
            "status": "rejected-as-required",
            "expected_guard": "function-local marker binding",
        },
        {
            "canary_id": "witness-commented-shard-call",
            "status": "rejected-as-required",
            "expected_guard": "canonical-and-sharded function reachability",
        },
    ]


def storage_only_rows(catalog: dict[str, Any]) -> list[dict[str, Any]]:
    names = {
        name
        for behavior in catalog["behavior_classes"]
        if behavior["profile_status"] == "pto-v0-storage-only"
        for name in behavior["registers"]
    }
    return [row for row in catalog["registers"] if row["name"] in names]


def storage_consumer_exclusion(
    catalog: dict[str, Any], sources: dict[str, str]
) -> dict[str, Any]:
    rows = storage_only_rows(catalog)
    require(len(rows) == 33, "expected exactly 33 PTO-v0 storage-only registers")
    addresses = expanded_storage_only_addresses(catalog)
    require(len(addresses) == 423, "storage-only canonical address expansion drift")
    inventory = unit_inventory(sources, STORAGE_BOUNDARY_SYMBOLS)
    fingerprint = require_inventory(
        "storage semantic access",
        inventory,
        EXPECTED_STORAGE_SEMANTIC_INVENTORY_SHA256,
    )
    return {
        "guard_id": "sysreg-consumer-exclusion-pto-v0-storage-only",
        "status": "closed-canonical-address-and-semantic-boundary",
        "register_count": len(rows),
        "registers": [row["name"] for row in rows],
        "canonical_address_count": len(addresses),
        "canonical_addresses": [
            {"address": f"0x{address:04X}", "registers": names}
            for address, names in addresses.items()
        ],
        "semantic_access_inventory_sha256": fingerprint,
        "semantic_access_inventory": inventory,
        "rule": "All fixed and bank-expanded storage-only addresses are enumerated, and every normative function that can reach the extended register backing store or any generic/context address API is content-addressed. A literal full-bank address, computed index, symbolic helper call, or direct backing-store access changes the reviewed inventory and fails closed.",
    }


def trap_consumer_exclusion(
    catalog: dict[str, Any], sources: dict[str, str]
) -> dict[str, Any]:
    traps = [
        row
        for row in catalog["trap_numbers"]
        if row["pto_v0_status"] == "envelope-only-no-trigger"
    ]
    require(
        [row["number"] for row in traps] == [33, 49, 51], "envelope-only trap set drift"
    )
    rows = []
    fault_symbols: set[str] = set()
    for trap in traps:
        producer = trap["producers"][0]
        match = re.fullmatch(r"SetFault\((Fault_[A-Za-z]+)\)", producer)
        require(
            match is not None,
            f"envelope-only trap lacks SetFault envelope: {trap['name']}",
        )
        fault = match.group(1)
        fault_symbols.add(fault)
        occurrences = []
        for relative, body in sorted(sources.items()):
            for line_number, line in enumerate(body.splitlines(), 1):
                if re.search(rf"\b{re.escape(fault)}\b", line) is None:
                    continue
                normalized = line.strip()
                allowed = (
                    relative == "asl/types.asl" and normalized.rstrip(",") == fault
                ) or (
                    relative == "asl/state.asl"
                    and normalized.startswith(
                        f"when {fault} => _ACRTrapNumber[[ring]] ="
                    )
                )
                require(
                    allowed,
                    f"envelope-only trap gained a PTO-v0 trigger: {relative}:{line_number}: {normalized}",
                )
                occurrences.append(
                    {"path": relative, "line": line_number, "text": normalized}
                )
        require(
            len(occurrences) == 2,
            f"envelope-only declaration/mapping drift: {trap['name']}",
        )
        rows.append(
            {
                "name": trap["name"],
                "number": trap["number"],
                "fault": fault,
                "status": trap["pto_v0_status"],
                "allowed_normative_occurrences": occurrences,
            }
        )
    inventory = unit_inventory(
        sources,
        TRAP_ACTIVATION_SYMBOLS | fault_symbols,
        {trap["number"] for trap in traps},
    )
    fingerprint = require_inventory(
        "trap activation",
        inventory,
        EXPECTED_TRAP_ACTIVATION_INVENTORY_SHA256,
    )
    return {
        "guard_id": "trap-consumer-exclusion-pto-v0-envelope-only",
        "status": "closed-no-production-trigger-reachability",
        "trap_count": len(rows),
        "traps": rows,
        "activation_inventory_sha256": fingerprint,
        "activation_inventory": inventory,
        "rule": "Envelope-only fault symbols remain limited to declaration and SetFault mapping. Every normative function that can mutate trap identity, invoke a trap producer, or mention canonical trap numbers 33, 49, or 51 is content-addressed, so direct assignments, helper activation, and indirect SetFault call sites fail closed.",
    }


def consumer_exclusion_negative_canaries(
    catalog: dict[str, Any], sources: dict[str, str]
) -> list[dict[str, str]]:
    cases = [
        (
            "storage-full-bank-address",
            storage_consumer_exclusion,
            "asl/state.asl",
            "func CanaryStorageFullAddress() => Word begin return ReadSystemRegisterAddress(Zeros{24} + 0x1f10); end;",
            "storage semantic access inventory drift",
        ),
        (
            "storage-symbolic-backing-index",
            storage_consumer_exclusion,
            "asl/state.asl",
            "func CanaryStorageSymbolic(index: SystemRegisterFileIndex) => Word begin return _ExtendedSystemRegisters[[index]]; end;",
            "storage semantic access inventory drift",
        ),
        (
            "storage-transitive-wrapper-consumer",
            storage_consumer_exclusion,
            "asl/state.asl",
            "func CanaryStorageWrapperConsumer(address: SystemRegisterAddress) begin ExecuteCompressedSystemRegisterGet(address); end;",
            "storage semantic access inventory drift",
        ),
        (
            "trap-direct-number-assignment",
            trap_consumer_exclusion,
            "asl/state.asl",
            "func CanaryTrapNumber(ring: AccessControlRing) begin _ACRTrapNumber[[ring]] = Zeros{6} + 33; end;",
            "trap activation inventory drift",
        ),
        (
            "trap-number-helper",
            trap_consumer_exclusion,
            "asl/state.asl",
            "pure func CanaryTrapHelper() => TrapNumber begin return Zeros{6} + 49; end;",
            "trap activation inventory drift",
        ),
        (
            "trap-indirect-setfault",
            trap_consumer_exclusion,
            "asl/state.asl",
            "func CanaryIndirectFault(code: FaultCode) begin SetFault(code, ReadTPC()); end;",
            "trap activation inventory drift",
        ),
    ]
    results = []
    for canary_id, guard, path, addition, expected_message in cases:
        mutated = dict(sources)
        mutated[path] = f"{mutated[path]}\n{addition}\n"
        try:
            guard(catalog, mutated)
        except SystemExit as error:
            require(
                expected_message in str(error),
                f"negative canary {canary_id} failed for the wrong reason: {error}",
            )
        else:
            raise SystemExit(f"negative canary was accepted: {canary_id}")
        results.append(
            {
                "canary_id": canary_id,
                "status": "rejected-as-required",
                "expected_guard": expected_message,
            }
        )
    return results


def generate() -> dict[str, Any]:
    catalog = load(CATALOG)
    normative_sources = normative_asl_sources()
    decoder = generated_decoder()
    main = (ROOT / "tests/asl/main.asl").read_text(encoding="utf-8")
    state_tests = (ROOT / "tests/asl/state-tests.asl").read_text(encoding="utf-8")
    reachability = test_reachability(decoder)
    require(
        "ValidateSystemRegisterResetAndAccess();" in main,
        "system-register generated witness is not reachable from canonical main",
    )
    require(
        "TestCompleteTrapEnvelope();" in main,
        "trap envelope witness is not reachable from canonical main",
    )

    behaviors = []
    side_effect_count = 0
    source_bodies = {
        path: (ROOT / path).read_text(encoding="utf-8")
        for path, _ in SIDE_EFFECT_BINDINGS.values()
    }
    for behavior in catalog["behavior_classes"]:
        behavior_id = behavior["id"]
        reset_marker = f"SYSREG-WITNESS class/{behavior_id}/reset"
        access_marker = f"SYSREG-WITNESS class/{behavior_id}/access"
        effects = []
        for effect in behavior["side_effects"]:
            binding = SIDE_EFFECT_BINDINGS.get((behavior_id, effect))
            if binding is None:
                marker = f"SYSREG-WITNESS effect/{behavior_id}/{slug(effect)}"
                source_path = "generated:build/decoders.asl"
                function = "ValidateSystemRegisterResetAndAccess"
                assertion_body = decoder
                closure = "static-consumer-exclusion-plus-access-round-trip"
            else:
                source_path, function = binding
                marker = f"SYSREG-EFFECT-WITNESS {behavior_id}/{slug(effect)}"
                assertion_body = source_bodies[source_path]
                closure = "direct-effect-assertion"
            effects.append(
                {
                    "side_effect": effect,
                    "witness_id": f"sysreg-effect:{behavior_id}:{slug(effect)}",
                    "assertion_marker": marker,
                    "assertion": bound_assertion(
                        source_path,
                        assertion_body,
                        function,
                        marker,
                        reachability,
                    ),
                    "function": function,
                    "source": source_path,
                    "closure": closure,
                    "execution_reachability": "canonical-and-sharded",
                }
            )
        side_effect_count += len(effects)
        behaviors.append(
            {
                "behavior_class": behavior_id,
                "profile_status": behavior["profile_status"],
                "registers": behavior["registers"],
                "reset_witness": {
                    "witness_id": f"sysreg-class:{behavior_id}:reset",
                    "assertion_marker": reset_marker,
                    "assertion": bound_assertion(
                        "generated:build/decoders.asl",
                        decoder,
                        "ValidateSystemRegisterResetAndAccess",
                        reset_marker,
                        reachability,
                    ),
                    "function": "ValidateSystemRegisterResetAndAccess",
                    "source": "generated:build/decoders.asl",
                    "execution_reachability": "canonical-and-sharded",
                },
                "access_witness": {
                    "witness_id": f"sysreg-class:{behavior_id}:access",
                    "assertion_marker": access_marker,
                    "assertion": bound_assertion(
                        "generated:build/decoders.asl",
                        decoder,
                        "ValidateSystemRegisterResetAndAccess",
                        access_marker,
                        reachability,
                    ),
                    "function": "ValidateSystemRegisterResetAndAccess",
                    "source": "generated:build/decoders.asl",
                    "execution_reachability": "canonical-and-sharded",
                },
                "side_effect_witnesses": effects,
            }
        )

    synchronous_helper_markers = [
        "TRAP-WITNESS envelope/assert-number",
        "TRAP-WITNESS envelope/assert-argument",
        "TRAP-WITNESS envelope/assert-restart",
    ]
    trap_witnesses = []
    for trap in catalog["trap_numbers"]:
        case_marker = f"TRAP-WITNESS case/{trap['name']}"
        case_statement = statement_after_marker(
            exact_function_body(
                "tests/asl/state-tests.asl",
                state_tests,
                "TestCompleteTrapEnvelope",
            ),
            case_marker,
        )
        require(
            "TestCompleteTrapEnvelope" in reachability[0]
            and "TestCompleteTrapEnvelope" in reachability[1],
            "trap case function is not reachable from canonical and sharded mains",
        )
        if trap["name"] == "INTERRUPT":
            helper_function = "TestCompleteTrapEnvelope"
            helper_markers = [
                "TRAP-WITNESS interrupt/assert-number",
                "TRAP-WITNESS interrupt/assert-argument",
                "TRAP-WITNESS interrupt/assert-restart",
            ]
            closure = "exact-interrupt-envelope"
        elif trap["name"] == "SCALL":
            helper_function = "CheckServiceRequestTrapMapping"
            helper_markers = [
                "TRAP-WITNESS scall/assert-number",
                "TRAP-WITNESS scall/assert-argument",
                "TRAP-WITNESS scall/assert-cause",
                "TRAP-WITNESS scall/assert-synchronous",
                "TRAP-WITNESS scall/assert-argument-valid",
                "TRAP-WITNESS scall/assert-saved-source",
                "TRAP-WITNESS scall/assert-saved-restart",
                "TRAP-WITNESS scall/assert-visible-restart",
                "TRAP-WITNESS scall/assert-vector-entry",
                "TRAP-WITNESS scall/assert-restart",
            ]
            closure = "exact-service-request-leaf-semantics"
        else:
            helper_function = "CheckSynchronousTrapMapping"
            helper_markers = synchronous_helper_markers
            closure = "exact-synchronous-envelope"
        helper_assertions = [
            {
                "assertion_marker": marker,
                "assertion": bound_assertion(
                    "tests/asl/state-tests.asl",
                    state_tests,
                    helper_function,
                    marker,
                    reachability,
                ),
                "function": helper_function,
                "source": "tests/asl/state-tests.asl",
                "execution_reachability": "canonical-and-sharded",
            }
            for marker in helper_markers
        ]
        trap_witnesses.append(
            {
                "name": trap["name"],
                "number": trap["number"],
                "pto_v0_status": trap["pto_v0_status"],
                "witness_id": f"trap-envelope:{trap['number']}:{trap['name']}",
                "case_marker": case_marker,
                "case_statement": case_statement,
                "function": "TestCompleteTrapEnvelope",
                "source": "tests/asl/state-tests.asl",
                "closure": closure,
                "execution_reachability": "canonical-and-sharded",
                "catalog_contract": {
                    "cause": trap["cause"],
                    "argument": trap["argument"],
                    "restart": trap["restart"],
                },
                "helper_assertions": helper_assertions,
            }
        )

    concrete_address_count = 0
    for row in catalog["registers"]:
        concrete_address_count += (
            16 if row["scope"] == "context-family" and "fixed_context" not in row else 1
        )
    require(
        concrete_address_count == 837,
        "bank-expanded system-register address count drift",
    )
    storage_guard = storage_consumer_exclusion(catalog, normative_sources)
    trap_guard = trap_consumer_exclusion(catalog, normative_sources)
    negative_canaries = consumer_exclusion_negative_canaries(catalog, normative_sources)
    binding_canaries = witness_binding_negative_canaries(decoder, state_tests)
    return {
        "schema_version": 1,
        "target": "S2-T1:S2-T3:issue-34",
        "status": "reference-witness-and-consumer-exclusion-closed",
        "behavior_classes": behaviors,
        "trap_witnesses": trap_witnesses,
        "consumer_exclusion": {
            "storage_only_registers": storage_guard,
            "envelope_only_traps": trap_guard,
            "negative_canaries": negative_canaries,
        },
        "witness_binding_negative_canaries": binding_canaries,
        "sources": [
            source("Makefile"),
            source("spec/catalog/system-registers.json"),
            source("scripts/generate-asl-decoders"),
            {
                "path": "generated:build/decoders.asl",
                "sha256": sha256_text(decoder),
            },
            source("tests/asl/main.asl"),
            source("tests/asl/shards/core-bundle.asl"),
            source("tests/asl/scalar-tests.asl"),
            source("tests/asl/state-tests.asl"),
            source("tests/asl/tile-tests.asl"),
            source("asl/types.asl"),
            source("asl/state.asl"),
            source("asl/profiles/pto-v0.asl"),
            source("asl/scalar/system-registers.asl"),
        ],
        "summary": {
            "register_definition_count": len(catalog["registers"]),
            "bank_expanded_address_count": concrete_address_count,
            "behavior_class_count": len(behaviors),
            "side_effect_contract_count": side_effect_count,
            "storage_only_register_count": len(storage_only_rows(catalog)),
            "trap_count": len(trap_witnesses),
            "production_active_trap_count": sum(
                row["pto_v0_status"] == "production-active" for row in trap_witnesses
            ),
            "envelope_only_trap_count": sum(
                row["pto_v0_status"] == "envelope-only-no-trigger"
                for row in trap_witnesses
            ),
        },
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    action.add_argument("--check-canaries", action="store_true")
    args = parser.parse_args()
    expected = serialized()
    if args.check_canaries:
        document = json.loads(expected)
        canaries = document["consumer_exclusion"]["negative_canaries"]
        canaries += document["witness_binding_negative_canaries"]
        for row in canaries:
            print(f"{row['canary_id']}: {row['status']} ({row['expected_guard']})")
        return 0
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.is_file() or OUTPUT.read_text(encoding="utf-8") != expected:
        raise SystemExit(f"stale generated evidence: {OUTPUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
