#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

structure_only=false
for argument in "$@"; do
    case $argument in
        --structure-only) structure_only=true ;;
        *)
            echo "usage: $0 [--structure-only]" >&2
            exit 2
            ;;
    esac
done

fail() {
    echo "error: $*" >&2
    exit 1
}

./scripts/check-active-paths

required_files=(
    .aslref-version
    AGENTS.md
    CODE_OF_CONDUCT.md
    CONTRIBUTING.md
    GOVERNANCE.md
    README.md
    SECURITY.md
    LICENSE
    NOTICE
    specification.toml
    .github/CODEOWNERS
    .codex/skills/pto-asl/SKILL.md
    asl/arch/overview/architecture.asl
    asl/block/lifecycle/BSTART.asl
    asl/scalar/alu/ADD.asl
    asl/tile/memory-and-data-movement/regular/TLOAD.asl
    docs/mkdocs/mkdocs.yml
    docs/status/decisions/0037-numeric-profile-identity-and-variation-framework.md
    docs/status/decisions/0038-scalar-numeric-flag-state-and-ownership.md
    docs/status/decisions/0039-numeric-rounding-selector-ownership.md
    docs/status/decisions/0047-numeric-rounding-semantics.md
    docs/status/decisions/0040-numeric-format-namespace-ownership.md
    docs/status/decisions/0048-numeric-format-value-classification.md
    docs/status/decisions/0049-hardware-subnormal-policy.md
    docs/status/decisions/0050-hardware-special-value-checkpoint.md
    docs/status/decisions/0051-predicate-state-namespace-boundary.md
    docs/status/decisions/0041-a2a3-mx-profile-applicability.md
    docs/status/decisions/0042-numeric-variation-point-ownership.md
    docs/status/decisions/0043-public-numeric-type-identity-and-availability.md
    docs/status/decisions/0044-public-integer-conversion-result-subset.md
    docs/status/decisions/0052-direct-tile-and-bundle-catalog-closure.md
    docs/status/decisions/0056-pto-encoding-ownership-and-gm-access.md
    docs/status/decisions/0046-separate-execution-mask-and-warp-predicates.md
    spec/release-inputs.json
    spec/catalog/scalar-forms.json
    spec/catalog/command-forms.json
    spec/catalog/numeric-profile-identities.json
    spec/catalog/numeric-profile-applicability.json
    spec/catalog/system-registers.json
    spec/catalog/tile-operations.json
    spec/hardware-conformance-profile.json
    spec/release-manifest.json
    spec/evidence/pto-isa-0583-abi-vectors.json
    spec/evidence/pto-isa-0583-encoding-totality.json
    spec/evidence/pto-isa-0583-hardware-numeric-vectors.json
    spec/evidence/release-gate-readiness.json
    spec/evidence/release-traceability-readiness.json
    scripts/generate-release-gate-readiness
    scripts/generate-release-manifest
    scripts/generate-release-traceability-readiness
    scripts/manual_semantic_audit.py
    scripts/asl_tests.py
    tests/README.md
    scripts/check-asl-layout
    scripts/check-active-paths
    scripts/check-asl-tests
    scripts/check-ndf
    scripts/check-release-closure
    scripts/print-asl-test-matrix
    scripts/prepare-aslref
    scripts/report-asl-page-results
    scripts/run-asl-page
    scripts/run-asl-test
    scripts/run-asl-release-suite
    scripts/check-release-manifest
    scripts/check-script-entrypoints
    scripts/encoding_witness.py
)

for path in "${required_files[@]}"; do
    [[ -f $path ]] || fail "required repository file is missing: $path"
done

pin=$(tr -d '[:space:]' < .aslref-version)
[[ $pin =~ ^[0-9a-f]{40}$ ]] || fail ".aslref-version must contain one full Git commit SHA"

if git ls-files | grep -Eq '^(build|\.cache)/'; then
    fail "generated build or cache files are tracked"
fi

# Parse policy input as TOML instead of matching source formatting. The status
# fields live in the specification table and must describe one maturity state.
metadata=$(python3 - <<'PY'
import pathlib
import tomllib

data = tomllib.loads(pathlib.Path("specification.toml").read_text(encoding="utf-8"))
specification = data.get("specification", {})
status = specification.get("status")
normative = specification.get("normative")
if not isinstance(status, str):
    raise SystemExit("specification.status must be a string")
if not isinstance(normative, bool):
    raise SystemExit("specification.normative must be a boolean")
print(status)
print(str(normative).lower())
PY
) || fail "specification.toml does not contain valid maturity metadata"

status=${metadata%%$'\n'*}
normative=${metadata#*$'\n'}

case $status in
    draft | normative | architecturally-complete) ;;
    *) fail "unsupported specification status: '$status'" ;;
esac

if [[ $normative != true ]]; then
    fail "$status status requires normative = true"
fi

# Every checked-in ASL source must reach the assembled file and therefore the
# type checker.
assembled=$(make --no-print-directory print-asl-sources)

while IFS= read -r path; do
    [[ -n $path ]] || continue
    [[ -f $path ]] || continue
    grep -Fxq -- "$path" <<<"$assembled" ||
        fail "ASL source is absent from ASL_SOURCES and is never type-checked: $path"
done < <(git ls-files asl | grep -E '\.asl$')

# Every supported maturity must execute semantic evidence.
test_count=0
while IFS= read -r path; do
    [[ -n $path ]] || continue
    test_count=$((test_count + 1))
    [[ -f $path ]] || fail "ASL_TESTS lists a missing file: $path"
done < <(make --no-print-directory print-asl-tests)

if [[ $test_count -eq 0 ]]; then
    fail "$status status requires executable semantic tests in ASL_TESTS"
fi

empty_tree=$(git hash-object -t tree /dev/null)
git diff --check "$empty_tree" HEAD
git diff --check
git diff --cached --check

./scripts/check-script-entrypoints

./scripts/check-asl-layout
./scripts/check-ndf
./scripts/check-asl-tests
python3 scripts/project_asl_catalogs.py --root . --check
python3 scripts/instruction_docs.py --check
python3 scripts/instruction_contracts.py --check --require-complete
./scripts/generate-instruction-contract-closure --check
python3 scripts/generate-mnemonic-avs.py --check
python3 scripts/check-publication-hygiene

if [[ $structure_only == true ]]; then
    echo "repository structure checks passed"
    exit 0
fi

./scripts/check-binary-closure
echo "repository checks passed"
