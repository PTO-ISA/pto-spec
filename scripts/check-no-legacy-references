#!/usr/bin/env python3
"""Reject superseded architecture and private-reference identities."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
FORBIDDEN = (
    "li" + "nx",
    "0" + "." + "57",
    "v" + "call",
    "m" + "call",
    "da" + "vincioo",
    "heng" + "liao1972",
)


def main() -> int:
    result = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    )
    failures: list[str] = []
    for relative in result.stdout.splitlines():
        lower_path = relative.lower()
        if any(term in lower_path for term in FORBIDDEN):
            failures.append(f"forbidden reference in path: {relative}")
            continue
        path = ROOT / relative
        if not path.is_file():
            continue
        try:
            body = path.read_text(encoding="utf-8").lower()
        except UnicodeDecodeError:
            continue
        if any(term in body for term in FORBIDDEN):
            failures.append(f"forbidden reference in file: {relative}")
    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1
    print("legacy-reference check passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
