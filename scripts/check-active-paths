#!/usr/bin/env python3
"""Reject obsolete, unowned, or symlinked active specification paths."""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


OBSOLETE_PATHS = (
    Path("asl/bundle"),
    Path("asl/numeric"),
    Path("asl/profiles"),
    Path("asl/architecture.asl"),
    Path("asl/types.asl"),
    Path("asl/state.asl"),
    Path("asl/concurrency.asl"),
    Path("asl/dispatch.asl"),
    Path("docs/instructions"),
    Path("docs/status/legacy"),
    Path("tests/asl/main.asl"),
    Path("tests/asl/shards"),
)
MARKDOWN_ROOTS = frozenset(
    {
        "arch",
        "block",
        "scalar",
        "tile",
        "status",
        "governance",
        "development",
        "releases",
        "site",
    }
)
GENERATED_SITE_PATHS = (
    Path("docs/site/node_modules"),
    Path("docs/site/.docusaurus"),
    Path("docs/site/build"),
    Path("docs/site/test-results"),
    Path("docs/site/playwright-report"),
)
AGENT_ENTRYPOINTS = (
    Path("AGENTS.md"),
    Path(".codex/skills/pto-asl/SKILL.md"),
    Path(".codex/skills/pto-asl/agents/openai.yaml"),
    Path(".codex/skills/pto-asl/references/arm-style.md"),
    Path(".codex/skills/pto-asl/references/formal-quality.md"),
    Path(".codex/skills/pto-asl/references/source-map.md"),
)
SUPERSEDED_AGENT_ROUTES = (
    "docs/status/legacy/",
    "scripts/check-catalogs",
    "ASL_TESTS",
    "make ci",
    "spec/requirements.json",
    "PRD-",
    "PD-",
)


def _at_or_below(path: Path, owner: Path) -> bool:
    return path == owner or owner in path.parents


def _owned_markdown(path: Path) -> bool:
    return (
        len(path.parts) >= 3
        and path.parts[0] == "docs"
        and path.parts[1] in MARKDOWN_ROOTS
    )


def _tracked_paths(root: Path, tracked_list: Path | None) -> tuple[Path, ...]:
    if tracked_list is not None:
        values = tracked_list.read_text(encoding="utf-8").splitlines()
    else:
        values = subprocess.run(
            ["git", "ls-files", "-z"],
            cwd=root,
            check=True,
            capture_output=True,
        ).stdout.decode().split("\0")
    return tuple(Path(value) for value in values if value)


def validate(root: Path, tracked: tuple[Path, ...]) -> list[str]:
    errors: list[str] = []
    for obsolete in OBSOLETE_PATHS:
        absolute = root / obsolete
        if absolute.exists() or absolute.is_symlink():
            errors.append(f"obsolete active path must not return: {obsolete}")
        for path in tracked:
            if _at_or_below(path, obsolete):
                errors.append(f"obsolete tracked path must not return: {path}")

    docs = root / "docs"
    if docs.exists():
        for absolute in sorted(docs.rglob("*")):
            relative = absolute.relative_to(root)
            if any(_at_or_below(relative, generated) for generated in GENERATED_SITE_PATHS):
                continue
            if absolute.is_symlink() and relative.suffix == ".md":
                errors.append(f"active Markdown symlink is forbidden: {relative}")
            if relative.suffix == ".md" and not _owned_markdown(relative):
                errors.append(
                    "active Markdown is outside the ASL mirror or another owned documentation root "
                    f"ownership: {relative}"
                )
    for path in tracked:
        if any(_at_or_below(path, generated) for generated in GENERATED_SITE_PATHS):
            errors.append(f"generated site path must not be tracked: {path}")
            continue
        if path.suffix == ".md" and path.parts[:1] == ("docs",) and not _owned_markdown(path):
            errors.append(
                "active Markdown is outside the ASL mirror or another owned documentation root "
                f"ownership: {path}"
            )
    for relative in AGENT_ENTRYPOINTS:
        path = root / relative
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for route in SUPERSEDED_AGENT_ROUTES:
            for line in text.splitlines():
                if route not in line:
                    continue
                errors.append(
                    "agent entrypoint routes to superseded contract: "
                    f"{relative}: {route}"
                )
    return sorted(set(errors))


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--tracked-list", type=Path)
    arguments = parser.parse_args()
    root = arguments.root.resolve()
    errors = validate(root, _tracked_paths(root, arguments.tracked_list))
    if errors:
        print("\n".join(f"error: {error}" for error in errors), file=sys.stderr)
        return 1
    print("active path closure passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
