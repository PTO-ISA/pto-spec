#!/usr/bin/env python3
"""Report one parallel ASL page to the console and GitHub step summary."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.asl_tests import report_page_results  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--matrix", type=Path, required=True)
    parser.add_argument("--results", type=Path, required=True)
    parser.add_argument("--summary", type=Path)
    arguments = parser.parse_args()
    summary = arguments.summary
    if summary is None and os.environ.get("GITHUB_STEP_SUMMARY"):
        summary = Path(os.environ["GITHUB_STEP_SUMMARY"])
    return report_page_results(
        arguments.matrix.resolve(),
        arguments.results.resolve(),
        summary_path=summary.resolve() if summary is not None else None,
    )


if __name__ == "__main__":
    raise SystemExit(main())
