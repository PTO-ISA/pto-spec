#!/usr/bin/env python3
"""Generate publication-safe S5-T2-A numeric profile decision inputs."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
from typing import Any
import sys


if str(ROOT := Path(__file__).resolve().parents[1]) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.adr_records import load_adrs


OUTPUT = ROOT / "spec/evidence/numeric-contract-decision-inputs.json"
PUBLIC_REPOSITORY = "https://github.com/hw-native-sys/pto-isa"
# Numeric implementation evidence remains at its separately audited snapshot.
# The public predicate/mask reconciliation advances independently because two
# numeric implementation files changed at the newer public commit and have not
# been re-audited as part of that version-boundary checkpoint.
PUBLIC_COMMIT = "712cbe9f23df5d5362be5e8327599f4285317473"
CURRENT_RECONCILIATION_COMMIT = "1f61a9a28b375e5113761defdc66fd03554b5e0d"


def source(
    source_id: str, path: str, role: str, sha256: str, layer: str
) -> dict[str, str]:
    return {
        "id": source_id,
        "path": path,
        "role": role,
        "layer": layer,
        "sha256": sha256,
        "url": f"{PUBLIC_REPOSITORY}/blob/{PUBLIC_COMMIT}/{path}",
    }


SOURCES = (
    source(
        "public-type-system",
        "docs/isa/state-and-types/type-system.md",
        "published numeric formats, exceptional values, conversion rules, and target variation points",
        "3bbd2d11d24cf503962f269f6c0d313a331039f1193409422ede4e68d9993330",
        "public-contract",
    ),
    source(
        "public-portability-rules",
        "docs/isa/reference/portability-and-target-profiles.md",
        "published portable-semantics and target-narrowing boundary",
        "e607ab10d5b35d5f492ee187c582d3782115f195c87c0b88fc038272d52abd29",
        "public-contract",
    ),
    source(
        "cpu-conversion",
        "include/pto/cpu/TCvt.hpp",
        "CPU conversion, rounding, and saturation implementation evidence",
        "5824b29148028fa9358854ce5a729571a0101dc8c07b9c1347f2fe9c76f247b4",
        "implementation-evidence",
    ),
    source(
        "cpu-square-root",
        "include/pto/cpu/TSqrt.hpp",
        "CPU square-root implementation evidence",
        "aab7b3b0df41690e8f112e6f02f63c365b82cf7e580b933e90701024f79177df",
        "implementation-evidence",
    ),
    source(
        "cpu-reciprocal-square-root",
        "include/pto/cpu/TRSqrt.hpp",
        "CPU reciprocal-square-root implementation evidence",
        "3b2304aad6473a3632dc034e0af6a5b474e0bd8bf043f72098fb50023d2eaa43",
        "implementation-evidence",
    ),
    source(
        "cpu-reduction",
        "include/pto/cpu/TReduce.hpp",
        "CPU reduction implementation evidence",
        "d91643b4c22673dfce152c636cf8a103153fd0e08321cbc43f5d637261161508",
        "implementation-evidence",
    ),
    source(
        "cpu-matrix",
        "include/pto/cpu/TMatmul.hpp",
        "CPU matrix arithmetic and MX implementation evidence",
        "bb2f361360740ad36961ab9431b42de1d33b341edf60e2f0862ff371aaf7dcd4",
        "implementation-evidence",
    ),
    source(
        "cpu-quantization",
        "include/pto/cpu/TQuant.hpp",
        "CPU quantization format, scale, rounding, and special-value implementation evidence",
        "8dd82083bd5c7332b39002b964d110a3fd0fffecf344c3ea5433cfcecbe8f779",
        "implementation-evidence",
    ),
    source(
        "cpu-dequantization",
        "include/pto/cpu/TDeQuant.hpp",
        "CPU dequantization implementation evidence",
        "f5d4e7a4c8f28845f27ec16d0092a4c9801a999d365a67c431727d8bcdd21bc4",
        "implementation-evidence",
    ),
)


NUMERIC_ADR_IDS = (
    "ADR-NUM-0008",
    "ADR-NUM-0010",
    "ADR-NUM-0013",
    "ADR-NUM-0014",
    "ADR-NUM-0015",
    "ADR-NUM-0016",
    "ADR-NUM-0017",
    "ADR-NUM-0018",
    "ADR-NUM-0019",
    "ADR-NUM-0021",
    "ADR-NUM-0022",
)

RETIRED_NUMERIC_DOMAINS = {
    "tile-dequantize",
    "tile-order",
    "tile-partial",
    "tile-quantize",
}


def parse_affected_domains(path: Path, known_domains: set[str]) -> tuple[str, ...]:
    body = path.read_text(encoding="utf-8").split("---", 2)[-1]
    sections = re.findall(
        r"^## Affected domains\n+(.*?)(?=^## |\Z)",
        body,
        flags=re.MULTILINE | re.DOTALL,
    )
    if len(sections) != 1:
        raise ValueError(f"{path}: expected exactly one Affected domains section")
    domains = []
    seen = set()
    for line in sections[0].splitlines():
        if not line.strip():
            continue
        match = re.fullmatch(r"- `([a-z0-9-]+)`", line)
        if match is None:
            raise ValueError(f"{path}: malformed affected-domain row: {line!r}")
        domain = match.group(1)
        if domain in seen:
            raise ValueError(f"{path}: duplicate affected domain: {domain}")
        seen.add(domain)
        if domain in RETIRED_NUMERIC_DOMAINS:
            continue
        if domain not in known_domains:
            raise ValueError(f"{path}: unknown affected domain: {domain}")
        domains.append(domain)
    if not domains:
        raise ValueError(f"{path}: affected-domain list is empty")
    return tuple(sorted(domains))


def load(relative: str) -> dict[str, Any]:
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"numeric profile decision-input generation failed: {message}")


def generate() -> dict[str, Any]:
    contracts = load("spec/evidence/numeric-contracts.json")
    readiness = load("spec/evidence/numeric-conformance-readiness.json")
    reconciliation = load("spec/evidence/public-source-reconciliation.json")
    comparison = load("spec/evidence/executable-model-comparison.json")
    require(
        reconciliation["public_repository"] == PUBLIC_REPOSITORY,
        "public repository drift",
    )
    require(
        reconciliation["public_commit"] == CURRENT_RECONCILIATION_COMMIT,
        "current public reconciliation commit drift",
    )
    require(readiness["target"] == "S5-T2", "readiness target drift")
    require(
        comparison["target"] == "S5-T3"
        and comparison["closure_judgment"]["can_close_s5_t3"] is True
        and comparison["closure_judgment"]["remaining_blockers"] == [],
        "comparison boundary is not closed",
    )

    sources_by_id = {row["id"]: row for row in SOURCES}
    require(len(sources_by_id) == len(SOURCES), "duplicate source identity")
    adr_index = load("spec/evidence/adr-index.json")
    records_by_id = {
        record.adr_id: record
        for record in load_adrs(ROOT / "docs/status/decisions")
    }
    mapped_adr_ids = set(NUMERIC_ADR_IDS)
    require(
        mapped_adr_ids <= set(records_by_id),
        "numeric ADR mapping references a missing decision record",
    )
    require(
        mapped_adr_ids <= {row["id"] for row in adr_index["records"]},
        "numeric ADR mapping is absent from the generated ADR index",
    )
    domains_by_id = {row["id"]: row for row in contracts["contract_domains"]}
    domains_by_adr_id = {
        adr_id: parse_affected_domains(records_by_id[adr_id].path, set(domains_by_id))
        for adr_id in NUMERIC_ADR_IDS
    }
    domain_adrs = {
        domain_id: sorted(
            adr_id
            for adr_id, affected_domains in domains_by_adr_id.items()
            if domain_id in affected_domains
        )
        for domain_id in domains_by_id
    }
    require(
        all(domain_adrs.values()),
        "one or more numeric domains have no ADR owner",
    )
    lanes_by_domain = {
        domain_id: lane["id"]
        for lane in readiness["lanes"]
        for domain_id in lane["contract_domains"]
    }
    operations_by_domain: dict[str, list[dict[str, Any]]] = {
        domain_id: [] for domain_id in domains_by_id
    }
    for operation in contracts["operations"]:
        operations_by_domain[operation["numeric_contract"]].append(operation)

    decisions = []
    for adr_id in sorted(mapped_adr_ids):
        record = records_by_id[adr_id]
        decisions.append(
            {
                "adr": adr_id,
                "status": record.status,
                "affected_domains": list(domains_by_adr_id[adr_id]),
                "acceptance_record": (
                    record.path.relative_to(ROOT).as_posix()
                    if record.status == "accepted"
                    else None
                ),
            }
        )

    domain_matrix = []
    for domain_id in domains_by_id:
        operation_rows = operations_by_domain[domain_id]
        hook_names = sorted(
            {
                name
                for operation in operation_rows
                for name in operation["primary_hooks"] + operation["reference_helpers"]
            }
        )
        decision_adr_ids = domain_adrs[domain_id]
        domain_matrix.append(
            {
                "domain": domain_id,
                "lane": lanes_by_domain[domain_id],
                "operation_count": len(operation_rows),
                "operation_keys": sorted(row["key"] for row in operation_rows),
                "hooks": hook_names,
                "open_numeric_dimensions": domains_by_id[domain_id][
                    "open_numeric_dimensions"
                ],
                "decision_adr_ids": decision_adr_ids,
                "status": "contract-rule-required",
                "selected_profile_rule": None,
            }
        )

    return {
        "schema_version": 1,
        "target": "S5-T2-A",
        "status": "decision-inputs-and-identities-closed-profile-decisions-open",
        "public_repository": PUBLIC_REPOSITORY,
        "public_commit": PUBLIC_COMMIT,
        "policy": {
            "authority": "PTO ASL and accepted architecture decisions define numeric semantics; public implementation evidence exposes choices but cannot select them.",
            "profile_boundary": "Support restrictions, portable result rules, named target result rules, and bounded implementation-defined behavior must be classified separately.",
            "cpu_role": "CPU simulation is an implementation under test and host arithmetic is not a target oracle.",
            "independent_comparison_role": "Executable-ISA comparison is separate evidence and does not provide S5-T2 numeric differential results or select numeric decisions.",
            "no_implicit_choice": "A missing profile rule remains open; the generator never chooses the most convenient backend behavior.",
        },
        "contract_partition_inputs": [
            {
                "id": "portable-numeric",
                "role": "portable result contract",
                "status": "identity-accepted-rules-required",
            },
            {
                "id": "cpu-observation",
                "role": "implementation-under-test observation only",
                "status": "identity-accepted-observation-schema-required-not-an-oracle",
            },
        ],
        "sources": list(SOURCES),
        "decisions": decisions,
        "domain_matrix": domain_matrix,
        "summary": {
            "source_count": len(SOURCES),
            "public_contract_source_count": sum(
                row["layer"] == "public-contract" for row in SOURCES
            ),
            "implementation_evidence_source_count": sum(
                row["layer"] == "implementation-evidence" for row in SOURCES
            ),
            "decision_count": len(decisions),
            "draft_decision_count": sum(
                row["status"] == "draft" for row in decisions
            ),
            "numeric_domain_count": len(domain_matrix),
            "open_numeric_domain_count": len(domain_matrix),
            "selected_contract_rule_count": 0,
            "contract_identity_count": 2,
        },
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    args = parser.parse_args()
    expected = serialized()
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.exists() or OUTPUT.read_text(encoding="utf-8") != expected:
        raise SystemExit(
            "numeric profile decision inputs are stale; run scripts/generate-numeric-contract-decision-inputs --write"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
