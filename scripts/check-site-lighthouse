#!/usr/bin/env python3
"""Run release-blocking Lighthouse budgets against the built PTO site."""

from __future__ import annotations

import json
import os
import shutil
import statistics
import subprocess
import sys
import time
import urllib.request
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
SITE = ROOT / "docs/site"
PORT = 3012
BASE_URL = f"http://127.0.0.1:{PORT}"
OUTPUT = ROOT / "build/site-lighthouse"


def chrome_path() -> str:
    candidates = [
        os.environ.get("CHROME_PATH"),
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        shutil.which("google-chrome"),
        shutil.which("chromium"),
        shutil.which("chromium-browser"),
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return candidate
    result = subprocess.run(
        [
            "node",
            "-e",
            "process.stdout.write(require('playwright').chromium.executablePath())",
        ],
        cwd=SITE,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode == 0 and Path(result.stdout).is_file():
        return result.stdout
    raise ValueError("no Chrome/Chromium executable is available for Lighthouse")


def wait_for_server(process: subprocess.Popen[bytes]) -> None:
    for _ in range(120):
        if process.poll() is not None:
            raise ValueError("Docusaurus server exited before Lighthouse started")
        try:
            with urllib.request.urlopen(BASE_URL, timeout=1):
                return
        except OSError:
            time.sleep(0.25)
    raise ValueError("Docusaurus server did not become ready")


def run_lighthouse(
    route: str, name: str, *, desktop: bool, attempt: int = 1
) -> dict[str, float]:
    output = OUTPUT / f"{name}-attempt-{attempt}.json"
    command = [
        "pnpm",
        "--dir",
        "docs/site",
        "exec",
        "lighthouse",
        f"{BASE_URL}{route}",
        "--quiet",
        "--output=json",
        f"--output-path={output}",
        f"--chrome-path={chrome_path()}",
        "--chrome-flags=--headless --no-sandbox --disable-gpu",
        "--only-categories=performance,accessibility,best-practices,seo",
    ]
    if desktop:
        command.append("--preset=desktop")
    subprocess.run(command, cwd=ROOT, check=True)
    report = json.loads(output.read_text(encoding="utf-8"))
    scores = {
        name: report["categories"][name]["score"] * 100
        for name in ("performance", "accessibility", "best-practices", "seo")
    }
    scores["cls"] = report["audits"]["cumulative-layout-shift"]["numericValue"]
    return scores


def enforce(label: str, scores: dict[str, float], *, mobile: bool = False) -> None:
    thresholds = {
        "performance": 80 if mobile else 90,
        "accessibility": 95,
        "best-practices": 95,
        "seo": 95,
    }
    failures = [
        f"{name} {scores[name]:.0f} < {threshold}"
        for name, threshold in thresholds.items()
        if scores[name] < threshold
    ]
    if scores["cls"] > 0.1:
        failures.append(f"CLS {scores['cls']:.3f} > 0.1")
    if failures:
        raise ValueError(f"{label} Lighthouse budget failed: {', '.join(failures)}")
    print(
        f"{label} Lighthouse passed: "
        + ", ".join(
            f"{name}={value:.3f}" if name == "cls" else f"{name}={value:.0f}"
            for name, value in scores.items()
        )
    )


def check_route(
    label: str,
    route: str,
    name: str,
    *,
    desktop: bool,
    mobile: bool = False,
    runner=run_lighthouse,
) -> dict[str, float]:
    """Retry only a noisy budget failure and enforce the three-sample median."""

    samples = [runner(route, name, desktop=desktop, attempt=1)]
    try:
        enforce(label, samples[0], mobile=mobile)
        return samples[0]
    except ValueError as first_failure:
        print(f"{first_failure}; collecting two bounded retry samples")
    samples.extend(
        runner(route, name, desktop=desktop, attempt=attempt)
        for attempt in (2, 3)
    )
    median = {
        metric: float(statistics.median(sample[metric] for sample in samples))
        for metric in samples[0]
    }
    enforce(f"{label} three-sample median", median, mobile=mobile)
    return median


def largest_unit_route() -> str:
    manifest = json.loads(
        (SITE / "build/pto-unit-routes.json").read_text(encoding="utf-8")
    )
    candidates = []
    for entry in manifest["entries"]:
        route = entry["route"]
        page = SITE / "build" / route.lstrip("/") / "index.html"
        candidates.append((page.stat().st_size, route))
    if not candidates:
        raise ValueError("unit route ledger is empty")
    return max(candidates)[1]


def main() -> int:
    OUTPUT.mkdir(parents=True, exist_ok=True)
    server = subprocess.Popen(
        ["python3", "scripts/serve-site-gzip", "--port", str(PORT)],
        cwd=ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        wait_for_server(server)
        check_route("home desktop", "/", "home-desktop", desktop=True)
        check_route("Architecture desktop", "/architecture/", "architecture-desktop", desktop=True)
        check_route("Instruction index desktop", "/instructions/", "instruction-index-desktop", desktop=True)
        check_route("NDF index desktop", "/ndf/", "ndf-index-desktop", desktop=True)
        check_route(
            "TLOAD desktop",
            "/instructions/tile/memory-and-data-movement/regular/TLOAD/",
            "tload-desktop",
            desktop=True,
        )
        check_route("NDF desktop", "/explore/ndf/", "ndf-desktop", desktop=True)
        check_route(
            "largest unit desktop",
            largest_unit_route(),
            "largest-unit-desktop",
            desktop=True,
        )
        check_route("home mobile", "/", "home-mobile", desktop=False, mobile=True)
        return 0
    except (KeyError, OSError, subprocess.CalledProcessError, ValueError) as error:
        print(f"site Lighthouse failed: {error}", file=sys.stderr)
        return 1
    finally:
        if server.poll() is None:
            server.terminate()
            try:
                server.wait(timeout=5)
            except subprocess.TimeoutExpired:
                server.kill()


if __name__ == "__main__":
    raise SystemExit(main())
