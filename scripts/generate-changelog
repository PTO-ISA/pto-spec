#!/usr/bin/env python3
"""Generate the navigational changelog from accepted ADR metadata."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import sys


ROOT = Path(__file__).resolve().parent.parent
ADR_INDEX = ROOT / "spec/evidence/adr-index.json"
DEFAULT_OUTPUT = ROOT / "CHANGELOG.md"


def _release_key(release: str) -> tuple[int, tuple[int, ...]]:
    if release == "unassigned":
        return (1, ())
    return (0, tuple(-int(part) for part in release.split(".")))


def _category(record: dict[str, object]) -> str:
    units = record.get("affected_units", [])
    surfaces: set[str] = set()
    if isinstance(units, list):
        for unit in units:
            if not isinstance(unit, str):
                continue
            match = re.match(r"PTO-(ARCH|BLOCK|SCALAR|TILE)(?:-|$)", unit)
            if match:
                surfaces.add(match.group(1).lower())
    if len(surfaces) > 1:
        return "Cross-cutting"
    if surfaces == {"arch"}:
        return "Architecture"
    if surfaces:
        return next(iter(surfaces)).capitalize()
    return "Governance"


def render() -> str:
    index = json.loads(ADR_INDEX.read_text(encoding="utf-8"))
    groups: dict[str, dict[str, list[dict[str, object]]]] = {}
    for record in index["records"]:
        if record["status"] != "accepted":
            continue
        for release in record["target_releases"]:
            groups.setdefault(release, {}).setdefault(_category(record), []).append(record)

    lines = [
        "# Changelog",
        "",
        "This file is generated from accepted ADR metadata. It is a navigation aid,",
        "not architecture authority; current meaning remains in the owning ASL/NDF.",
    ]
    for release in sorted(groups, key=_release_key):
        lines.extend(
            ["", "## Unassigned" if release == "unassigned" else f"## Release {release}"]
        )
        for category in sorted(groups[release]):
            lines.extend(["", f"### {category}"])
            for record in sorted(groups[release][category], key=lambda row: row["id"]):
                lines.append(
                    f"- [{record['id']}]({record['path']}): {record['title']}"
                )
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--stdout", action="store_true")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    arguments = parser.parse_args()
    if arguments.check and arguments.stdout:
        parser.error("--check and --stdout are mutually exclusive")
    try:
        rendered = render()
        if arguments.stdout:
            sys.stdout.write(rendered)
            return 0
        if arguments.check:
            if not arguments.output.is_file() or arguments.output.read_text(encoding="utf-8") != rendered:
                print(f"error: {arguments.output} is out of date", file=sys.stderr)
                return 1
            print(f"changelog is current: {arguments.output}")
            return 0
        arguments.output.write_text(rendered, encoding="utf-8")
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    print(f"wrote {arguments.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
