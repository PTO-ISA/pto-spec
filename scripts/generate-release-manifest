# Each line is selector:name. Keeping the reviewed map here makes regenerating
# the manifest a verification action, not a way to bless arbitrary ABI drift.
EXPECTED_TEPL_MAP_TEXT = """
000:TADD 001:TSUB 002:TMUL 003:TDIV 004:TREM 006:TAND 007:TOR 008:TXOR
009:TSHL 00A:TSHR 00B:TMAX 00C:TMIN 00D:TCMP 00F:TABS 010:TNOT 011:TNEG
012:TEXP 013:TLOG 014:TRECIP 015:TSQRT 016:TRSQRT 017:TRELU 01A:TSEL 01B:TCVT
01C:TFMA 020:TADDS 021:TSUBS 022:TMULS 023:TDIVS 024:TREMS 026:TANDS 027:TORS
028:TXORS 029:TSHLS 02A:TSHRS 02B:TMAXS 02C:TMINS 02D:TCMPS 03A:TSELS 03B:TEXPANDS
040:TROWSUM 041:TROWMAX 042:TROWMIN 043:TROWPROD 044:TROWEXPAND 045:TROWEXPANDADD 046:TROWEXPANDSUB 047:TROWEXPANDMUL
048:TROWEXPANDDIV 049:TROWEXPANDMAX 04A:TROWEXPANDMIN 04B:TROWEXPANDEXPDIF 04C:TROWARGMAX 04D:TROWARGMIN 050:TCOLSUM 051:TCOLMAX
052:TCOLMIN 053:TCOLPROD 054:TCOLEXPAND 055:TCOLEXPANDADD 056:TCOLEXPANDSUB 057:TCOLEXPANDMUL 058:TCOLEXPANDDIV 059:TCOLEXPANDMAX
05A:TCOLEXPANDMIN 05B:TCOLEXPANDEXPDIF 05C:TCOLARGMAX 05D:TCOLARGMIN 060:TCONCAT 062:TEXTRACT 063:TINSERT 064:TIMG2COL
066:TCI 067:TTRI 068:THISTOGRAM 06A:TQUANT 06B:TDEQUANT 06C:TSORT 06D:TMRGSORT
06F:TGATHER 070:TSCATTER 075:TPERMUTE 076:TSHUF 077:TPACK 078:TUNPACK
"""
EXPECTED_TEPL_MAP = {
    int(token.split(":", 1)[0], 16): token.split(":", 1)[1]
    for token in EXPECTED_TEPL_MAP_TEXT.split()
}
