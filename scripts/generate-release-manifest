FORM_PROJECTION_KEYS = (
    "form_id",
    "mnemonic",
    "asm",
    "length_bits",
    "encoding_kind",
    "encoding",
    "fields",
    "constraints",
)


def normalized_json_bytes(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")


def pretty_json_bytes(value: object) -> bytes:
    return (json.dumps(value, indent=2, sort_keys=True) + "\n").encode("utf-8")


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def load_json(relative: str) -> dict:
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def parse_int(value: object, label: str) -> int:
    if isinstance(value, int):
        return value
    if isinstance(value, str):
        return int(value, 0)
    raise SystemExit(f"{label} must be an integer or an integer string")


def operation_function(row: dict) -> int:
    if "function" not in row:
        raise SystemExit(f"operation {row.get('name', '<unnamed>')} has no function")
    return parse_int(row["function"], f"{row.get('name', '<unnamed>')}.function")


def operation_selector(row: dict) -> int:
    function = operation_function(row)
    if row.get("family") != "TEPL":
        return function
    if "mode" not in row or "selector" not in row:
        raise SystemExit(
            f"TEPL operation {row.get('name', '<unnamed>')} must carry mode, function, and selector"
        )
    mode = parse_int(row["mode"], f"{row.get('name', '<unnamed>')}.mode")
    if not 0 <= mode <= 3 or not 0 <= function <= 31:
        raise SystemExit(f"{row['name']} mode/function is outside the 2-bit/5-bit encoding")
    selector = (mode << 5) | function
    if parse_int(row["selector"], f"{row['name']}.selector") != selector:
        raise SystemExit(f"{row['name']} selector does not equal (mode << 5) | function")
    return selector


def validate_release_metadata() -> dict:
    metadata = tomllib.loads((ROOT / "specification.toml").read_text(encoding="utf-8"))
    release = metadata.get("release", {})
    expected = {
        "architecture_version": RELEASE,
        "publication_version": PUBLICATION_VERSION,
        "encoding_abi": ENCODING_ABI,
        "manifest": str(MANIFEST_PATH),
    }
    for key, value in expected.items():
        if release.get(key) != value:
            raise SystemExit(f"release.{key} must be {value!r}")
    return metadata


def validate_tile_catalog() -> tuple[dict, dict[str, list[dict]]]:
    catalog = load_json("spec/catalog/tile-operations.json")
    operations = catalog.get("operations")
    if not isinstance(operations, list):
        raise SystemExit("tile catalog operations must be an array")
    by_family = {
        family: [row for row in operations if row.get("family") == family]
        for family in FAMILY_COUNTS
    }
    actual_counts = {family: len(rows) for family, rows in by_family.items()}
    if actual_counts != FAMILY_COUNTS or len(operations) != sum(FAMILY_COUNTS.values()):
        raise SystemExit(
            f"tile operation closure must be exactly {FAMILY_COUNTS}, got {actual_counts}"
        )
    if catalog.get("operation_count") != sum(FAMILY_COUNTS.values()):
        raise SystemExit("tile operation_count must be exactly 107")
    names = [row.get("name") for row in operations]
    if None in names or len(names) != len(set(names)):
        raise SystemExit("tile operation names must be present and globally unique")

    tepl_map = {operation_selector(row): row["name"] for row in by_family["TEPL"]}
    if len(tepl_map) != FAMILY_COUNTS["TEPL"]:
        raise SystemExit("TEPL selectors must be unique")
    if tepl_map != EXPECTED_TEPL_MAP:
        missing = sorted(set(EXPECTED_TEPL_MAP.items()) - set(tepl_map.items()))
        extra = sorted(set(tepl_map.items()) - set(EXPECTED_TEPL_MAP.items()))
        raise SystemExit(f"TEPL 0.58.5 map mismatch; missing={missing}, unexpected={extra}")

    for family, expected in (
        ("TLSU", EXPECTED_TLSU_MAP),
        ("CUBE", EXPECTED_CUBE_MAP),
    ):
        actual = {operation_function(row): row["name"] for row in by_family[family]}
        if actual != expected:
            raise SystemExit(f"{family} 0.58.5 function map must be {expected}, got {actual}")

    for row in operations:
        expected_command = (
            "BSTART.TEPL"
            if row["family"] == "TEPL"
            else EXPECTED_NON_TEPL_COMMANDS[row["name"]]
        )
        if row.get("command_mnemonic") != expected_command:
            raise SystemExit(
                f"{row['name']} must map to command mnemonic {expected_command}, "
                f"got {row.get('command_mnemonic')}"
            )

    forbidden = sorted(set(names).intersection(DELETED_TEPL_NAMES))
    if forbidden:
        raise SystemExit(f"deleted D-class operations remain in the base ISA: {forbidden}")
    non_accepted = {
        row["name"]: row.get("disposition")
        for row in operations
        if row.get("disposition") != "accepted-direct-operation"
    }
    if non_accepted:
        raise SystemExit(
            "all base ISA operations must have disposition "
            f"'accepted-direct-operation'; got {non_accepted}"
        )
    contract_status_counts = dict(Counter(row.get("contract_status") for row in operations))
    if contract_status_counts != {"reviewed-complete": sum(FAMILY_COUNTS.values())}:
        raise SystemExit(
            "all 107 base ISA operations must have contract_status 'reviewed-complete'; "
            f"got {contract_status_counts}"
        )
    return catalog, by_family


def encoding_projection(tile_catalog: dict) -> dict:
    forms: list[dict] = []
    for label, relative in (
        ("scalar_forms", "spec/catalog/scalar-forms.json"),
        ("command_forms", "spec/catalog/command-forms.json"),
    ):
        catalog = load_json(relative)
        if catalog.get("form_count") != FORM_COUNTS[label] or len(catalog.get("forms", [])) != FORM_COUNTS[label]:
            raise SystemExit(f"{label} closure must remain exactly {FORM_COUNTS[label]}")
        if label == "command_forms":
            families = dict(Counter(row.get("semantic_family") for row in catalog["forms"]))
            if families != COMMAND_FAMILY_COUNTS:
                raise SystemExit(
                    f"command form families must remain exactly {COMMAND_FAMILY_COUNTS}, got {families}"
                )
        forms.extend(catalog["forms"])
    form_projection = [
        {key: row[key] for key in FORM_PROJECTION_KEYS}
        for row in sorted(forms, key=lambda row: row["form_id"])
    ]
    tile_projection = [
        {
            "family": row["family"],
            "name": row["name"],
            "command_mnemonic": row["command_mnemonic"],
            "mode": (
                parse_int(row["mode"], f"{row['name']}.mode")
                if row["family"] == "TEPL"
                else None
            ),
            "function": operation_function(row),
            "selector": operation_selector(row) if row["family"] == "TEPL" else None,
        }
        for row in sorted(
            tile_catalog["operations"],
            key=lambda row: (row["family"], operation_selector(row), row["name"]),
        )
    ]
    register_projection = [
        {
            key: row[key]
            for key in ("name", "address", "low_index", "fixed_context", "access", "scope")
            if key in row
        }
        for row in sorted(
            load_json("spec/catalog/system-registers.json")["registers"],
            key=lambda row: (
                parse_int(row.get("address", row.get("low_index")), "register location"),
                row["name"],
            ),
        )
    ]
    extension_reservation_projection = load_json(
        "spec/catalog/extension-encoding-reservations.json"
    )["reservations"]
    return {
        "encoding_abi": ENCODING_ABI,
        "extension_encoding_reservations": extension_reservation_projection,
        "scalar_and_command_forms": form_projection,
        "system_registers": register_projection,
        "tile_operations": tile_projection,
    }


def raw_tepl_word(datatype: int, mode: int, function: int) -> str:
    return f"0x{((datatype << 27) | (mode << 25) | (function << 20) | 0x19181):08X}"


def build_totality_evidence(encoding_hash: str) -> dict:
    accepted_functions = {
        str(mode): sorted(selector & 0x1F for selector in EXPECTED_TEPL_MAP if selector >> 5 == mode)
        for mode in range(4)
    }
    classifications = []
    accepted_count = reserved_count = illegal_count = 0
    for datatype in range(32):
        for mode in range(4):
            for function in range(32):
                if datatype in ILLEGAL_DATATYPES:
                    label = "illegal-datatype"
                    illegal_count += 1
                elif datatype in RESERVED_DATATYPES or function not in accepted_functions[str(mode)]:
                    label = "reserved"
                    reserved_count += 1
                else:
                    label = "accepted"
                    accepted_count += 1
                classifications.append(label)

    positive_names = (
        'TADD',
        'TSEL',
        'TFMA',
        'THISTOGRAM',
        'TSORT',
    )
    positive_vectors = []
    inverse = {name: selector for selector, name in EXPECTED_TEPL_MAP.items()}
    for name in positive_names:
        selector = inverse[name]
        positive_vectors.append(
            {
                "name": name,
                "datatype": "U64",
                "mode": selector >> 5,
                "function": selector & 0x1F,
                "raw": raw_tepl_word(24, selector >> 5, selector & 0x1F),
                "expected": "accepted",
            }
        )

    deleted_selectors = {
        'TPRELU': (0, 14),
        'TAXPY': (1, 15),
        'TGATHERB': (3, 1),
        'TRANDOM': (3, 9),
        'TPARTARGMAX': (3, 21),
        'TPARTARGMIN': (3, 22),
        'TRESHAPE': (3, 23),
        'TDEINTERLEAVE': (3, 24),
        'TINTERLEAVE': (3, 25),
        'TPUSH': (3, 26),
        'TPOP': (3, 27),
        'TALLOC': (3, 28),
        'TFREE': (3, 29),
        'TFMOD': (0, 24),
        'TFMODS': (0, 25),
        'TADDC': (0, 24),
        'TSUBC': (1, 5),
        'TADDSC': (1, 14),
        'TSUBSC': (1, 24),
        'TLRELU': (1, 25),
    }
    negative_vectors = [
        {
            "former_name": name,
            "datatype": "U64",
            "mode": mode,
            "function": function,
            "raw": raw_tepl_word(24, mode, function),
            "expected": "reserved-reject",
        }
        for name, (mode, function) in deleted_selectors.items()
    ]
    negative_vectors.append(
        {
            "former_encoding": "pre-0.58.0-TADD",
            "raw": "0xC2001181",
            "expected": "encoding-abi-reject",
        }
    )
    return {
        "schema_version": 2,
        "release": RELEASE,
        "encoding_abi": ENCODING_ABI,
        "encoding_projection_sha256": encoding_hash,
        "family_counts": {**FAMILY_COUNTS, "total": sum(FAMILY_COUNTS.values())},
        "optional_base_operations": 0,
        "pending_base_operations": [],
        "contract_status_counts": {"reviewed-complete": sum(FAMILY_COUNTS.values())},
        "dispatch_outcome_contract": {
            "recognized_operation_legality_or_handler_failure": "TileExecution_Rejected",
            "unknown_or_reserved_selector": "TileExecution_Rejected",
        },
        "tepl": {
            "selector_count": len(EXPECTED_TEPL_MAP),
            "mode_counts": {
                str(mode): sum(selector >> 5 == mode for selector in EXPECTED_TEPL_MAP)
                for mode in range(4)
            },
            "accepted_functions": accepted_functions,
            "datatype_codes": {
                "accepted": list(VALID_DATATYPES),
                "reserved": list(RESERVED_DATATYPES),
                "illegal": list(ILLEGAL_DATATYPES),
            },
            "raw_space": {
                "total": len(classifications),
                "accepted": accepted_count,
                "reserved": reserved_count,
                "illegal": illegal_count,
                "classification_sha256": sha256_bytes(normalized_json_bytes(classifications)),
            },
        },
        "tlsu": {"function_map": {str(key): value for key, value in EXPECTED_TLSU_MAP.items()}},
        "cube": {"function_map": {str(key): value for key, value in EXPECTED_CUBE_MAP.items()}},
        "deleted_tepl_operations": list(DELETED_TEPL_NAMES),
        "positive_raw_vectors": positive_vectors,
        "negative_raw_vectors": negative_vectors,
    }


def build_abi_vectors(encoding_hash: str) -> dict:
    identity = {
        "release": RELEASE,
        "encoding_abi": ENCODING_ABI,
        "encoding_projection_sha256": encoding_hash,
    }
    return {
        "schema_version": 1,
        "release": RELEASE,
        "encoding_abi": ENCODING_ABI,
        "encoding_projection_sha256": encoding_hash,
        "elf_identity": {
            "section": ".note.pto.isa",
            "note_name": "PTO",
            "note_type": "PTO_NT_ISA_IDENTITY",
            "note_type_value": 1,
            "alignment_bytes": 4,
            "name_size_bytes": 4,
            "descriptor_encoding": "UTF-8 JSON with lexicographically sorted keys and no insignificant whitespace",
            "descriptor_nul_terminated": False,
            "descriptor_fields": [
                "release",
                "encoding_abi",
                "encoding_projection_sha256",
            ],
            "link_policy": "all input identities must be present and exactly equal",
            "load_policy": "the image identity must exactly match the implementation identity",
        },
        "bare_metal_identity": {
            "format": "PTO release manifest identity object",
            "required_fields": [
                "release",
                "encoding_abi",
                "encoding_projection_sha256",
            ],
            "policy": "the supplied identity must exactly match the implementation identity",
        },
        "cases": [
            {"id": "elf-link-match", "stage": "link", "inputs": [identity, identity], "expected": "accept"},
            {"id": "elf-link-missing-identity", "stage": "link", "inputs": [identity, None], "expected": "reject", "reason": "missing-identity"},
            {"id": "elf-link-release-mismatch", "stage": "link", "inputs": [identity, {**identity, "release": "0.58.0"}], "expected": "reject", "reason": "release-mismatch"},
            {"id": "elf-link-abi-mismatch", "stage": "link", "inputs": [identity, {**identity, "encoding_abi": "pto-isa-0.58.0-legacy-selector-v0"}], "expected": "reject", "reason": "encoding-abi-mismatch"},
            {"id": "elf-link-hash-mismatch", "stage": "link", "inputs": [identity, {**identity, "encoding_projection_sha256": "0" * 64}], "expected": "reject", "reason": "encoding-hash-mismatch"},
            {"id": "elf-load-match", "stage": "load", "image": identity, "implementation": identity, "expected": "accept"},
            {"id": "elf-load-missing-identity", "stage": "load", "image": None, "implementation": identity, "expected": "reject", "reason": "missing-identity"},
            {"id": "elf-load-hash-mismatch", "stage": "load", "image": {**identity, "encoding_projection_sha256": "f" * 64}, "implementation": identity, "expected": "reject", "reason": "encoding-hash-mismatch"},
            {"id": "bare-metal-manifest-match", "stage": "bare-metal-load", "image": identity, "implementation": identity, "expected": "accept"},
            {"id": "bare-metal-manifest-mismatch", "stage": "bare-metal-load", "image": {**identity, "release": "0.58.0"}, "implementation": identity, "expected": "reject", "reason": "release-mismatch"},
        ],
    }


def validate_numeric_profile() -> dict:
    profile = load_json(str(NUMERIC_PROFILE_PATH))
    expected_keys = {
        "arithmetic",
        "b_datr",
        "claim_scope",
        "comparisons",
        "conversion",
        "data_types",
        "implementation_conformance",
        "isa_release",
        "mixed_expdif",
        "tcvt_e8m0",
        "matrix",
        "min_max",
        "packed_storage",
        "profile_id",
        "reductions",
        "reference_model_relation",
        "reserved_data_type_codes",
        "schema_version",
        "sort",
        "subnormal_policy",
    }
    if set(profile) != expected_keys:
        raise SystemExit("hardware numeric profile top-level schema drift")
    if (
        profile["schema_version"] != 2
        or profile["isa_release"] != NUMERIC_PROFILE_RELEASE
    ):
        raise SystemExit(
            "hardware numeric profile must identify schema 2 and retained "
            f"release {NUMERIC_PROFILE_RELEASE}"
        )
    if profile["profile_id"] != NUMERIC_PROFILE_ID:
        raise SystemExit(f"hardware numeric profile ID must be {NUMERIC_PROFILE_ID}")
    reference = profile["reference_model_relation"]
    if reference != {
        "hardware_conformance_claim": False,
        "profile_id": "pto-v0",
        "role": "deterministic raw-carrier ASL reference-test profile",
        "rule": "General pto-v0 output values are not hardware numeric conformance evidence; the B.FPATR postprocess and TCVT-to-E8M0 hooks implement their bit-exact sections of this profile.",
    }:
        raise SystemExit("pto-v0 must remain a non-hardware reference-test profile")
    if profile["implementation_conformance"].get("repository_claim") != "contract-and-vector-definition-only":
        raise SystemExit("repository must not claim hardware numeric implementation conformance")
    if profile["subnormal_policy"] != {
        "architectural_mode_state": "none",
        "configuration_validation": "Any request for FTZ, DAZ, or an operation-local subnormal override is non-conforming and must reject before effects.",
        "denormals_are_zero": False,
        "flush_to_zero": False,
        "input_subnormals": "preserve exact source value",
        "operation_override": False,
        "profile_selection": "fixed by pto-hardware-numeric-0.58.5-ieee-v1",
        "result_subnormals": "gradual underflow to the destination format",
        "scope": "Every otherwise-supported operation/type tuple whose source or destination format defines subnormal encodings.",
        "tininess_detection": "after-rounding",
    }:
        raise SystemExit("hardware numeric subnormal policy drift")

    data_types = profile["data_types"]
    actual_names = {row.get("code"): row.get("name") for row in data_types}
    if actual_names != EXPECTED_DATA_TYPE_NAMES or len(data_types) != len(EXPECTED_DATA_TYPE_NAMES):
        raise SystemExit(
            f"hardware numeric DataType map must be exactly {EXPECTED_DATA_TYPE_NAMES}, got {actual_names}"
        )
    if profile["reserved_data_type_codes"] != list(RESERVED_DATATYPES):
        raise SystemExit("hardware numeric profile reserved DataType codes drift")
    nan_capable_names = {
        "FP64", "FP32", "TF32", "HF32", "FP16", "BF16",
        "HiF8", "E4M3", "E5M2", "E8M0",
    }
    actual_nan_names = {
        row["name"] for row in data_types if "canonical_qnan" in row
    }
    if actual_nan_names != nan_capable_names:
        raise SystemExit(
            "canonical NaN registry must match the exact NaN-capable format set"
        )

    low_format_names = {
        "HiF8", "E4M3", "E5M2", "E3M2", "E2M3",
        "E2M1X2", "E1M2X2", "E8M0", "HiF4X2",
    }
    low_rows = {row["name"]: row for row in data_types if row["name"] in low_format_names}
    if set(low_rows) != low_format_names or any("encoding" not in row for row in low_rows.values()):
        raise SystemExit("every low-precision DataType must define an exact encoding")
    if low_rows["E3M2"].get("payload_bits") != 6 or low_rows["E2M3"].get("payload_bits") != 6:
        raise SystemExit("FP6 formats must use a six-bit payload in the eight-bit carrier")
    expected_e1m2_values = {
        "0x0": "+0", "0x1": "+0.25", "0x2": "+0.5", "0x3": "+0.75",
        "0x4": "+1", "0x5": "+1.25", "0x6": "+1.5", "0x7": "+1.75",
        "0x8": "-0", "0x9": "-0.25", "0xA": "-0.5", "0xB": "-0.75",
        "0xC": "-1", "0xD": "-1.25", "0xE": "-1.5", "0xF": "-1.75",
    }
    for name in ("E1M2X2", "HiF4X2"):
        if low_rows[name]["encoding"].get("lane_raw_values") != expected_e1m2_values:
            raise SystemExit(f"{name} must define the exact public E1M2 value table")
    if low_rows["HiF4X2"]["encoding"].get("distinct_identity_from") != "E1M2X2":
        raise SystemExit("HiF4X2 and E1M2X2 must remain distinct DataType identities")

    packed = profile["packed_storage"]
    if packed.get("applies_to") != ["E2M1X2", "E1M2X2", "HiF4X2", "S4X2", "U4X2"]:
        raise SystemExit("packed logical-lane type registry drift")
    if "Logical lane 2*i is bits 3:0" not in packed.get("lane_order", ""):
        raise SystemExit("packed lane order must keep even lanes in the low nibble")

    ordinary = profile["matrix"].get("ordinary", {})
    expected_ordinary = {
        "floating_input_types": [
            "FP32", "TF32", "HF32", "FP16", "BF16", "HiF8", "E4M3",
            "E5M2", "E3M2", "E2M3", "E2M1X2", "E1M2X2",
        ],
        "signed_input_types": ["S16", "S8", "S4X2"],
        "unsigned_input_types": ["U16", "U8", "U4X2"],
        "pair_rule": "The two inputs may differ only within one listed class.",
        "accumulator_by_class": {
            "floating": "FP32", "signed": "S32", "unsigned": "U32",
        },
        "bias_by_class": {
            "floating": "FP32", "signed": "S32", "unsigned": "U32",
        },
        "header_data_type": "left input type",
        "b_datr_data_type": "right input type; omission inherits the left input type",
    }
    if ordinary != expected_ordinary:
        raise SystemExit("ordinary matrix mixed-type and accumulator contract drift")

    mx = profile["matrix"].get("mx", {})
    if (
        mx.get("allowed_operand_types") !=
            ["FP16", "BF16", "E4M3", "E5M2", "E2M1X2", "E1M2X2"] or
        mx.get("pair_rule") !=
            "Every ordered pair of allowed operand types is assigned." or
        mx.get("unscaled_operand_types") != ["FP16", "BF16"] or
        mx.get("scaled_operand_types") !=
            ["E4M3", "E5M2", "E2M1X2", "E1M2X2"]
    ):
        raise SystemExit("MX matrix operand-type and scale-presence contract drift")
    if (
        mx.get("header_data_type") != "left input type" or
        mx.get("acc_type") != "FP32" or mx.get("bias_type") != "FP32" or
        mx.get("scale_type") != "E8M0" or
        mx.get("scale_block_logical_k_elements") != 32 or
        mx.get("scale_a_shape") != "M x ceil(K/32)" or
        mx.get("scale_b_shape") != "ceil(K/32) x N"
    ):
        raise SystemExit("MX header/ACC/bias/scale contract drift")

    postprocess = profile["matrix"].get("postprocess", {})
    modes = postprocess.get("modes", [])
    expected_mode_codes = [
        0, 1, 2, 3, 4, 5, 12, 13, 16, 17, 18, 19, 20,
        23, 24, 25, 26, 27, 28, 32, 33, 34, 35, 36, 37, 38, 39,
    ]
    if [row.get("code") for row in modes] != expected_mode_codes:
        raise SystemExit("B.FPATR postprocess mode table drift")
    if postprocess.get("order") != [
        "raw-accumulator-row-and-group-reductions",
        "prequant-destination-conversion",
        "destination-domain-activation",
        "atomic-output-and-status-publication",
    ]:
        raise SystemExit("B.FPATR postprocess ordering drift")

    invalid = profile["conversion"].get("float_to_integer_invalid", {}).get("sat_disabled", {})
    if invalid != {
        "S4X2": {"lane_raw": "0x8", "packed_all_lanes_raw": "0x88"},
        "S8": "0x80", "S16": "0x8000", "S32": "0x80000000",
        "S64": "0x8000000000000000",
        "U4X2": {"lane_raw": "0xF", "packed_all_lanes_raw": "0xFF"},
        "U8": "0xFF", "U16": "0xFFFF", "U32": "0xFFFFFFFF",
        "U64": "0xFFFFFFFFFFFFFFFF",
    }:
        raise SystemExit("float-to-integer invalid-result table drift")

    expected_comparisons = {
        "0": "EQ",
        "1": "NE",
        "2": "LT",
        "3": "GT",
        "4": "LE",
        "5": "GE",
    }
    if profile["b_datr"].get("comparison_modes") != expected_comparisons:
        raise SystemExit("B.DATR comparison-mode map drift")
    if profile["b_datr"].get("comparison_reserved") != [6, 7]:
        raise SystemExit("B.DATR comparison modes 6 and 7 must remain reserved")
    rounding = profile["b_datr"].get("rounding_modes", {})
    expected_round_names = {
        "0": "NONE",
        "1": "RNE",
        "2": "RTZ",
        "3": "RDN",
        "4": "RUP",
        "5": "RNA",
        "6": "RTO",
        "7": "RHB",
    }
    if set(rounding) != set(expected_round_names) or any(
        not rounding[code].startswith(name + ":")
        for code, name in expected_round_names.items()
    ):
        raise SystemExit("B.DATR rounding-mode map drift")
    if profile["sort"].get("group_size") != 32:
        raise SystemExit("hardware TSORT group size must remain exactly 32")
    if profile["sort"].get("output") != "value paired with U32 original index":
        raise SystemExit("hardware TSORT output must retain U32 original indices")
    if not profile["arithmetic"].get("standard", "").startswith("IEEE 754-2019"):
        raise SystemExit("hardware numeric profile must use IEEE 754-2019 semantics")
    expected_mixed_expdif = {
        "accepted_operations": ["TROWEXPANDEXPDIF", "TCOLEXPANDEXPDIF"],
        "accepted_source_destination_pairs": [
            ["FP16", "FP16"],
            ["BF16", "BF16"],
            ["FP32", "FP32"],
            ["FP16", "FP32"],
            ["BF16", "FP32"],
        ],
        "pipeline": "ExactWidenFP16ToFP32 or ExactWidenBF16ToFP32 for both sources, then FP32 SUB, then FP32 EXP",
        "exact_widening": {
            "BF16": {
                "finite_zero_infinity": "ZeroExtend32(source_bits) << 16",
                "inexact_flag": False,
                "rounding": "none",
            },
            "FP16": {
                "finite_zero_infinity": "IEEE binary16 value-preserving widening to the unique FP32 encoding",
                "inexact_flag": False,
                "rounding": "none",
                "subnormals": "normalize to the unique equal-valued FP32 encoding",
            },
            "nan": "Use the selected profile FP32 canonical-NaN and signaling-input rule",
        },
        "fp32_sub_exp": {
            "numeric_status": "Use the selected profile FP32 NV/DZ/OF/UF/NX rules",
            "rounding": "Use the selected profile FP32 rounding rule",
            "special_values": "Use the selected profile FP32 IEEE special-value rule",
        },
        "discriminator_vectors": [
            {
                "source_type": "FP16",
                "a": "0x2000",
                "b": "0x0001",
                "widen_first_sub": "0x3BFFFF80",
                "source_precision_sub_then_widen": "0x3C000000",
                "widen_first_exp": "0x3F810100",
                "source_precision_exp": "0x3F810101",
            },
            {
                "source_type": "BF16",
                "a": "0x3F80",
                "b": "0x3B00",
                "widen_first_sub": "0x3F7F8000",
                "source_precision_sub_then_widen": "0x3F800000",
                "widen_first_exp": "0x402DA16E",
                "source_precision_exp": "0x402DF854",
            },
        ],
    }
    if profile["mixed_expdif"] != expected_mixed_expdif:
        raise SystemExit("mixed EXPDIF hardware-profile clause drift")
    expected_tcvt_e8m0 = {
        "accepted_source_types": ["FP16", "BF16", "FP32"],
        "destination_type": "E8M0",
        "finite_domain": "positive finite values",
        "encoding": "rounded_base2_exponent_plus_127",
        "exact_range": {"minimum": "2^-127", "maximum": "2^127"},
        "rounding": "resolved B.DATR RMode in the base-two exponent domain",
        "inexact": "Every non-power-of-two in-range source records NX.",
        "invalid": {
            "inputs": [
                "positive_zero", "negative_zero", "negative_finite",
                "negative_infinity", "quiet_nan", "signaling_nan",
            ],
            "result": "0xFF",
            "flags": ["NV"],
        },
        "positive_infinity": {
            "sat0_result": "0xFF",
            "sat1_result": "0xFE",
            "flags": ["OF", "NX"],
        },
        "finite_underflow": {
            "sat0_result": "0xFF",
            "sat1_result": "0x00",
            "flags": ["UF", "NX"],
        },
        "finite_overflow": {
            "sat0_result": "0xFF",
            "sat1_result": "0xFE",
            "flags": ["OF", "NX"],
        },
        "canonicalize": (
            "representation-only; it does not change the E8M0 value map"
        ),
    }
    if profile["tcvt_e8m0"] != expected_tcvt_e8m0:
        raise SystemExit("TCVT-to-E8M0 hardware-profile clause drift")
    return profile


def build_numeric_vectors(profile: dict) -> dict:
    profile_hash = sha256_bytes((ROOT / NUMERIC_PROFILE_PATH).read_bytes())
    canonical_nan = [
        {
            "data_type": row["name"],
            "input_class": "any-NaN",
            "expected": row["canonical_qnan"],
        }
        for row in profile["data_types"]
        if "canonical_qnan" in row
    ]
    sort_input = [
        "3", "+0", "qNaN#0", "-0", "2", "2", "-1", "qNaN#1",
        "4", "-4", "5", "-5", "6", "-6", "7", "-7",
        "8", "-8", "9", "-9", "10", "-10", "11", "-11",
        "12", "-12", "13", "-13", "14", "-14", "15", "-15",
    ]
    return {
        "schema_version": 1,
        "release": RELEASE,
        "hardware_profile_id": NUMERIC_PROFILE_ID,
        "hardware_profile_sha256": profile_hash,
        "implementation_conformance_status": "b-fpatr-and-tcvt-e8m0-asl-proven-other-numeric-domains-unproven",
        "reference_profile": {
            "profile_id": "pto-v0",
            "hardware_conformance_claim": False,
            "bit_exact_surfaces": [
                "B.FPATR matrix postprocess",
                "TCVT FP16/BF16/FP32 to E8M0",
            ],
        },
        "vector_groups": {
            "canonical_nan": canonical_nan,
            "low_precision_encoding": [
                {"data_type": "HiF8", "raw": "0x00", "expected": "+0"},
                {"data_type": "HiF8", "raw": "0x01", "expected": "2^-22"},
                {"data_type": "HiF8", "raw": "0x07", "expected": "2^-16"},
                {"data_type": "HiF8", "raw": "0x08", "expected": "1"},
                {"data_type": "HiF8", "raw": "0x6E", "expected": "32768"},
                {"data_type": "HiF8", "raw": "0x6F", "expected": "+infinity"},
                {"data_type": "HiF8", "raw": "0x80", "expected": "NaN"},
                {"data_type": "HiF8", "raw": "0xEF", "expected": "-infinity"},
                {"data_type": "E4M3", "raw": "0x01", "expected": "2^-9"},
                {"data_type": "E4M3", "raw": "0x7E", "expected": "448"},
                {"data_type": "E4M3", "raw": "0x7F", "expected": "NaN"},
                {"data_type": "E5M2", "raw": "0x01", "expected": "2^-16"},
                {"data_type": "E5M2", "raw": "0x7B", "expected": "57344"},
                {"data_type": "E5M2", "raw": "0x7C", "expected": "+infinity"},
                {"data_type": "E5M2", "raw": "0x7E", "expected": "NaN"},
                {"data_type": "E3M2", "raw": "0x01", "expected": "0.0625"},
                {"data_type": "E3M2", "raw": "0x1F", "expected": "28"},
                {"data_type": "E2M3", "raw": "0x01", "expected": "0.125"},
                {"data_type": "E2M3", "raw": "0x1F", "expected": "7.5"},
                {"data_type": "E8M0", "raw": "0x00", "expected": "2^-127"},
                {"data_type": "E8M0", "raw": "0x7F", "expected": "1"},
                {"data_type": "E8M0", "raw": "0x80", "expected": "2"},
                {"data_type": "E8M0", "raw": "0xFE", "expected": "2^127"},
                {"data_type": "E8M0", "raw": "0xFF", "expected": "NaN"},
            ],
            "mixed_expdif": profile["mixed_expdif"],
            "tcvt_e8m0": {
                "contract": profile["tcvt_e8m0"],
                "vectors": [
                    {"source_type": "BF16", "input": "0x3F80", "rmode": "RNE", "sat": False, "expected": "0x7F", "flags": []},
                    {"source_type": "BF16", "input": "0x3FC0", "rmode": "RNE", "sat": False, "expected": "0x80", "flags": ["NX"]},
                    {"source_type": "BF16", "input": "0x3FC0", "rmode": "RTM", "sat": False, "expected": "0x7F", "flags": ["NX"]},
                    {"source_type": "FP32", "input": "0x00400000", "rmode": "RNE", "sat": False, "expected": "0x00", "flags": []},
                    {"source_type": "FP32", "input": "0x00200000", "rmode": "RNE", "sat": False, "expected": "0xFF", "flags": ["UF", "NX"]},
                    {"source_type": "FP32", "input": "0x00200000", "rmode": "RNE", "sat": True, "expected": "0x00", "flags": ["UF", "NX"]},
                    {"source_type": "FP32", "input": "0x7F000000", "rmode": "RNE", "sat": False, "expected": "0xFE", "flags": []},
                    {"source_type": "FP32", "input": "0x7F7FFFFF", "rmode": "RNE", "sat": False, "expected": "0xFF", "flags": ["OF", "NX"]},
                    {"source_type": "BF16", "input": "0x0000", "rmode": "RNE", "sat": False, "expected": "0xFF", "flags": ["NV"]},
                    {"source_type": "BF16", "input": "0x7F80", "rmode": "RNE", "sat": True, "expected": "0xFE", "flags": ["OF", "NX"]},
                ],
                "unsupported_source_types": [
                    "FP64", "TF32", "HF32", "HiF8", "E4M3", "E5M2",
                    "E3M2", "E2M3", "E2M1X2", "E1M2X2", "E8M0",
                    "HiF4X2", "S64", "S32", "S16", "S8", "S4X2",
                    "U64", "U32", "U16", "U8", "U4X2",
                ],
            },
            "packed_lane_order": [
                {
                    "data_type": "E1M2X2",
                    "raw_byte": "0x91",
                    "expected_logical_lanes": ["+0.25", "-0.25"],
                    "rule": "low-nibble-even-high-nibble-odd",
                },
                {
                    "data_type": "HiF4X2",
                    "raw_byte": "0x91",
                    "expected_logical_lanes": ["+0.25", "-0.25"],
                    "rule": "low-nibble-even-high-nibble-odd",
                },
                {
                    "data_type": "E2M1X2",
                    "raw_byte": "0x91",
                    "expected_logical_lanes": ["+0.5", "-0.5"],
                    "rule": "low-nibble-even-high-nibble-odd",
                },
            ],
            "signed_zero": [
                {"id": "fp32-negative-zero-multiply", "operation": "multiply", "inputs": ["-0", "2"], "expected": "0x80000000"},
                {"id": "fp32-exact-cancellation-rne", "operation": "add", "inputs": ["+1", "-1"], "rounding": "RNE", "expected": "0x00000000"},
                {"id": "fp32-min-zero", "operation": "minimum", "inputs": ["+0", "-0"], "expected": "0x80000000"},
                {"id": "fp32-max-zero", "operation": "maximum", "inputs": ["+0", "-0"], "expected": "0x00000000"},
            ],
            "rounding": [
                {"mode": "RNE", "input": "2.5", "destination": "S32", "expected": "2"},
                {"mode": "RNE", "input": "3.5", "destination": "S32", "expected": "4"},
                {"mode": "RTZ", "input": "-1.9", "destination": "S32", "expected": "-1"},
                {"mode": "RDN", "input": "-1.1", "destination": "S32", "expected": "-2"},
                {"mode": "RUP", "input": "1.1", "destination": "S32", "expected": "2"},
                {"mode": "RNA", "input": "2.1", "destination": "S32", "expected": "2"},
                {"mode": "RNA", "input": "-2.1", "destination": "S32", "expected": "-2"},
                {"mode": "RNA", "input": "2.5", "destination": "S32", "expected": "3"},
                {"mode": "RNA", "input": "-2.5", "destination": "S32", "expected": "-3"},
                {"mode": "RTO", "input": "2.0", "destination": "S32", "expected": "2"},
                {"mode": "RTO", "input": "2.25", "destination": "S32", "expected": "3"},
                {"mode": "RTO", "input": "-2.25", "destination": "S32", "expected": "-3"},
                {"mode": "RHB", "input": "2.5", "destination": "S32", "expected": "3"},
                {"mode": "RHB", "input": "-2.5", "destination": "S32", "expected": "-2"},
            ],
