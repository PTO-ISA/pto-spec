def canonical_input_paths() -> list[str]:
    asl = sorted(str(path.relative_to(ROOT)) for path in (ROOT / "asl").rglob("*.asl"))
    paths = sorted(
        set(CANONICAL_STATIC_INPUTS).union(asl, CANONICAL_EVIDENCE_INPUTS)
    )
    missing = [path for path in paths if not (ROOT / path).is_file()]
    if missing:
        raise SystemExit(f"canonical release inputs are missing: {missing}")
    return paths


def validate_owned_set() -> None:
    actual_docs = tuple(
        sorted(
            str(path.relative_to(ROOT))
            for surface in ("arch", "block", "scalar", "tile")
            for path in (ROOT / "docs" / surface).rglob("*.md")
        )
    )
    if actual_docs != GENERATED_DOCS:
        raise SystemExit(
            f"owned generated documentation set drift: expected {GENERATED_DOCS}, got {actual_docs}"
        )
    actual_evidence = tuple(
        sorted(str(path.relative_to(ROOT)) for path in (ROOT / "spec/evidence").glob("*0585*.json"))
    )
    unexpected_evidence = tuple(sorted(set(actual_evidence) - set(EVIDENCE_FILES)))
    if unexpected_evidence:
        raise SystemExit(
            f"unexpected owned 0.58.5 evidence files: {unexpected_evidence}"
        )


def build_artifacts() -> dict[str, dict]:
    metadata = validate_release_metadata()
    selection = evaluate_release_selection(ROOT)
    tile_catalog, _ = validate_tile_catalog()
    numeric_profile = validate_numeric_profile()
    validate_owned_set()
    projection = encoding_projection(tile_catalog)
    encoding_hash = sha256_bytes(normalized_json_bytes(projection))
    totality = build_totality_evidence(encoding_hash)
    abi_vectors = build_abi_vectors(encoding_hash)
    numeric_vectors = build_numeric_vectors(numeric_profile)
    evidence_bytes = {
        str(TOTALITY_PATH): pretty_json_bytes(totality),
        str(ABI_VECTORS_PATH): pretty_json_bytes(abi_vectors),
        str(NUMERIC_VECTORS_PATH): pretty_json_bytes(numeric_vectors),
    }

    canonical_inputs = []
    input_hashes = {}
    for relative in canonical_input_paths():
        digest = sha256_bytes((ROOT / relative).read_bytes())
        canonical_inputs.append({"path": relative, "sha256": digest})
        input_hashes[relative] = digest
    content_hash = sha256_bytes(normalized_json_bytes(input_hashes))

    owned_artifacts = []
    for relative in GENERATED_DOCS:
        owned_artifacts.append(
            {"path": relative, "kind": "generated-documentation", "sha256": sha256_bytes((ROOT / relative).read_bytes())}
        )
    for relative in EVIDENCE_FILES:
        owned_artifacts.append(
            {"path": relative, "kind": "generated-evidence", "sha256": sha256_bytes(evidence_bytes[relative])}
        )

    manifest = {
        "schema_version": 1,
        "release": RELEASE,
        "publication_version": PUBLICATION_VERSION,
        "specification_status": metadata["specification"]["status"],
        "encoding_abi": ENCODING_ABI,
        "content_sha256": content_hash,
        "encoding_projection_sha256": encoding_hash,
        "hardware_conformance_profile": {
            "profile_id": NUMERIC_PROFILE_ID,
            "path": str(NUMERIC_PROFILE_PATH),
            "sha256": sha256_bytes((ROOT / NUMERIC_PROFILE_PATH).read_bytes()),
            "evidence": str(NUMERIC_VECTORS_PATH),
            "repository_implementation_conformance":
                "b-fpatr-and-tcvt-e8m0-asl-proven-other-numeric-domains-unproven",
        },
        "release_selection": manifest_selection(selection),
        "hash_contract": {
            "algorithm": "SHA-256",
            "json_encoding": "UTF-8 JSON with lexicographically sorted keys and separators ',' ':'",
            "content_projection": "object mapping each canonical input path to its file SHA-256",
            "encoding_projection": "encoding ABI ID plus scalar/command forms, PTO extension-encoding reservations, tile selector/function assignments, and system-register locations",
        },
        "catalog_counts": {
            **FORM_COUNTS,
            "command_form_families": COMMAND_FAMILY_COUNTS,
            "extension_encoding_reservations": len(
                projection["extension_encoding_reservations"]
            ),
            "tile_operations": FAMILY_COUNTS,
            "tile_operations_total": sum(FAMILY_COUNTS.values()),
            "pending_base_operations": 0,
            "contract_status_counts": {"reviewed-complete": sum(FAMILY_COUNTS.values())},
        },
        "elf_identity": abi_vectors["elf_identity"],
        "canonical_inputs": canonical_inputs,
        "owned_artifacts": sorted(owned_artifacts, key=lambda row: row["path"]),
    }
    return {
        str(TOTALITY_PATH): totality,
        str(ABI_VECTORS_PATH): abi_vectors,
        str(NUMERIC_VECTORS_PATH): numeric_vectors,
        str(MANIFEST_PATH): manifest,
    }


def check_artifacts(artifacts: dict[str, dict]) -> None:
    failures = []
    for relative, expected in artifacts.items():
        path = ROOT / relative
        if not path.is_file():
            failures.append(f"missing {relative}")
            continue
        try:
            actual = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            failures.append(f"invalid {relative}: {error}")
            continue
        if actual != expected:
            failures.append(f"stale {relative}")
    if failures:
        raise SystemExit(
            "release artifacts are not reproducible:\n- "
            + "\n- ".join(failures)
            + "\nrun ./scripts/generate-release-manifest"
        )


def write_artifacts(artifacts: dict[str, dict]) -> None:
    for relative in (
        str(TOTALITY_PATH),
        str(ABI_VECTORS_PATH),
        str(NUMERIC_VECTORS_PATH),
        str(MANIFEST_PATH),
    ):
        path = ROOT / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(pretty_json_bytes(artifacts[relative]))
        print(f"wrote {relative}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail if artifacts are absent or stale")
    parser.add_argument("--print-encoding-hash", action="store_true", help="print only the computed encoding hash")
    args = parser.parse_args()
    artifacts = build_artifacts()
    if args.print_encoding_hash:
        print(artifacts[str(MANIFEST_PATH)]["encoding_projection_sha256"])
    elif args.check:
        check_artifacts(artifacts)
        print(
            f"release manifest passed: PTO ISA {RELEASE}, "
            f"encoding {artifacts[str(MANIFEST_PATH)]['encoding_projection_sha256']}"
        )
    else:
        write_artifacts(artifacts)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        sys.exit(1)
