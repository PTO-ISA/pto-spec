                {"namespace": "scalar-core-state-frm", "raw": 4, "expected_mode": "RNE", "encoding_status": "reserved-fallback"},
                {"namespace": "scalar-core-state-frm", "raw": 7, "expected_mode": "RNE", "encoding_status": "reserved-fallback"},
