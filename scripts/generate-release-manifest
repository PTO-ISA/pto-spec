    'MGATHER_CAS': 'BSTART.MGATHER.CAS',
    'GMOV': 'BSTART.GMOV',
    'TMATMUL': 'BSTART.TMATMUL',
    'TMATMUL_BIAS': 'BSTART.TMATMUL.BIAS',
    'TMATMUL_ACC': 'BSTART.TMATMUL.ACC',
