        for path in (ROOT / "asl").rglob("*.asl")
    )
)
RELEASE_INPUTS_PATH = ROOT / "spec/release-inputs.json"
RELEASE_INPUTS = json.loads(RELEASE_INPUTS_PATH.read_text(encoding="utf-8"))
if RELEASE_INPUTS.get("schema") != "pto.release-inputs.v1":
    raise SystemExit("spec/release-inputs.json has the wrong schema")
RELEASE_EVIDENCE = tuple(RELEASE_INPUTS.get("evidence", ()))
