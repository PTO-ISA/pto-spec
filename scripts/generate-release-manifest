    'TGEMV_MX': 'BSTART.TGEMVMX',
    'TGEMV_MX_BIAS': 'BSTART.TGEMVMX.BIAS',
    'TGEMV_MX_ACC': 'BSTART.TGEMVMX.ACC',
}
DELETED_TEPL_NAMES = (
    'TPRELU',
    'TAXPY',
    'TGATHERB',
    'TRANDOM',
