#!/usr/bin/env python3
"""Generate the deterministic PTO functional-model ASL construct inventory."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.functional_model_inventory import InventoryError, inventory_files  # noqa: E402

MODELGEN = ROOT / "tools/functional-model/modelgen"
if str(MODELGEN) not in sys.path:
    sys.path.insert(0, str(MODELGEN))

from pto_mir import (  # noqa: E402
    ModelgenError,
    build_mir,
    build_readiness,
    render_mir,
    render_readiness,
)


DEFAULT_OUTPUT = ROOT / "spec/evidence/functional-model-asl-constructs.json"
DEFAULT_MIR_OUTPUT = ROOT / "build/functional-model/share/pto/pto-mir-v1.json"
DEFAULT_READINESS_OUTPUT = ROOT / "spec/evidence/functional-model-mir-readiness.json"
DEFAULT_SCHEMA = ROOT / "spec/schemas/pto-mir-v1.schema.json"


def _aslref_root() -> Path:
    configured = os.environ.get("PTO_ASLREF_ROOT")
    return Path(configured) if configured else ROOT / ".cache/herdtools7"


def _ast_mli() -> Path:
    return _aslref_root() / "asllib/AST.mli"


def _generate_typed_ast(output: Path) -> None:
    subprocess.run(["make", "--no-print-directory", "build"], cwd=ROOT, check=True)
    with output.open("wb") as stream:
        subprocess.run(
            [
                str(ROOT / "scripts/aslref"),
                "--type-check-strict",
                "--serialize-typed",
                "--no-exec",
                str(ROOT / "build/pto-spec.asl"),
            ],
            cwd=ROOT,
            stdout=stream,
            check=True,
        )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--typed-ast", type=Path)
    parser.add_argument("--ast-mli", type=Path)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--mir-output", type=Path, default=DEFAULT_MIR_OUTPUT)
    parser.add_argument(
        "--readiness-output", type=Path, default=DEFAULT_READINESS_OUTPUT
    )
    parser.add_argument("--schema", type=Path, default=DEFAULT_SCHEMA)
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()

    temporary: tempfile.TemporaryDirectory[str] | None = None
    try:
        typed_ast = arguments.typed_ast
        if typed_ast is None:
            temporary = tempfile.TemporaryDirectory(prefix="pto-functional-model-")
            typed_ast = Path(temporary.name) / "pto-spec.typed.ast"
            _generate_typed_ast(typed_ast)
        ast_mli = arguments.ast_mli or _ast_mli()
        typed_ast_bytes = typed_ast.read_bytes()
        ast_mli_bytes = ast_mli.read_bytes()
        schema_bytes = arguments.schema.read_bytes()
        mir, stats = build_mir(typed_ast_bytes, ast_mli_bytes, schema_bytes)
        rendered = inventory_files(typed_ast, ast_mli)
        mir_rendered = render_mir(mir)
        readiness_rendered = render_readiness(
            build_readiness(
                typed_ast=typed_ast_bytes,
                ast_mli=ast_mli_bytes,
                schema_bytes=schema_bytes,
                mir_bytes=mir_rendered,
                stats=stats,
            )
        )
        if arguments.check:
            expected = (
                (arguments.output, rendered.encode("utf-8")),
                (arguments.mir_output, mir_rendered),
                (arguments.readiness_output, readiness_rendered.encode("utf-8")),
            )
            for path, content in expected:
                if not path.is_file():
                    raise InventoryError(f"missing generated artifact {path}")
                if path.read_bytes() != content:
                    raise InventoryError(f"stale generated artifact {path}")
            print(f"functional-model artifacts are current: {arguments.mir_output}")
        else:
            outputs = (
                (arguments.output, rendered.encode("utf-8")),
                (arguments.mir_output, mir_rendered),
                (arguments.readiness_output, readiness_rendered.encode("utf-8")),
            )
            for path, content in outputs:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(content)
                print(f"wrote {path}")
    except (
        InventoryError,
        ModelgenError,
        OSError,
        subprocess.CalledProcessError,
    ) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    finally:
        if temporary is not None:
            temporary.cleanup()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
