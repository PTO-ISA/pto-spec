#!/usr/bin/env python3
"""Generate the named hardware-profile PD-05 special-value checkpoint."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.evidence_sources import source_rows  # noqa: E402

HARDWARE_PROFILE = ROOT / "spec/hardware-conformance-profile.json"
FORMAT_CONTRACT = ROOT / "spec/evidence/numeric-format-namespace-contract.json"
NUMERIC_CONTRACTS = ROOT / "spec/evidence/numeric-contracts.json"
SCALAR_FORMS = ROOT / "spec/catalog/scalar-forms.json"
COMPARISON = ROOT / "spec/evidence/executable-model-comparison.json"
OUTPUT = ROOT / "spec/evidence/numeric-special-value-contract.json"
ACCEPTANCE_RECORD = (
    "docs/status/decisions/0050-hardware-special-value-checkpoint.md"
)
PROFILE_ID = "pto-hardware-numeric-0.58.0-ieee-v1"


SIGNED_ZERO_ENCODINGS = {
    "FP64": "0x8000000000000000",
    "FP32": "0x80000000",
    "TF32": "0x80000000",
    "HF32": "0x80000000",
    "FP16": "0x8000",
    "BF16": "0x8000",
    "E4M3": "0x80",
    "E5M2": "0x80",
    "E3M2": "0x20",
    "E2M3": "0x20",
    "E2M1X2": "0x8",
    "E1M2X2": "0x8",
    "HiF4X2": "0x8",
}
TILE_OPERATIONS = {
    "TCMP": "comparison-special-result",
    "TCMPS": "comparison-special-result",
    "TMIN": "minmax-special-result",
    "TMINS": "minmax-special-result",
    "TMAX": "minmax-special-result",
    "TMAXS": "minmax-special-result",
}
SCALAR_OPERATIONS = {"FMIN", "FMAX"}


def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"numeric special-value generation failed: {message}")


def source(path: str) -> dict[str, str]:
    absolute = ROOT / path
    return {
        "path": path,
        "sha256": hashlib.sha256(absolute.read_bytes()).hexdigest(),
    }


def generate() -> dict[str, Any]:
    profile = load(HARDWARE_PROFILE)
    formats = load(FORMAT_CONTRACT)
    contracts = load(NUMERIC_CONTRACTS)
    scalar = load(SCALAR_FORMS)
    comparison = load(COMPARISON)

    require(profile["profile_id"] == PROFILE_ID, "hardware profile identity drift")
    require(
        profile["arithmetic"]["canonical_nan_output"]
        == "When the destination format has a NaN encoding, every produced NaN is replaced by that format's canonical NaN encoding.",
        "canonical NaN policy drift",
    )
    require(
        profile["arithmetic"]["signed_zero"]
        == "IEEE signed zero is preserved by formats that encode both signs of zero; HiF8 has one zero encoding. Exact cancellation follows the selected rounding mode. Equal-sign zero inputs preserve that sign; a mixed-sign zero tie uses -0 for minimum and +0 for maximum.",
        "signed-zero policy drift",
    )
    require(
        profile["comparisons"]
        == {
            "false_result": 0,
            "nan": {
                "EQ": False,
                "GE": False,
                "GT": False,
                "LE": False,
                "LT": False,
                "NE": True,
                "signaling_nan_reports_invalid": True,
            },
            "signed_zero": "+0 and -0 compare equal and neither is less than the other for formats with signed zero",
            "true_result": 1,
        },
        "comparison special-value policy drift",
    )

    format_rows = formats["value_classification"]["formats"]
    require(len(format_rows) == 25, "format inventory drift")
    require(
        formats["summary"]["nan_capable_type_count"] == 10
        and formats["summary"]["signaling_nan_capable_type_count"] == 7
        and formats["summary"]["signed_zero_type_count"] == 13,
        "format capability count drift",
    )
    special_formats = []
    for row in format_rows:
        expected_negative_zero = SIGNED_ZERO_ENCODINGS.get(row["name"])
        require(
            row["signed_zero"] == (expected_negative_zero is not None),
            f"signed-zero capability drift for {row['name']}",
        )
        special_formats.append(
            {
                "name": row["name"],
                "asl_enumerator": row["asl_enumerator"],
                "logical_element_bits": row["logical_element_bits"],
                "nan_capable": row["nan_capable"],
                "signaling_nan_capable": row["signaling_nan_capable"],
                "canonical_nan": row["canonical_nan"],
                "signed_zero": row["signed_zero"],
                "positive_zero": "0x0" if row["signed_zero"] else None,
                "negative_zero": expected_negative_zero,
            }
        )

    numeric_operations = {row["name"]: row for row in contracts["operations"]}
    require(
        TILE_OPERATIONS.keys() <= numeric_operations.keys(),
        "tile special-value operation inventory drift",
    )
    scalar_rows = {
        row["mnemonic"]: row
        for row in scalar["forms"]
        if row["mnemonic"] in SCALAR_OPERATIONS
    }
    require(set(scalar_rows) == SCALAR_OPERATIONS, "scalar min/max inventory drift")

    all_type_names = [row["name"] for row in format_rows]
    operation_scope = []
    for mnemonic in sorted(SCALAR_OPERATIONS):
        row = scalar_rows[mnemonic]
        operation_scope.append(
            {
                "operation_key": f"scalar:{row['form_id']}",
                "mnemonic": mnemonic,
                "surface": "scalar-form",
                "rule": "portable-minmax-special-result-already-executable",
                "type_names": ["FP64", "FP32"],
                "support_boundary": "accepted scalar source selectors only",
            }
        )
    for mnemonic, rule in sorted(TILE_OPERATIONS.items()):
        row = numeric_operations[mnemonic]
        operation_scope.append(
            {
                "operation_key": row["key"],
                "mnemonic": mnemonic,
                "surface": row["surface"],
                "rule": rule,
                "type_names": all_type_names,
                "support_boundary": "conditional on an otherwise-supported operation/type tuple",
            }
        )

    require(
        comparison["closure_judgment"]["can_close_s5_t3"] is True
        and comparison["snapshot"]["worktree_clean"] is True,
        "independent comparison closure drift",
    )
    provenance = formats["independent_comparison"]["provenance_sha256"]
    require(
        comparison["snapshot"]["revision_sha256"] == provenance,
        "independent comparison provenance drift",
    )

    tuple_count = sum(len(row["type_names"]) for row in operation_scope)
    return {
        "schema_version": 1,
        "target": "S5-T2-A2:PD-05-SC2",
        "decision_id": "PD-05",
        "checkpoint_id": "PD-05-SC2",
        "status": "named-hardware-special-value-checkpoint-accepted-pd05-open",
        "acceptance_record": ACCEPTANCE_RECORD,
        "profile_id": PROFILE_ID,
        "policy": {
            "produced_nan": "canonical-destination-format-nan",
            "comparison_nan": "NE-true-all-other-relations-false",
            "comparison_signaling_nan": "same-boolean-result-and-invalid-condition",
            "comparison_signed_zero": "equal-neither-less-nor-greater",
            "minmax_one_nan": "select-numeric-operand",
            "minmax_two_nan": "canonical-destination-format-nan",
            "minmax_signaling_nan": "same-result-and-invalid-condition",
            "minmax_signed_zero": "preserve-equal-sign-mixed-tie-minimum-negative-maximum-positive",
            "result_encoding": {"false": 0, "true": 1},
            "support_boundary": "The checkpoint does not create operation/type support and does not select the named hardware profile generically.",
            "pto_v0_boundary": "The active pto-v0 raw-carrier hooks are unchanged.",
        },
        "asl_contract": {
            "classifier": "TileNumericValueClass",
            "canonical_nan": "HardwareNumericCanonicalNaNResult",
            "signed_zero_encodings": "HardwareNumericSignedZeroEncodings",
            "comparison_special_result": "HardwareNumericComparisonSpecial",
            "minmax_special_result": "HardwareNumericMinMaxSpecial",
        },
        "formats": special_formats,
        "operation_scope": operation_scope,
        "independent_comparison": {
            "status": "fp32-fp64-shared-special-selection-corroborated-with-fmax-zero-divergence-not-numeric-oracle",
            "provenance_sha256": provenance,
            "matched_contracts": [
                "ordered-NaN-comparison-foundation",
                "positive-negative-zero-equality",
                "signaling-versus-quiet-NaN-classification",
                "one-NaN-and-two-NaN-minmax-selection",
                "fmin-zero-selection-and-fmax-zero-selection-except-equal-negative-zero",
            ],
            "divergences": [
                "comparison-model-fmax-equal-negative-zero-returns-positive-zero-pto-preserves-negative-zero",
            ],
            "limits": [
                "no-PTO-low-precision-operation-binding",
                "no-complete-infinity-arithmetic-contract",
                "no-complete-target-flag-or-status-contract",
                "not-a-PTO-numeric-oracle",
            ],
        },
        "tests": {
            "sources": [
                "tests/asl/profile-tests.asl",
                "tests/asl/scalar-tests.asl",
            ],
            "entrypoints": [
                "ValidateNumericFormatClassification",
                "TestScalarFPDispatchEffects",
            ],
            "assertion_helpers": [
                "AssertHardwareNumericNaNSpecialRules",
                "AssertHardwareNumericSignedZeroSpecialRules",
                "AssertHardwareNumericSignedZeroNotApplicable",
            ],
            "required_witnesses": [
                "all-ten-canonical-NaN-formats",
                "all-seven-signaling-NaN-formats",
                "all-six-comparison-relations",
                "left-right-and-two-NaN-minmax",
                "all-thirteen-signed-zero-formats-mixed-orders-and-equal-sign-ties",
                "all-twelve-no-signed-zero-formats",
                "invalid-internal-encoding-rejects-before-special-result",
                "scalar-fp32-fp64-equal-sign-zero-minmax",
            ],
        },
        "sources": [
            source(
                "docs/status/decisions/0050-hardware-special-value-checkpoint.md"
            ),
            source("spec/hardware-conformance-profile.json"),
            source("spec/evidence/numeric-format-namespace-contract.json"),
            source("spec/evidence/numeric-contracts.json"),
            source("spec/catalog/scalar-forms.json"),
            source("spec/evidence/executable-model-comparison.json"),
            *source_rows(ROOT, "asl/tile/model/numeric/formats.asl"),
            *source_rows(ROOT, "asl/scalar/model/fsu/*.asl"),
            *source_rows(ROOT, "asl/scalar/model/dispatch/*.asl"),
            source("tests/asl/profile-tests.asl"),
        ],
        "summary": {
            "format_count": 25,
            "nan_capable_type_count": 10,
            "signaling_nan_capable_type_count": 7,
            "signed_zero_type_count": 13,
            "comparison_operation_count": 2,
            "minmax_operation_count": 6,
            "operation_scope_count": len(operation_scope),
            "conditional_operation_type_tuple_count": tuple_count,
            "accepted_special_result_rule_count": 3,
            "accepted_complete_domain_rule_count": 0,
            "accepted_complete_decision_count": 0,
            "pd05_complete": False,
            "s5_t2_complete": False,
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--write", action="store_true")
    mode.add_argument("--check", action="store_true")
    args = parser.parse_args()
    expected = json.dumps(generate(), indent=2, ensure_ascii=False) + "\n"
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.is_file() or OUTPUT.read_text(encoding="utf-8") != expected:
        raise SystemExit(f"stale generated artifact {OUTPUT}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
