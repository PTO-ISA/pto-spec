TILE_BINDING_CONSTANT = re.compile(
    r"(?:TRUE|FALSE|TileAxis_(?:Row|Column)|"
    r"TileBinary_[A-Z]+|TileUnary_[A-Z]+|TileReduction_[A-Z]+|"
    r"TileExpand_[A-Z]+|TilePartial_[A-Z]+)"
)


def load(relative: str):
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def extract_field(row: dict, field_name: str, instruction: int) -> int:
    field = next(field for field in row["fields"] if field["name"] == field_name)
    value = 0
    for piece in field["pieces"]:
        mask = (1 << piece["width"]) - 1
        value |= ((instruction >> piece["instruction_lsb"]) & mask) << piece[
            "value_lsb"
        ]
    return value


def classify_agu_form(row: dict) -> dict:
    parts = row["mnemonic"].split(".")
    core_index = 1 if parts[0] in {"C", "HL"} else 0
    core = parts[core_index]
    suffixes = set(parts[core_index + 1 :])
    actions = {
        "ExecuteScalarLoad": "Load",
        "ExecuteScalarLoadPair": "LoadPair",
        "ExecuteScalarStore": "Store",
        "ExecuteScalarStorePair": "StorePair",
        "ScalarPrefetch": "Prefetch",
    }
    require(row["semantic_handler"] in actions, f"unknown AGU handler {row['form_id']}")
    action = actions[row["semantic_handler"]]
    if action == "Prefetch":
        size_bytes = 1
    else:
        width_prefixes = (("LB", "SB"), ("LH", "SH"), ("LW", "SW"), ("LD", "SD"))
        widths = (1, 2, 4, 8)
        matches = [
            width
            for prefixes, width in zip(width_prefixes, widths, strict=True)
            if core.startswith(prefixes)
        ]
        require(len(matches) == 1, f"ambiguous AGU width {row['form_id']}")
        size_bytes = matches[0]

    field_names = {field["name"] for field in row["fields"]}
    if "PCR" in suffixes:
        address_kind = "PCRelative"
    elif parts[0] == "C":
        address_kind = "Compressed"
    elif "SrcRType" in field_names:
        address_kind = "Register"
    else:
        address_kind = "Immediate"
    if suffixes & {"PR", "UPR"}:
        update_mode = "PreIndex"
    elif suffixes & {"PO", "UPO"}:
        update_mode = "PostIndex"
    else:
        update_mode = "None"
    unscaled = bool(suffixes & {"U", "UPR", "UPO", "UA"})
    if address_kind == "PCRelative":
        offset_scale = 2
    elif address_kind == "Register" and "shamt" in field_names:
        offset_scale = 0
    elif unscaled:
        offset_scale = 0
    else:
        offset_scale = int(math.log2(size_bytes))
    signed_load = (
        action in {"Load", "LoadPair"}
        and core.startswith(("LB", "LH", "LW"))
        and not core.startswith(("LBU", "LHU", "LWU"))
    )
    return {
        "action": action,
        "address_kind": address_kind,
        "offset_scale": offset_scale,
        "prefetch_returns_address": row["mnemonic"] in {"HL.PRF.A", "HL.PRFI.UA"},
        "signed_load": signed_load,
        "size_bytes": size_bytes,
        "update_mode": update_mode,
    }


def expand_number_entries(entries: list) -> set[int]:
    values: set[int] = set()
    for entry in entries:
        if isinstance(entry, int):
            values.add(entry)
        else:
            require(
                isinstance(entry, list) and len(entry) == 2,
                "invalid numeric range entry",
            )
            start = int(entry[0], 0) if isinstance(entry[0], str) else entry[0]
            end = int(entry[1], 0) if isinstance(entry[1], str) else entry[1]
            require(start <= end, "reversed numeric range entry")
            values.update(range(start, end + 1))
    return values


def main() -> int:
    scalar = load("spec/catalog/scalar-forms.json")
    system_registers = load("spec/catalog/system-registers.json")
    tile = load("spec/catalog/tile-operations.json")
    crosscheck = load("spec/evidence/independent-tile-crosscheck.json")
    requirements = load("spec/requirements.json")["requirements"]
    profile_catalog = load("spec/profile-hooks.json")
    specification = tomllib.loads(
        (ROOT / "specification.toml").read_text(encoding="utf-8")
    )

    isa_name = "PTO Instruction Set Architecture"
    require(
        set(scalar)
        == {
            "constraint_count",
            "form_count",
            "forms",
            "isa",
            "operand_field_count",
            "operand_piece_count",
            "schema_version",
            "semantic_handler_count",
        },
        "scalar catalog top-level schema drift",
    )
    require(scalar["schema_version"] == 1, "unsupported scalar catalog schema")
    require(specification["specification"]["name"] == isa_name, "wrong ISA name")
    require(
        specification["specification"]["normative"] is True,
        "specification must be normative",
    )
    require(
        specification["architecture"]["tile_model"] == "one-level",
        "tile model must be one-level",
    )
    require(
        specification["architecture"]["hierarchical_calls"] is False,
        "hierarchical calls must be disabled",
    )
    require(
        specification["maturity"]["instruction_dispatch"]
        == "all-473-scalar-forms-and-111-tile-operations-executable",
        "instruction dispatch maturity must match the complete checked catalogs",
    )
    require(
        specification["maturity"]["tile_semantics"]
        == "decoded-with-explicit-legality-and-profile-hooks",
        "tile maturity must record explicit decoded legality",
    )
    require(
        specification["architecture"]["scalar_forms"] == 473,
        "status record scalar count drift",
    )
    require(
        specification["architecture"]["system_register_definitions"] == 52,
        "status record system-register count drift",
    )
    require(
        specification["architecture"]["trap_numbers"] == 13,
        "status record trap count drift",
    )

    forms = scalar["forms"]
    require(scalar["isa"] == isa_name, "scalar catalog has wrong ISA identity")
    require(scalar["form_count"] == len(forms) == 473, "scalar form count must be 473")
    require(
        scalar["operand_field_count"] == 45, "scalar operand field count must be 45"
    )
    require(
        scalar["operand_piece_count"] == 1865, "scalar operand piece count must be 1865"
    )
    require(
        scalar["constraint_count"] == 3, "scalar operand constraint count must be 3"
    )
    require(
        scalar["semantic_handler_count"] == 67,
        "scalar semantic handler count must be 67",
    )
    require(
        all(row["mnemonic"] != "DMA" for row in forms),
        "DMA must remain outside the accepted scalar surface",
    )
    form_ids = [row["form_id"] for row in forms]
    require(len(form_ids) == len(set(form_ids)), "scalar form IDs must be unique")
    require(
        Counter(row["semantic_family"] for row in forms)
        == Counter(
            {"AGU": 183, "ALU": 107, "AMO": 52, "BRU": 66, "FSU": 30, "SYS": 35}
        ),
        "scalar family counts changed",
    )
    agu_metadata = [
        classify_agu_form(row) for row in forms if row["semantic_family"] == "AGU"
    ]
    require(len(agu_metadata) == 183, "AGU execution metadata must cover 183 forms")
    expected_agu_distributions = {
        "action": Counter(
            {"Load": 85, "LoadPair": 19, "Store": 59, "StorePair": 14, "Prefetch": 6}
        ),
        "address_kind": Counter(
            {"Immediate": 98, "Register": 59, "PCRelative": 22, "Compressed": 4}
        ),
        "offset_scale": Counter({0: 105, 1: 19, 2: 43, 3: 16}),
        "prefetch_returns_address": Counter({False: 181, True: 2}),
        "signed_load": Counter({False: 139, True: 44}),
        "size_bytes": Counter({1: 39, 2: 52, 4: 54, 8: 38}),
        "update_mode": Counter({"None": 117, "PreIndex": 33, "PostIndex": 33}),
    }
    for key, expected in expected_agu_distributions.items():
        require(
            Counter(metadata[key] for metadata in agu_metadata) == expected,
            f"AGU {key} classification drift",
        )
    for row in forms:
        require(
            set(row)
            == {
                "asm",
                "constraints",
                "encoding",
                "encoding_kind",
                "fields",
                "form_id",
                "length_bits",
                "mnemonic",
                "semantic_family",
                "semantic_group",
                "semantic_handler",
                "status",
            },
            f"scalar form schema drift for {row.get('form_id', '<unknown>')}",
        )
        require(
            row["status"] == "accepted", f"non-accepted scalar form {row['form_id']}"
        )
        require(
            row["length_bits"] in {16, 32, 48},
            f"invalid scalar width for {row['form_id']}",
        )
        require(row["encoding"], f"missing encoding for {row['form_id']}")
        for part in row["encoding"]:
            require(
                set(part) == {"index", "mask", "match", "width_bits"},
                f"encoding schema drift for {row['form_id']}",
            )
            require(
                part["index"] == 0,
                f"multi-part scalar encoding is not supported for {row['form_id']}",
            )
            mask = int(part["mask"], 16)
            match = int(part["match"], 16)
            require(
                part["width_bits"] == row["length_bits"],
                f"encoding width drift for {row['form_id']}",
            )
            require(
                mask < 1 << row["length_bits"],
                f"mask exceeds width for {row['form_id']}",
            )
            require(
                match < 1 << row["length_bits"],
                f"match exceeds width for {row['form_id']}",
            )
            require(
                match & ~mask == 0, f"match sets unmasked bits for {row['form_id']}"
            )
        field_names: set[str] = set()
        for field in row["fields"]:
            require(
                set(field) == {"name", "pieces", "signedness", "width"},
                f"field schema drift in {row['form_id']}",
            )
            require(
                field["name"] not in field_names,
                f"duplicate field {field['name']} in {row['form_id']}",
            )
            field_names.add(field["name"])
            require(
                field["signedness"] in {"encoding-defined", "signed", "unsigned"},
                f"bad signedness in {row['form_id']}",
            )
            require(1 <= field["width"] <= 48, f"bad field width in {row['form_id']}")
            if field["name"] in SCALAR_REGISTER_FIELDS:
                require(
                    field["width"] == 5,
                    f"scalar register field must be five bits in {row['form_id']}",
                )
            covered_value_bits: set[int] = set()
            covered_instruction_bits: set[int] = set()
            for piece in field["pieces"]:
                require(
                    set(piece) == {"instruction_lsb", "value_lsb", "width"},
                    f"piece schema drift in {row['form_id']}",
                )
                require(piece["width"] > 0, f"empty field piece in {row['form_id']}")
                instruction_bits = set(
                    range(
                        piece["instruction_lsb"],
                        piece["instruction_lsb"] + piece["width"],
                    )
                )
                value_bits = set(
                    range(piece["value_lsb"], piece["value_lsb"] + piece["width"])
                )
                require(
                    max(instruction_bits) < row["length_bits"],
                    f"field exceeds instruction in {row['form_id']}",
                )
                require(
                    not covered_instruction_bits & instruction_bits,
                    f"overlapping instruction pieces in {row['form_id']}",
                )
                require(
                    not covered_value_bits & value_bits,
                    f"overlapping value pieces in {row['form_id']}",
                )
                covered_instruction_bits.update(instruction_bits)
                covered_value_bits.update(value_bits)
            require(
                covered_value_bits == set(range(field["width"])),
                f"non-contiguous field value in {row['form_id']}",
            )
        for constraint in row["constraints"]:
            require(
                constraint["field"] in field_names,
                f"constraint references absent field in {row['form_id']}",
            )
            require(
                constraint["operator"] == "not-equal",
                f"unsupported constraint in {row['form_id']}",
            )
            width = next(
                field["width"]
                for field in row["fields"]
                if field["name"] == constraint["field"]
            )
            require(
                0 <= constraint["value"] < 1 << width,
                f"constraint value exceeds field in {row['form_id']}",
            )

    overlaps: list[tuple[dict, dict]] = []
    for left_index, left in enumerate(forms):
        left_encoding = left["encoding"][0]
        left_mask = int(left_encoding["mask"], 16)
        left_match = int(left_encoding["match"], 16)
        for right in forms[left_index + 1 :]:
            if left["length_bits"] != right["length_bits"]:
                continue
            right_encoding = right["encoding"][0]
            right_mask = int(right_encoding["mask"], 16)
            right_match = int(right_encoding["match"], 16)
            common_mask = left_mask & right_mask
            if (left_match & common_mask) != (right_match & common_mask):
                continue
            left_specificity = left_mask.bit_count()
            right_specificity = right_mask.bit_count()
            require(
                left_specificity != right_specificity,
                f"ambiguous equal-priority forms: {left['form_id']} and {right['form_id']}",
            )
            broad = left if left_specificity < right_specificity else right
            narrow = right if broad is left else left
            require(
                broad["constraints"],
                f"unreviewed scalar encoding overlap: {left['form_id']} and {right['form_id']}",
            )
            require(
                all(
                    constraint["operator"] == "not-equal"
                    and extract_field(
                        broad,
                        constraint["field"],
                        int(narrow["encoding"][0]["match"], 16),
                    )
                    == constraint["value"]
                    for constraint in broad["constraints"]
                ),
                f"broad-form constraint does not exclude narrow form: {broad['form_id']} and {narrow['form_id']}",
            )
            overlaps.append((broad, narrow))
    require(
        len(overlaps) == 3,
        "scalar overlap review set must contain exactly three constrained aliases",
    )

    operations = tile["operations"]
    require(
        set(tile)
        == {
            "isa",
            "operation_count",
            "operations",
            "rejected_review_only_codes",
            "rejected_review_only_names",
            "reserved",
            "schema_version",
        },
        "tile catalog top-level schema drift",
    )
    require(tile["schema_version"] == 2, "unsupported tile catalog schema")
    require(tile["isa"] == isa_name, "tile catalog has wrong ISA identity")
    require(
        tile["operation_count"] == len(operations) == 111,
        "tile operation count must be 111",
    )
    require(
        len({row["name"] for row in operations}) == 111,
        "tile operation names must be unique",
    )
    require(
        Counter(row["family"] for row in operations)
        == Counter({"TEPL": 97, "TMA": 6, "CUBE": 8}),
        "tile family counts changed",
    )
    for family in ("TEPL", "TMA", "CUBE"):
        rows = [row for row in operations if row["family"] == family]
        key = "selector" if family == "TEPL" else "function"
        values = [row[key] for row in rows]
        require(len(values) == len(set(values)), f"duplicate {family} {key}")
        for row in rows:
            expected_keys = {
                "disposition",
                "family",
                "name",
                key,
                "semantic_handler",
                "operands",
                "arguments",
            }
            if row.get("result") is not None:
                expected_keys.add("result")
            require(
                set(row) == expected_keys,
                f"tile operation schema drift for {row['name']}",
            )
            require(
                row["disposition"] == "accepted-direct-operation",
                f"invalid tile disposition for {row['name']}",
            )
            value = int(row[key], 0) if isinstance(row[key], str) else row[key]
            require(
                0 <= value < 1 << 12, f"tile selector exceeds 12 bits for {row['name']}"
            )
            matching_handlers = [
                handler
                for handler, operation_names in TILE_SEMANTIC_GROUPS.items()
                if row["name"] in operation_names
            ]
            require(
                matching_handlers == [row["semantic_handler"]],
                f"tile handler binding drift for {row['name']}",
            )
            operand_fields = [operand["field"] for operand in row["operands"]]
            require(
                len(operand_fields) == len(set(operand_fields)),
                f"duplicate tile operand field for {row['name']}",
            )
            for operand in row["operands"]:
                require(
                    set(operand) == {"field", "role"},
                    f"tile operand schema drift for {row['name']}",
                )
                require(
                    operand["field"] in TILE_OPERAND_FIELDS,
                    f"unknown tile operand field for {row['name']}: {operand['field']}",
                )
                require(
                    isinstance(operand["role"], str) and operand["role"],
                    f"empty tile operand role for {row['name']}",
                )
            referenced_operands: list[str] = []
            for argument in row["arguments"]:
                require(
                    set(argument) in ({"operand"}, {"constant"}),
                    f"tile argument schema drift for {row['name']}",
                )
                if "operand" in argument:
                    require(
                        argument["operand"] in operand_fields,
                        f"undeclared tile operand argument for {row['name']}: {argument['operand']}",
                    )
                    referenced_operands.append(argument["operand"])
                else:
                    require(
                        TILE_BINDING_CONSTANT.fullmatch(argument["constant"])
                        is not None,
                        f"invalid tile binding constant for {row['name']}: {argument['constant']}",
                    )
            require(
                set(referenced_operands) == set(operand_fields),
                f"unused tile operand metadata for {row['name']}",
            )
            if "result" in row:
                require(
                    row["result"] == "value" and row["name"] == "TALLOC",
                    f"invalid tile result binding for {row['name']}",
                )

    tepl_accepted = {
        int(row["selector"], 0) if isinstance(row["selector"], str) else row["selector"]
        for row in operations
        if row["family"] == "TEPL"
    }
    tepl_review = {
        int(value, 0) if isinstance(value, str) else value
        for value in tile["rejected_review_only_codes"]["TEPL"]
    }
    tepl_reserved = expand_number_entries(tile["reserved"]["tepl_selector_ranges"])
    require(
        not (
            tepl_accepted & tepl_review
            or tepl_accepted & tepl_reserved
            or tepl_review & tepl_reserved
        ),
        "TEPL selector partitions overlap",
    )
    require(
        tepl_accepted | tepl_review | tepl_reserved == set(range(1 << 10)),
        "TEPL selector partition is incomplete",
    )

    tma_accepted = {row["function"] for row in operations if row["family"] == "TMA"}
    tma_review = set(tile["rejected_review_only_codes"]["TMA"])
    tma_reserved = expand_number_entries(tile["reserved"]["tma_functions"])
    require(
        tma_accepted | tma_review | tma_reserved == set(range(32)),
        "TMA function partition is incomplete",
    )
    require(
        not (
            tma_accepted & tma_review
            or tma_accepted & tma_reserved
            or tma_review & tma_reserved
        ),
        "TMA function partitions overlap",
    )

    cube_accepted = {row["function"] for row in operations if row["family"] == "CUBE"}
    cube_review = set(tile["rejected_review_only_codes"]["CUBE"])
    cube_unassigned = expand_number_entries(
        tile["reserved"]["cube_functions_without_named_alias"]
    )
    require(
        cube_accepted | cube_review | cube_unassigned == set(range(32)),
        "CUBE function partition is incomplete",
    )
    require(
        not (
            cube_accepted & cube_review
            or cube_accepted & cube_unassigned
            or cube_review & cube_unassigned
        ),
        "CUBE function partitions overlap",
    )

    require(
        set(system_registers)
        == {
            "address_bits",
            "canonical_address_bits",
            "isa",
            "register_definition_count",
            "registers",
            "schema_version",
            "trap_count",
            "trap_numbers",
        },
        "system-register catalog top-level schema drift",
    )
    require(
        system_registers["schema_version"] == 1,
        "unsupported system-register catalog schema",
    )
    require(
        system_registers["isa"] == isa_name,
        "system-register catalog has wrong ISA identity",
    )
    require(
        system_registers["address_bits"] == 24,
        "system-register address width must be 24",
    )
    require(
        system_registers["canonical_address_bits"] == 16,
        "canonical system-register address width must be 16",
    )
    register_rows = system_registers["registers"]
    require(
        system_registers["register_definition_count"] == len(register_rows) == 52,
        "system-register definition count must be 52",
    )
    register_names: set[str] = set()
    canonical_registers: set[int] = set()
    for row in register_rows:
        require(
            row["name"] not in register_names,
            f"duplicate system-register name {row['name']}",
        )
        register_names.add(row["name"])
        require(
            row["access"] in {"RO", "WO", "RW"}, f"invalid access for {row['name']}"
        )
        require(
            row["scope"] in {"base", "context-family"},
            f"invalid scope for {row['name']}",
        )
        if row["scope"] == "base":
            require(
                set(row) == {"access", "address", "name", "scope"},
                f"base register schema drift for {row['name']}",
            )
            address = int(row["address"], 0)
            require(
                0 <= address < 1 << 16,
                f"base register exceeds canonical address width: {row['name']}",
            )
        else:
            require(
                set(row)
                in (
                    {"access", "low_index", "name", "scope"},
                    {"access", "fixed_context", "low_index", "name", "scope"},
                ),
                f"context register schema drift for {row['name']}",
            )
            low_index = int(row["low_index"], 0)
            require(
                0 <= low_index < 1 << 12,
                f"context register low index exceeds 12 bits: {row['name']}",
            )
            context = row.get("fixed_context", 0)
            require(
                0 <= context < 16, f"fixed context exceeds four bits: {row['name']}"
            )
            address = context << 12 | low_index
        require(
            address not in canonical_registers,
            f"duplicate canonical system-register address for {row['name']}",
        )
        canonical_registers.add(address)

    trap_rows = system_registers["trap_numbers"]
    require(
        system_registers["trap_count"] == len(trap_rows) == 13,
        "trap-number count must be 13",
    )
    require(len({row["name"] for row in trap_rows}) == 13, "trap names must be unique")
    require(
        len({row["number"] for row in trap_rows}) == 13, "trap numbers must be unique"
    )
    for row in trap_rows:
        require(
            set(row) == {"name", "number"},
            f"trap schema drift for {row.get('name', '<unknown>')}",
        )
        require(
            0 <= row["number"] < 64, f"trap number exceeds six bits for {row['name']}"
        )

    semantic_names: set[str] = set()
    asl_body = "\n".join(
        path.read_text(encoding="utf-8") for path in (ROOT / "asl").rglob("*.asl")
    )
    require(
        re.search(r"\bDMA64\b", asl_body) is None,
        "removed DMA64 semantics remain in normative ASL",
    )
    for path in (ROOT / "asl").rglob("*.asl"):
        if path == ROOT / "asl" / "state.asl" or path == (
            ROOT / "asl" / "scalar" / "memory.asl"
        ):
            continue
        body = path.read_text(encoding="utf-8")
        require(
            re.search(r"\b(?:ReadMemoryByte|WriteMemoryByte)\s*\(", body) is None,
            f"normative memory access bypasses the profile probe boundary: {path.relative_to(ROOT)}",
        )
    for relative in (
        "asl/scalar/addressing.asl",
        "asl/scalar/dispatch.asl",
        "asl/tile/memory.asl",
    ):
        body = (ROOT / relative).read_text(encoding="utf-8")
        require(
            "ProbeDataAccess(" in body,
            f"multi-access completion path lacks profile preflight: {relative}",
        )
    for handler, names in TILE_SEMANTIC_GROUPS.items():
        require(
            semantic_names.isdisjoint(names),
            f"duplicate tile semantic mapping for {sorted(semantic_names & names)}",
        )
        semantic_names.update(names)
        require(
            re.search(rf"\bfunc\s+{re.escape(handler)}\b", asl_body) is not None,
            f"missing ASL handler {handler}",
        )
        require(
            re.search(
                rf"\breadonly\s+func\s+TileOperandsLegal_{re.escape(handler)}\b",
                asl_body,
            )
            is not None,
            f"missing ASL tile legality predicate for {handler}",
        )
    catalog_names = {row["name"] for row in operations}
    require(
        semantic_names == catalog_names,
        f"tile semantic coverage drift: missing={sorted(catalog_names - semantic_names)}, extra={sorted(semantic_names - catalog_names)}",
    )

    generator = ROOT / "scripts" / "generate-asl-decoders"
    generated_tile_dispatch = subprocess.run(
        [str(generator)],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    require(
        re.search(r"\bfunc\s+ExecuteTileInstruction\b", generated_tile_dispatch)
        is not None,
        "missing generated tile execution entry point",
    )
    for index, row in enumerate(operations):
        operation = re.sub(r"[^A-Za-z0-9_]", "_", row["name"])
        require(
            len(
                re.findall(
                    rf"\bwhen\s+TileOperation_{re.escape(operation)}\s*=>",
                    generated_tile_dispatch,
                )
            )
            == 1,
            f"tile operation lacks one decoded execution binding: {row['name']}",
        )
        require(
            f"if !TileOperandsLegal_{row['semantic_handler']}("
            in generated_tile_dispatch,
            f"tile operation lacks decoded legality binding: {row['name']}",
        )
        require(
            f"assert TileHandlerOfIndex({index}) == "
            f"TileHandler_{row['semantic_handler']};" in generated_tile_dispatch,
            f"tile operation lacks handler-identity evidence: {row['name']}",
        )
        for operand in row["operands"]:
            require(
                f"assert TileOperandPresent({index}, "
                f"TileOperand_{operand['field']});" in generated_tile_dispatch,
                f"tile operation lacks operand-presence evidence: {row['name']}/{operand['field']}",
            )

    for family, handlers in SCALAR_FAMILY_HANDLERS.items():
        require(
            any(row["semantic_family"] == family for row in forms),
            f"unused scalar family mapping {family}",
        )
        for handler in handlers:
            require(
                re.search(rf"\bfunc\s+{re.escape(handler)}\b", asl_body) is not None,
                f"missing scalar handler {handler}",
            )
    for row in forms:
        require(
            re.search(rf"\bfunc\s+{re.escape(row['semantic_handler'])}\b", asl_body)
            is not None,
            f"missing per-form semantic handler {row['semantic_handler']} for {row['form_id']}",
        )

    dispatch_body = (ROOT / "asl" / "scalar" / "dispatch.asl").read_text(
        encoding="utf-8"
    )
    require(
        re.search(r"\bfunc\s+ExecuteScalarInstruction\b", dispatch_body) is not None,
        "missing public scalar execution entry point",
    )
    require(
        "ScalarRegisterOperandsLegal(instruction, form)" in dispatch_body
        and "SetFault(Fault_TileLegality, ReadPC())" in dispatch_body,
        "scalar dispatch does not preflight Reg5 tile bridges",
    )
    require(
        "readonly func ScalarRegisterOperandsLegal" in generated_tile_dispatch,
        "generated scalar Reg5 legality coverage is missing",
    )
    require(
        "DecodeScalarForm('000000000000000000000000000000000111000000001011', 32)"
        in generated_tile_dispatch,
        "removed DMA encoding lacks generated rejection evidence",
    )
    scalar_operands_body = (ROOT / "asl" / "scalar" / "operands.asl").read_text(
        encoding="utf-8"
    )
    require(
        re.search(r"\bassert\b", re.sub(r"//.*", "", scalar_operands_body)) is None,
        "Reg5 tile-bridge legality must not use ASL assertions",
    )
    executable_family_counts = {
        "AGU": 183,
        "ALU": 107,
        "AMO": 52,
        "BRU": 66,
        "FSU": 30,
        "SYS": 35,
    }
    executable_forms = [
        row for row in forms if row["semantic_family"] in executable_family_counts
    ]
    for family, expected_count in executable_family_counts.items():
        require(
            sum(row["semantic_family"] == family for row in executable_forms)
            == expected_count,
            f"{family} dispatch inventory must contain {expected_count} forms",
        )
    for row in executable_forms:
        if row["semantic_family"] == "AGU":
            continue
        operation = re.sub(r"[^A-Za-z0-9_]", "_", row["mnemonic"])
        require(
            re.search(rf"\bScalarOperation_{re.escape(operation)}\b", dispatch_body)
            is not None,
            f"executable form lacks decoded execution binding: {row['form_id']}",
        )
    require(
        re.search(r"\bfunc\s+ExecuteDecodedAGUForm\b", dispatch_body) is not None,
        "missing metadata-driven AGU execution binding",
    )
    require(
        "ScalarAGUActionOfForm"
        in (ROOT / "scripts" / "generate-asl-decoders").read_text(encoding="utf-8"),
        "missing generated AGU execution metadata",
    )

    test_body = "\n".join(
        path.read_text(encoding="utf-8")
        for path in (ROOT / "tests" / "asl").glob("*.asl")
    )
    test_body = re.sub(r"//.*", "", test_body)
    for handler in sorted({row["semantic_handler"] for row in forms}):
        require(
            re.search(rf"\b{re.escape(handler)}\s*\(", test_body) is not None,
            f"scalar semantic handler lacks executable feature evidence: {handler}",
        )
    for handler in sorted(TILE_SEMANTIC_GROUPS):
        require(
            re.search(rf"\b{re.escape(handler)}\s*\(", test_body) is not None,
            f"tile semantic handler lacks executable feature evidence: {handler}",
        )
    require(
        re.search(r"\bExecuteTileInstruction\s*\(", test_body) is not None,
        "decoded tile execution lacks executable feature evidence",
    )
    require(
        "Fault_TileLegality" in test_body
        and "TileExecution_Rejected" in test_body
        and "ScalarExecution_Rejected" in test_body,
        "tile and Reg5 legality lack executable rejection evidence",
    )
    require(
        "TestScalarPairMemoryCompletion" in test_body
        and "TestTileMemoryCompletionAndRestart" in test_body
        and "first_status" in test_body
        and "middle_status" in test_body
        and "last_status" in test_body
        and "restart_status" in test_body,
        "memory completion lacks pair and first/middle/last restart evidence",
    )
    for handler in (
        "ReadSystemRegisterAddress",
        "WriteSystemRegisterAddress",
        "SwapSystemRegisterAddress",
        "PackTrapStatus",
    ):
        require(
            re.search(rf"\bfunc\s+{re.escape(handler)}\b", asl_body) is not None,
            f"missing system-state handler {handler}",
        )

    evidence_rows = crosscheck["operations"]
    require(
        set(crosscheck)
        == {
            "commit",
            "license",
            "operation_count",
            "operations",
            "policy",
            "schema_version",
            "source_class",
            "worktree_dirty",
        },
        "independent evidence top-level schema drift",
    )
    require(crosscheck["schema_version"] == 1, "unsupported evidence schema")
    require(
        crosscheck["operation_count"] == len(evidence_rows) == 111,
        "independent evidence must cover 111 operations",
    )
    require(
        {row["name"] for row in evidence_rows} == {row["name"] for row in operations},
        "evidence name drift",
    )
    require(
        {row["disposition"] for row in evidence_rows}
        <= {"agree", "conflict", "incomplete", "ignored"},
        "invalid independent-evidence disposition",
    )
    require(
        Counter(row["disposition"] for row in evidence_rows)
        == Counter({"agree": 97, "incomplete": 13, "conflict": 1}),
        "independent evidence disposition counts changed",
    )
    require(
        re.fullmatch(r"[0-9a-f]{40}", crosscheck["commit"]) is not None,
        "independent evidence commit must be full SHA",
    )
    require(
        isinstance(crosscheck["worktree_dirty"], bool),
        "independent evidence dirty flag must be boolean",
    )
    for row in evidence_rows:
        require(
            set(row) >= {"disposition", "name", "reason"},
            f"evidence schema drift for {row.get('name', '<unknown>')}",
        )
        if "document" in row:
            require(
                re.fullmatch(r"[A-Z0-9_.]+\.md", row["document"]) is not None,
                f"non-anonymized evidence document for {row['name']}",
            )
            require(
                re.fullmatch(r"[0-9a-f]{64}", row["sha256"]) is not None,
                f"bad evidence hash for {row['name']}",
            )
    require(
        crosscheck["license"] == "proprietary-no-project-license",
        "private evidence license must not be overstated",
    )
    require(
        crosscheck["source_class"] == "private-independent-tile-reference",
        "independent evidence source class drift",
    )

    requirement_ids = [row["id"] for row in requirements]
    require(
        load("spec/requirements.json")["schema_version"] == 1,
        "unsupported requirement schema",
    )
    require(
        len(requirement_ids) == len(set(requirement_ids)), "duplicate requirement IDs"
    )
    for requirement in requirements:
        require(
            re.fullmatch(r"PTO-REQ-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}", requirement["id"])
            is not None,
            "bad requirement ID",
        )
        require(
            requirement["source"].startswith("https://"),
            f"non-public source for {requirement['id']}",
        )
        for relative in requirement["model"] + requirement["tests"]:
            require(
                (ROOT / relative).exists(), f"missing traceability path: {relative}"
            )

    require(
        set(profile_catalog) == {"hooks", "schema_version"},
        "profile-hook catalog top-level schema drift",
    )
    require(profile_catalog["schema_version"] == 1, "unsupported profile-hook schema")
    profile_hooks = profile_catalog["hooks"]
    profile_names = [row["name"] for row in profile_hooks]
    requirements_by_id = {row["id"]: row for row in requirements}
    require(len(profile_names) == len(set(profile_names)), "duplicate profile hooks")
    asl_text = "\n".join(
        path.read_text(encoding="utf-8") for path in (ROOT / "asl").rglob("*.asl")
    )
    for hook in profile_hooks:
        require(
            set(hook)
            == {
                "domain",
                "model",
                "name",
                "portable_default",
                "profile_obligations",
                "requirement",
                "status",
                "tests",
            },
            f"profile-hook schema drift for {hook.get('name', '<unknown>')}",
        )
        require(
            hook["status"] == "explicit-impdef",
            f"bad profile-hook status for {hook['name']}",
        )
        require(
            all(
                isinstance(hook[key], str) and hook[key]
                for key in ("domain", "model", "name", "portable_default")
            ),
            f"empty profile-hook identity for {hook['name']}",
        )
        require(
            hook["requirement"] in requirement_ids,
            f"unknown profile requirement for {hook['name']}",
        )
        require(
            "spec/profile-hooks.json"
            in requirements_by_id[hook["requirement"]]["model"],
            f"profile registry is not traceable from {hook['requirement']}",
        )
        require(
            hook["portable_default"], f"missing portable default for {hook['name']}"
        )
        require(
            isinstance(hook["profile_obligations"], list)
            and hook["profile_obligations"]
            and all(hook["profile_obligations"]),
            f"missing profile obligations for {hook['name']}",
        )
        model_path = ROOT / hook["model"]
        require(model_path.exists(), f"missing profile model for {hook['name']}")
        require(
            re.search(
                rf"\bimpdef\s+func\s+{re.escape(hook['name'])}\b",
                model_path.read_text(encoding="utf-8"),
            )
            is not None,
            f"profile hook is not an impdef declaration: {hook['name']}",
        )
        require(
            len(re.findall(rf"\b{re.escape(hook['name'])}\b", asl_text)) >= 2,
            f"profile hook has no ASL call site: {hook['name']}",
        )
        require(
            isinstance(hook["tests"], list) and hook["tests"],
            f"missing profile tests for {hook['name']}",
        )
        for relative in hook["tests"]:
            require(
                (ROOT / relative).exists(), f"missing profile test path: {relative}"
            )
    declared_profile_names: set[str] = set()
    for path in (ROOT / "asl").rglob("*.asl"):
        declared_profile_names.update(
            re.findall(
                r"\bimpdef\s+func\s+([A-Za-z][A-Za-z0-9_]*)\b",
                path.read_text(encoding="utf-8"),
            )
        )
    require(
        set(profile_names) == declared_profile_names,
        "profile-hook catalog does not exactly cover ASL impdef declarations",
    )
    for requirement in requirements:
        if "profile" in requirement["status"]:
            require(
                "spec/profile-hooks.json" in requirement["model"],
                f"profile-bearing requirement omits registry: {requirement['id']}",
            )

    used_ids: set[str] = set()
    nested_names = (
        "V" + "CALL",
        "M" + "CALL",
        "V" + "PAR",
        "V" + "SEQ",
        "M" + "PAR",
        "M" + "SEQ",
    )
    for path in (ROOT / "asl").rglob("*.asl"):
        body = path.read_text(encoding="utf-8")
        used_ids.update(re.findall(r"PTO-REQ-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}", body))
        active = body.upper()
        for forbidden in nested_names:
            require(
                re.search(
                    rf"(?<![A-Z0-9_.]){re.escape(forbidden)}(?![A-Z0-9_.])", active
                )
                is None,
                f"forbidden nested architecture surface in {path}",
            )
    require(
        used_ids <= set(requirement_ids),
        f"ASL uses unknown requirement IDs: {sorted(used_ids - set(requirement_ids))}",
    )

    print(
        "catalog checks passed: 473 scalar forms, 45 operand fields, 1,865 field pieces, "
        "3 constrained overlaps, 52 system-register definitions, 13 trap numbers, and "
        "111 tile operations with complete handler and executable feature coverage; "
        f"{len(profile_names)} profile hooks are declared, invoked, and traceable"
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (AssertionError, KeyError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
