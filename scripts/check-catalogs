        require(
            len(matched_forms) == expected_family_constraints[constraint["id"]],
            f"family constraint application drift in {constraint['id']}",
        )
        for row in matched_forms:
            fields_by_name = {field["name"]: field for field in row["fields"]}
            require(
                constraint["left_field"] in fields_by_name
                and constraint["right_field"] in fields_by_name,
                f"constraint fields absent in {row['form_id']}",
            )
            require(
                fields_by_name[constraint["left_field"]]["width"]
                == fields_by_name[constraint["right_field"]]["width"],
                f"constraint field widths differ in {row['form_id']}",
            )
            family_constraint_applications.append((constraint["id"], row["form_id"]))
    require(
        scalar["family_constraint_application_count"]
