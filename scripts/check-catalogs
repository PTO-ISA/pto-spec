                "hooks": len(lane["hooks"]),
                "operations": len(lane["operation_keys"]),
            },
            f"numeric-conformance lane count drift for {lane['id']}",
        )
        lane_domain_membership.update(lane["contract_domains"])
        lane_hook_membership.update(lane["hooks"])
        lane_operation_membership.update(lane["operation_keys"])
        parallel_shards.append(lane["parallel_shard"])
    require(
        lane_domain_membership
        == Counter({domain_id: 1 for domain_id in numeric_domains_by_id})
        and lane_hook_membership
        == Counter({hook_name: 1 for hook_name in numeric_hooks_by_name})
        and lane_operation_membership
        == Counter({key: 1 for key in numeric_operations_by_key})
        and len(parallel_shards) == len(set(parallel_shards)),
        "numeric-conformance lanes do not partition domains, hooks, operations, and shards exactly once",
    )
    require(
        numeric_readiness["summary"]
        == {
            "accepted_configuration_identity_count": 4,
            "accepted_selection_framework_rule_count": 5,
            "accepted_public_type_binding_count": 16,
            "accepted_bounded_result_rule_count": 3,
            "accepted_bounded_result_tuple_count": 48,
            "public_type_identity_count": 16,
            "contract_domain_count": 20,
            "differential_result_count": 0,
            "hook_count": 30,
            "lane_count": 6,
            "operation_count": 108,
            "profile_identity_count": 0,
            "promotion_ready": False,
            "qualified_oracle_count": 0,
            "reviewed_lane_count": 0,
            "vector_manifest_count": 0,
        },
        "numeric-conformance readiness summary drift",
    )

    require(
        set(numeric_profile_decisions)
        == {
            "decision_questions",
            "domain_matrix",
            "policy",
            "profile_partition_inputs",
            "public_commit",
            "public_repository",
            "schema_version",
            "sources",
            "status",
            "summary",
            "target",
        },
        "numeric profile decision-input top-level schema drift",
    )
    require(
        numeric_profile_decisions["schema_version"] == 1
        and numeric_profile_decisions["target"] == "S5-T2-A"
        and numeric_profile_decisions["status"]
        == "decision-inputs-and-identities-closed-profile-decisions-open"
        and numeric_profile_decisions["public_repository"]
        == reconciliation["public_repository"]
        and numeric_profile_decisions["public_commit"]
        == reconciliation["public_commit"],
        "numeric profile decision-input identity or public source pin drift",
    )
    require(
        set(numeric_profile_decisions["policy"])
        == {
            "authority",
            "cpu_role",
            "independent_comparison_role",
            "no_implicit_choice",
            "profile_boundary",
        }
        and all(numeric_profile_decisions["policy"].values()),
        "numeric profile decision-input policy drift",
    )
    profile_partition_inputs = numeric_profile_decisions["profile_partition_inputs"]
    require(
        [row["id"] for row in profile_partition_inputs]
        == ["portable-numeric", "cpu-observation", "a2a3-target", "a5-target"],
        "numeric profile partition input identity drift",
    )
    for row in profile_partition_inputs:
        require(
            set(row) == {"id", "role", "status"}
            and isinstance(row["role"], str)
            and row["role"]
            and row["status"]
            in {
                "identity-accepted-rules-required",
                "identity-accepted-observation-schema-required-not-an-oracle",
            },
            f"numeric profile partition input drift for {row.get('id', '<unknown>')}",
        )

    profile_source_rows = numeric_profile_decisions["sources"]
    profile_sources_by_id = {row["id"]: row for row in profile_source_rows}
    require(
        len(profile_sources_by_id) == len(profile_source_rows) == 24,
        "numeric profile source identity or count drift",
    )
    for source_id, row in profile_sources_by_id.items():
        require(
            set(row) == {"id", "layer", "path", "role", "sha256", "url"}
            and row["layer"] in {"public-contract", "implementation-evidence"}
            and isinstance(row["path"], str)
            and row["path"]
            and isinstance(row["role"], str)
            and row["role"]
            and re.fullmatch(r"[0-9a-f]{64}", row["sha256"]) is not None
            and row["url"]
            == f"{numeric_profile_decisions['public_repository']}/blob/{numeric_profile_decisions['public_commit']}/{row['path']}",
            f"numeric profile source drift for {source_id}",
        )

    decision_rows = numeric_profile_decisions["decision_questions"]
    decisions_by_id = {row["id"]: row for row in decision_rows}
    require(
        [row["id"] for row in decision_rows]
        == [f"PD-{index:02d}" for index in range(1, 13)]
        and len(decisions_by_id) == len(decision_rows),
        "numeric profile decision question identity or ordering drift",
    )
    allowed_profile_dispositions = {
        "correctly-rounded-portable-rule",
        "implementation-defined-with-explicit-allowed-set",
        "named-profile-error-bound",
        "named-target-profile-rule",
        "portable-normative-rule",
        "unsupported-in-profile",
    }
    decision_source_membership: Counter[str] = Counter()
    decision_domain_membership: Counter[str] = Counter()
    for decision_id, row in decisions_by_id.items():
        require(
            set(row)
            == {
                "acceptance_evidence",
                "classification",
                "decision_record",
                "domains",
                "finding",
                "id",
                "permitted_dispositions",
                "selected_disposition",
                "source_ids",
                "status",
                "title",
                "unresolved_rule",
            }
            and row["classification"] in {"architecture-decision", "profile-decision"}
            and (
                (
                    decision_id == "PD-03"
                    and row["status"] == "accepted"
                    and row["selected_disposition"] == "portable-normative-rule"
                    and row["decision_record"]
                    == "docs/architecture-decisions/0047-numeric-rounding-semantics.md"
                )
                or (
                    decision_id != "PD-03"
                    and row["status"] == "decision-required"
                    and row["selected_disposition"] is None
                    and row["decision_record"] is None
                )
            )
            and all(
                isinstance(row[key], str) and row[key]
                for key in ("finding", "title", "unresolved_rule")
            )
            and row["domains"]
            and set(row["domains"]) <= set(numeric_domains_by_id)
            and row["source_ids"]
            and set(row["source_ids"]) <= set(profile_sources_by_id)
            and row["permitted_dispositions"]
            and set(row["permitted_dispositions"]) <= allowed_profile_dispositions
            and row["acceptance_evidence"]
            and len(row["acceptance_evidence"]) == len(set(row["acceptance_evidence"])),
            f"numeric profile decision question drift for {decision_id}",
        )
        decision_source_membership.update(row["source_ids"])
        decision_domain_membership.update(row["domains"])
    require(
        set(decision_source_membership) == set(profile_sources_by_id)
        and set(decision_domain_membership) == set(numeric_domains_by_id),
        "numeric profile decision questions do not cover every source and domain",
    )

    readiness_lane_by_domain = {
        domain_id: lane["id"]
        for lane in numeric_lanes
        for domain_id in lane["contract_domains"]
    }
    profile_domain_rows = numeric_profile_decisions["domain_matrix"]
    profile_domains_by_id = {row["domain"]: row for row in profile_domain_rows}
    require(
        len(profile_domains_by_id) == len(profile_domain_rows) == 20
        and set(profile_domains_by_id) == set(numeric_domains_by_id),
        "numeric profile domain decision matrix identity drift",
    )
    for domain_id, row in profile_domains_by_id.items():
        expected_operations = sorted(
            operation["key"]
            for operation in numeric_operation_rows
            if operation["numeric_contract"] == domain_id
        )
        expected_hooks = sorted(
            {
                hook_name
                for operation in numeric_operation_rows
                if operation["numeric_contract"] == domain_id
                for hook_name in operation["primary_hooks"]
                + operation["reference_helpers"]
            }
        )
        require(
            set(row)
            == {
                "decision_question_ids",
                "domain",
                "hooks",
                "lane",
                "open_numeric_dimensions",
                "operation_count",
                "operation_keys",
                "selected_profile_rule",
                "source_ids",
                "status",
            }
            and row["lane"] == readiness_lane_by_domain[domain_id]
            and row["operation_count"] == len(expected_operations)
            and row["operation_keys"] == expected_operations
            and row["hooks"] == expected_hooks
            and row["open_numeric_dimensions"]
            == numeric_domains_by_id[domain_id]["open_numeric_dimensions"]
            and row["decision_question_ids"]
            and set(row["decision_question_ids"]) <= set(decisions_by_id)
            and row["source_ids"]
            and set(row["source_ids"]) <= set(profile_sources_by_id)
            and row["status"] == "profile-rule-required"
            and row["selected_profile_rule"] is None,
            f"numeric profile domain decision drift for {domain_id}",
        )
    require(
        numeric_profile_decisions["summary"]
        == {
            "decision_question_count": 12,
            "implementation_evidence_source_count": 21,
            "numeric_domain_count": 20,
            "open_decision_question_count": 11,
            "open_numeric_domain_count": 20,
            "profile_identity_count": 4,
            "public_contract_source_count": 3,
            "selected_profile_rule_count": 0,
            "source_count": 24,
        },
        "numeric profile decision-input summary drift",
    )
    require(
        set(numeric_profile_identities)
        == {
            "active_reference_profile",
            "identities",
            "policy",
            "schema_version",
            "status",
            "summary",
        }
        and numeric_profile_identities["schema_version"] == 1
        and numeric_profile_identities["status"]
        == "identity-framework-closed-rules-open"
        and numeric_profile_identities["active_reference_profile"] == "pto-v0"
        and set(numeric_profile_identities["policy"])
        == {
            "authority",
            "bounded_variation",
            "cpu_observation",
            "support_boundary",
            "unknown_selection",
        }
        and all(numeric_profile_identities["policy"].values()),
        "numeric profile identity catalog schema or policy drift",
    )
    identity_rows = numeric_profile_identities["identities"]
    identity_rows_by_partition = {row["partition_id"]: row for row in identity_rows}
    require(
        len(identity_rows_by_partition) == len(identity_rows) == 4
        and list(identity_rows_by_partition)
        == ["portable-numeric", "cpu-observation", "a2a3-target", "a5-target"]
        and [row["id"] for row in identity_rows]
        == [
            "pto-numeric-v1",
            "pto-cpu-observation-v1",
            "pto-a2a3-numeric-v1",
            "pto-a5-numeric-v1",
        ]
        and [row["kind"] for row in identity_rows]
        == [
            "portable-numeric-contract",
            "observation-only",
            "target-numeric-profile",
            "target-numeric-profile",
        ]
        and all(
            set(row)
            == {
                "acceptance_record",
                "id",
                "kind",
                "normative_identity",
                "partition_id",
                "relation_to_pto_v0",
                "role",
                "rule_status",
                "selection",
                "source_ids",
            }
            and row["acceptance_record"]
            == "docs/architecture-decisions/0037-numeric-profile-identity-and-variation-framework.md"
            and (ROOT / row["acceptance_record"]).is_file()
            and row["source_ids"]
            and set(row["source_ids"]) <= set(profile_sources_by_id)
            and row["role"]
            and row["selection"]
            and row["relation_to_pto_v0"]
            and row["rule_status"]
            in {"decision-required", "observation-schema-required"}
            for row in identity_rows
        )
        and identity_rows[1]["normative_identity"] is False
        and all(
            row["normative_identity"] is True
            for row in identity_rows[0:1] + identity_rows[2:]
        )
        and numeric_profile_identities["summary"]
        == {
            "accepted_identity_count": 4,
            "complete_rule_count": 0,
            "identity_count": 4,
            "observation_only_count": 1,
            "portable_contract_count": 1,
            "target_profile_count": 2,
        },
        "numeric profile identity catalog membership or acceptance drift",
    )
    require(
        set(numeric_variation_ownership)
        == {
            "acceptance_record",
            "artifact_id",
            "bounded_result_subsets",
            "decision_id",
            "hooks",
            "operations",
            "ownership_routes",
            "policy",
            "schema_version",
            "selection_surfaces",
            "sources",
            "status",
            "summary",
            "support_rules",
            "target",
            "variation_points",
        }
        and numeric_variation_ownership["schema_version"] == 1
        and numeric_variation_ownership["artifact_id"]
        == "numeric-variation-point-ownership"
        and numeric_variation_ownership["target"] == "S5-T2-A4:PD-12"
        and numeric_variation_ownership["decision_id"] == "PD-12"
        and numeric_variation_ownership["status"]
        == "variation-point-discovery-and-ownership-closed-result-bounds-open"
        and numeric_variation_ownership["acceptance_record"]
        == "docs/architecture-decisions/0042-numeric-variation-point-ownership.md"
        and numeric_variation_ownership["ownership_routes"]
        == [
            "portable-rule",
            "named-profile-rule",
            "visible-selector-rule",
            "unsupported-in-profile",
        ]
        and set(numeric_variation_ownership["policy"])
        == {
            "applies_to",
            "authority",
            "cpu_observation_is_owner",
            "delegation",
            "evidence_boundary",
            "missing_rule",
            "reference_fallback_forbidden",
            "unsupported",
        }
        and all(
            numeric_variation_ownership["policy"][key]
            for key in (
                "applies_to",
                "authority",
                "delegation",
                "evidence_boundary",
                "missing_rule",
                "unsupported",
            )
        )
        and numeric_variation_ownership["policy"]["reference_fallback_forbidden"]
        is True
        and numeric_variation_ownership["policy"]["cpu_observation_is_owner"]
        is False,
        "numeric variation-point ownership identity or policy drift",
    )
    variation_points = numeric_variation_ownership["variation_points"]
    variation_points_by_id = {row["id"]: row for row in variation_points}
    expected_variation_pairs = {
        (domain_id, dimension)
        for domain_id, domain in numeric_domains_by_id.items()
        for dimension in domain["open_numeric_dimensions"]
    }
    require(
        len(variation_points_by_id) == len(variation_points) == 99
        and {(row["domain_id"], row["label"]) for row in variation_points}
        == expected_variation_pairs
        and len({row["dimension_id"] for row in variation_points}) == 41
        and all(
            set(row)
            == {
                "admissible_routes",
                "decision_owner_id",
                "decision_owner_kind",
                "decision_ownership",
                "dimension_id",
                "domain_id",
                "hook_ids",
                "id",
                "label",
                "lane",
                "missing_rule_disposition",
                "operation_keys",
                "requirement_id",
                "result_acceptance_record",
                "result_rule_id",
                "selected_route",
                "selector_dependencies",
                "status",
            }
            and row["id"]
            == f"numeric-vp/{row['domain_id']}/{row['dimension_id']}"
            and row["lane"] == profile_domains_by_id[row["domain_id"]]["lane"]
            and row["operation_keys"]
            == profile_domains_by_id[row["domain_id"]]["operation_keys"]
            and row["hook_ids"] == profile_domains_by_id[row["domain_id"]]["hooks"]
            and row["requirement_id"]
            == numeric_domains_by_id[row["domain_id"]]["requirement"]
            and row["decision_ownership"]["primary_decision_id"]
            in profile_domains_by_id[row["domain_id"]]["decision_question_ids"]
            and row["decision_ownership"]["cross_cutting_decision_ids"]
            == ["PD-01", "PD-12"]
            and row["decision_owner_kind"] == "portable-architecture"
            and row["decision_owner_id"] == "pto-numeric-v1"
            and {route["kind"] for route in row["admissible_routes"]}
            >= {"portable-rule", "named-profile-rule", "unsupported-in-profile"}
            and all(
                route.get("selector_source_class")
                in {None, "architectural-state", "decoded-operand", "bundle-state"}
                for route in row["admissible_routes"]
            )
            and "pto-cpu-observation-v1"
            not in {route.get("profile_id") for route in row["admissible_routes"]}
            and (
                (
                    row["decision_ownership"]["primary_decision_id"] == "PD-03"
                    and row["selected_route"]
                    == {"kind": "portable-rule", "profile_id": "pto-numeric-v1"}
                    and row["result_rule_id"]
                    == f"pd03-rounding/{row['domain_id']}"
                    and row["result_acceptance_record"]
                    == "docs/architecture-decisions/0047-numeric-rounding-semantics.md"
                    and row["status"] == "portable-rounding-rule-accepted"
                )
                or (
                    row["decision_ownership"]["primary_decision_id"] != "PD-03"
                    and row["selected_route"] is None
                    and row["result_rule_id"] is None
                    and row["result_acceptance_record"] is None
                    and row["status"]
                    == "ownership-inventoried-result-rule-required"
                )
            )
            and row["missing_rule_disposition"] == "reject-before-effects"
            for row in variation_points
        ),
        "numeric variation-point rows do not exactly cover domain dimensions and owner boundaries",
    )
    variation_ids_by_domain = {
        domain_id: sorted(
            row["id"] for row in variation_points if row["domain_id"] == domain_id
        )
        for domain_id in numeric_domains_by_id
    }
    ownership_operation_rows = numeric_variation_ownership["operations"]
    ownership_operations_by_key = {
        row["operation_key"]: row for row in ownership_operation_rows
    }
    unsupported_profiles_by_operation = {
        key: sorted(
            row["profile_id"]
            for row in applicability_rules
            if row["operation_key"] == key
        )
        for key in numeric_operations_by_key
    }
    require(
        len(ownership_operations_by_key) == len(ownership_operation_rows) == 108
        and set(ownership_operations_by_key) == set(numeric_operations_by_key)
        and all(
            row["domain"] == numeric_operations_by_key[key]["numeric_contract"]
            and row["hooks"]
            == numeric_operations_by_key[key]["primary_hooks"]
            + numeric_operations_by_key[key]["reference_helpers"]
            and row["variation_point_ids"]
            == variation_ids_by_domain[row["domain"]]
            and row["decision_owner_kind"] == "portable-architecture"
            and row["decision_owner_id"] == "pto-numeric-v1"
            and row["accepted_unsupported_profiles"]
            == unsupported_profiles_by_operation[key]
            and row["accepted_result_rule_count"]
            == (1 if row["domain"] in set(pd03["domains"]) else 0)
            and row["status"]
            == (
                "rounding-rule-accepted-other-result-rules-open"
                if row["domain"] in set(pd03["domains"])
                else "owner-closed-result-rules-open"
            )
            for key, row in ownership_operations_by_key.items()
        ),
        "numeric variation-point operation reachability drift",
    )
    ownership_hook_rows = numeric_variation_ownership["hooks"]
    ownership_hooks_by_name = {row["hook"]: row for row in ownership_hook_rows}
    expected_domains_by_hook = {
        hook_name: sorted(
            {
                operation["numeric_contract"]
                for operation in numeric_operations_by_key.values()
                if hook_name
                in operation["primary_hooks"] + operation["reference_helpers"]
            }
        )
        for hook_name in numeric_hooks_by_name
    }
    require(
        len(ownership_hooks_by_name) == len(ownership_hook_rows) == 30
        and set(ownership_hooks_by_name) == set(numeric_hooks_by_name)
        and Counter(row["role"] for row in ownership_hook_rows)
        == Counter(
            {
                "portable-profile-boundary": 23,
                "pto-v0-reference-helper": 5,
                "numeric-library-helper-no-decoded-operation": 2,
            }
        )
        and all(
            row["role"] == numeric_hooks_by_name[name]["role"]
            and row["requirement"] == numeric_hooks_by_name[name]["requirement"]
            and row["domains"] == expected_domains_by_hook[name]
            and row["operation_keys"]
            == numeric_hooks_by_name[name]["operation_keys"]
            and row["variation_point_ids"]
            == sorted(
                point_id
                for domain_id in expected_domains_by_hook[name]
                for point_id in variation_ids_by_domain[domain_id]
            )
            and row["decision_owner_kind"] == "portable-architecture"
            and row["decision_owner_id"] == "pto-numeric-v1"
            and (
                (
                    any(
                        variation_points_by_id[point_id]["decision_ownership"][
                            "primary_decision_id"
                        ]
                        == "PD-03"
                        for point_id in row["variation_point_ids"]
                    )
                    and row["selected_route"]
                    == {"kind": "portable-rule", "profile_id": "pto-numeric-v1"}
                    and row["result_rule_id"] == f"pd03-rounding-hook/{name}"
                    and row["status"]
                    == "rounding-rule-accepted-other-result-rules-open"
                )
                or (
                    not any(
                        variation_points_by_id[point_id]["decision_ownership"][
                            "primary_decision_id"
                        ]
                        == "PD-03"
                        for point_id in row["variation_point_ids"]
                    )
                    and row["selected_route"] is None
                    and row["result_rule_id"] is None
                    and row["status"]
                    == "ownership-inventoried-result-rule-required"
                )
            )
            for name, row in ownership_hooks_by_name.items()
        ),
        "numeric variation-point hook ownership drift",
    )
    variation_source_paths = [
        "spec/evidence/numeric-contracts.json",
        "spec/evidence/numeric-profile-decision-inputs.json",
        "spec/catalog/numeric-profile-identities.json",
        "spec/profile-hooks.json",
        "spec/evidence/numeric-rounding-selector-contract.json",
        "spec/evidence/numeric-format-namespace-contract.json",
        "spec/evidence/public-numeric-type-baseline.json",
        "spec/evidence/public-integer-conversion-contract.json",
        "spec/evidence/numeric-profile-applicability-closure.json",
        "docs/architecture-decisions/0042-numeric-variation-point-ownership.md",
    ]
    require(
        numeric_variation_ownership["support_rules"]
        == {
            "path": "spec/evidence/numeric-profile-applicability-closure.json",
            "rule_count": 6,
            "tuple_count": 150,
            "result_rule_count": 0,
            "status": "accepted-support-rejection-separate-from-numeric-results",
        }
        and numeric_variation_ownership["bounded_result_subsets"]
        == [
            {
                "path": "spec/evidence/public-integer-conversion-contract.json",
                "operation_key": "tile:TEPL:TCVT",
                "domain": "tile-convert",
                "result_rule_count": 3,
                "tuple_count": 48,
                "profile_support_rule_count": 0,
                "status": "accepted-portable-results-only-after-profile-support",
            }
        ]
        and [row["path"] for row in numeric_variation_ownership["sources"]]
        == variation_source_paths
        and all(
            row["sha256"]
            == hashlib.sha256((ROOT / row["path"]).read_bytes()).hexdigest()
            for row in numeric_variation_ownership["sources"]
        )
        and numeric_variation_ownership["summary"]
        == {
            "variation_point_count": 99,
            "unique_dimension_count": 41,
            "domain_count": 20,
            "operation_count": 108,
            "hook_count": 30,
            "primary_operation_hook_edge_count": 134,
            "reference_helper_operation_edge_count": 8,
            "portable_decision_owner_point_count": 99,
            "selected_route_count": 18,
            "accepted_result_rule_count": 18,
            "accepted_unsupported_tuple_count": 150,
            "accepted_domain_result_rule_count": 0,
            "accepted_bounded_result_subset_rule_count": 3,
            "accepted_bounded_result_subset_tuple_count": 48,
            "pd12_complete": False,
            "s5_t2_a_complete": False,
            "s5_t2_complete": False,
        },
        "numeric variation-point source or summary drift",
    )
    variation_check = subprocess.run(
        [
            str(ROOT / "scripts/generate-numeric-variation-point-ownership"),
            "--check",
        ],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
    )
    require(
        variation_check.returncode == 0,
        "numeric variation-point ownership evidence is not deterministic or is stale",
    )
    require(
        set(numeric_profile_proposals)
        == {
            "decision_proposals",
            "domain_proposals",
            "framework_acceptance",
            "format_namespace_contract",
            "identity_catalog",
            "input",
            "policy",
            "profile_applicability_contract",
            "public_integer_conversion",
            "public_type_baseline",
            "variation_point_contract",
            "profile_hooks",
            "profile_proposals",
            "promotion_residuals",
            "rounding_selector_contract",
            "scalar_flag_contract",
            "schema_version",
            "status",
            "summary",
            "target",
        }
        and numeric_profile_proposals["schema_version"] == 9
        and numeric_profile_proposals["target"] == "S5-T2-A"
        and numeric_profile_proposals["status"]
        == "proposal-complete-one-decision-accepted",
        "numeric profile proposal identity or schema drift",
    )
    require(
        numeric_profile_proposals["format_namespace_contract"]
        == {
            "path": "spec/evidence/numeric-format-namespace-contract.json",
            "sha256": hashlib.sha256(
                (
                    ROOT / "spec/evidence/numeric-format-namespace-contract.json"
                ).read_bytes()
            ).hexdigest(),
            "status": "namespace-and-carrier-inventory-closed-format-rules-open",
            "acceptance_record": "docs/architecture-decisions/0040-numeric-format-namespace-ownership.md",
            "tile_data_type_count": 25,
            "tile_storage_width_counts": {
                "4": 5,
                "8": 8,
                "16": 4,
                "32": 5,
                "64": 3,
            },
            "scalar_source_mapped_count": 2,
            "scalar_source_reserved_count": 2,
            "scalar_floating_destination_mapped_count": 15,
            "scalar_floating_destination_reserved_count": 17,
            "scalar_integer_destination_mapped_count": 15,
            "scalar_integer_destination_reserved_count": 17,
            "tma_talloc_mapped_count": 25,
            "tma_talloc_reserved_count": 39,
            "bundle_mapped_count": 25,
            "bundle_reserved_count": 7,
            "four_bit_type_count": 5,
            "open_residual_count": 8,
            "pd02_complete": False,
        },
        "numeric profile proposal format namespace checkpoint drift",
    )
    require(
        numeric_profile_proposals["public_type_baseline"]
