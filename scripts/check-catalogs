                "status",
            },
            f"scalar form schema drift for {row.get('form_id', '<unknown>')}",
        )
        require(
            row["status"] == "accepted", f"non-accepted scalar form {row['form_id']}"
        )
        require(
            row["length_bits"] in {16, 32, 48},
            f"invalid scalar width for {row['form_id']}",
        )
        require(row["encoding"], f"missing encoding for {row['form_id']}")
        for part in row["encoding"]:
            require(
                set(part) == {"index", "mask", "match", "width_bits"},
                f"encoding schema drift for {row['form_id']}",
            )
            require(
                part["index"] == 0,
                f"multi-part scalar encoding is not supported for {row['form_id']}",
            )
            mask = int(part["mask"], 16)
            match = int(part["match"], 16)
            require(
                part["width_bits"] == row["length_bits"],
                f"encoding width drift for {row['form_id']}",
            )
            require(
                mask < 1 << row["length_bits"],
                f"mask exceeds width for {row['form_id']}",
            )
            require(
                match < 1 << row["length_bits"],
                f"match exceeds width for {row['form_id']}",
            )
            require(
                match & ~mask == 0, f"match sets unmasked bits for {row['form_id']}"
            )
        field_names: set[str] = set()
        for field in row["fields"]:
            require(
                set(field) == {"name", "pieces", "signedness", "width"},
                f"field schema drift in {row['form_id']}",
            )
            require(
                field["name"] not in field_names,
                f"duplicate field {field['name']} in {row['form_id']}",
            )
            field_names.add(field["name"])
            require(
                field["signedness"] in {"encoding-defined", "signed", "unsigned"},
                f"bad signedness in {row['form_id']}",
            )
            require(1 <= field["width"] <= 48, f"bad field width in {row['form_id']}")
            if field["name"] in SCALAR_REGISTER_FIELDS:
                require(
                    field["width"] == 5,
                    f"scalar register field must be five bits in {row['form_id']}",
                )
            covered_value_bits: set[int] = set()
            covered_instruction_bits: set[int] = set()
            for piece in field["pieces"]:
                require(
                    set(piece) == {"instruction_lsb", "value_lsb", "width"},
                    f"piece schema drift in {row['form_id']}",
                )
                require(piece["width"] > 0, f"empty field piece in {row['form_id']}")
                instruction_bits = set(
                    range(
                        piece["instruction_lsb"],
                        piece["instruction_lsb"] + piece["width"],
                    )
                )
                value_bits = set(
                    range(piece["value_lsb"], piece["value_lsb"] + piece["width"])
                )
                require(
                    max(instruction_bits) < row["length_bits"],
                    f"field exceeds instruction in {row['form_id']}",
                )
                require(
                    not covered_instruction_bits & instruction_bits,
                    f"overlapping instruction pieces in {row['form_id']}",
                )
                require(
                    not covered_value_bits & value_bits,
                    f"overlapping value pieces in {row['form_id']}",
                )
                covered_instruction_bits.update(instruction_bits)
                covered_value_bits.update(value_bits)
            require(
                covered_value_bits == set(range(field["width"])),
                f"non-contiguous field value in {row['form_id']}",
            )
        for constraint in row["constraints"]:
            require(
                constraint["field"] in field_names,
                f"constraint references absent field in {row['form_id']}",
            )
            require(
                constraint["operator"] == "not-equal",
                f"unsupported constraint in {row['form_id']}",
            )
            width = next(
                field["width"]
                for field in row["fields"]
                if field["name"] == constraint["field"]
            )
            require(
                0 <= constraint["value"] < 1 << width,
                f"constraint value exceeds field in {row['form_id']}",
            )

    require(
        sum(len(row["constraints"]) for row in forms)
        == scalar["form_constraint_count"],
        "scalar form constraint total drift",
    )

    overlaps: list[tuple[dict, dict]] = []
    for left_index, left in enumerate(forms):
        left_encoding = left["encoding"][0]
        left_mask = int(left_encoding["mask"], 16)
        left_match = int(left_encoding["match"], 16)
        for right in forms[left_index + 1 :]:
            if left["length_bits"] != right["length_bits"]:
                continue
            right_encoding = right["encoding"][0]
            right_mask = int(right_encoding["mask"], 16)
            right_match = int(right_encoding["match"], 16)
            common_mask = left_mask & right_mask
            if (left_match & common_mask) != (right_match & common_mask):
                continue
            left_specificity = left_mask.bit_count()
            right_specificity = right_mask.bit_count()
            require(
                left_specificity != right_specificity,
                f"ambiguous equal-priority forms: {left['form_id']} and {right['form_id']}",
            )
            broad = left if left_specificity < right_specificity else right
            narrow = right if broad is left else left
            require(
                broad["constraints"],
                f"unreviewed scalar encoding overlap: {left['form_id']} and {right['form_id']}",
            )
            require(
                all(
                    constraint["operator"] == "not-equal"
                    and extract_field(
                        broad,
                        constraint["field"],
                        int(narrow["encoding"][0]["match"], 16),
                    )
                    == constraint["value"]
                    for constraint in broad["constraints"]
                ),
                f"broad-form constraint does not exclude narrow form: {broad['form_id']} and {narrow['form_id']}",
            )
            overlaps.append((broad, narrow))
    require(
        len(overlaps) == 3,
        "scalar overlap review set must contain exactly three constrained aliases",
    )

    command_forms = command["forms"]
    require(command["isa"] == isa_name, "command catalog has wrong ISA identity")
    require(command["surface"] == "command-and-boundary", "wrong command surface")
    require(
        command["form_count"] == len(command_forms) == 99,
        "command form count must be 99",
    )
    require(command["form_constraint_count"] == 35, "command constraint count drift")
    require(command["operand_field_count"] == 57, "command operand-field count drift")
    require(command["operand_piece_count"] == 190, "command operand-piece count drift")
    require(command["semantic_handler_count"] == 21, "command handler count drift")
    require(
        Counter(row["semantic_family"] for row in command_forms)
        == Counter({"CMD": 74, "BBD": 25}),
        "command family counts changed",
    )
    require(
        Counter(row["length_bits"] for row in command_forms)
        == Counter({16: 10, 32: 67, 48: 13, 64: 9}),
        "command length distribution changed",
    )
    command_ids = [row["form_id"] for row in command_forms]
    require(
        len(command_ids) == len(set(command_ids)), "command form IDs must be unique"
    )
    for row in command_forms:
        require(
            set(row)
            == {
                "asm",
                "constraints",
                "encoding",
                "encoding_kind",
                "fields",
                "form_id",
                "length_bits",
                "mnemonic",
                "semantic_family",
                "semantic_group",
                "semantic_handler",
                "semantic_summary",
                "status",
            },
            f"command form schema drift for {row.get('form_id', '<unknown>')}",
        )
        require(
            row["status"] == "accepted", f"non-accepted command form {row['form_id']}"
        )
        require(
            row["length_bits"] in {16, 32, 48, 64},
            f"bad command width {row['form_id']}",
        )
        require(
            row["semantic_summary"].strip(), f"missing command summary {row['form_id']}"
        )
        covered_encoding_bits: set[int] = set()
        for part in row["encoding"]:
            require(
                set(part) == {"index", "mask", "match", "width_bits"},
                f"command encoding schema drift for {row['form_id']}",
            )
            width = part["width_bits"]
            low = part["index"] * 32
            require(
                width in {16, 32, 48},
                f"bad command encoding part width {row['form_id']}",
            )
            require(
                low + width <= row["length_bits"],
                f"command encoding exceeds form {row['form_id']}",
            )
            part_bits = set(range(low, low + width))
            require(
                not covered_encoding_bits & part_bits,
                f"overlapping command encoding parts {row['form_id']}",
            )
            covered_encoding_bits.update(part_bits)
            mask = int(part["mask"], 16)
            match = int(part["match"], 16)
            require(
                mask < 1 << width and match < 1 << width,
                f"command encoding exceeds part {row['form_id']}",
            )
            require(
                match & ~mask == 0, f"command match sets unmasked bits {row['form_id']}"
            )
        field_names: set[str] = set()
        for field in row["fields"]:
            require(
                set(field) == {"name", "pieces", "signedness", "width"},
                f"command field schema drift in {row['form_id']}",
            )
            require(
                field["name"] not in field_names,
                f"duplicate command field {row['form_id']}",
            )
            field_names.add(field["name"])
            require(
                field["signedness"] in {"encoding-defined", "signed", "unsigned"},
                f"bad command signedness {row['form_id']}",
            )
            value_bits: set[int] = set()
            instruction_bits: set[int] = set()
            for piece in field["pieces"]:
                require(
                    set(piece) == {"instruction_lsb", "value_lsb", "width"},
                    f"command piece schema drift {row['form_id']}",
                )
                ibits = set(
                    range(
                        piece["instruction_lsb"],
                        piece["instruction_lsb"] + piece["width"],
                    )
                )
                vbits = set(
                    range(piece["value_lsb"], piece["value_lsb"] + piece["width"])
                )
                require(
                    ibits and max(ibits) < row["length_bits"],
                    f"command field exceeds form {row['form_id']}",
                )
                require(
                    not instruction_bits & ibits and not value_bits & vbits,
                    f"overlapping command field pieces {row['form_id']}",
                )
                instruction_bits.update(ibits)
                value_bits.update(vbits)
            require(
                value_bits
                and value_bits == set(range(min(value_bits), field["width"])),
                f"non-contiguous command value {row['form_id']}",
            )
        for constraint in row["constraints"]:
            require(
                constraint["field"] in field_names,
                f"command constraint references absent field {row['form_id']}",
            )
            width = next(
                field["width"]
                for field in row["fields"]
                if field["name"] == constraint["field"]
            )
            if constraint["operator"] == "not-equal":
                require(
                    set(constraint) == {"field", "operator", "value"}
                    and 0 <= constraint["value"] < 1 << width,
                    f"command not-equal constraint drift {row['form_id']}",
                )
            elif constraint["operator"] == "one-of":
                values = constraint["values"]
                require(
                    set(constraint) == {"field", "operator", "values"}
                    and values
                    and len(values) == len(set(values))
                    and values == sorted(values)
                    and all(0 <= value < 1 << width for value in values),
                    f"command one-of constraint drift {row['form_id']}",
                )
            else:
                require(False, f"unsupported command constraint {row['form_id']}")

    require(
        sum(len(row["constraints"]) for row in command_forms)
        == command["form_constraint_count"],
        "command form constraint total drift",
    )

    for scalar_row in forms:
        scalar_mask = int(scalar_row["encoding"][0]["mask"], 16)
        scalar_match = int(scalar_row["encoding"][0]["match"], 16)
        for command_row in command_forms:
            if scalar_row["length_bits"] != command_row["length_bits"]:
                continue
            command_mask = 0
            command_match = 0
            for part in command_row["encoding"]:
                shift = part["index"] * 32
                command_mask |= int(part["mask"], 16) << shift
                command_match |= int(part["match"], 16) << shift
            common = scalar_mask & command_mask
            require(
                scalar_match & common != command_match & common,
                f"scalar/command decode overlap: {scalar_row['form_id']} and {command_row['form_id']}",
            )

    command_by_id = {row["form_id"]: row for row in command_forms}
    reviewed_command_overlaps: set[tuple[str, str]] = set()
    for overlap in command["reviewed_encoding_overlaps"]:
        require(
            set(overlap) == {"broad_form_id", "narrow_form_id", "reason"}
            and overlap["broad_form_id"] in command_by_id
            and overlap["narrow_form_id"] in command_by_id
            and overlap["reason"].strip(),
            "command reviewed-overlap schema drift",
        )
        pair = (overlap["broad_form_id"], overlap["narrow_form_id"])
        require(
            pair not in reviewed_command_overlaps,
            "duplicate reviewed command overlap",
        )
        reviewed_command_overlaps.add(pair)

    actual_command_overlaps: set[tuple[str, str]] = set()
    for left_index, left in enumerate(command_forms):
        left_mask, left_match = aggregate_encoding(left)
        for right in command_forms[left_index + 1 :]:
            if left["length_bits"] != right["length_bits"]:
                continue
            right_mask, right_match = aggregate_encoding(right)
            common = left_mask & right_mask
            if left_match & common != right_match & common:
                continue
            require(
                left_mask.bit_count() != right_mask.bit_count(),
                f"ambiguous equal-priority command forms: {left['form_id']} and {right['form_id']}",
            )
            broad, narrow = (
                (left, right)
                if left_mask.bit_count() < right_mask.bit_count()
                else (right, left)
            )
            actual_command_overlaps.add((broad["form_id"], narrow["form_id"]))
    require(
        actual_command_overlaps == reviewed_command_overlaps,
        "command encoding overlap review set drift: "
        f"actual={sorted(actual_command_overlaps)}, "
        f"reviewed={sorted(reviewed_command_overlaps)}",
    )

    tepl_command = next(
        row for row in command_forms if row["mnemonic"] == "BSTART.TEPL"
    )
    require(
        aggregate_encoding(tepl_command) == (0x000FFFFF, 0x00019181)
        and field_shape(tepl_command)
        == {
            "DataType": (5, ((27, 0, 5),)),
            "Mode": (2, ((25, 0, 2),)),
            "Function": (5, ((20, 0, 5),)),
        },
        "PTO ISA 0.57.1 BSTART.TEPL raw contract drift",
    )

    datr = next(row for row in command_forms if row["mnemonic"] == "B.DATR")
    require(
        aggregate_encoding(datr) == (0x000C707F, 0x00001023)
        and field_shape(datr)
        == {
            "CMode": (3, ((29, 0, 3),)),
            "PadValueOrByteId": (2, ((27, 0, 2),)),
            "Sat": (1, ((26, 0, 1),)),
            "Canonicalize": (1, ((25, 0, 1),)),
            "DataType": (5, ((20, 0, 5),)),
            "RMode": (3, ((15, 0, 3),)),
            "Layout": (5, ((7, 0, 5),)),
        },
        "PTO ISA 0.57.1 B.DATR raw contract drift",
    )

    catr = next(row for row in command_forms if row["mnemonic"] == "B.CATR")
    require(
        aggregate_encoding(catr) == (0xFBF07FFF, 0x00000023)
        and field_shape(catr)
        == {
            "DR": (1, ((26, 0, 1),)),
            "trap": (1, ((19, 0, 1),)),
            "far": (1, ((18, 0, 1),)),
            "atom": (1, ((17, 0, 1),)),
            "aq": (1, ((16, 0, 1),)),
            "rl": (1, ((15, 0, 1),)),
        },
        "PTO ISA 0.57.1 B.CATR raw contract drift",
    )

    iot_forms = [row for row in command_forms if row["mnemonic"] == "B.IOT"]
    iot_contract = {
        ("SrcTile0", "L", "imm4", "S0R", "DstTile"): (0xFC00787F, 0x00005013),
        ("SrcTile1", "SrcTile0", "L", "S1R", "S0R"): (
            0x0007F3FF,
            0x00004013,
        ),
        ("SrcTile1", "SrcTile0", "L", "imm4", "S1R", "S0R", "DstTile"): (
            0x0000707F,
            0x00004013,
        ),
        ("SrcTile0", "L", "S0R"): (0xFC07FBFF, 0x00005013),
        ("L", "imm4", "DstTile"): (0xFFF07C7F, 0x00006013),
    }
    require(
        len(iot_forms) == 5
        and {
            tuple(field["name"] for field in row["fields"]): aggregate_encoding(
                row
            )
            for row in iot_forms
        }
        == iot_contract,
        "PTO ISA 0.57.1 B.IOT five-form raw contract drift",
    )

    operations = tile["operations"]
    require(
        set(tile)
        == {
            "deleted_names",
            "isa",
            "operation_count",
            "operations",
            "rejected_review_only_codes",
            "rejected_names",
            "reserved",
            "schema_version",
        },
        "tile catalog top-level schema drift",
    )
    require(tile["schema_version"] == 3, "unsupported tile catalog schema")
    require(tile["isa"] == isa_name, "tile catalog has wrong ISA identity")
    require(
        tile["operation_count"] == len(operations) == 120,
        "tile operation count must be 120",
    )
    require(
        len({row["name"] for row in operations}) == 120,
        "tile operation names must be unique",
    )
    require(
        Counter(row["family"] for row in operations)
        == Counter({"TEPL": 98, "TMA": 9, "CUBE": 13}),
        "tile family counts changed",
    )
    require(
        len(tile["deleted_names"]) == len(set(tile["deleted_names"])) == 9
        and len(tile["rejected_names"]) == len(set(tile["rejected_names"]))
        and set(tile["deleted_names"]).isdisjoint(tile["rejected_names"])
        and (set(tile["deleted_names"]) | set(tile["rejected_names"])).isdisjoint(
            row["name"] for row in operations
        ),
        "deleted/rejected tile identity partition drift",
    )
    tma_rows = [row for row in operations if row["family"] == "TMA"]
    expected_tma_selectors = {str(row["function"]): row["name"] for row in tma_rows}
    require(
        set(tma_totality)
        == {
            "architecture_contract",
            "covered_selectors",
            "decoded_selector_case_count",
            "decoded_selector_test",
            "evidence_files",
            "requirement_ids",
            "scenario_count",
            "schema_version",
            "status",
            "target",
            "test_entrypoint",
            "test_scenarios",
            "validation",
        }
        and tma_totality["schema_version"] == 1
        and tma_totality["target"] == "S4-T9"
        and tma_totality["status"] == "closed"
        and tma_totality["covered_selectors"] == expected_tma_selectors
        and tma_totality["decoded_selector_case_count"] == len(tma_rows) == 9
        and tma_totality["scenario_count"] == len(tma_totality["test_scenarios"]) == 12,
        "TMA totality inventory or scenario evidence drift",
    )
    require(
        set(tma_totality["architecture_contract"])
        == {
            "cas",
            "events",
            "four_bit_packing",
            "indexed_operations",
            "masked_gather",
            "preflight",
        }
        and tma_totality["requirement_ids"]
        == [
            "PTO-REQ-TMA-001",
            "PTO-REQ-MEMORY-COMPLETION-001",
            "PTO-REQ-MEMORY-TSO-001",
        ],
        "TMA architecture or requirement contract drift",
    )
    tma_test_body = (ROOT / "tests/asl/tma-totality-tests.asl").read_text(
        encoding="utf-8"
    )
    require(
        "func TestTmaDecodedSelectorClosure()" in tma_test_body
        and "func TestTmaTotality()" in tma_test_body
        and tma_test_body.count("TileDecode_TMA, Zeros{12} +") == 8
        and "TileDecode_TMA, Zeros{12}, operands" in tma_test_body,
        "TMA decoded selector matrix is not executable or complete",
    )
    cube_rows = [row for row in operations if row["family"] == "CUBE"]
    expected_cube_functions = {str(row["function"]): row["name"] for row in cube_rows}
    require(
        set(cube_totality)
        == {
            "accepted_selector_count",
            "alias_case_count",
            "alias_test",
            "architecture_contract",
            "covered_functions",
            "decoded_selector_test",
            "evidence_files",
            "numeric_conformance_target",
            "preflight_case_count",
            "preflight_test",
            "reserved_functions",
            "reserved_selector_count",
            "reserved_selector_test",
            "requirement_ids",
            "schema_version",
            "status",
            "target",
            "type_identity_count",
            "type_layout_test",
        }
        and cube_totality["schema_version"] == 1
        and cube_totality["target"] == "S4-T10"
        and cube_totality["status"] == "closed"
        and cube_totality["accepted_selector_count"] == len(cube_rows) == 13
        and cube_totality["reserved_selector_count"] == 19
        and cube_totality["reserved_functions"]
        == [3, 7, 9, 10, 11, 12, 13, 14, 15, 19, 23, 24, 25, 26, 27, 28, 29, 30, 31]
        and cube_totality["covered_functions"] == expected_cube_functions
        and cube_totality["type_identity_count"] == 25
        and cube_totality["alias_case_count"] == 2
        and cube_totality["preflight_case_count"] == 3
        and cube_totality["numeric_conformance_target"] == "S5-T2",
        "CUBE totality inventory or case evidence drift",
    )
    require(
        set(cube_totality["architecture_contract"])
        == {
            "aliases",
            "data_types",
            "layouts",
            "locations",
            "preflight",
            "source_definedness",
        }
        and cube_totality["requirement_ids"]
        == [
            "PTO-REQ-CUBE-001",
            "PTO-REQ-TILE-LEGALITY-001",
            "PTO-REQ-PROFILE-001",
        ],
        "CUBE architecture or requirement contract drift",
    )
    comparison_rows = executable_model_comparison["rows"]
    comparison_stable_ids = [row["stable_id"] for row in comparison_rows]
    expected_comparison_stable_ids = {
        *(row["form_id"] for row in forms),
        *(row["form_id"] for row in command_forms),
        *(
            f"{row['family'].lower()}:0x{int(row.get('selector', row.get('function')), 0) if isinstance(row.get('selector', row.get('function')), str) else row.get('selector', row.get('function')):03x}:{row['name']}"
            for row in operations
        ),
    }
    comparison_classifications = Counter(
        row["classification"] for row in comparison_rows
    )
    comparison_surfaces = Counter(row["surface"] for row in comparison_rows)
    comparison_requirement_ids = {row["id"] for row in requirements}
    require(
        set(executable_model_comparison)
        == {
            "authority",
            "closure_judgment",
            "model_limits",
            "rows",
            "schema",
            "scope",
            "snapshot",
            "status",
            "summary",
            "target",
        }
        and executable_model_comparison["schema"]
        == "pto.executable-model-comparison.v1"
        and executable_model_comparison["target"] == "S5-T3"
        and executable_model_comparison["status"]
        == "comparison-matrix-closed-clean-gates-passed:S5-T3"
        and len(comparison_rows) == len(comparison_stable_ids) == 693
        and len(set(comparison_stable_ids)) == 693
        and set(comparison_stable_ids) == expected_comparison_stable_ids
        and comparison_classifications
        == Counter(
            {
                "comparable-match": 557,
                "divergence": 96,
                "intentional-extension": 1,
                "non-comparable": 39,
            }
        )
        and comparison_surfaces
        == Counter({"scalar": 474, "command": 99, "direct-tile": 120})
        and all(
            row["requirements"]
            and set(row["requirements"]) <= comparison_requirement_ids
            and row["evidence"]
            and row["pto_disposition"]
            for row in comparison_rows
        ),
        "executable-model comparison inventory or disposition matrix drift",
    )
    comparison_snapshot = executable_model_comparison["snapshot"]
    comparison_gates = {row["id"]: row for row in comparison_snapshot["gates"]}
    comparison_toolchain_checks = {
        row["id"]: row for row in comparison_snapshot["required_toolchain_checks"]
    }
    require(
        comparison_snapshot["worktree_clean"] is True
        and re.fullmatch(r"[0-9a-f]{64}", comparison_snapshot["revision_sha256"])
        is not None
        and len(comparison_snapshot["content_hashes"]) == 5
        and all(
            re.fullmatch(r"[0-9a-f]{64}", value) is not None
            for value in comparison_snapshot["content_hashes"].values()
        )
        and set(comparison_gates)
        == {
            "canonical-encoding-check",
            "decode-regeneration-check",
            "documentation-check",
            "format-regeneration",
            "format-validation",
            "pto-operation-manifest-check",
            "semantic-coverage-check",
            "semantic-status-check",
        }
        and all(row["result"] == "pass" for row in comparison_gates.values())
        and set(comparison_toolchain_checks) == {"sail-parser-c-backend-check"}
        and all(row["result"] == "pass" for row in comparison_toolchain_checks.values())
        and executable_model_comparison["closure_judgment"]["can_close_s5_t3"] is True
        and executable_model_comparison["closure_judgment"]["remaining_blockers"] == []
        and {row["id"] for row in executable_model_comparison["model_limits"]}
        == {
            "accepted-0.57.1-abi-break",
            "bundle-bridge-operand-boundary",
            "no-independent-tile-payload-execution",
            "predicate-p0-p7-difference",
            "reg5-flat-model-mismatch",
            "tepl-selector-boundary",
            "tma-and-cube-manifest-boundary",
        },
        "executable-model comparison snapshot, gate, or model-limit drift",
    )
    cube_test_body = (ROOT / "tests/asl/cube-totality-tests.asl").read_text(
        encoding="utf-8"
    )
    require(
        "func TestCubeDecodedSelectorMatrix()" in cube_test_body
        and "func TestCubeRawCarrierTypeAndPlacementMatrix()" in cube_test_body
        and "func TestCubeAliasMatrix()" in cube_test_body
        and "func TestCubeCompositePreflight()" in cube_test_body
        and "func TestCubeTotality()" in cube_test_body,
        "CUBE totality test matrix is not executable or complete",
    )
    for family in ("TEPL", "TMA", "CUBE"):
        rows = [row for row in operations if row["family"] == family]
        key = "selector" if family == "TEPL" else "function"
        values = [row[key] for row in rows]
        require(len(values) == len(set(values)), f"duplicate {family} {key}")
        for row in rows:
            expected_keys = {
                "command_mnemonic",
                "contract_status",
                "datr_contract",
                "disposition",
                "effect_contract",
                "family",
                "fault_contract",
                "legality_handler",
                "name",
                key,
                "restart_contract",
                "semantic_handler",
                "state_effects",
                "operands",
                "arguments",
            }
            if family == "TEPL":
                expected_keys.update({"mode", "function"})
            if row.get("result") is not None:
                expected_keys.add("result")
            if family == "CUBE":
                expected_keys.add("acc_effect")
            require(
                set(row) == expected_keys,
                f"tile operation schema drift for {row['name']}",
            )
            require(
                row["disposition"] == "accepted-direct-operation",
                f"invalid tile disposition for {row['name']}",
            )
            value = int(row[key], 0) if isinstance(row[key], str) else row[key]
            width = 7 if family == "TEPL" else 5
            require(
                0 <= value < 1 << width,
                f"tile selector width drift for {row['name']}",
            )
            if family == "TEPL":
                require(
                    isinstance(row["mode"], int)
                    and 0 <= row["mode"] < 4
                    and isinstance(row["function"], int)
                    and 0 <= row["function"] < 32
                    and value == (row["mode"] << 5) | row["function"],
                    f"TEPL mode/function/selector formula drift for {row['name']}",
                )
            require(
                row["contract_status"] == "reviewed-complete"
                and row["legality_handler"]
                == f"TileOperandsLegal_{row['semantic_handler']}"
                and row["effect_contract"] == row["semantic_handler"]
                and row["fault_contract"] == "ExecuteTileInstruction"
                and row["restart_contract"]
                == "CompleteBundleAtWithAcceptedApplicabilityRules"
                and isinstance(row["state_effects"], list)
                and row["state_effects"]
                and all(
                    isinstance(effect, str) and effect
                    for effect in row["state_effects"]
                ),
                f"incomplete reviewed semantic contract for {row['name']}",
            )
            datr_contract = row["datr_contract"]
            require(
                set(datr_contract) == {"allowed_nonzero_fields", "pad_union"}
                and datr_contract["pad_union"]
                in {"pad-value", "histogram-byte-id", "must-zero"}
                and datr_contract["allowed_nonzero_fields"]
                == [
                    field
                    for field in TILE_DATR_FIELD_ORDER
                    if row["name"] in TILE_DATR_APPLICABILITY[field]
                ],
                f"B.DATR applicability contract drift for {row['name']}",
            )
            expected_pad_union = next(
                (
                    union
                    for union, names in TILE_DATR_PAD_UNIONS.items()
                    if row["name"] in names
                ),
                "must-zero",
            )
            require(
                datr_contract["pad_union"] == expected_pad_union
                and (
                    "PadValueOrByteId"
                    in datr_contract["allowed_nonzero_fields"]
                )
                == (expected_pad_union != "must-zero"),
                f"B.DATR PadValue/ByteId union drift for {row['name']}",
            )
            expected_state_effects = [
                f"operand:{operand['field']}:{operand['role']}"
                for operand in row["operands"]
            ]
            if family == "CUBE":
                expected_state_effects.append(
                    f"implicit:ACC:{row['acc_effect']}"
                )
            require(
                row["state_effects"] == expected_state_effects,
                f"machine-readable state-effect contract drift for {row['name']}",
            )
            require(
                isinstance(row["command_mnemonic"], str)
                and row["command_mnemonic"].startswith("BSTART."),
                f"invalid tile command mnemonic for {row['name']}",
            )
            if family == "CUBE":
                require(
                    row["acc_effect"]
                    in {
                        "write-initialize",
                        "read-write",
                        "read-release-on-commit",
                    },
                    f"invalid ACC effect for {row['name']}",
                )
            matching_handlers = [
                handler
                for handler, operation_names in TILE_SEMANTIC_GROUPS.items()
                if row["name"] in operation_names
            ]
            require(
                matching_handlers == [row["semantic_handler"]],
                f"tile handler binding drift for {row['name']}",
            )
            operand_fields = [operand["field"] for operand in row["operands"]]
            require(
                len(operand_fields) == len(set(operand_fields)),
                f"duplicate tile operand field for {row['name']}",
            )
            for operand in row["operands"]:
                require(
                    set(operand) == {"field", "role"},
                    f"tile operand schema drift for {row['name']}",
                )
                require(
                    operand["field"] in TILE_OPERAND_FIELDS,
                    f"unknown tile operand field for {row['name']}: {operand['field']}",
                )
                require(
                    isinstance(operand["role"], str) and operand["role"],
                    f"empty tile operand role for {row['name']}",
                )
            referenced_operands: list[str] = []
            for argument in row["arguments"]:
                require(
                    set(argument) in ({"operand"}, {"constant"}, {"runtime"}),
                    f"tile argument schema drift for {row['name']}",
                )
                if "operand" in argument:
                    require(
                        argument["operand"] in operand_fields,
                        f"undeclared tile operand argument for {row['name']}: {argument['operand']}",
                    )
                    referenced_operands.append(argument["operand"])
                elif "constant" in argument:
                    require(
                        TILE_BINDING_CONSTANT.fullmatch(argument["constant"])
                        is not None,
                        f"invalid tile binding constant for {row['name']}: {argument['constant']}",
                    )
                else:
                    require(
                        row["name"] == "MGATHER_MASK"
                        and argument["runtime"] == "CurrentBundlePadValue",
                        f"invalid tile runtime binding for {row['name']}",
                    )
            require(
                set(referenced_operands) == set(operand_fields),
                f"unused tile operand metadata for {row['name']}",
            )
            require(
                "result" not in row,
                f"direct tile operation returns a scalar for {row['name']}",
            )

    tepl_by_name = {
        row["name"]: (
            int(row["selector"], 0)
            if isinstance(row["selector"], str)
            else row["selector"]
        )
        for row in operations
        if row["family"] == "TEPL"
    }
    require(
        tepl_by_name == TEPL_V0571_SELECTORS,
        "PTO ISA 0.57.1 TEPL map drift",
    )
    for field, expected_names in TILE_DATR_APPLICABILITY.items():
        require(
            {
                row["name"]
                for row in operations
                if field in row["datr_contract"]["allowed_nonzero_fields"]
            }
            == expected_names,
            f"exact B.DATR {field} operation set drift",
        )
    for union, expected_names in TILE_DATR_PAD_UNIONS.items():
        require(
            {
                row["name"]
                for row in operations
                if row["datr_contract"]["pad_union"] == union
            }
            == expected_names,
            f"exact B.DATR {union} operation set drift",
        )
    require(
        {
            row["command_mnemonic"]
            for row in operations
            if row["family"] == "TEPL"
        }
        == {"BSTART.TEPL"},
        "TEPL command mapping drift",
    )
    named_tile_commands = [
        row["command_mnemonic"]
        for row in operations
        if row["family"] != "TEPL"
    ]
    require(
        len(named_tile_commands) == len(set(named_tile_commands)) == 22,
        "TMA/CUBE command mappings must be unique",
    )
    command_mnemonics = Counter(row["mnemonic"] for row in command_forms)
    require(
        all(
            command_mnemonics[mnemonic] == 1
            for mnemonic in {"BSTART.TEPL", *named_tile_commands}
        ),
        "tile command mapping does not identify one command form",
    )
    require(
        not (
            {"B.ARG", "BSTART.CUBE", "BSTART.FIXP"}
            & set(command_mnemonics)
        ),
        "legacy tile descriptor or generic direct-operation command remains active",
    )
    for operation in operations:
        if operation["family"] == "TEPL":
            continue
        command_form = next(
            row
            for row in command_forms
            if row["mnemonic"] == operation["command_mnemonic"]
        )
        base = 0x00011181 if operation["family"] == "TMA" else 0x00031181
        require(
            aggregate_encoding(command_form)
            == (0x07FFFFFF, (operation["function"] << 20) | base)
            and field_shape(command_form)
            == {"DataType": (5, ((27, 0, 5),))},
            f"named {operation['family']} command raw contract drift: "
            f"{operation['command_mnemonic']}",
        )

    cube_rows_by_name = {
        row["name"]: row for row in operations if row["family"] == "CUBE"
    }
    require(
        all(
            not any(
                operand["field"] == "destination0"
                for operand in row["operands"]
            )
            for name, row in cube_rows_by_name.items()
            if name != "ACCCVT"
        ),
        "CUBE must model ACC implicitly rather than as destination0",
    )
    require(
        [
            operand["field"]
            for operand in cube_rows_by_name["ACCCVT"]["operands"]
        ]
        == ["destination0", "numeric_control"]
        and cube_rows_by_name["ACCCVT"]["arguments"]
        == [{"operand": "destination0"}, {"operand": "numeric_control"}],
        "ACCCVT must publish one Tile from implicit ACC",
    )
    numeric_control_operations = {
        row["name"]
        for row in operations
        if any(operand["field"] == "numeric_control" for operand in row["operands"])
    }
    require(
        numeric_control_operations == {"ACCCVT", "TCVT", "TQUANT", "TDEQUANT"}
        and all(
            row["arguments"][-1] == {"operand": "numeric_control"}
            for row in operations
            if row["name"] in numeric_control_operations
        ),
        "rounding and saturation control must bind exactly four numeric operations",
    )
    sort_row = next(row for row in operations if row["name"] == "TSORT")
    require(
        [operand["field"] for operand in sort_row["operands"]]
        == ["destination0", "destination1", "source0", "flag0"]
        and sort_row["arguments"][:2]
        == [{"operand": "destination0"}, {"operand": "destination1"}],
        "TSORT value/index destination contract drift",
    )
    gather_mask_row = next(
        row for row in operations if row["name"] == "MGATHER_MASK"
    )
    require(
        gather_mask_row["arguments"][-1]
        == {"runtime": "CurrentBundlePadValue"},
        "masked gather must consume the current B.DATR pad value",
    )

    tepl_accepted = {
        int(row["selector"], 0) if isinstance(row["selector"], str) else row["selector"]
        for row in operations
        if row["family"] == "TEPL"
    }
    tepl_review = {
        int(value, 0) if isinstance(value, str) else value
        for value in tile["rejected_review_only_codes"]["TEPL"]
    }
    tepl_reserved = expand_number_entries(tile["reserved"]["tepl_selector_ranges"])
    deleted_tepl = {
        "TFMA": 0x005,
        "TFMOD": 0x018,
        "TFMODS": 0x019,
        "TADDC": 0x01C,
        "TSUBC": 0x025,
        "TADDSC": 0x02E,
        "TSUBSC": 0x038,
        "TLRELU": 0x039,
        "TRANDOM": 0x069,
    }
    require(
        set(deleted_tepl) == set(tile["deleted_names"])
        and set(tile["rejected_names"]).isdisjoint(deleted_tepl)
        and set(deleted_tepl).isdisjoint(
            row["name"] for row in operations
        )
        and set(deleted_tepl.values()) <= tepl_reserved,
        "deleted PTO ISA 0.57.1 TEPL identities must remain absent and reserved",
    )
    require(
        tepl_review == set()
        and tile["rejected_review_only_codes"]["TMA"] == []
        and tile["rejected_review_only_codes"]["CUBE"] == [],
        "PTO ISA 0.57.1 has no review-only executable tile allocation",
    )
    require(
        not (
            tepl_accepted & tepl_review
            or tepl_accepted & tepl_reserved
            or tepl_review & tepl_reserved
        ),
        "TEPL selector partitions overlap",
    )
    require(
        tepl_accepted | tepl_review | tepl_reserved == set(range(1 << 7)),
        "TEPL selector partition is incomplete",
    )
    tepl_rows = [row for row in operations if row["family"] == "TEPL"]
    require(
        set(tepl_totality)
        == {
            "accepted_selector_count",
            "compact_reserved_selector_test_count",
            "compact_selector_test_range",
            "evidence",
            "family",
            "handler_counts",
            "known_open_items",
            "policy",
            "profile",
            "reserved_selector_count",
            "schema",
            "selector_domain_size",
            "selector_scope",
            "stage4_contract",
            "stage5_deferred_contract",
            "target",
        }
        and tepl_totality["schema"] == "pto.tepl-totality.v1"
        and tepl_totality["target"] == "S4-T8"
        and tepl_totality["family"] == "TEPL"
        and tepl_totality["selector_domain_size"] == 1 << 7
        and tepl_totality["accepted_selector_count"] == len(tepl_rows) == 98
        and tepl_totality["reserved_selector_count"] == (1 << 7) - len(tepl_rows)
        and tepl_totality["compact_selector_test_range"] == "0..127"
        and tepl_totality["compact_reserved_selector_test_count"] == 30
        and tepl_totality["profile"] == "pto-v0"
        and tepl_totality["selector_scope"]["included"]
        == [row["name"] for row in tepl_rows]
        and tepl_totality["handler_counts"]
        == dict(sorted(Counter(row["semantic_handler"] for row in tepl_rows).items())),
        "TEPL totality inventory, selector partition, or handler counts drift",
    )
    require(
        set(tepl_totality["policy"])
        == {
            "data_types",
            "histogram",
            "indices",
            "layouts",
            "locations",
            "multi_destination_aliases",
            "partial_regions",
            "sort_merge",
            "source_aliases",
            "tprelu",
        }
        and tepl_totality["known_open_items"]
        == [
            "S5-T2 numeric conformance for profile-owned arithmetic, conversion, rounding, saturation, and exceptional-value behavior"
        ],
        "TEPL policy or deferred-conformance contract drift",
    )
    tepl_test_body = (ROOT / "tests/asl/tepl-totality-tests.asl").read_text(
        encoding="utf-8"
    )
    tepl_entrypoints = tepl_totality["evidence"]["asl_entrypoints"]
    require(
        set(tepl_totality["evidence"])
        == {"adr", "asl_entrypoints", "full_reserved_selector_test", "test_file"}
        and tepl_totality["evidence"]["test_file"]
        == "tests/asl/tepl-totality-tests.asl"
        and tepl_totality["evidence"]["adr"]
        == "docs/architecture-decisions/0035-tepl-raw-carrier-totality.md"
        and tepl_totality["evidence"]["full_reserved_selector_test"]
        == "scripts/generate-asl-decoders:ValidateCanonicalRejectedTileSelectors"
        and len(tepl_entrypoints) == len(set(tepl_entrypoints)) == 8
        and all(f"func {name}()" in tepl_test_body for name in tepl_entrypoints)
        and "TestTeplTotality();"
        in (ROOT / "tests/asl/main.asl").read_text(encoding="utf-8")
        and "TestTeplTotality();"
        in (ROOT / "tests/asl/shards/tepl-totality.asl").read_text(encoding="utf-8"),
        "TEPL totality evidence is not executable or integrated",
    )

    tma_accepted = {row["function"] for row in operations if row["family"] == "TMA"}
    tma_review = set(tile["rejected_review_only_codes"]["TMA"])
    tma_reserved = expand_number_entries(tile["reserved"]["tma_functions"])
    require(
        tma_accepted | tma_review | tma_reserved == set(range(32)),
        "TMA function partition is incomplete",
    )
    require(
        not (
            tma_accepted & tma_review
            or tma_accepted & tma_reserved
            or tma_review & tma_reserved
        ),
        "TMA function partitions overlap",
    )

    cube_accepted = {row["function"] for row in operations if row["family"] == "CUBE"}
    cube_review = set(tile["rejected_review_only_codes"]["CUBE"])
    cube_unassigned = expand_number_entries(
        tile["reserved"]["cube_functions_without_named_alias"]
    )
    require(
        cube_accepted | cube_review | cube_unassigned == set(range(32)),
        "CUBE function partition is incomplete",
    )
    require(
        not (
            cube_accepted & cube_review
            or cube_accepted & cube_unassigned
            or cube_review & cube_unassigned
        ),
        "CUBE function partitions overlap",
    )

    require(
        set(system_registers)
        == {
            "address_bits",
            "behavior_classes",
            "canonical_address_bits",
            "isa",
            "register_definition_count",
            "registers",
            "schema_version",
            "trap_count",
            "trap_numbers",
        },
        "system-register catalog top-level schema drift",
    )
    require(
        system_registers["schema_version"] == 1,
        "unsupported system-register catalog schema",
    )
    require(
        system_registers["isa"] == isa_name,
        "system-register catalog has wrong ISA identity",
    )
    require(
        system_registers["address_bits"] == 24,
        "system-register address width must be 24",
    )
    require(
        system_registers["canonical_address_bits"] == 16,
        "canonical system-register address width must be 16",
    )
    register_rows = system_registers["registers"]
    require(
        system_registers["register_definition_count"] == len(register_rows) == 72,
        "system-register definition count must be 72",
    )
    register_names: set[str] = set()
    register_access: dict[str, str] = {}
    canonical_registers: set[int] = set()
    for row in register_rows:
        require(
            row["name"] not in register_names,
            f"duplicate system-register name {row['name']}",
        )
        register_names.add(row["name"])
        register_access[row["name"]] = row["access"]
        require(
            row["access"] in {"RO", "WO", "RW"}, f"invalid access for {row['name']}"
        )
        require(
            row["scope"] in {"base", "context-family"},
            f"invalid scope for {row['name']}",
        )
        if row["scope"] == "base":
            require(
                set(row) == {"access", "address", "name", "scope"},
                f"base register schema drift for {row['name']}",
            )
            address = int(row["address"], 0)
            require(
                0 <= address < 1 << 16,
                f"base register exceeds canonical address width: {row['name']}",
            )
        else:
            require(
                set(row)
                in (
                    {"access", "low_index", "name", "scope"},
                    {"access", "fixed_context", "low_index", "name", "scope"},
                ),
                f"context register schema drift for {row['name']}",
            )
            low_index = int(row["low_index"], 0)
            require(
                0 <= low_index < 1 << 12,
                f"context register low index exceeds 12 bits: {row['name']}",
            )
            context = row.get("fixed_context", 0)
            require(
                0 <= context < 16, f"fixed context exceeds four bits: {row['name']}"
            )
            address = context << 12 | low_index
        require(
            address not in canonical_registers,
            f"duplicate canonical system-register address for {row['name']}",
        )
        canonical_registers.add(address)

    behavior_rows = system_registers["behavior_classes"]
    require(behavior_rows, "system-register behavior classes must not be empty")
    behavior_ids: set[str] = set()
    behavior_registers: set[str] = set()
    allowed_resets = {
        "zero",
        "one",
        "pto-model-max-tile-capacity-bytes",
        "external-and-timer-enabled",
    }
    allowed_reads = {
        "stored-value",
        "architectural-time",
        "profile-value",
        "packed-trap-status",
        "trap-argument-zero",
        "refresh-timer-then-pending-bitmap",
        "refresh-timer-then-lowest-pending-id",
        "reject-write-only",
        "saved-context-value",
    }
    allowed_writes = {
        "store-value",
        "reject-read-only",
        "unpack-trap-status",
        "store-trap-argument-zero",
        "acknowledge-interrupt-id",
        "store-saved-context-value",
    }
    for behavior in behavior_rows:
        require(
            set(behavior)
            == {
                "id",
                "profile_status",
                "read",
                "registers",
                "reset",
                "side_effects",
                "write",
            },
            f"system-register behavior schema drift for {behavior.get('id', '<unknown>')}",
        )
        behavior_id = behavior["id"]
        require(
            behavior_id not in behavior_ids, f"duplicate behavior class {behavior_id}"
        )
        behavior_ids.add(behavior_id)
        require(
            behavior["profile_status"]
            in {"architectural-active", "profile-constant", "pto-v0-storage-only"},
            f"invalid profile status for behavior class {behavior_id}",
        )
        require(behavior["reset"] in allowed_resets, f"invalid reset for {behavior_id}")
        require(
            behavior["read"] in allowed_reads,
            f"invalid read behavior for {behavior_id}",
        )
        require(
            behavior["write"] in allowed_writes,
            f"invalid write behavior for {behavior_id}",
        )
        require(
            isinstance(behavior["side_effects"], list)
            and len(behavior["side_effects"]) == len(set(behavior["side_effects"]))
            and all(
                isinstance(effect, str) and effect
                for effect in behavior["side_effects"]
            ),
            f"invalid side-effect list for behavior class {behavior_id}",
        )
        require(behavior["registers"], f"empty behavior class {behavior_id}")
        for name in behavior["registers"]:
            require(
                name in register_names,
                f"unknown register {name} in behavior class {behavior_id}",
            )
            require(
                name not in behavior_registers,
                f"register {name} appears in multiple behavior classes",
            )
            behavior_registers.add(name)
            access = register_access[name]
            require(
                (access == "RO") == (behavior["write"] == "reject-read-only"),
                f"read-only access and write behavior disagree for {name}",
            )
            require(
                (access == "WO") == (behavior["read"] == "reject-write-only"),
                f"write-only access and read behavior disagree for {name}",
            )
    require(
        behavior_registers == register_names,
        "system-register behavior classes must cover every register exactly once",
    )
    behaviors_by_id = {row["id"]: row for row in behavior_rows}
    require(
        len(behavior_rows) == len(behaviors_by_id) == 25,
        "system-register behavior inventory must contain 25 unique classes",
    )
    require(
        behaviors_by_id["saved-execution-context"]["registers"]
        == [
            "EBARG0_ACRn",
            "EBARG_BPC_CUR_ACRn",
            "EBARG_BPC_TGT_ACRn",
            "EBARG_TPC_ACRn",
            "EBARG_LRA_ACRn",
            "EBARG_TQ0_ACRn",
            "EBARG_TQ1_ACRn",
            "EBARG_TQ2_ACRn",
            "EBARG_TQ3_ACRn",
            "EBARG_UQ0_ACRn",
            "EBARG_UQ1_ACRn",
            "EBARG_UQ2_ACRn",
            "EBARG_UQ3_ACRn",
        ]
        and behaviors_by_id["saved-loop-context-storage"]["registers"]
        == ["EBARG_LB_ACRn", "EBARG_LC_ACRn"]
        and behaviors_by_id["extended-context-storage"]["registers"]
        == [
            "EBARG_EXTCTX_PTR_ACRn",
            "EBARG_EXTCTX_META_ACRn",
            "EBARG_TPLFLAGS_ACRn",
        ],
        "EBARG recovery-active and storage-only behavior partition drift",
    )

    trap_rows = system_registers["trap_numbers"]
    require(
        system_registers["trap_count"] == len(trap_rows) == 13,
        "trap-number count must be 13",
    )
    require(len({row["name"] for row in trap_rows}) == 13, "trap names must be unique")
    require(
        len({row["number"] for row in trap_rows}) == 13, "trap numbers must be unique"
    )
    for row in trap_rows:
        require(
            set(row)
            == {
                "argument",
                "cause",
                "name",
                "number",
                "producers",
                "pto_v0_status",
                "restart",
            },
            f"trap schema drift for {row.get('name', '<unknown>')}",
        )
        require(
            0 <= row["number"] < 64, f"trap number exceeds six bits for {row['name']}"
        )
        require(
            row["pto_v0_status"] in {"production-active", "envelope-only-no-trigger"},
            f"invalid PTO v0 trap status for {row['name']}",
        )
        require(
            isinstance(row["producers"], list)
            and row["producers"]
            and len(row["producers"]) == len(set(row["producers"]))
            and all(
                isinstance(producer, str) and producer for producer in row["producers"]
            ),
            f"invalid producer list for trap {row['name']}",
        )
        require(
            isinstance(row["cause"], str) and row["cause"],
            f"missing cause contract for trap {row['name']}",
        )
        require(
            isinstance(row["argument"], str) and row["argument"],
            f"missing argument contract for trap {row['name']}",
        )
        require(
            row["restart"]
            in {"saved-source-context", "saved-context-resume-next-instruction"},
            f"invalid restart contract for trap {row['name']}",
        )

    semantic_names: set[str] = set()
    asl_body = "\n".join(
        path.read_text(encoding="utf-8") for path in (ROOT / "asl").rglob("*.asl")
    )
    envelope_only_traps = {
        row["number"]
        for row in trap_rows
        if row["pto_v0_status"] == "envelope-only-no-trigger"
    }
    require(
        envelope_only_traps == {33, 49, 51},
        "PTO v0 envelope-only trap disposition drift",
    )
    for row in trap_rows:
        for producer in row["producers"]:
            fault_match = re.fullmatch(r"SetFault\((Fault_[A-Za-z]+)\)", producer)
            if fault_match is not None:
                fault = fault_match.group(1)
                suffix = "" if row["number"] == 0 else rf"\s*\+\s*{row['number']}"
                require(
                    re.search(
                        rf"when\s+{fault}\s*=>\s*_ACRTrapNumber\[\[ring\]\]\s*=\s*Zeros\{{6\}}{suffix}\s*;",
                        asl_body,
                    )
                    is not None,
                    f"trap producer mapping drift for {row['name']}: {producer}",
                )
            else:
                require(
                    re.search(rf"\bfunc\s+{re.escape(producer)}\b", asl_body)
                    is not None,
                    f"trap producer function is missing for {row['name']}: {producer}",
                )
    concurrency_body = (ROOT / "asl" / "concurrency.asl").read_text(encoding="utf-8")
    for relation in (
        "MemoryProgramOrderLocationBefore",
        "MemoryReadsFromBefore",
        "MemoryExternalReadsFromBefore",
        "MemoryCoherenceBefore",
        "MemoryFromReadBefore",
        "MemoryPreservedProgramOrderBefore",
        "MemoryCandidateExecutionValid",
        "MemoryExecutionAllowedTSO",
    ):
        require(
            re.search(rf"\bfunc\s+{relation}\b", concurrency_body) is not None,
            f"PTO-TSO relation is missing: {relation}",
        )
    require(
        "Mixed-size or partially overlapping" in concurrency_body
        and "MemoryRelationAcyclic(TRUE)" in concurrency_body
        and "MemoryRelationAcyclic(FALSE)" in concurrency_body,
        "PTO-TSO validity or acyclicity gate drift",
    )
    for path in (ROOT / "asl").rglob("*.asl"):
        if path == ROOT / "asl" / "state.asl" or path == (
            ROOT / "asl" / "scalar" / "memory.asl"
        ):
            continue
        body = path.read_text(encoding="utf-8")
        require(
            re.search(r"\b(?:ReadMemoryByte|WriteMemoryByte)\s*\(", body) is None,
            f"normative memory access bypasses the profile probe boundary: {path.relative_to(ROOT)}",
        )
    for relative in (
        "asl/scalar/addressing.asl",
        "asl/scalar/dispatch.asl",
        "asl/tile/memory.asl",
    ):
        body = (ROOT / relative).read_text(encoding="utf-8")
        require(
            "ProbeDataAccess(" in body,
            f"multi-access completion path lacks profile preflight: {relative}",
        )
    for handler, names in TILE_SEMANTIC_GROUPS.items():
        require(
            semantic_names.isdisjoint(names),
            f"duplicate tile semantic mapping for {sorted(semantic_names & names)}",
        )
        semantic_names.update(names)
        require(
            re.search(rf"\bfunc\s+{re.escape(handler)}\b", asl_body) is not None,
            f"missing ASL handler {handler}",
        )
        require(
            re.search(
                rf"\breadonly\s+func\s+TileOperandsLegal_{re.escape(handler)}\b",
                asl_body,
            )
            is not None,
            f"missing ASL tile legality predicate for {handler}",
        )
    catalog_names = {row["name"] for row in operations}
    require(
        semantic_names == catalog_names,
        f"tile semantic coverage drift: missing={sorted(catalog_names - semantic_names)}, extra={sorted(semantic_names - catalog_names)}",
    )

    generator = ROOT / "scripts" / "generate-asl-decoders"
    generated_tile_dispatch = subprocess.run(
        [str(generator)],
        cwd=ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    require(
        re.search(r"\bfunc\s+ExecuteTileInstruction\b", generated_tile_dispatch)
        is not None,
        "missing generated tile execution entry point",
    )
    for stable_interface in (
        "CommandFormSelectsTileOperation",
        "CommandTileFamilyOfForm",
        "CommandTileCodeOfForm",
        "CommandTileDataTypeOfForm",
        "TileOperationDATRFieldApplicable",
        "TileOperationDATRPadUnion",
        "TileOperationDATRFieldsLegal",
    ):
        require(
            re.search(
                rf"\bfunc\s+{stable_interface}\b",
                generated_tile_dispatch,
            )
            is not None,
            f"missing generated tile-command interface {stable_interface}",
        )
    require(
        "if _LastFault != Fault_None then" in generated_tile_dispatch
        and "TileExecution_Faulted" not in generated_tile_dispatch,
        "generated tile dispatch must preserve the Executed/Rejected status contract",
    )
    require(
        re.search(
            r"\bfunc\s+CompleteBundleAtWithAcceptedApplicabilityRules\b",
            asl_body,
        )
        is not None,
        "catalog restart contract target is absent",
    )
    for index, row in enumerate(operations):
        operation = re.sub(r"[^A-Za-z0-9_]", "_", row["name"])
        require(
            len(
                re.findall(
                    rf"\bwhen\s+TileOperation_{re.escape(operation)}\s*=>",
                    generated_tile_dispatch,
                )
            )
            == 1,
            f"tile operation lacks one decoded execution binding: {row['name']}",
        )
        require(
            f"if !TileOperandsLegal_{row['semantic_handler']}("
            in generated_tile_dispatch,
            f"tile operation lacks decoded legality binding: {row['name']}",
        )
        require(
            re.search(
                rf"\bfunc\s+{re.escape(row['legality_handler'])}\b",
                asl_body,
            )
            is not None
            and re.search(
                rf"\bfunc\s+{re.escape(row['effect_contract'])}\b",
                asl_body,
            )
            is not None
            and row["fault_contract"] in generated_tile_dispatch
            and re.search(
                rf"\bfunc\s+{re.escape(row['restart_contract'])}\b",
                asl_body,
            )
            is not None,
            f"catalog semantic contract target is absent for {row['name']}",
        )
        require(
            f"assert TileHandlerOfIndex({index}) == "
            f"TileHandler_{row['semantic_handler']};"
            in generated_tile_dispatch,
            f"tile operation lacks handler-identity evidence: {row['name']}",
        )
        for operand in row["operands"]:
            require(
                f"assert TileOperandPresent({index}, "
                f"TileOperand_{operand['field']});"
                in generated_tile_dispatch,
                f"tile operation lacks operand-presence evidence: "
                f"{row['name']}/{operand['field']}",
            )
        datr_witnesses = re.findall(
            rf"assert\s+(!?)TileOperationDATRFieldsLegal\({index},[^;]+;",
            generated_tile_dispatch,
        )
        require(
            len(datr_witnesses) == len(TILE_DATR_FIELD_ORDER)
            and datr_witnesses.count("!")
            == len(TILE_DATR_FIELD_ORDER)
            - len(row["datr_contract"]["allowed_nonzero_fields"]),
            f"B.DATR positive/negative applicability witnesses drift for "
            f"{row['name']}",
        )
    applicability_dispatch = generated_tile_dispatch.split(
        "func ExecuteTileInstructionWithoutTimeWithAcceptedApplicabilityRules(", 1
    )[1].split("func ExecuteTileInstructionWithoutTime(", 1)[0]
    require(
        applicability_dispatch.index(
            "if TileOperationRejectedByAcceptedApplicabilityRules("
        )
        < applicability_dispatch.index(
            "case TileOperationOfIndex(accepted_operation) of"
        )
        and "SetFault(Fault_IllegalInstruction, ReadPC())"
        in applicability_dispatch,
        "numeric applicability must reject before tile source, legality, and handler effects",
    )
    bundle_dispatch_body = (ROOT / "asl/bundle/dispatch.asl").read_text(
        encoding="utf-8"
    )
    bundle_start_applicability = bundle_dispatch_body.split(
        "func ExecuteDecodedBundleStartWithAcceptedApplicabilityRules(", 1
    )[1].split("func ExecuteDecodedBundleStart(", 1)[0]
    require(
        bundle_start_applicability.index(
            "if !BundleOperationDescriptorLegal(descriptor) then"
        )
        < bundle_start_applicability.index(
            "if BundleOperationDescriptorRejectedByAcceptedApplicabilityRules("
        )
        < bundle_start_applicability.index(
            "CompleteBundleAtWithAcceptedApplicabilityRules("
        )
        < bundle_start_applicability.index("ClearBundleHeaderState();")
        and "SetFault(Fault_IllegalInstruction, ReadTPC())"
        in bundle_start_applicability,
        "numeric applicability must reject a bundle start before live-bundle completion or descriptor installation",
    )
    require(
        "constant PTO_SCALAR_BINARY_EFFECT_FORM_COUNT = 53;" in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarBinaryEffects()")
        == 1
        and generated_tile_dispatch.count("let scalar_binary_status_") == 53,
        "generated scalar binary before/after evidence must cover 53 forms",
    )
    require(
        "constant PTO_SCALAR_NONBINARY_ALU_EFFECT_FORM_COUNT = 54;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_ALU_EFFECT_FORM_COUNT = 107;"
        in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarALUEffects()")
        == 1
        and generated_tile_dispatch.count("let scalar_alu_status_") == 54,
        "generated non-binary ALU before/after evidence must cover 54 forms",
    )
    require(
        "constant PTO_SCALAR_ALU_BOUNDARY_CASE_COUNT = 337;" in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarALUTotality()")
        == 1
        and generated_tile_dispatch.count("let scalar_alu_boundary_status_") == 337,
        "generated scalar ALU boundary evidence must cover all 337 decoded cases",
    )
    for row in (row for row in forms if row["semantic_family"] == "ALU"):
        field_names = {field["name"] for field in row["fields"]}
        if row["mnemonic"] == "HL.CCAT":
            boundary_labels = ("zero", "shift-63", "shift-64", "shift-127")
        elif row["mnemonic"] == "HL.CCATW":
            boundary_labels = (
                "zero",
                "shift-31",
                "shift-32",
                "shift-63",
                "shift-64",
                "shift-127",
            )
        elif row["mnemonic"] == "CSEL":
            boundary_labels = (
                "zero",
                "lower",
                "modifier-two",
                "upper",
                "predicate-true",
            )
        elif "SrcRType" in field_names:
            boundary_labels = ("zero", "lower", "upper", "modifier-two")
        else:
            boundary_labels = ("zero", "lower", "upper")
        boundary_prefix = f"// {row['form_id']}: {row['mnemonic']} [boundary-"
        require(
            generated_tile_dispatch.count(boundary_prefix) == len(boundary_labels)
            and all(
                generated_tile_dispatch.count(
                    f"// {row['form_id']}: {row['mnemonic']} [boundary-{label}]"
                )
                == 1
                for label in boundary_labels
            ),
            f"decoded scalar ALU boundary inventory drift for {row['form_id']}",
        )
    require(
        "constant PTO_SCALAR_BRU_EFFECT_FORM_COUNT = 66;" in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarBRUEffects()")
        == 1
        and generated_tile_dispatch.count("let scalar_bru_status_") == 126
        and generated_tile_dispatch.count("let scalar_bru_bundle_predicate_status_")
        == 4
        and generated_tile_dispatch.count("let scalar_bru_jr_alignment_status") == 1,
        "generated BRU before/after evidence must cover 66 forms, both "
        "in-bundle B.Z/B.NZ outcomes, and the JR alignment fault",
    )
    require(
        "constant PTO_SCALAR_BRU_TOTALITY_CASE_COUNT = 284;" in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarBRUTotality()")
        == 1
        and generated_tile_dispatch.count("let scalar_bru_totality_status_") == 284,
        "generated scalar BRU totality evidence must cover all 284 decoded cases",
    )
    bru_class_by_form_id = {
        form_id: class_id
        for class_id in bru_effect_class_ids
        for form_id in classes_by_id[class_id]["form_ids"]
    }
    require(
        len(bru_class_by_form_id) == 66,
        "scalar BRU effect classes must partition all accepted BRU forms",
    )
    for row in (row for row in forms if row["semantic_family"] == "BRU"):
        class_id = bru_class_by_form_id[row["form_id"]]
        field_names = {field["name"] for field in row["fields"]}
        if class_id in {"scalar-compare-value", "scalar-commit-value"}:
            totality_labels = ["zero", "lower", "upper"]
            if "SrcRType" in field_names:
                totality_labels += ["modifier-01", "modifier-10", "modifier-11"]
            if class_id == "scalar-commit-value" and "shamt" in field_names:
                totality_labels += ["shamt-max"]
        elif class_id == "scalar-branch-control":
            totality_labels = [
                "zero",
                "lower",
                "upper",
                "lower-not-taken",
                "upper-not-taken",
            ]
        elif class_id == "scalar-jump-control":
            totality_labels = (
                [
                    "zero",
                    "lower",
                    "upper",
                    "srczero-max-alias",
                    "odd-target-fault",
                ]
                if row["mnemonic"] == "JR"
                else ["zero", "lower", "upper"]
            )
        elif class_id in {"scalar-pc-relative-value", "scalar-return-address"}:
            totality_labels = ["zero", "lower", "upper", "wrap"]
        else:
            raise AssertionError(f"unclassified BRU effect class: {class_id}")
        comment_prefix = f"// {row['form_id']}: {row['mnemonic']} [bru-totality-"
        require(
            generated_tile_dispatch.count(comment_prefix) == len(totality_labels)
            and all(
                generated_tile_dispatch.count(
                    f"// {row['form_id']}: {row['mnemonic']} [bru-totality-{label}]"
                )
                == 1
                for label in totality_labels
            ),
            f"decoded scalar BRU totality inventory drift for {row['form_id']}",
        )
    require(
        "constant PTO_SCALAR_BRU_ALIAS_FAULT_CASE_COUNT = 32;"
        in generated_tile_dispatch
        and generated_tile_dispatch.count(
            "func ValidateCanonicalScalarBRUAliasAndFaults()"
        )
        == 1
        and generated_tile_dispatch.count("// BRU-ALIAS-FAULT-DECODED:") == 32
        and generated_tile_dispatch.count("let scalar_bru_alias_fault_status_") == 33
        and all(
            generated_tile_dispatch.count(f"// BRU-ALIAS-FAULT-DECODED: {case_id}") == 1
            for case_id in expected_bru_alias_fault_case_ids
        ),
        "generated scalar BRU alias/fault evidence inventory drift",
    )
    require(
        "constant PTO_SCALAR_AMO_EFFECT_FORM_COUNT = 53;" in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarAMOEffects()")
        == 1
        and generated_tile_dispatch.count("let scalar_amo_status_") == 53
        and generated_tile_dispatch.count("let scalar_amo_sc_fail_status_") == 4
        and generated_tile_dispatch.count("let scalar_amo_cas_fail_status_") == 8
        and generated_tile_dispatch.count("let scalar_amo_dma_fault_status_") == 1,
        "generated AMO before/after evidence must cover 53 forms, every SC "
        "miss and CAS mismatch, and the DMA no-partial-effect fault",
    )
    amo_stage4_markers = re.findall(
        r"^\s*// AMO-S4 (\S.*)$", generated_tile_dispatch, flags=re.MULTILINE
    )
    amo_stage4_marker_prefix_counts = Counter(
        marker.split("/", 1)[0] for marker in amo_stage4_markers
    )
    require(
        "constant PTO_SCALAR_AMO_MODIFIER_CASE_COUNT = 337;" in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_VALUE_CASE_COUNT = 320;" in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_SEMANTIC_SOURCE_OCCURRENCE_COUNT = 110;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_TEMP_SOURCE_CASE_COUNT = 880;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_SPECIAL_DESTINATION_CASE_COUNT = 324;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_ABSOLUTE_OVERLAP_CASE_COUNT = 76;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_IGNORED_SRC_ZERO_CASE_COUNT = 128;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_ALIAS_CASE_COUNT = 1408;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_FAULT_CASE_COUNT = 151;" in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_RESTART_CASE_COUNT = 151;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_SC_MISS_NO_PROBE_CASE_COUNT = 11;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_FAULT_RESTART_CASE_COUNT = 313;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_RESERVATION_CASE_COUNT = 81;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_DMA_CASE_COUNT = 15;" in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_TOTALITY_CASE_COUNT = 1066;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_STAGE4_CASE_COUNT = 2474;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_RETAINED_STAGE1_CASE_COUNT = 66;"
        in generated_tile_dispatch
        and "constant PTO_SCALAR_AMO_EXECUTABLE_CASE_COUNT = 2540;"
        in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarAMOTotality()")
        == 1
        and generated_tile_dispatch.count("func ValidateCanonicalScalarAMOAliases()")
        == 1
        and len(amo_stage4_markers) == len(set(amo_stage4_markers)) == 2474
        and amo_stage4_marker_prefix_counts
        == {
            "alias": 1408,
            "dma": 15,
            "fault": 151,
            "modifier": 337,
            "reservation": 81,
            "restart": 151,
            "sc-miss-no-probe": 11,
            "value": 320,
        },
        "generated scalar AMO Stage 4 constants, marker uniqueness, or package counts drift",
    )
    for row in amo_rows:
        form_id = row["form_id"]
        class_id = scalar_amo_effect_class(row)
        modifier_count = 1 << sum(
            any(field["name"] == field_name for field in row["fields"])
            for field_name in ("aq", "rl", "far")
        )
        value_count = (
            0
            if class_id == "scalar-dma-copy"
            else 4
            if class_id in {"scalar-amo-load-reserved", "scalar-amo-swap"}
            else 8
            if class_id == "scalar-amo-store-conditional"
            else 10
            if class_id == "scalar-amo-cas"
            else 7
            if row["mnemonic"].endswith(("SMIN", "SMAX", "UMIN", "UMAX"))
            else 4
        )
        fault_count = (
            0
            if class_id == "scalar-dma-copy"
            else 2
            if row["mnemonic"].endswith(("B", ".B"))
            else 3
        )
        require(
            sum(
                marker.startswith(f"modifier/{form_id}/")
                for marker in amo_stage4_markers
            )
            == modifier_count
            and sum(
                marker.startswith(f"value/{form_id}/") for marker in amo_stage4_markers
            )
            == value_count
            and sum(
                marker.startswith(f"fault/{form_id}/") for marker in amo_stage4_markers
            )
            == fault_count
            and sum(
                marker.startswith(f"restart/{form_id}/")
                for marker in amo_stage4_markers
            )
            == fault_count,
            f"generated scalar AMO per-form modifier, value, or fault/restart coverage drift: {form_id}",
        )
        for field in row["fields"]:
            field_name = field["name"]
            if field_name in {"SrcL", "SrcR", "SrcD"}:
                require(
                    sum(
                        marker.startswith(f"alias/temp-source/{form_id}/{field_name}/")
                        for marker in amo_stage4_markers
                    )
                    == 8,
                    f"generated scalar AMO temporary-source selector coverage drift: {form_id}.{field_name}",
                )
        if any(field["name"] == "RegDst" for field in row["fields"]):
            require(
                sum(
                    marker.startswith(f"alias/special-destination/{form_id}/")
                    for marker in amo_stage4_markers
                )
                == 9
                and sum(
                    marker.startswith(f"alias/absolute-overlap/{form_id}/")
                    for marker in amo_stage4_markers
                )
                == sum(
                    field["name"] in {"SrcL", "SrcR", "SrcD"} for field in row["fields"]
                ),
                f"generated scalar AMO destination or absolute-overlap coverage drift: {form_id}",
            )
        if any(field["name"] == "SrcZero" for field in row["fields"]):
            require(
                sum(
                    marker.startswith(f"alias/ignored-srczero/{form_id}/")
                    for marker in amo_stage4_markers
                )
                == 32,
                f"generated scalar AMO ignored SrcZero coverage drift: {form_id}",
            )
    require(
        "constant PTO_SCALAR_FSU_EFFECT_FORM_COUNT = 30;" in generated_tile_dispatch
        and generated_tile_dispatch.count("func ValidateCanonicalScalarFSUEffects()")
        == 1
        and generated_tile_dispatch.count("let scalar_fsu_success_status_") == 30
        and generated_tile_dispatch.count("let scalar_fsu_sensitive_status_") == 30
        and generated_tile_dispatch.count("let scalar_fsu_nan_") == 4
        and generated_tile_dispatch.count("let scalar_fsu_minmax_nan_") == 6
        and generated_tile_dispatch.count("let scalar_fsu_divide_zero_status_") == 1
        and generated_tile_dispatch.count("let scalar_fsu_recip_zero_status_") == 1
        and generated_tile_dispatch.count("let scalar_fsu_invalid_source_fault_status_")
        == 1
        and generated_tile_dispatch.count(
            "let scalar_fsu_invalid_destination_fault_status_"
        )
        == 1,
