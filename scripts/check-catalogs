        require(
            set(hook)
            == {
                "domain",
                "conformance_status",
                "implementation_status",
                "maturity_target",
                "model",
                "name",
                "portable_default",
                "profile_obligations",
                "requirement",
                "tests",
            },
            f"profile-hook schema drift for {hook.get('name', '<unknown>')}",
        )
        require(
            hook["implementation_status"] == "implemented-by-pto-v0",
            f"bad profile-hook implementation status for {hook['name']}",
        )
        require(
            (
                hook["conformance_status"] == "reference-profile-closed"
                and hook["maturity_target"] is None
            )
            or (
                hook["conformance_status"]
                == "raw-carrier-reference-closed-target-conformance-open"
                and hook["maturity_target"] == "S5-T2"
            ),
            f"profile-hook conformance status drift for {hook['name']}",
        )
        require(
            all(
                isinstance(hook[key], str) and hook[key]
                for key in ("domain", "model", "name", "portable_default")
            ),
            f"empty profile-hook identity for {hook['name']}",
        )
        require(
            hook["requirement"] in requirement_ids,
            f"unknown profile requirement for {hook['name']}",
        )
        require(
            "spec/profile-hooks.json"
            in requirements_by_id[hook["requirement"]]["model"],
            f"profile registry is not traceable from {hook['requirement']}",
        )
        require(
            hook["portable_default"], f"missing portable default for {hook['name']}"
        )
        require(
            isinstance(hook["profile_obligations"], list)
            and hook["profile_obligations"]
            and all(hook["profile_obligations"]),
            f"missing profile obligations for {hook['name']}",
        )
        model_path = ROOT / hook["model"]
        require(model_path.exists(), f"missing profile model for {hook['name']}")
        require(
            re.search(
                rf"\bimpdef\s+func\s+{re.escape(hook['name'])}\b",
                model_path.read_text(encoding="utf-8"),
            )
            is not None,
            f"profile hook is not an impdef declaration: {hook['name']}",
        )
        require(
            re.search(
                rf"\bimplementation\s+func\s+{re.escape(hook['name'])}\b",
                profile_implementation_body,
            )
            is not None,
            f"profile hook lacks active implementation: {hook['name']}",
        )
        require(
            re.search(rf"\b{re.escape(hook['name'])}\s*\(", profile_test_body)
            is not None,
            f"profile hook lacks direct conformance witness: {hook['name']}",
        )
        require(
            len(re.findall(rf"\b{re.escape(hook['name'])}\b", asl_text)) >= 2,
            f"profile hook has no ASL call site: {hook['name']}",
        )
        require(
            isinstance(hook["tests"], list) and hook["tests"],
            f"missing profile tests for {hook['name']}",
        )
        for relative in hook["tests"]:
            require(
                (ROOT / relative).exists(), f"missing profile test path: {relative}"
            )
    require(
        Counter(hook["conformance_status"] for hook in profile_hooks)
        == Counter(
            {
                "reference-profile-closed": 8,
                "raw-carrier-reference-closed-target-conformance-open": 30,
            }
        ),
        "profile hook reference/conformance maturity inventory drift",
    )

    numeric_owner = "PTO numeric architecture maintainers"
    numeric_disposition = (
        "pto-v0-reference-defined-target-numeric-conformance-open:S5-T2"
    )
    require(
        set(numeric_contracts)
        == {
            "active_reference_profile",
            "contract_domains",
            "hooks",
            "maturity_target",
