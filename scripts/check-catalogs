        == maturity_level_for_stage[contiguous_closed_stage],
        "maturity current level must equal the highest contiguous closed stage",
    )
    maturity_plan_body = (ROOT / "docs" / "maturity-bringup-plan.md").read_text(
        encoding="utf-8"
    )
