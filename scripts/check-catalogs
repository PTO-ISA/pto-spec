    require(
        set(amo_contract)
        == {
            "dma",
            "fault_precedence",
            "reg5_order",
            "reservation",
            "restart",
            "width_return",
        }
        and all(amo_contract.values())
        and amo_contract["fault_precedence"]
        == ["alignment", "translation", "permission-or-bounded-memory"]
        and amo_contract["width_return"]
        == {
            "byte": "zero-extend",
            "doubleword": "unchanged",
            "halfword": "zero-extend",
