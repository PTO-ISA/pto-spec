    require(
        numeric_contracts["schema_version"] == 1
        and numeric_contracts["maturity_target"] == "S5-T1"
        and numeric_contracts["status"] == "closed-inventory-and-ownership"
        and numeric_contracts["active_reference_profile"] == "pto-v0",
