        profile_hook = profile_hooks_by_name[name]
        expected_role = (
            "numeric-library-helper-no-decoded-operation"
            if name in numeric_library_only_hooks
            else "pto-v0-reference-helper"
            if name in numeric_helper_hooks
            else "portable-profile-boundary"
        )
        require(
            set(hook)
            == {
                "model",
                "name",
                "operation_keys",
                "profile_owner",
                "requirement",
                "role",
