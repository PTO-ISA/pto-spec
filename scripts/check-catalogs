        and raise_interrupt_body.index("SetInterruptPending(ring, interrupt_id);")
        < raise_interrupt_body.index("InterruptEnabled(ring, interrupt_id)")
        and "NaturalToWord(interrupt_id as integer {0..262144})"
        in raise_interrupt_body
        and "RaiseInterrupt(0," in interrupt_register_test
        and "RaiseInterrupt(63," in interrupt_register_test
        and "boundary_pending[0] == '1' && boundary_pending[63] == '1'"
        in interrupt_register_test
        and "_LastFault == Fault_None" in interrupt_register_test
        and "ReadTPC() == Zeros{PTO_XLEN} + 0x5150" in interrupt_register_test
        and "!_TrapContexts[[0]].valid" in interrupt_register_test
        and "RaiseInterrupt(63," in complete_trap_test
        and "_ACRTrapArgument0[[1]] == Zeros{PTO_XLEN} + 63"
        in complete_trap_test
        and "TestInterruptRegisterState();" in main_test_body,
        "interrupt injection must constrain IDs to 0..63 and witness both boundaries",
    )
    require(
        "SystemRegisterAccessPermitted(address, FALSE, CurrentACR())"
        in system_register_body
        and "SystemRegisterAccessPermitted(address, TRUE, CurrentACR())"
        in system_register_body
        and "Fault_IllegalInstruction" in system_register_body,
        "system-register ACR checks are not enforced on read and write",
    )
    require(
        "ResetProfileState();" in main_test_body
        and "ResetProfileState();" in profile_test_body
        and "ResetMemoryExecution();" in profile_implementation_body
        and "_MemoryEventCount == 0" in profile_test_body,
        "active profile reset is not executed and tested",
    )
    require(
        "func AdvanceArchitecturalTime()" in system_body
        and "func BeginArchitecturalInstructionAttempt()" in system_body
        and "BeginArchitecturalInstructionAttempt();" in dispatch_body
        and "BeginArchitecturalInstructionAttempt();" in command_dispatch_body
        and "BeginArchitecturalInstructionAttempt();" in generated_tile_dispatch,
        "scalar, command, and tile decoded attempts must use the uniform timed prelude",
    )
    profile_requirement_ids = {hook["requirement"] for hook in profile_hooks}
    for requirement in requirements:
        if requirement["id"] in profile_requirement_ids:
            require(
                "spec/profile-hooks.json" in requirement["model"],
                f"profile-bearing requirement omits registry: {requirement['id']}",
            )

    used_ids: set[str] = set()
    nested_names = (
        "V" + "CALL",
        "M" + "CALL",
        "V" + "PAR",
        "V" + "SEQ",
        "M" + "PAR",
        "M" + "SEQ",
    )
    for path in (ROOT / "asl").rglob("*.asl"):
        body = path.read_text(encoding="utf-8")
        used_ids.update(re.findall(r"PTO-REQ-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}", body))
        active = body.upper()
        for forbidden in nested_names:
            require(
                re.search(
                    rf"(?<![A-Z0-9_.]){re.escape(forbidden)}(?![A-Z0-9_.])", active
                )
                is None,
                f"forbidden nested architecture surface in {path}",
            )
    require(
        used_ids <= set(requirement_ids),
        f"ASL uses unknown requirement IDs: {sorted(used_ids - set(requirement_ids))}",
    )

    print(
        "catalog checks passed: 474 scalar forms, 45 operand fields, 1,867 field pieces, "
        "3 form constraints, no family constraints, "
        "3 constrained overlaps, 72 system-register definitions, 13 trap numbers, and "
        "99 command forms and 120 tile operations with closed handler reachability and feature evidence; "
        "474 scalar forms have decoded before/after effect closure; "
        f"{len(profile_names)} profile hooks are declared, invoked, and traceable; "
        "S5-T1 owns 19 scalar and 89 direct-tile numeric contracts"
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (AssertionError, KeyError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
