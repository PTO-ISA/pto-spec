    def concrete_system_register_addresses(row: dict) -> list[int]:
        if row["scope"] == "base":
            return [int(row["address"], 0)]
        low_index = int(row["low_index"], 0)
        if "fixed_context" in row:
            return [(row["fixed_context"] << 12) | low_index]
        return [(ring << 12) | low_index for ring in range(16)]

    sys_transfer_widths = {
        "C.SSRGET": 5,
        "SSRGET": 12,
        "LSRGET": 12,
        "HL.SSRGET": 24,
        "SSRSET": 12,
        "HL.SSRSET": 24,
        "SSRSWAP": 12,
    }
    derived_transfer_breakdown = {}
    for mnemonic, width in sys_transfer_widths.items():
        access_counts = Counter(
            row["access"]
            for row in register_rows
            for address in concrete_system_register_addresses(row)
            if address < 1 << width
        )
        derived_transfer_breakdown[mnemonic] = {
            "RO": access_counts["RO"],
            "RW": access_counts["RW"],
            "WO": access_counts["WO"],
            "cases": sum(access_counts.values()),
        }
