def load(relative: str):
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def extract_field(row: dict, field_name: str, instruction: int) -> int:
    field = next(field for field in row["fields"] if field["name"] == field_name)
    value = 0
    for piece in field["pieces"]:
        mask = (1 << piece["width"]) - 1
        value |= ((instruction >> piece["instruction_lsb"]) & mask) << piece[
            "value_lsb"
        ]
    return value


def family_constraint_applies(row: dict, constraint: dict) -> bool:
    selector = constraint["applies_to"]
    field_names = {field["name"] for field in row["fields"]}
    return (
        row["semantic_family"] in selector["semantic_families"]
        and row["semantic_handler"] in selector["semantic_handlers"]
        and set(selector["required_fields"]) <= field_names
    )


def classify_agu_form(row: dict) -> dict:
    parts = row["mnemonic"].split(".")
    core_index = 1 if parts[0] in {"C", "HL"} else 0
    core = parts[core_index]
    suffixes = set(parts[core_index + 1 :])
    actions = {
        "ExecuteScalarLoad": "Load",
        "ExecuteScalarLoadPair": "LoadPair",
        "ExecuteScalarStore": "Store",
        "ExecuteScalarStorePair": "StorePair",
        "ScalarPrefetch": "Prefetch",
    }
    require(row["semantic_handler"] in actions, f"unknown AGU handler {row['form_id']}")
    action = actions[row["semantic_handler"]]
    if action == "Prefetch":
        size_bytes = 1
    else:
        width_prefixes = (("LB", "SB"), ("LH", "SH"), ("LW", "SW"), ("LD", "SD"))
        widths = (1, 2, 4, 8)
        matches = [
            width
            for prefixes, width in zip(width_prefixes, widths, strict=True)
            if core.startswith(prefixes)
        ]
        require(len(matches) == 1, f"ambiguous AGU width {row['form_id']}")
        size_bytes = matches[0]

    field_names = {field["name"] for field in row["fields"]}
    if "PCR" in suffixes:
        address_kind = "PCRelative"
    elif parts[0] == "C":
        address_kind = "Compressed"
    elif "SrcRType" in field_names:
        address_kind = "Register"
    else:
        address_kind = "Immediate"
    if suffixes & {"PR", "UPR"}:
        update_mode = "PreIndex"
    elif suffixes & {"PO", "UPO"}:
        update_mode = "PostIndex"
    else:
        update_mode = "None"
    unscaled = bool(suffixes & {"U", "UPR", "UPO", "UA"})
    if address_kind == "PCRelative":
        offset_scale = 2
    elif address_kind == "Register" and "shamt" in field_names:
        offset_scale = 0
    elif unscaled:
        offset_scale = 0
    else:
        offset_scale = int(math.log2(size_bytes))
    signed_load = (
        action in {"Load", "LoadPair"}
        and core.startswith(("LB", "LH", "LW"))
        and not core.startswith(("LBU", "LHU", "LWU"))
    )
    return {
        "action": action,
        "address_kind": address_kind,
        "offset_scale": offset_scale,
        "prefetch_returns_address": row["mnemonic"] in {"HL.PRF.A", "HL.PRFI.UA"},
        "signed_load": signed_load,
        "size_bytes": size_bytes,
        "update_mode": update_mode,
    }


def expand_number_entries(entries: list) -> set[int]:
    values: set[int] = set()
    for entry in entries:
        if isinstance(entry, int):
            values.add(entry)
        else:
            require(
                isinstance(entry, list) and len(entry) == 2,
                "invalid numeric range entry",
            )
            start = int(entry[0], 0) if isinstance(entry[0], str) else entry[0]
            end = int(entry[1], 0) if isinstance(entry[1], str) else entry[1]
            require(start <= end, "reversed numeric range entry")
            values.update(range(start, end + 1))
    return values


def aggregate_encoding(row: dict) -> tuple[int, int]:
    mask = 0
    match = 0
    for part in row["encoding"]:
        shift = part["index"] * 32
        mask |= int(part["mask"], 16) << shift
        match |= int(part["match"], 16) << shift
    return mask, match


def field_shape(
    row: dict,
) -> dict[str, tuple[int, tuple[tuple[int, int, int], ...]]]:
    return {
        field["name"]: (
            field["width"],
            tuple(
                (
                    piece["instruction_lsb"],
                    piece["value_lsb"],
                    piece["width"],
                )
                for piece in field["pieces"]
            ),
        )
        for field in row["fields"]
    }


