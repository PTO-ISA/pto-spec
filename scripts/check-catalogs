def scalar_amo_effect_class(row: dict) -> str | None:
    """Classify AMO forms by visible architectural effect, not shared handler."""
    if row["semantic_family"] != "AMO":
        return None
    handler = row["semantic_handler"]
    mnemonic = row["mnemonic"]
    if handler == "LoadReserved":
        return "scalar-amo-load-reserved"
    if handler == "StoreConditional":
        return "scalar-amo-store-conditional"
    if handler == "CompareAndSwap":
        return "scalar-amo-cas"
    if handler == "ExecuteScalarDMACopy64":
        return "scalar-dma-copy"
    if handler == "AtomicReadModifyWrite":
        if mnemonic.startswith("SWAP"):
            return "scalar-amo-swap"
        if mnemonic.startswith(("LW.", "LD.")):
            return "scalar-amo-load-rmw"
        if mnemonic.startswith(("SW.", "SD.")):
            return "scalar-amo-store-rmw"
    return None


def scalar_fsu_effect_class(row: dict) -> str | None:
    """Classify FSU forms by raw-carrier effect and flag ownership."""
    if row["semantic_family"] != "FSU":
        return None
    mnemonic = row["mnemonic"]
    if mnemonic == "FABS":
        return "scalar-fp-absolute"
    if mnemonic in {"FEXP", "FRECIP", "FSQRT"}:
        return "scalar-fp-unary-profile"
    if mnemonic in {"FADD", "FSUB", "FMUL", "FDIV"}:
        return "scalar-fp-binary-profile"
    if mnemonic in {"FMIN", "FMAX"}:
        return "scalar-fp-minmax"
    if mnemonic in {"FEQ", "FNE", "FLT", "FGE"}:
        return "scalar-fp-compare-quiet"
    if mnemonic in {"FEQS", "FNES", "FLTS", "FGES"}:
        return "scalar-fp-compare-signaling"
    if mnemonic in {"FMADD", "FMSUB", "FNMADD", "FNMSUB"}:
        return "scalar-fp-fused-profile"
    if mnemonic == "FCVT":
        return "scalar-fp-format-convert"
    if mnemonic in {"FCVTA", "FCVTM", "FCVTN", "FCVTP", "FCVTZ"}:
        return "scalar-fp-to-integer"
    if mnemonic in {"SCVTF", "UCVTF"}:
        return "scalar-integer-to-fp"
    return None


def scalar_sys_effect_class(row: dict) -> str | None:
    """Classify SYS forms by visible register, request, epoch, or trap effect."""
    if row["semantic_family"] != "SYS":
        return None
    handler = row["semantic_handler"]
    mnemonic = row["mnemonic"]
    if handler in {
        "ExecuteCompressedSystemRegisterGet",
        "ExecuteSystemRegisterGet",
    }:
        return "scalar-system-register-read"
    if handler == "ExecuteSystemRegisterSet":
        return "scalar-system-register-write"
    if handler == "ExecuteSystemRegisterSwap":
        return "scalar-system-register-swap"
    if handler == "ExecuteMaintenance":
        if mnemonic.startswith("TLB."):
            return "scalar-tlb-maintenance"
        return "scalar-cache-maintenance"
    direct = {
        "ExecuteControlRequest": "scalar-execution-control-request",
        "SoftwareBreakpoint": "scalar-software-breakpoint",
        "FenceData": "scalar-data-fence",
        "FenceInstruction": "scalar-instruction-fence",
        "ArchitectureAssert": "scalar-architecture-assert",
        "ArchitectureCloseRequest": "scalar-architecture-close-request",
        "ArchitectureEnterRequest": "scalar-architecture-enter-request",
        "SetCommitTarget": "scalar-set-commit-target",
    }
    return direct.get(handler)


def scalar_agu_effect_class(row: dict) -> str | None:
    """Classify AGU forms by memory effect, writeback, pair, or hint result."""
    if row["semantic_family"] != "AGU":
        return None
    handler = row["semantic_handler"]
    group = row["semantic_group"]
    mnemonic = row["mnemonic"]
    writeback = group.endswith(("/PRE_INDEX", "/POST_INDEX"))
    if handler == "ExecuteScalarLoad":
        return "scalar-agu-load-writeback" if writeback else "scalar-agu-load"
    if handler == "ExecuteScalarLoadPair":
        return "scalar-agu-load-pair"
    if handler == "ExecuteScalarStore":
        return "scalar-agu-store-writeback" if writeback else "scalar-agu-store"
    if handler == "ExecuteScalarStorePair":
        return "scalar-agu-store-pair"
    if handler == "ScalarPrefetch":
        if mnemonic in {"HL.PRF.A", "HL.PRFI.UA"}:
            return "scalar-agu-prefetch-address"
        return "scalar-agu-prefetch"
    return None


