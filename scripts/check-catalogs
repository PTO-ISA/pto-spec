            and hook["role"] == expected_role
            and hook["model"] == profile_hook["model"]
            and hook["requirement"] == profile_hook["requirement"]
            and hook["profile_owner"] == numeric_owner
            and hook["operation_keys"] == sorted(expected_operation_keys_by_hook[name]),
            f"numeric hook contract drift for {name}",
        )
    require(
        numeric_contracts["summary"]
        == {
            "decoded_operation_count": 108,
            "direct_tile_operation_count": 89,
