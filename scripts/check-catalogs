    scalar_forms_by_name = {
        row["mnemonic"]: row for row in forms if row["semantic_family"] == "FSU"
    }
    tile_operations_by_name = {row["name"]: row for row in operations}
    expected_numeric_operations = {}
    for domain_id, (
        requirement,
        stage4_target,
        hooks,
        names,
        surface,
    ) in numeric_domain_specs.items():
        for name in names:
            if surface == "scalar-form":
                catalog_row = scalar_forms_by_name[name]
                key = f"scalar:{catalog_row['form_id']}"
                catalog_identity = catalog_row["form_id"]
                family = "FSU"
            else:
                catalog_row = tile_operations_by_name[name]
                key = f"tile:{catalog_row['family']}:{name}"
                catalog_identity = catalog_row.get("selector") or name
                family = catalog_row["family"]
            primary_hooks = list(hooks)
            if domain_id == "cube-matrix":
                if "_BIAS" in name:
                    primary_hooks.append("TileProfileMatrixBias")
                if "_MX" in name:
                    primary_hooks.append(
                        "TileProfileMatrixScaledAccumulate"
                    )
            reference_helpers = []
            if name == "TSQRT":
                reference_helpers.append("TileSquareRoot")
            if name == "TRSQRT":
                reference_helpers.extend(("TileSquareRoot", "TileReciprocal"))
            if name == "TLOG":
                reference_helpers.append("TileLogarithm")
            if name == "TRECIP":
                reference_helpers.append("TileReciprocal")
            if name == "TEXP":
                reference_helpers.append("TileExponential")
            if name.endswith("EXPANDEXPDIF"):
                reference_helpers.append("TileExpDifference")
            expected_numeric_operations[key] = {
                "catalog_identity": catalog_identity,
                "disposition": numeric_disposition,
                "family": family,
                "key": key,
                "name": name,
                "numeric_contract": domain_id,
                "primary_hooks": primary_hooks,
                "profile_owner": numeric_owner,
                "reference_helpers": reference_helpers,
                "requirement": requirement,
                "stage4_target": stage4_target,
                "surface": surface,
            }
    numeric_operation_rows = numeric_contracts["operations"]
    numeric_operations_by_key = {row["key"]: row for row in numeric_operation_rows}
    require(
        len(numeric_operations_by_key) == len(numeric_operation_rows) == 108
        and numeric_operations_by_key == expected_numeric_operations,
        "numeric operation inventory, ownership, or hook mapping drift",
    )

    expected_operation_keys_by_hook = {name: [] for name in profile_names}
    for operation in expected_numeric_operations.values():
        for hook_name in operation["primary_hooks"] + operation["reference_helpers"]:
            expected_operation_keys_by_hook[hook_name].append(operation["key"])
