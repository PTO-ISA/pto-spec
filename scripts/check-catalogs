    numeric_hooks_by_name = {row["name"]: row for row in numeric_hook_rows}
    require(
        len(numeric_hooks_by_name) == len(numeric_hook_rows) == 30
        and set(numeric_hooks_by_name) == expected_numeric_hook_names,
        "numeric hook ownership inventory drift",
