                "target_conformance_status",
            }
            and row["profile_owner"] == numeric_owner
            and row["requirement"] == requirement
            and row["stage4_target"] == stage4_target
            and row["primary_hooks"] == list(hooks)
            and row["target_conformance_status"] == "open:S5-T2"
            and isinstance(row["open_numeric_dimensions"], list)
