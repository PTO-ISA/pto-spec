    for target_id in sorted(expected_target_ids):
        target = targets_by_id[target_id]
        expected_stage = int(target_id[1])
        require(
            target["stage"] == expected_stage,
            f"maturity target stage drift for {target_id}",
        )
        require(
            target["status"] in {"closed", "in-progress", "open", "blocked"},
            f"unsupported maturity target status for {target_id}",
        )
        expected_keys = (
            base_target_keys
            if target["status"] == "closed"
            else base_target_keys | {"tracking"}
        )
        require(
            set(target) == expected_keys,
            f"maturity target schema drift for {target_id}",
        )
        require(
            isinstance(target["owner"], str)
            and target["owner"]
            and isinstance(target["title"], str)
            and target["title"],
            f"maturity target owner/title missing for {target_id}",
        )
        require(
            isinstance(target["requirements"], list)
            and target["requirements"]
            and set(target["requirements"]) <= set(requirement_ids),
            f"maturity target requirement traceability drift for {target_id}",
        )
        require(
            isinstance(target["evidence"], list) and target["evidence"],
            f"maturity target evidence missing for {target_id}",
        )
        for relative in target["evidence"]:
            require(
                isinstance(relative, str) and relative and (ROOT / relative).exists(),
                f"missing maturity evidence path for {target_id}: {relative}",
            )
        gaps = target["gaps"]
        require(isinstance(gaps, list), f"maturity gaps must be a list for {target_id}")
        if target["status"] == "closed":
            require(not gaps, f"closed maturity target retains gaps: {target_id}")
        else:
            require(gaps, f"open maturity target lacks classified gaps: {target_id}")
            tracking = target["tracking"]
            require(
                isinstance(tracking, list) and tracking,
                f"open maturity target lacks tracking issue or ADR: {target_id}",
            )
            for reference in tracking:
                require(
                    isinstance(reference, str)
                    and reference
                    and (
                        reference.startswith("https://") or (ROOT / reference).exists()
                    ),
                    f"invalid maturity tracking reference for {target_id}: {reference}",
                )
        for gap in gaps:
            require(
                set(gap)
                == {"acceptance_evidence", "classification", "id", "statement"},
                f"maturity gap schema drift in {target_id}",
            )
            require(
                re.fullmatch(rf"{re.escape(target_id)}-G[1-9][0-9]*", gap["id"])
                is not None
                and gap["id"] not in seen_gap_ids,
                f"maturity gap identity drift in {target_id}",
            )
            seen_gap_ids.add(gap["id"])
            require(
                gap["classification"] in allowed_gap_classes,
                f"unknown maturity gap classification for {gap['id']}",
            )
            require(
                isinstance(gap["statement"], str)
                and gap["statement"]
                and isinstance(gap["acceptance_evidence"], list)
                and gap["acceptance_evidence"]
                and all(gap["acceptance_evidence"]),
                f"maturity gap lacks statement or acceptance evidence: {gap['id']}",
            )
    for stage_row in stage_rows:
        stage_id = stage_row["id"]
        require(
            set(stage_row) == {"id", "status", "targets"}
            and stage_row["targets"] == expected_stage_targets[stage_id],
            f"maturity stage target inventory drift for stage {stage_id}",
        )
        statuses = [
            targets_by_id[target_id]["status"] for target_id in stage_row["targets"]
        ]
        derived_status = (
            "closed"
            if all(status == "closed" for status in statuses)
            else "open"
            if all(status == "open" for status in statuses)
            else "in-progress"
        )
        require(
            stage_row["status"] == derived_status,
            f"maturity stage status does not derive from its targets: stage {stage_id}",
        )
    contiguous_closed_stage = -1
    for stage_row in stage_rows:
        if stage_row["status"] != "closed":
            break
        contiguous_closed_stage = stage_row["id"]
    maturity_level_for_stage = {
        0: "M0-mechanically-closed",
        1: "M1-execution-path-closed",
        2: "M2-state-and-fault-closed",
        3: "M3-ordering-closed",
        4: "M4-reference-semantics-closed",
        5: "M5-conformance-closed",
        6: "M6-architecturally-complete",
    }
