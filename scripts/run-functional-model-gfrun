#!/usr/bin/env python3
"""Run the checked functional-model corpus through gfrun's ASL engine."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import struct
import subprocess


RUN_SCHEMA = "linx-gfrun-asl-run-v1"
SUMMARY_SCHEMA = "pto-functional-model-gfrun-validation-v1"


class ValidationError(ValueError):
    pass


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def memory_write_sha256(writes: list[object]) -> str:
    canonical = bytearray(b"pto-memory-write-log-v1\0")
    canonical += struct.pack("<Q", len(writes))
    for item in writes:
        if not isinstance(item, dict):
            raise ValidationError("memory-write trace entry is not an object")
        canonical += struct.pack("<QB", int(item["address"]), int(item["value"]))
    return hashlib.sha256(canonical).hexdigest()


def load_json(path: Path) -> dict[str, object]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValidationError(f"cannot read JSON {path}: {error}") from error
    if not isinstance(value, dict):
        raise ValidationError(f"JSON root is not an object: {path}")
    return value


def require_equal(actual: object, expected: object, label: str) -> None:
    if actual != expected:
        raise ValidationError(f"{label}: expected {expected!r}, observed {actual!r}")


def validate_input_hash(path: Path, expected: object, label: str) -> None:
    if not path.is_file():
        raise ValidationError(f"missing {label}: {path}")
    require_equal(sha256_file(path), expected, f"{label} sha256")


def validate_run(
    case_manifest: dict[str, object],
    run_manifest: dict[str, object],
    result_bytes: bytes,
    golden_bytes: bytes,
) -> str:
    case = case_manifest["case"]
    if not isinstance(case, dict):
        raise ValidationError("case manifest has no case object")
    require_equal(run_manifest.get("schema"), RUN_SCHEMA, "run schema")
    require_equal(run_manifest.get("engine"), "asl", "execution engine")

    descriptor = run_manifest.get("model_descriptor_sha256")
    if not isinstance(descriptor, str) or len(descriptor) != 64:
        raise ValidationError("run manifest has no 32-byte model descriptor identity")
    try:
        bytes.fromhex(descriptor)
    except ValueError as error:
        raise ValidationError("model descriptor identity is not hexadecimal") from error
    model_descriptor = run_manifest.get("model_descriptor")
    if not isinstance(model_descriptor, dict):
        raise ValidationError("run manifest has no model descriptor object")

    stop_policy = case["stop_policy"]
    result_contract = case["result"]
    isa = case["isa"]
    if not isinstance(stop_policy, dict) or not isinstance(result_contract, dict):
        raise ValidationError("case stop or result contract is not an object")
    if not isinstance(isa, dict):
        raise ValidationError("case ISA identity is not an object")
    architecture = model_descriptor.get("architecture")
    if not isinstance(architecture, dict):
        raise ValidationError("model descriptor architecture is not an object")
    require_equal(
        architecture.get("encoding_abi"), isa["encoding_abi"],
        "model/corpus encoding ABI",
    )
    require_equal(
        architecture.get("encoding_fingerprint_sha256"),
        isa["encoding_projection_sha256"],
        "model/corpus encoding projection",
    )
    require_equal(
        architecture.get("functional_profile_id"), isa["model_profile"],
        "model/corpus functional profile",
    )
    expected_elf_isa = {
        "release": isa["version"],
        "encoding_abi": isa["encoding_abi"],
        "encoding_projection_sha256": isa["encoding_projection_sha256"],
    }
    require_equal(
        run_manifest.get("elf", {}).get("isa"), expected_elf_isa,
        "ELF ISA identity",
    )
    outcome = run_manifest.get("outcome")
    observed_result = run_manifest.get("result")
    trace = run_manifest.get("trace")
    if not isinstance(outcome, dict) or not isinstance(observed_result, dict):
        raise ValidationError("run manifest has no outcome or result object")
    if not isinstance(trace, list) or not trace:
        raise ValidationError("run manifest has no nonempty trace")

    require_equal(outcome.get("status"), "completed", "run outcome")
    require_equal(outcome.get("reason"), stop_policy["kind"], "run stop reason")
    require_equal(outcome.get("steps"), stop_policy["max_steps"], "executed steps")
    require_equal(outcome.get("final_tpc"), stop_policy["stop_pc"], "final TPC")
    require_equal(len(trace), stop_policy["max_steps"], "trace length")
    require_equal(
        [step.get("length_bits") for step in trace if isinstance(step, dict)],
        case["expected_length_sequence"],
        "instruction length sequence",
    )
    expected_trace = case.get("expected_trace")
    if not isinstance(expected_trace, list):
        raise ValidationError("case manifest has no expected trace")
    require_equal(len(trace), len(expected_trace), "expected trace length")
    for index, step in enumerate(trace):
        if not isinstance(step, dict):
            raise ValidationError(f"trace step {index} is not an object")
        require_equal(step.get("status"), 0, f"trace step {index} ABI status")
        expected_step = expected_trace[index]
        if not isinstance(expected_step, dict):
            raise ValidationError(f"expected trace step {index} is not an object")
        require_equal(step.get("step_state"), expected_step.get("step_state", 1),
                      f"trace step {index} state")
        require_equal(step.get("instruction_status"),
                      expected_step.get("instruction_status", 1),
                      f"trace step {index} instruction status")
        require_equal(step.get("fault_code"), 0, f"trace step {index} fault")
        require_equal(step.get("fault_address"), 0, f"trace step {index} fault address")
        require_equal(step.get("fault_cause"), 0, f"trace step {index} fault cause")
        require_equal(step.get("origin_pe"), 0, f"trace step {index} origin PE")
        require_equal(step.get("request_token"), expected_step.get("request_token", 0),
                      f"trace step {index} request token")
        require_equal(step.get("request_type"), expected_step.get("request_type", 0),
                      f"trace step {index} request type")
        require_equal(step.get("request_argument0"),
                      expected_step.get("request_argument0", 0),
                      f"trace step {index} request argument")
        for field in (
            "pre_tpc", "post_tpc", "pre_bpc", "post_bpc",
            "raw_instruction_le", "length_bits", "sequence",
            "memory_write_count", "memory_write_sha256", "memory_writes",
        ):
            require_equal(step.get(field), expected_step.get(field),
                          f"trace step {index} {field}")
        writes = step.get("memory_writes")
        if not isinstance(writes, list):
            raise ValidationError(f"trace step {index} has no memory-write log")
        require_equal(step.get("memory_write_count"), len(writes),
                      f"trace step {index} memory-write count")
        require_equal(step.get("memory_write_sha256"), memory_write_sha256(writes),
                      f"trace step {index} memory-write digest")
        summary_digest = step.get("bundle_tile_state_sha256")
        if not isinstance(summary_digest, str) or len(summary_digest) != 64:
            raise ValidationError(
                f"trace step {index} has no Bundle/Tile model digest"
            )
        try:
            bytes.fromhex(summary_digest)
        except ValueError as error:
            raise ValidationError(
                f"trace step {index} Bundle/Tile digest is not hexadecimal"
            ) from error
        if index > 0:
            require_equal(
                step.get("pre_tpc"),
                trace[index - 1].get("post_tpc"),
                f"trace step {index} TPC continuity",
            )

    observed_requests = [
        step.get("request_type")
        for step in trace
        if isinstance(step, dict) and step.get("step_state") == 3
    ]
    require_equal(observed_requests, case["allowed_requests"], "host request sequence")
    if stop_policy["kind"] == "exit_group":
        require_equal(outcome.get("exit_status"), stop_policy["exit_status"],
                      "exit status")
        require_equal(outcome.get("exit_argument"), trace[-1]["request_argument0"],
                      "exit argument")

    require_equal(result_bytes, golden_bytes, "result bytes")
    require_equal(observed_result.get("address"), result_contract["address"], "result address")
    require_equal(observed_result.get("size"), result_contract["size"], "result size")
    require_equal(observed_result.get("bytes_hex"), golden_bytes.hex(), "manifest result bytes")
    return descriptor


def run_case(
    gfrun: Path,
    corpus_root: Path,
    output_root: Path,
    index_row: dict[str, object],
) -> dict[str, object]:
    case_directory = corpus_root / str(index_row["directory"])
    case_manifest_path = case_directory / "manifest.json"
    validate_input_hash(case_manifest_path, index_row["manifest_sha256"], "case manifest")
    manifest = load_json(case_manifest_path)
    case = manifest.get("case")
    if not isinstance(case, dict):
        raise ValidationError("case manifest has no case object")
    require_equal(case.get("id"), index_row["id"], "case identity")

    elf_contract = case["elf"]
    golden_contract = case["golden"]
    stop_policy = case["stop_policy"]
    if not all(isinstance(value, dict) for value in (elf_contract, golden_contract, stop_policy)):
        raise ValidationError("case ELF, golden, or stop policy is not an object")
    elf = case_directory / str(elf_contract["filename"])
    golden = case_directory / str(golden_contract["filename"])
    validate_input_hash(elf, elf_contract["sha256"], "ELF")
    validate_input_hash(golden, golden_contract["sha256"], "golden")

    case_output = output_root / str(case["id"])
    case_output.mkdir(parents=True, exist_ok=True)
    result = case_output / "result.bin"
    run_manifest_path = case_output / "run.json"
    command = [
        str(gfrun),
        "-f", str(elf),
        "--stop_pc", str(stop_policy["stop_pc"]),
        "--asl_max_steps", str(stop_policy["max_steps"]),
        "--asl_result_out", str(result),
        "--asl_manifest_out", str(run_manifest_path),
    ]
    completed = subprocess.run(command, text=True, capture_output=True)
    expected_return = (
        int(stop_policy["exit_status"])
        if stop_policy["kind"] == "exit_group" else 0
    )
    if completed.returncode != expected_return:
        raise ValidationError(
            f"gfrun returned {completed.returncode} for {case['id']}; "
            f"expected {expected_return}: "
            f"{completed.stderr.strip()}"
        )
    if not result.is_file() or not run_manifest_path.is_file():
        raise ValidationError(f"gfrun did not produce outputs for {case['id']}")
    run_manifest = load_json(run_manifest_path)
    descriptor = validate_run(manifest, run_manifest, result.read_bytes(), golden.read_bytes())
    return {
        "id": case["id"],
        "status": "pass",
        "elf_sha256": elf_contract["sha256"],
        "golden_sha256": golden_contract["sha256"],
        "result_sha256": sha256_file(result),
        "run_manifest_sha256": sha256_file(run_manifest_path),
        "model_descriptor_sha256": descriptor,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--gfrun", type=Path, required=True)
    parser.add_argument("--corpus", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    arguments = parser.parse_args()
    if not arguments.gfrun.is_file():
        raise ValidationError(f"missing gfrun: {arguments.gfrun}")

    index_path = arguments.corpus / "manifest.json"
    index = load_json(index_path)
    require_equal(index.get("schema"), "pto-functional-model-corpus-index-v1", "corpus schema")
    rows = index.get("cases")
    if not isinstance(rows, list) or not rows:
        raise ValidationError("corpus index has no cases")
    arguments.output.mkdir(parents=True, exist_ok=True)
    results = [
        run_case(arguments.gfrun, arguments.corpus, arguments.output, row)
        for row in rows
        if isinstance(row, dict)
    ]
    require_equal(len(results), len(rows), "validated case count")
    descriptors = {row["model_descriptor_sha256"] for row in results}
    if len(descriptors) != 1:
        raise ValidationError("cases ran against different model descriptor identities")

    summary = {
        "schema": SUMMARY_SCHEMA,
        "status": "pass",
        "gfrun": str(arguments.gfrun.resolve()),
        "corpus_manifest_sha256": sha256_file(index_path),
        "model_descriptor_sha256": descriptors.pop(),
        "cases": results,
    }
    summary_path = arguments.output / "summary.json"
    summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")
    print(summary_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
