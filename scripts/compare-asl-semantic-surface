#!/usr/bin/env python3
"""Compare migrated ASL named declarations with an exact Git baseline."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.asl_units import APPROVED_SURFACES, compare_ref_to_tree


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--before-ref", required=True)
    parser.add_argument("--after-root", type=Path, required=True)
    parser.add_argument("--surface", action="append", choices=APPROVED_SURFACES, required=True)
    arguments = parser.parse_args()
    errors = compare_ref_to_tree(
        ROOT,
        arguments.before_ref,
        arguments.after_root,
        tuple(arguments.surface),
    )
    for error in errors:
        print(f"error: {error}", file=sys.stderr)
    if errors:
        return 1
    print("ASL named signatures and bodies preserved")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
