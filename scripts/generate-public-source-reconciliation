# These are differences between a direct binary operation and a typed source
# intrinsic. They are not unresolved semantic conflicts. The PTO-owned ASL and
# catalogs remain authoritative at the binary architecture layer.
TILE_LAYER_RESOLUTIONS = {
    "TAXPY": (
        "public-api-aligned",
        "The public intrinsic exposes destination, source, and scalar roles matching the direct operation.",
    ),
    "TPREFETCH": (
        "explicit-layer-difference",
        "The typed intrinsic carries a destination-shaped lowering context; the direct architecture operation is a destination-free address hint and writes no tile state.",
    ),
    "TDEQUANT": (
        "explicit-layer-difference",
        "The public typed API carries scale and offset tiles; the direct binary operation carries scalar scale and zero-point operands.",
    ),
    "TCONCAT": (
        "explicit-layer-difference",
        "The public typed API derives layout and offers index-tile overloads; the direct binary operation carries an explicit axis operand.",
    ),
    "TDEINTERLEAVE": (
        "public-api-aligned",
        "A public intrinsic overload exposes two destinations and one source, matching the direct operation's core roles.",
    ),
    "TINTERLEAVE": (
        "explicit-layer-difference",
        "The public typed API exposes two destination tiles; the direct binary operation has one architectural destination and two sources.",
    ),
    "TSORT": (
        "explicit-layer-difference",
        "The public source spelling is TSORT32 and carries index or temporary tiles; the direct binary operation is TSORT with explicit sort-width and descending operands.",
    ),
    "THISTOGRAM": (
        "public-api-aligned",
        "The public intrinsic exposes destination, source, index, and selected-byte roles corresponding to the direct operation.",
    ),
    "TPARTARGMAX": (
        "public-api-aligned",
        "The public intrinsic exposes value and index destinations plus left and right value/index sources.",
    ),
    "TPARTARGMIN": (
        "public-api-aligned",
        "The public intrinsic exposes value and index destinations plus left and right value/index sources.",
    ),
    "TPUSH": (
        "explicit-layer-difference",
        "The typed source helper is a producer-side API; the direct architecture operation publishes a defined source into an explicit free TileInfo slot, preserves the producer, and has no hidden pipe state.",
    ),
    "TPOP": (
        "explicit-layer-difference",
        "The typed source helper is a consumer-side API; the direct architecture operation copies an explicit source slot into a matching configured consumer and then releases that source slot, with no hidden pipe state.",
    ),
    "TALLOC": (
        "explicit-layer-difference",
        "The typed source helper requests storage; the direct architecture operation allocates TileInfo capacity bounded by TILE_CAPACITY and makes contents undefined.",
    ),
    "TFREE": (
        "explicit-layer-difference",
        "The typed source helper releases storage; the direct architecture operation clears the corresponding TileInfo allocation state.",
    ),
}

EXCLUDED_PUBLIC_TILE_OPERATIONS = {
    name: (
        "The symbol remains in the pinned public source API, but PTO ISA 0.58.4 "
        "does not accept it as a direct DavinciOO Tile operation."
    )
    for name in {
        "TALLOC",
        "TAXPY",
        "TDEINTERLEAVE",
        "TFREE",
        "TGATHERB",
        "TINTERLEAVE",
        "TPARTARGMAX",
        "TPARTARGMIN",
        "TPOP",
        "TPUSH",
        "TRESHAPE",
    }
}


def load(relative: str):
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def public_url(path: str) -> str:
    return f"{PUBLIC_REPOSITORY}/blob/{PUBLIC_COMMIT}/{path}"


def source_rows() -> list[dict]:
    rows = []
    for source in PUBLIC_SOURCES:
        row = dict(source)
        row["url"] = public_url(source["path"])
        rows.append(row)
    return rows


def scalar_rows(forms: list[dict]) -> list[dict]:
    rows = []
    for form in forms:
        family = form["semantic_family"]
        source_layer = (
            "shared-scalar-source-layer"
            if family in {"ALU", "FSU"}
            else "scalar-control-or-lowering-layer"
        )
        rows.append(
            {
                "form_id": form["form_id"],
                "mnemonic": form["mnemonic"],
                "semantic_family": family,
                "closure_status": "closed",
                "public_layer": source_layer,
            }
        )
    return rows


def tile_rows(operations: list[dict]) -> list[dict]:
    rows = []
    for operation in operations:
        name = operation["name"]
        public_symbol = "TSORT32" if name == "TSORT" else name
        if name in TILE_LAYER_RESOLUTIONS:
            closure_basis, resolution = TILE_LAYER_RESOLUTIONS[name]
        elif public_symbol not in PUBLIC_TILE_SYMBOLS:
            closure_basis = "catalog-defined-direct-binary"
            resolution = (
                "The canonical PTO catalog defines this direct binary operation; "
                "no typed public intrinsic symbol is required for the binary architecture."
            )
        else:
            closure_basis = "public-source-supported"
            resolution = (
                "The canonical PTO operation is present in the audited public "
                "intrinsic inventory with the same operation spelling."
            )
        rows.append(
            {
                "name": name,
                "family": operation["family"],
                "selector": operation.get("selector"),
                "closure_status": "closed",
                "closure_basis": closure_basis,
                "public_symbol": public_symbol,
                "public_symbol_relation": (
                    "documented-spelling-mapping"
                    if name == "TSORT"
                    else "exact-name"
                    if public_symbol in PUBLIC_TILE_SYMBOLS
                    else "catalog-defined"
                ),
                "resolution": resolution,
            }
        )
    return rows


def excluded_public_tile_rows() -> list[dict]:
    return [
        {
            "name": name,
            "public_symbol": name,
            "disposition": "source-api-only-not-a-direct-operation",
            "resolution": resolution,
        }
        for name, resolution in sorted(EXCLUDED_PUBLIC_TILE_OPERATIONS.items())
    ]


def predicate_version_boundary() -> dict:
    return {
        "active_release": "PTO ISA 0.58.4",
        "current_public_source_release": "PTO ISA v0.6 micro-instruction surface",
        "disposition": "outside-active-0.58.4-release-line",
        "accepted_mapping": None,
        "mapping_rule": (
            "No public v0.6 typed mask is mapped to a PTO ISA 0.58.4 "
            "architectural register, selector, encoding, producer, or consumer."
        ),
        "concepts": [
            {
                "id": "pto-isa-0580-warp-predicate-registers",
                "source_class": "active-0.58.4-architectural-state",
                "representation": "P0-P7",
                "width_bits": 32,
                "count": 8,
                "lifecycle": "P0 hardwired all-ones; P1-P7 reset zero; all trap-preserved",
                "accepted_producers": [],
                "accepted_consumers": [],
                "mapping_status": "closed-no-accepted-0.58.0-instruction-mapping",
            },
            {
                "id": "pto-isa-0580-machine-execution-mask",
                "source_class": "active-0.58.4-architectural-state",
                "representation": "MPAR/MSEQ execution mask",
                "width_bits": 64,
                "count": 1,
                "lifecycle": "trap-preserved; no accepted PTO instruction initializes it",
                "accepted_producers": [],
                "accepted_consumers": [],
                "mapping_status": "closed-no-accepted-PTO-consumer",
            },
            {
                "id": "public-v06-typed-mask-values",
                "source_class": "public-v0.6-micro-instruction",
                "representation": "!pto.mask<G>",
                "width_bits": [64, 128, 256],
                "count": None,
