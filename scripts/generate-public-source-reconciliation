            },
            {
                "id": "future-encoded-physical-predicate-register-mapping",
                "source_class": "future-architecture-decision",
                "representation": None,
                "width_bits": None,
                "count": None,
                "lifecycle": None,
                "accepted_producers": [],
                "accepted_consumers": [],
                "mapping_status": "undefined-do-not-infer",
            },
        ],
    }


def generate() -> dict:
    scalar = load("spec/catalog/scalar-forms.json")
    tile = load("spec/catalog/tile-operations.json")
    scalars = scalar_rows(scalar["forms"])
    tiles = tile_rows(tile["operations"])
    excluded_tiles = excluded_public_tile_rows()
    return {
        "schema_version": 2,
        "public_repository": PUBLIC_REPOSITORY,
        "public_commit": PUBLIC_COMMIT,
        "pin_history": {
            "previous_reconciliation_commit": PREVIOUS_RECONCILIATION_COMMIT,
            "issue_observation_commit": ISSUE_OBSERVATION_COMMIT,
            "current_reconciliation_commit": PUBLIC_COMMIT,
            "disposition": "the selected exact reconciliation snapshot supersedes the issue observation pin; all selected source pages are attested by content hash",
        },
        "public_sources": source_rows(),
        "public_tile_symbol_inventory": {
            "count": len(PUBLIC_TILE_SYMBOLS),
            "source_id": "public-intrinsic-api",
            "source_sha256": "d157d4c2b13c0928feb1ce775ba1fbcf49e4b3b207ee8460986ce4c2a2d57800",
            "symbols": sorted(PUBLIC_TILE_SYMBOLS),
        },
        "policy": {
            "authority": "PTO ASL, catalogs, and accepted architecture decisions define the direct binary architecture.",
            "public_api_use": "The pinned public PTO repository is source-API and lowering evidence; matching names do not import unmodeled operands or behavior.",
        },
        "public_layer_sources": {
            "shared-scalar-source-layer": [
                "public-shared-scalar-arith",
                "public-scalar-control",
            ],
            "scalar-control-or-lowering-layer": [
                "public-scalar-control",
                "public-source-precedence",
            ],
            "typed-tile-intrinsic-layer": [
                "public-intrinsic-api",
                "public-isa-scope",
                "public-assembly-model",
            ],
            "public-v0.6-predicate-mask-layer": [
                "public-v06-release-marker",
                "public-v06-micro-profile",
                "public-v06-predicate-algebra",
                "public-v06-predicate-memory",
            ],
        },
        "predicate_version_boundary": predicate_version_boundary(),
        "summary": {
            "scalar_forms": {"count": len(scalars), "closed": len(scalars), "open": 0},
            "tile_operations": {
                "count": len(tiles),
                "closed": len(tiles),
                "open": 0,
                "public_exact_name": sum(
                    row["public_symbol_relation"] == "exact-name" for row in tiles
                ),
                "public_spelling_mapping": sum(
                    row["public_symbol_relation"] == "documented-spelling-mapping"
                    for row in tiles
                ),
            },
            "excluded_public_tile_operations": {
                "count": len(excluded_tiles),
                "closed": len(excluded_tiles),
            },
            "closure_basis": {
                "public_source_supported": sum(
                    row["closure_basis"] == "public-source-supported" for row in tiles
                ),
                "catalog_defined_direct_binary": sum(
                    row["closure_basis"] == "catalog-defined-direct-binary"
                    for row in tiles
                ),
                "public_api_aligned": sum(
                    row["closure_basis"] == "public-api-aligned" for row in tiles
                ),
                "explicit_layer_difference": sum(
                    row["closure_basis"] == "explicit-layer-difference" for row in tiles
                ),
                "open": 0,
            },
        },
        "scalar_forms": scalars,
        "tile_operations": tiles,
        "excluded_public_tile_operations": excluded_tiles,
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=True) + "\n"


def verify_public_repository(repository: Path) -> None:
    resolved = subprocess.run(
        ["git", "rev-parse", f"{PUBLIC_COMMIT}^{{commit}}"],
        cwd=repository,
        check=False,
        capture_output=True,
        text=True,
    )
    if resolved.returncode != 0 or resolved.stdout.strip() != PUBLIC_COMMIT:
        raise SystemExit(
            f"public source verification failed: {PUBLIC_COMMIT} is unavailable in {repository}"
        )
    for source in PUBLIC_SOURCES:
        content = subprocess.run(
            ["git", "show", f"{PUBLIC_COMMIT}:{source['path']}"],
            cwd=repository,
            check=False,
            capture_output=True,
        )
        if content.returncode != 0:
            raise SystemExit(
                f"public source verification failed: missing {source['path']} at {PUBLIC_COMMIT}"
            )
        actual = hashlib.sha256(content.stdout).hexdigest()
        if actual != source["sha256"]:
            raise SystemExit(
                f"public source verification failed: content hash drift for {source['path']}"
            )


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    parser.add_argument(
        "--verify-source-repository",
        type=Path,
        help="verify the exact pinned public commit and source hashes in a local Git checkout",
    )
    args = parser.parse_args()
    if args.verify_source_repository is not None:
        verify_public_repository(args.verify_source_repository.resolve())
    expected = serialized()
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.exists() or OUTPUT.read_text(encoding="utf-8") != expected:
        print(
            "public source reconciliation is stale; run scripts/generate-public-source-reconciliation --write",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
