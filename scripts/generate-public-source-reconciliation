# These are differences between a direct binary operation and a typed source
# intrinsic. They are not unresolved semantic conflicts. The PTO-owned ASL and
# catalogs remain authoritative at the binary architecture layer.
TILE_LAYER_RESOLUTIONS = {
    "TAXPY": (
        "public-api-aligned",
        "The public intrinsic exposes destination, source, and scalar roles matching the direct operation.",
    ),
    "TPREFETCH": (
        "explicit-layer-difference",
        "The typed intrinsic carries a destination-shaped lowering context; the direct architecture operation is a destination-free address hint and writes no tile state.",
    ),
    "TDEQUANT": (
        "explicit-layer-difference",
        "The public typed API carries scale and offset tiles; the direct binary operation carries scalar scale and zero-point operands.",
    ),
    "TCONCAT": (
        "explicit-layer-difference",
        "The public typed API derives layout and offers index-tile overloads; the direct binary operation carries an explicit axis operand.",
    ),
    "TDEINTERLEAVE": (
        "public-api-aligned",
        "A public intrinsic overload exposes two destinations and one source, matching the direct operation's core roles.",
    ),
    "TINTERLEAVE": (
        "explicit-layer-difference",
        "The public typed API exposes two destination tiles; the direct binary operation has one architectural destination and two sources.",
    ),
    "TSORT": (
        "explicit-layer-difference",
        "The public source spelling is TSORT32 and carries index or temporary tiles; the direct binary operation is TSORT with an explicit descending flag.",
    ),
    "THISTOGRAM": (
        "public-api-aligned",
        "The public intrinsic exposes destination, source, index, and selected-byte roles corresponding to the direct operation.",
    ),
    "TPARTARGMAX": (
        "public-api-aligned",
        "The public intrinsic exposes value and index destinations plus left and right value/index sources.",
    ),
    "TPARTARGMIN": (
        "public-api-aligned",
        "The public intrinsic exposes value and index destinations plus left and right value/index sources.",
    ),
    "TPUSH": (
        "public-api-aligned",
        "The public intrinsic has typed pipe and tile/global producer overloads corresponding to direct pipe push behavior.",
    ),
    "TPOP": (
        "public-api-aligned",
        "The public intrinsic has typed pipe and tile consumer overloads corresponding to direct pipe pop behavior.",
    ),
    "TALLOC": (
        "explicit-layer-difference",
        "The public typed API accepts a GlobalTensor and returns an event; the direct binary operation claims a pipe slot and returns its address.",
    ),
    "TFREE": (
        "public-api-aligned",
        "The public intrinsic exposes typed pipe and optional global-resource release overloads corresponding to direct pipe release behavior.",
    ),
}


def load(relative: str):
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def public_url(path: str) -> str:
    return f"{PUBLIC_REPOSITORY}/blob/{PUBLIC_COMMIT}/{path}"


def source_rows() -> list[dict]:
    rows = []
    for source in PUBLIC_SOURCES:
        row = dict(source)
        row["url"] = public_url(source["path"])
        rows.append(row)
    return rows


def scalar_rows(forms: list[dict]) -> list[dict]:
    rows = []
    for form in forms:
        family = form["semantic_family"]
        source_layer = (
            "shared-scalar-source-layer"
            if family in {"ALU", "FSU"}
            else "scalar-control-or-lowering-layer"
        )
        rows.append(
            {
                "form_id": form["form_id"],
                "mnemonic": form["mnemonic"],
                "semantic_family": family,
                "closure_status": "closed",
                "public_layer": source_layer,
            }
        )
    return rows


def tile_rows(operations: list[dict], evidence_by_name: dict[str, dict]) -> list[dict]:
    rows = []
    for operation in operations:
        name = operation["name"]
        evidence = evidence_by_name[name]
        public_symbol = "TSORT32" if name == "TSORT" else name
        if public_symbol not in PUBLIC_TILE_SYMBOLS:
            raise ValueError(f"tile operation lacks an audited public symbol: {name}")
        if name in TILE_LAYER_RESOLUTIONS:
            closure_basis, resolution = TILE_LAYER_RESOLUTIONS[name]
        else:
            closure_basis = "existing-pto-contract-and-private-agreement"
            resolution = (
                "The canonical PTO operation and anonymized independent observation agree; "
                "the audited public intrinsic inventory contains the same operation spelling."
            )
        rows.append(
            {
                "name": name,
                "family": operation["family"],
                "selector": operation.get("selector"),
                "closure_status": "closed",
                "closure_basis": closure_basis,
                "private_disposition": evidence["disposition"],
                "public_symbol": public_symbol,
                "public_symbol_relation": (
                    "documented-spelling-mapping" if name == "TSORT" else "exact-name"
                ),
                "resolution": resolution,
            }
        )
    return rows


def generate() -> dict:
    scalar = load("spec/catalog/scalar-forms.json")
    tile = load("spec/catalog/tile-operations.json")
    independent = load("spec/evidence/independent-tile-crosscheck.json")
    evidence_by_name = {row["name"]: row for row in independent["operations"]}
    scalars = scalar_rows(scalar["forms"])
    tiles = tile_rows(tile["operations"], evidence_by_name)
    return {
        "schema_version": 1,
        "public_repository": PUBLIC_REPOSITORY,
        "public_commit": PUBLIC_COMMIT,
        "public_sources": source_rows(),
        "public_tile_symbol_inventory": {
            "count": len(PUBLIC_TILE_SYMBOLS),
            "source_id": "public-intrinsic-api",
            "source_sha256": "6fbd4bfb068606ee7cd00cb0b98d38e8550a026779d3d723d9a08934400e0e98",
            "symbols": sorted(PUBLIC_TILE_SYMBOLS),
        },
        "policy": {
            "authority": "PTO ASL, catalogs, and accepted architecture decisions define the direct binary architecture.",
            "public_api_use": "The pinned public PTO repository is source-API and lowering evidence; matching names do not import unmodeled operands or behavior.",
            "private_evidence_use": "The anonymized private ledger remains raw independent evidence and is not rewritten by this reconciliation.",
            "external_isa_use": "Arm ASL and other ISA specifications are review-only comparisons; PTO-owned text and tests are required for every retained rule.",
        },
        "public_layer_sources": {
            "shared-scalar-source-layer": ["public-shared-scalar-arith", "public-scalar-control"],
            "scalar-control-or-lowering-layer": ["public-scalar-control", "public-source-precedence"],
            "typed-tile-intrinsic-layer": ["public-intrinsic-api", "public-isa-scope", "public-assembly-model"],
        },
        "summary": {
            "scalar_forms": {"count": len(scalars), "closed": len(scalars), "open": 0},
            "tile_operations": {
                "count": len(tiles),
                "closed": len(tiles),
                "open": 0,
                "public_exact_name": sum(row["public_symbol_relation"] == "exact-name" for row in tiles),
                "public_spelling_mapping": sum(
                    row["public_symbol_relation"] == "documented-spelling-mapping" for row in tiles
                ),
            },
            "private_crosscheck_raw": {
                "agree": sum(row["disposition"] == "agree" for row in independent["operations"]),
                "incomplete": sum(row["disposition"] == "incomplete" for row in independent["operations"]),
                "conflict": sum(row["disposition"] == "conflict" for row in independent["operations"]),
            },
            "private_crosscheck_closure": {
                "existing_pto_contract": sum(
                    row["closure_basis"] == "existing-pto-contract-and-private-agreement" for row in tiles
                ),
                "public_api_aligned": sum(row["closure_basis"] == "public-api-aligned" for row in tiles),
                "explicit_layer_difference": sum(
                    row["closure_basis"] == "explicit-layer-difference" for row in tiles
                ),
                "open": 0,
            },
        },
        "scalar_forms": scalars,
        "tile_operations": tiles,
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=True) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    args = parser.parse_args()
    expected = serialized()
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.exists() or OUTPUT.read_text(encoding="utf-8") != expected:
        print(
            "public source reconciliation is stale; run scripts/generate-public-source-reconciliation --write",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
