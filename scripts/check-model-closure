#!/usr/bin/env python3
"""Fail closed unless compiler-to-ASL closure evidence matches this release."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.model_closure import (  # noqa: E402
    repository_expectations,
    validate_run_envelope,
    validate_semantic_payload,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--semantic-payload", required=True, type=Path)
    parser.add_argument("--run-envelope", required=True, type=Path)
    parser.add_argument("--pto-commit", required=True)
    parser.add_argument("--llvm-repository", default="https://github.com/LinxISA/llvm-project.git")
    parser.add_argument("--llvm-commit", required=True)
    parser.add_argument("--asl-model-commit", required=True)
    parser.add_argument("--workflow-commit", required=True)
    parser.add_argument("--run-id")
    parser.add_argument("--run-attempt")
    arguments = parser.parse_args()

    try:
        payload = json.loads(arguments.semantic_payload.read_text(encoding="utf-8"))
        envelope = json.loads(arguments.run_envelope.read_text(encoding="utf-8"))
        expected = repository_expectations(
            ROOT,
            pto_commit=arguments.pto_commit,
            llvm_repository=arguments.llvm_repository,
            llvm_commit=arguments.llvm_commit,
            asl_model_commit=arguments.asl_model_commit,
            workflow_commit=arguments.workflow_commit,
        )
        errors = [
            *validate_semantic_payload(payload, expected),
            *validate_run_envelope(
                envelope,
                payload,
                expected,
                expected_run_id=arguments.run_id,
                expected_run_attempt=arguments.run_attempt,
            ),
        ]
    except (OSError, ValueError, json.JSONDecodeError, subprocess.CalledProcessError) as error:
        print(f"error: cannot validate model closure: {error}", file=sys.stderr)
        return 1
    if errors:
        for error in sorted(set(errors)):
            print(f"error: {error}", file=sys.stderr)
        return 1
    print("PTO compiler-to-ASL model closure passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
