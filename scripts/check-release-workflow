#!/usr/bin/env python3
"""Check the manual exact-head release verification workflow contract."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.full_validation_workflow import (
    validate_full_validation_workflow,
    validate_nightly_workflow,
    validate_workflow_inventory,
)
from scripts.release_workflow import validate_pr_workflow, validate_release_workflow


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--workflows-dir",
        type=Path,
        default=ROOT / ".github/workflows",
    )
    arguments = parser.parse_args()
    workflows_dir = arguments.workflows_dir.resolve()
    paths = sorted(
        path
        for path in workflows_dir.iterdir()
        if path.is_file() and path.suffix.lower() in {".yml", ".yaml"}
    )
    workflows = {
        path.name: path.read_text(encoding="utf-8")
        for path in paths
    }
    required = {"asl.yml", "full-validation.yml", "nightly.yml", "release.yml"}
    missing = sorted(required - set(workflows))
    if missing:
        for name in missing:
            print(f"missing workflow: {name}", file=sys.stderr)
        return 1
    errors = validate_pr_workflow(workflows["asl.yml"])
    errors.extend(validate_full_validation_workflow(workflows["full-validation.yml"]))
    errors.extend(validate_nightly_workflow(workflows["nightly.yml"]))
    errors.extend(validate_release_workflow(workflows["release.yml"]))
    errors.extend(validate_workflow_inventory(workflows))
    if errors:
        print("release workflow contract failed:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    print("release workflow contract passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
