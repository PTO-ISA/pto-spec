#!/usr/bin/env python3
"""Check the manual exact-head release verification workflow contract."""

from __future__ import annotations

from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.release_workflow import validate_pr_workflow, validate_release_workflow


def main() -> int:
    pr_path = ROOT / ".github/workflows/asl.yml"
    workflow_path = ROOT / ".github/workflows/release.yml"
    missing = [path for path in (pr_path, workflow_path) if not path.is_file()]
    if missing:
        for path in missing:
            print(f"missing workflow: {path.relative_to(ROOT)}", file=sys.stderr)
        return 1
    errors = validate_pr_workflow(pr_path.read_text(encoding="utf-8"))
    errors.extend(validate_release_workflow(workflow_path.read_text(encoding="utf-8")))
    if errors:
        print("release workflow contract failed:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    print("release workflow contract passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
