    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x33);")
    print(f"    WriteGPR(2, Zeros{{PTO_XLEN}} + 0x{address:x});")
    print("    WriteGPR(3, Zeros{PTO_XLEN} + 0x55);")
    print("    _ReservationValid = TRUE;")
    print("    _ReservationAddress = Zeros{PTO_XLEN} + 0x900;")
    print("    _ReservationSize = 4;")
    print("    WriteMemoryByte(Zeros{PTO_XLEN} + 0x700, Zeros{8} + 0xa5);")
    print(f"    SetCurrentACR({source_acr});")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_sc_miss_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, "
        f"{row['length_bits']});"
    )
    print(
        f"    assert scalar_amo_sc_miss_s4_status_{case_index} == "
        "ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _FaultAddress == Zeros{PTO_XLEN};")
    print("    assert _MemoryEventCount == 0;")
    print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 1;")
    print("    assert !_ReservationValid;")
    print("    assert ReadMemoryByte(Zeros{PTO_XLEN} + 0x700) == Zeros{8} + 0xa5;")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print("    StopMemoryEventCapture();")


def emit_scalar_amo_ordinary_store_reservation(
    case_index: int,
    marker: str,
    *,
    size_bytes: int,
    address: int,
    preserves: bool,
) -> None:
    print(f"    // AMO-S4 {marker}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print("    _ReservationValid = TRUE;")
    print("    _ReservationAddress = Zeros{PTO_XLEN} + 0x800;")
    print("    _ReservationSize = 4;")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    Store(Zeros{{PTO_XLEN}} + 0x{address:x}, {size_bytes}, "
        "Zeros{PTO_XLEN} + 0x5a);"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _MemoryEventCount == 1;")
    print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Store;")
    print(f"    assert _MemoryEvents[[0]].agent == {case_index % 4};")
    print(
        f"    assert _MemoryEvents[[0]].address == Zeros{{PTO_XLEN}} + 0x{address:x};"
    )
    print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
    print("    assert _MemoryEvents[[0]].write_performed;")
    print("    assert _MemoryEvents[[0]].write_value == Zeros{PTO_XLEN} + 0x5a;")
    print("    assert _MemoryEvents[[0]].order == MemoryOrder_Relaxed;")
    print(
        f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
        f"{size_bytes}) == Zeros{{PTO_XLEN}} + 0x5a;"
    )
    if preserves:
        print("    assert _ReservationValid;")
        print("    assert _ReservationAddress == Zeros{PTO_XLEN} + 0x800;")
        print("    assert _ReservationSize == 4;")
    else:
        print("    assert !_ReservationValid;")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x100;")
    print("    StopMemoryEventCapture();")


def emit_scalar_amo_fence_reservation(
    case_index: int,
    marker: str,
    *,
    predecessor: int | None,
    successor: int | None,
) -> None:
    print(f"    // AMO-S4 {marker}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print("    _ReservationValid = TRUE;")
    print("    _ReservationAddress = Zeros{PTO_XLEN} + 0x800;")
    print("    _ReservationSize = 4;")
    if predecessor is None or successor is None:
        print("    _InstructionCacheEpoch = 0;")
        print("    FenceInstruction();")
        print("    assert _InstructionCacheEpoch == 1;")
        print("    assert _MemoryEventCount == 0;")
    else:
        print(f"    StartMemoryEventCapture({case_index % 4});")
        print(
            f"    FenceData({bit_literal(predecessor, 4)}, "
            f"{bit_literal(successor, 4)});"
        )
        print("    assert _MemoryEventCount == 1;")
        print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Fence;")
        print(f"    assert _MemoryEvents[[0]].agent == {case_index % 4};")
        print(
            "    assert _MemoryEvents[[0]].fence_predecessor == "
            f"{bit_literal(predecessor, 4)};"
        )
        print(
            "    assert _MemoryEvents[[0]].fence_successor == "
            f"{bit_literal(successor, 4)};"
        )
        print("    StopMemoryEventCapture();")
    print("    assert !_ReservationValid;")
    print("    assert _LastFault == Fault_None;")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x100;")


def emit_scalar_amo_dma_fault_or_restart(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    marker: str,
    *,
    source_address: int,
    destination_address: int,
    expected_fault_address: int,
    restart: bool,
) -> None:
    instruction = scalar_amo_instruction(row, family_constraints)
    print(f"    // AMO-S4 {marker}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print(f"    WriteGPR(1, Zeros{{PTO_XLEN}} + 0x{source_address:x});")
    print(f"    WriteGPR(2, Zeros{{PTO_XLEN}} + 0x{destination_address:x});")
    if destination_address + 64 <= 0x1000:
        print("    for dma_fault_init = 0 to 63 do")
        print(
            f"        WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{destination_address:x} + "
            "NaturalToWord(dma_fault_init as integer {0..262144}), "
            "Zeros{8} + 0xa5);"
        )
        print("    end;")
    if source_address + 64 <= 0x1000:
        print("    for dma_fault_source = 0 to 63 do")
        print(
            f"        WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{source_address:x} + "
            "NaturalToWord(dma_fault_source as integer {0..262144}), "
            "Zeros{8} + ((dma_fault_source * 3 + 1) MOD 256));"
        )
        print("    end;")
    print("    _ReservationValid = TRUE;")
    print("    _ReservationAddress = Zeros{PTO_XLEN} + 0x900;")
    print("    _ReservationSize = 4;")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_dma_fault_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, 32);"
    )
    print(
        f"    assert scalar_amo_dma_fault_s4_status_{case_index} == "
        "ScalarExecution_Rejected;"
    )
    print("    assert _LastFault == Fault_DataPage;")
    print(
        f"    assert _FaultAddress == Zeros{{PTO_XLEN}} + 0x{expected_fault_address:x};"
    )
    print("    assert _MemoryEventCount == 0;")
    if destination_address + 64 <= 0x1000:
        print("    for dma_fault_check = 0 to 63 do")
        print(
            f"        assert ReadMemoryByte(Zeros{{PTO_XLEN}} + 0x{destination_address:x} + "
            "NaturalToWord(dma_fault_check as integer {0..262144})) == "
            "Zeros{8} + 0xa5;"
        )
        print("    end;")
    print("    assert _ReservationValid;")
    print("    assert _ReservationAddress == Zeros{PTO_XLEN} + 0x900;")
    print("    assert _ReservationSize == 4;")
    print("    assert _TrapContexts[[0]].valid;")
    print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")
    print(
        f"    assert ReadTPC() == TrapVectorEntry(0, Zeros{{PTO_XLEN}} + "
        f"0x{expected_fault_address:x});"
    )
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print("    StopMemoryEventCapture();")
    if not restart:
        return
    repaired_source = 0x200
    repaired_destination = 0x300
    print(f"    let scalar_amo_dma_recover_s4_{case_index} = RecoverTrapContext(0);")
    print(f"    assert scalar_amo_dma_recover_s4_{case_index};")
    print("    ClearFault();")
    print(f"    WriteGPR(1, Zeros{{PTO_XLEN}} + 0x{repaired_source:x});")
    print(f"    WriteGPR(2, Zeros{{PTO_XLEN}} + 0x{repaired_destination:x});")
    print("    for dma_restart_init = 0 to 63 do")
    print(
        f"        WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{repaired_destination:x} + "
        "NaturalToWord(dma_restart_init as integer {0..262144}), "
        "Zeros{8} + 0xa5);"
    )
    print(
        f"        WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{repaired_source:x} + "
        "NaturalToWord(dma_restart_init as integer {0..262144}), "
        "Zeros{8} + ((dma_restart_init * 3 + 1) MOD 256));"
    )
    print("    end;")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_dma_restart_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, 32);"
    )
    print(
        f"    assert scalar_amo_dma_restart_s4_status_{case_index} == "
        "ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _MemoryEventCount == 16;")
    for chunk in range(8):
        value = scalar_amo_dma_chunk_value(chunk)
        source_event = chunk
        destination_event = chunk + 8
        print(f"    assert _MemoryEvents[[{source_event}]].kind == MemoryEvent_Load;")
        print(f"    assert _MemoryEvents[[{source_event}]].agent == {case_index % 4};")
        print(
            f"    assert _MemoryEvents[[{source_event}]].address == "
            f"Zeros{{PTO_XLEN}} + 0x{repaired_source + chunk * 8:x};"
        )
        print(f"    assert _MemoryEvents[[{source_event}]].size_bytes == 8;")
        print(f"    assert !_MemoryEvents[[{source_event}]].write_performed;")
        print(
            f"    assert _MemoryEvents[[{source_event}]].order == MemoryOrder_Relaxed;"
        )
        print(
            f"    assert _MemoryEvents[[{source_event}]].read_value == "
            f"{bit_literal(value, 64)};"
        )
        print(
            f"    assert _MemoryEvents[[{destination_event}]].kind == "
            "MemoryEvent_Store;"
        )
        print(
            f"    assert _MemoryEvents[[{destination_event}]].agent == "
            f"{case_index % 4};"
        )
        print(
            f"    assert _MemoryEvents[[{destination_event}]].address == "
            f"Zeros{{PTO_XLEN}} + 0x{repaired_destination + chunk * 8:x};"
        )
        print(f"    assert _MemoryEvents[[{destination_event}]].size_bytes == 8;")
        print(f"    assert _MemoryEvents[[{destination_event}]].write_performed;")
        print(
            f"    assert _MemoryEvents[[{destination_event}]].order == "
            "MemoryOrder_Relaxed;"
        )
        print(
            f"    assert _MemoryEvents[[{destination_event}]].write_value == "
            f"{bit_literal(value, 64)};"
        )
    print("    for dma_restart_check = 0 to 63 do")
    print(
        f"        assert ReadMemoryByte(Zeros{{PTO_XLEN}} + 0x{repaired_destination:x} + "
        "NaturalToWord(dma_restart_check as integer {0..262144})) == "
        "Zeros{8} + ((dma_restart_check * 3 + 1) MOD 256);"
    )
    print("    end;")
    print("    assert _ReservationValid;")
    print("    assert _ReservationAddress == Zeros{PTO_XLEN} + 0x900;")
    print("    assert _ReservationSize == 4;")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 2;")
    print("    StopMemoryEventCapture();")


def scalar_fsu_effect_class(row: dict) -> str | None:
    if row["semantic_family"] != "FSU":
        return None
    mnemonic = row["mnemonic"]
    if mnemonic == "FABS":
        return "scalar-fp-absolute"
    if mnemonic in {"FEXP", "FRECIP", "FSQRT"}:
        return "scalar-fp-unary-profile"
    if mnemonic in {"FADD", "FSUB", "FMUL", "FDIV"}:
        return "scalar-fp-binary-profile"
    if mnemonic in {"FMIN", "FMAX"}:
        return "scalar-fp-minmax"
    if mnemonic in {"FEQ", "FNE", "FLT", "FGE"}:
        return "scalar-fp-compare-quiet"
    if mnemonic in {"FEQS", "FNES", "FLTS", "FGES"}:
        return "scalar-fp-compare-signaling"
    if mnemonic in {"FMADD", "FMSUB", "FNMADD", "FNMSUB"}:
        return "scalar-fp-fused-profile"
    if mnemonic == "FCVT":
        return "scalar-fp-format-convert"
    if mnemonic in {"FCVTA", "FCVTM", "FCVTN", "FCVTP", "FCVTZ"}:
        return "scalar-fp-to-integer"
    if mnemonic in {"SCVTF", "UCVTF"}:
        return "scalar-integer-to-fp"
    raise ValueError(
        f"FSU form does not have exactly one reviewed effect class: "
        f"{row['form_id']} ({row['semantic_handler']})"
    )


def scalar_fsu_witness(
    row: dict,
    family_constraints: list[dict],
    *,
    src_type: int = 1,
    dst_type: int | None = None,
    field_values: dict[str, int] | None = None,
) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    values = {
        "RegDst": 3,
        "SrcA": 4,
        "SrcL": 1,
        "SrcR": 2,
        "SrcType": src_type,
    }
    if dst_type is not None:
        values["DstType"] = dst_type
    elif field_by_name(row, "DstType") is not None:
        class_id = scalar_fsu_effect_class(row)
        values["DstType"] = 9 if class_id == "scalar-fp-to-integer" else 1
    if field_values is not None:
        values.update(field_values)
    for field_name, value in values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"FSU effect witness violates constraint for {row['form_id']}"
            )
    return instruction


def scalar_fsu_source_type_code(src_type: int) -> int:
    if src_type == 0:
        return 0
    if src_type == 1:
        return 1
    return 31


def scalar_signed_integer_source_type_code(src_type: int) -> int:
    if src_type == 0:
        return 8
    if src_type == 1:
        return 9
    return 31


def scalar_unsigned_integer_source_type_code(src_type: int) -> int:
    if src_type == 0:
        return 0
    if src_type == 1:
        return 1
    return 31


def normalize_scalar_fp_source_py(value: int, data_type: int) -> int:
    if data_type == 1:
        return value & MASK32
    return value & MASK64


def normalize_scalar_integer_source_py(value: int, data_type: int) -> int:
    if data_type == 1:
        return value & MASK32
    if data_type == 9:
        return sign_extended(value, 32)
    return value & MASK64


def normalize_scalar_fp_result_py(value: int, data_type: int) -> int:
    widths = {
        1: 32,
        2: 19,
        3: 32,
        4: 16,
        5: 16,
        6: 8,
        7: 8,
        8: 8,
        9: 6,
        10: 6,
        11: 4,
        12: 4,
        13: 8,
        14: 9,
    }
    return value & ((1 << widths.get(data_type, 64)) - 1)


def normalize_scalar_integer_result_py(value: int, data_type: int) -> int:
    if data_type in {0, 8}:
        return value & MASK64
    if data_type in {1, 2, 3, 4, 5, 6, 7}:
        return value & (
            (1 << {1: 32, 2: 16, 3: 8, 4: 4, 5: 2, 6: 1, 7: 1}[data_type]) - 1
        )
    if data_type in {9, 10, 11, 12, 13, 14}:
        return sign_extended(
            value, {9: 32, 10: 16, 11: 8, 12: 4, 13: 2, 14: 1}[data_type]
        )
    raise ValueError(f"unsupported scalar integer result type: {data_type}")


def scalar_fp32_is_nan(value: int) -> bool:
    value &= MASK32
    return (value >> 23) & 0xFF == 0xFF and value & 0x7FFFFF != 0


def scalar_fp32_is_signaling_nan(value: int) -> bool:
    value &= MASK32
    return scalar_fp32_is_nan(value) and value & 0x400000 == 0


def scalar_fp32_is_zero(value: int) -> bool:
    return value & 0x7FFFFFFF == 0


def scalar_fp32_order_key(value: int) -> int:
    value &= MASK32
    return (~value & MASK32) if value & 0x80000000 else value ^ 0x80000000


def scalar_fp_width(src_type: int) -> int:
    if src_type == 0:
        return 64
    if src_type == 1:
        return 32
    raise ValueError(f"unsupported decoded FSU source type: {src_type}")


def scalar_fp_is_nan(value: int, src_type: int) -> bool:
    width = scalar_fp_width(src_type)
    fraction_width = 52 if width == 64 else 23
    exponent_width = 11 if width == 64 else 8
    mask = (1 << width) - 1
    value &= mask
    exponent = (value >> fraction_width) & ((1 << exponent_width) - 1)
    fraction = value & ((1 << fraction_width) - 1)
    return exponent == (1 << exponent_width) - 1 and fraction != 0


def scalar_fp_is_signaling_nan(value: int, src_type: int) -> bool:
    fraction_width = 52 if scalar_fp_width(src_type) == 64 else 23
    return (
        scalar_fp_is_nan(value, src_type) and value & (1 << (fraction_width - 1)) == 0
    )


def scalar_fp_is_zero(value: int, src_type: int) -> bool:
    width = scalar_fp_width(src_type)
    return value & ((1 << (width - 1)) - 1) == 0


def scalar_fp_order_key(value: int, src_type: int) -> int:
    width = scalar_fp_width(src_type)
    mask = (1 << width) - 1
    sign = 1 << (width - 1)
    value &= mask
    return (~value & mask) if value & sign else value ^ sign


def scalar_fp_encoding_equal_py(left: int, right: int, src_type: int) -> bool:
    width = scalar_fp_width(src_type)
    mask = (1 << width) - 1
    if scalar_fp_is_nan(left, src_type) or scalar_fp_is_nan(right, src_type):
        return False
    return (left & mask) == (right & mask) or (
        scalar_fp_is_zero(left, src_type) and scalar_fp_is_zero(right, src_type)
    )


def scalar_fp_encoding_less_py(left: int, right: int, src_type: int) -> bool:
    if scalar_fp_is_nan(left, src_type) or scalar_fp_is_nan(right, src_type):
        return False
    if scalar_fp_is_zero(left, src_type) and scalar_fp_is_zero(right, src_type):
        return False
    return scalar_fp_order_key(left, src_type) < scalar_fp_order_key(right, src_type)


def scalar_fp_encoding_compare_py(
    operation: str, left: int, right: int, src_type: int
) -> bool:
    if scalar_fp_is_nan(left, src_type) or scalar_fp_is_nan(right, src_type):
        return False
    equal = scalar_fp_encoding_equal_py(left, right, src_type)
    less = scalar_fp_encoding_less_py(left, right, src_type)
    if operation == "EQ":
        return equal
    if operation == "NE":
        return not equal
    if operation == "LT":
        return less
    if operation == "LE":
        return less or equal
    if operation == "GT":
        return not less and not equal
    if operation == "GE":
        return not less
    raise ValueError(f"unclassified floating comparison: {operation}")


def scalar_fp_minmax_py(operation: str, left: int, right: int, src_type: int) -> int:
    width = scalar_fp_width(src_type)
    mask = (1 << width) - 1
    sign = 1 << (width - 1)
    left &= mask
    right &= mask
    left_nan = scalar_fp_is_nan(left, src_type)
    right_nan = scalar_fp_is_nan(right, src_type)
    if left_nan and right_nan:
        return 0x7FF8000000000000 if width == 64 else 0x7FC00000
    if left_nan:
        return right
    if right_nan:
        return left
    if scalar_fp_is_zero(left, src_type) and scalar_fp_is_zero(right, src_type):
        if operation == "MAX":
            return 0
        if left & sign or right & sign:
            return sign
        return 0
    less = scalar_fp_encoding_less_py(left, right, src_type)
    if operation == "MIN":
        return left if less else right
    if operation == "MAX":
        return right if less else left
    raise ValueError(f"unclassified floating min/max: {operation}")


def scalar_fsu_operation(row: dict) -> str:
    mnemonic = row["mnemonic"]
    if mnemonic in {"FEQ", "FEQS"}:
        return "EQ"
    if mnemonic in {"FNE", "FNES"}:
        return "NE"
    if mnemonic in {"FLT", "FLTS"}:
        return "LT"
    if mnemonic in {"FGE", "FGES"}:
        return "GE"
    return mnemonic.removeprefix("F")


def scalar_fsu_success_inputs(row: dict) -> tuple[int, int, int, int, int]:
    class_id = scalar_fsu_effect_class(row)
    src_type = 1
    dst_type = 1
    left = 0x1234567880000001
    right = 0x11111111
    addend = 0x76543210
    if class_id == "scalar-fp-absolute":
        left = 0x12345678BF800001
    elif class_id == "scalar-fp-unary-profile" and row["mnemonic"] == "FRECIP":
        left = 3
    elif class_id == "scalar-fp-binary-profile" and row["mnemonic"] == "FDIV":
        left = 17
        right = 3
    elif class_id == "scalar-fp-minmax":
        left = 0x80000000
        right = 0
    elif class_id.startswith("scalar-fp-compare"):
        operation = scalar_fsu_operation(row)
        left, right = {
            "EQ": (0x3F800000, 0x3F800000),
            "NE": (0x3F800000, 0x40000000),
            "LT": (0xBF800000, 0x3F800000),
            "GE": (0x40000000, 0x3F800000),
        }[operation]
    elif class_id == "scalar-fp-format-convert":
        dst_type = 4
    elif class_id == "scalar-fp-to-integer":
        dst_type = 9
        left = 0x1234567880000001
    elif class_id == "scalar-integer-to-fp":
        dst_type = 4
        left = 0x1234567880000001
    return left, right, addend, src_type, dst_type


def scalar_fsu_expected(
    row: dict, left: int, right: int, addend: int, src_type: int, dst_type: int
) -> tuple[int, int]:
    class_id = scalar_fsu_effect_class(row)
    source_type = scalar_fsu_source_type_code(src_type)
    left_fp = normalize_scalar_fp_source_py(left, source_type)
    right_fp = normalize_scalar_fp_source_py(right, source_type)
    addend_fp = normalize_scalar_fp_source_py(addend, source_type)
    mnemonic = row["mnemonic"]
    flags = 0
    if class_id == "scalar-fp-absolute":
        result = left_fp & ((1 << (scalar_fp_width(src_type) - 1)) - 1)
        return normalize_scalar_fp_result_py(result, source_type), flags
    if class_id == "scalar-fp-unary-profile":
        if mnemonic == "FEXP":
            result = left_fp + 1
        elif mnemonic == "FRECIP":
            if scalar_fp_is_zero(left_fp, src_type):
                return normalize_scalar_fp_result_py(MASK64, source_type), 2
            result = MASK64 // left_fp
        elif mnemonic == "FSQRT":
            result = left_fp
        else:
            raise ValueError(f"unclassified FSU unary operation: {mnemonic}")
        return normalize_scalar_fp_result_py(result, source_type), flags
    if class_id == "scalar-fp-binary-profile":
        operation = scalar_fsu_operation(row)
        if operation == "ADD":
            result = left_fp + right_fp
        elif operation == "SUB":
            result = left_fp - right_fp
        elif operation == "MUL":
            result = left_fp * right_fp
        elif operation == "DIV":
            if scalar_fp_is_zero(right_fp, src_type):
                return normalize_scalar_fp_result_py(MASK64, source_type), 2
            result = left_fp // right_fp
        else:
            raise ValueError(f"unclassified FSU binary operation: {mnemonic}")
        return normalize_scalar_fp_result_py(result, source_type), flags
    if class_id == "scalar-fp-minmax":
        result = scalar_fp_minmax_py(
            scalar_fsu_operation(row), left_fp, right_fp, src_type
        )
        if scalar_fp_is_signaling_nan(left_fp, src_type) or scalar_fp_is_signaling_nan(
            right_fp, src_type
        ):
            flags = 1
        return normalize_scalar_fp_result_py(result, source_type), flags
    if class_id.startswith("scalar-fp-compare"):
        operation = scalar_fsu_operation(row)
        signaling = class_id == "scalar-fp-compare-signaling"
        any_nan = scalar_fp_is_nan(left_fp, src_type) or scalar_fp_is_nan(
            right_fp, src_type
        )
        any_snan = scalar_fp_is_signaling_nan(
            left_fp, src_type
        ) or scalar_fp_is_signaling_nan(right_fp, src_type)
        if (signaling and any_nan) or any_snan:
            flags = 1
        result = (
            1
            if scalar_fp_encoding_compare_py(operation, left_fp, right_fp, src_type)
            else 0
        )
        return result, flags
    if class_id == "scalar-fp-fused-profile":
        product = (left_fp * right_fp) & MASK64
        operation = mnemonic.removeprefix("F")
        if operation == "MADD":
            result = product + addend_fp
        elif operation == "MSUB":
            result = product - addend_fp
        elif operation == "NMADD":
            result = -((product + addend_fp) & MASK64)
        elif operation == "NMSUB":
            result = -((product - addend_fp) & MASK64)
        else:
            raise ValueError(f"unclassified FSU fused operation: {mnemonic}")
        return normalize_scalar_fp_result_py(result, source_type), flags
    if class_id == "scalar-fp-format-convert":
        return normalize_scalar_fp_result_py(left_fp, dst_type), flags
    if class_id == "scalar-fp-to-integer":
        return normalize_scalar_integer_result_py(left_fp, dst_type), flags
    if class_id == "scalar-integer-to-fp":
        if mnemonic == "SCVTF":
            integer_type = scalar_signed_integer_source_type_code(src_type)
        else:
            integer_type = scalar_unsigned_integer_source_type_code(src_type)
        result = normalize_scalar_integer_source_py(left, integer_type)
        return normalize_scalar_fp_result_py(result, dst_type), flags
    raise ValueError(f"unhandled FSU effect class: {class_id}")


def scalar_fsu_sensitivity_inputs(row: dict) -> tuple[int, int, int, int, int]:
    class_id = scalar_fsu_effect_class(row)
    left, right, addend, src_type, dst_type = scalar_fsu_success_inputs(row)
    if class_id == "scalar-fp-absolute":
        left = 0x3F000003
    elif class_id in {
        "scalar-fp-unary-profile",
        "scalar-fp-format-convert",
        "scalar-fp-to-integer",
        "scalar-integer-to-fp",
    }:
        left = 5
    elif class_id.startswith("scalar-fp-compare"):
        operation = scalar_fsu_operation(row)
        left, right = {
            "EQ": (0x3F800000, 0x40000000),
            "NE": (0x3F800000, 0x3F800000),
            "LT": (0x40000000, 0x3F800000),
            "GE": (0xBF800000, 0x3F800000),
        }[operation]
    elif class_id == "scalar-fp-minmax":
        left = 0xBF800000
        right = 0x3F800000
    elif class_id == "scalar-fp-fused-profile":
        addend = 0x13572468
    else:
        right = 5
    return left, right, addend, src_type, dst_type


def emit_scalar_fsu_setup(
    left: int,
    right: int,
    addend: int,
    destination: int,
    flags: int = 0,
    rounding_mode: int = 2,
) -> None:
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    _SystemRegisters.core_state = Zeros{PTO_XLEN};")
    print(f"    _SystemRegisters.core_state[39:37] = {bit_literal(rounding_mode, 3)};")
    if flags != 0:
        print(f"    _SystemRegisters.core_state[36:32] = {bit_literal(flags, 5)};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print(f"    WriteGPR(1, {bit_literal(left, 64)});")
    print(f"    WriteGPR(2, {bit_literal(right, 64)});")
    print(f"    WriteGPR(3, {bit_literal(destination, 64)});")
    print(f"    WriteGPR(4, {bit_literal(addend, 64)});")


def emit_scalar_fsu_success(
    row: dict,
    effect_index: int,
    scenario_name: str,
    witness: int,
    left: int,
    right: int,
    addend: int,
    expected: int,
    expected_flags: int,
    *,
    sticky_flags: int = 0,
    compare_against: int | None = None,
    rounding_mode: int = 2,
) -> None:
    destination_sentinel = 0x5555555555555555
    observed_flags = sticky_flags | expected_flags
    variable = f"scalar_fsu_{scenario_name}_status_{effect_index}"
    emit_scalar_fsu_setup(
        left, right, addend, destination_sentinel, sticky_flags, rounding_mode
    )
    print(
        f"    let {variable} = "
        f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
    )
    print(f"    assert {variable} == ScalarExecution_Executed;")
    print("    assert _LastFault == Fault_None;")
    print(f"    assert ReadGPR(3) == {bit_literal(expected, 64)};")
    if compare_against is not None:
        print(f"    assert ReadGPR(3) != {bit_literal(compare_against, 64)};")
    print(f"    assert ScalarFPFlags() == {bit_literal(observed_flags, 5)};")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
    if field_by_name(row, "SrcR") is not None:
        print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
    if field_by_name(row, "SrcA") is not None:
        print(f"    assert ReadGPR(4) == {bit_literal(addend, 64)};")


def emit_scalar_fsu_fault(
    row: dict,
    effect_index: int,
    scenario_name: str,
    witness: int,
    left: int,
    right: int,
    addend: int,
    *,
    sticky_flags: int = 0x1F,
) -> None:
    destination_sentinel = 0x5555555555555555
    variable = f"scalar_fsu_{scenario_name}_fault_status_{effect_index}"
    emit_scalar_fsu_setup(left, right, addend, destination_sentinel, sticky_flags)
    for index in range(4):
        print(f"    _TQueue[[{index}]] = Zeros{{PTO_XLEN}} + 0x{0x41 + index:x};")
        print(f"    _UQueue[[{index}]] = Zeros{{PTO_XLEN}} + 0x{0x51 + index:x};")
    print(
        f"    let {variable} = "
        f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
    )
    print(f"    assert {variable} == ScalarExecution_Rejected;")
    print("    assert _LastFault == Fault_IllegalInstruction;")
    print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
    print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
    if field_by_name(row, "SrcR") is not None:
        print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
    if field_by_name(row, "SrcA") is not None:
        print(f"    assert ReadGPR(4) == {bit_literal(addend, 64)};")
    print(f"    assert ScalarFPFlags() == {bit_literal(sticky_flags, 5)};")
    for index in range(4):
        print(
            f"    assert ReadTemporaryQueue(TRUE, {index}) == "
            f"Zeros{{PTO_XLEN}} + 0x{0x41 + index:x};"
        )
        print(
            f"    assert ReadTemporaryQueue(FALSE, {index}) == "
            f"Zeros{{PTO_XLEN}} + 0x{0x51 + index:x};"
        )
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x100;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print("    assert _TrapContexts[[0]].valid;")
    print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")


def scalar_fsu_type_cases(row: dict) -> list[tuple[str, int, int, bool]]:
    if field_by_name(row, "DstType") is None:
        return [
            (f"src-{src_type:02b}", src_type, 1, src_type < 2) for src_type in range(4)
        ]
    cases = [
        (f"src-{src_type:02b}-dst-{dst_type:02d}", src_type, dst_type, True)
        for src_type in range(2)
        for dst_type in range(15)
    ]
    cases.extend(
        (f"src-{src_type:02b}-dst-00", src_type, 0, False) for src_type in (2, 3)
    )
    cases.extend(
        (f"src-00-dst-{dst_type:02d}", 0, dst_type, False) for dst_type in range(15, 32)
    )
    cases.append(("src-10-dst-31-both-invalid", 2, 31, False))
    return cases


def scalar_fsu_boundary_values(src_type: int) -> dict[str, int]:
    if src_type == 0:
        return {
            "positive_zero": 0x0000000000000000,
            "negative_zero": 0x8000000000000000,
            "positive_one": 0x3FF0000000000000,
            "positive_two": 0x4000000000000000,
            "negative_one": 0xBFF0000000000000,
            "positive_infinity": 0x7FF0000000000000,
            "negative_infinity": 0xFFF0000000000000,
            "quiet_nan": 0x7FF8000000000042,
            "signaling_nan": 0x7FF0000000000042,
            "all_ones": MASK64,
            "maximum_finite": 0x7FEFFFFFFFFFFFFF,
        }
    return {
        "positive_zero": 0x00000000,
        "negative_zero": 0x80000000,
        "positive_one": 0x3F800000,
        "positive_two": 0x40000000,
        "negative_one": 0xBF800000,
        "positive_infinity": 0x7F800000,
        "negative_infinity": 0xFF800000,
        "quiet_nan": 0x7FC00042,
        "signaling_nan": 0x7F800042,
        "all_ones": MASK32,
        "maximum_finite": 0x7F7FFFFF,
    }


def scalar_fsu_boundary_cases(
    row: dict,
) -> list[tuple[str, int, int, int, int, int]]:
    class_id = scalar_fsu_effect_class(row)
    cases: list[tuple[str, int, int, int, int, int]] = []
    for src_type in (0, 1):
        values = scalar_fsu_boundary_values(src_type)
        width_label = "fp64" if src_type == 0 else "fp32"
        if class_id == "scalar-fp-absolute":
            names = (
                "positive_zero",
                "negative_zero",
                "positive_one",
                "negative_one",
                "positive_infinity",
                "negative_infinity",
                "quiet_nan",
                "signaling_nan",
            )
            for name in names:
                cases.append((f"{width_label}-{name}", values[name], 3, 5, src_type, 1))
        elif class_id == "scalar-fp-unary-profile":
            for name in ("positive_zero", "negative_zero", "positive_one", "all_ones"):
                cases.append((f"{width_label}-{name}", values[name], 3, 5, src_type, 1))
        elif class_id == "scalar-fp-binary-profile":
            pairs = (
                ("positive-zero-pair", "positive_zero", "positive_zero"),
                ("negative-zero-divisor", "positive_one", "negative_zero"),
                ("ones", "positive_one", "positive_one"),
                ("maximum-left", "maximum_finite", "positive_one"),
                ("maximum-right", "positive_one", "maximum_finite"),
                ("signed-carriers", "negative_one", "positive_two"),
                ("nan-carriers", "quiet_nan", "signaling_nan"),
            )
            for label, left_name, right_name in pairs:
                cases.append(
                    (
                        f"{width_label}-{label}",
                        values[left_name],
                        values[right_name],
                        5,
                        src_type,
                        1,
                    )
                )
        elif class_id in {
            "scalar-fp-minmax",
            "scalar-fp-compare-quiet",
            "scalar-fp-compare-signaling",
        }:
            pairs = (
                ("ordered-less", "positive_one", "positive_two"),
                ("ordered-greater", "positive_two", "positive_one"),
                ("equal", "positive_one", "positive_one"),
                ("positive-negative-zero", "positive_zero", "negative_zero"),
                ("negative-positive-zero", "negative_zero", "positive_zero"),
                (
                    "positive-negative-infinity",
                    "positive_infinity",
                    "negative_infinity",
                ),
                (
                    "negative-positive-infinity",
                    "negative_infinity",
                    "positive_infinity",
                ),
                ("left-qnan", "quiet_nan", "positive_one"),
                ("right-qnan", "positive_one", "quiet_nan"),
                ("left-snan", "signaling_nan", "positive_one"),
                ("right-snan", "positive_one", "signaling_nan"),
                ("two-qnan", "quiet_nan", "quiet_nan"),
                ("two-snan", "signaling_nan", "signaling_nan"),
                ("two-positive-infinity", "positive_infinity", "positive_infinity"),
                ("two-negative-infinity", "negative_infinity", "negative_infinity"),
            )
            for label, left_name, right_name in pairs:
                cases.append(
                    (
                        f"{width_label}-{label}",
                        values[left_name],
                        values[right_name],
                        5,
                        src_type,
                        1,
                    )
                )
        elif class_id == "scalar-fp-fused-profile":
            triples = (
                ("zeros", "positive_zero", "positive_zero", "positive_zero"),
                ("ones", "positive_one", "positive_one", "positive_one"),
                ("signed", "negative_one", "positive_two", "positive_one"),
                ("maximum", "maximum_finite", "positive_two", "positive_one"),
                ("nan-carriers", "quiet_nan", "signaling_nan", "all_ones"),
            )
            for label, addend_name, left_name, right_name in triples:
                cases.append(
                    (
                        f"{width_label}-{label}",
                        values[left_name],
                        values[right_name],
                        values[addend_name],
                        src_type,
                        1,
                    )
                )
        else:
            for name in (
                "positive_zero",
                "negative_zero",
                "maximum_finite",
                "all_ones",
            ):
                destination_type = 9 if class_id == "scalar-fp-to-integer" else 4
                cases.append(
                    (
                        f"{width_label}-{name}",
                        values[name],
                        3,
                        5,
                        src_type,
                        destination_type,
                    )
                )
    return cases


def scalar_fsu_active_rounding_consumer(row: dict) -> bool:
    return scalar_fsu_effect_class(row) in {
        "scalar-fp-unary-profile",
        "scalar-fp-binary-profile",
        "scalar-fp-fused-profile",
        "scalar-fp-format-convert",
        "scalar-integer-to-fp",
    }


def scalar_fsu_fixed_rounding_consumer(row: dict) -> bool:
    return scalar_fsu_effect_class(row) == "scalar-fp-to-integer"


def scalar_fsu_sticky_inputs(row: dict) -> tuple[int, int, int, int, int]:
    left, right, addend, src_type, dst_type = scalar_fsu_success_inputs(row)
    class_id = scalar_fsu_effect_class(row)
    values = scalar_fsu_boundary_values(src_type)
    if class_id in {"scalar-fp-minmax", "scalar-fp-compare-quiet"}:
        left = values["signaling_nan"]
        right = values["positive_one"]
    elif class_id == "scalar-fp-compare-signaling":
        left = values["quiet_nan"]
        right = values["positive_one"]
    elif row["mnemonic"] == "FDIV":
        right = values["negative_zero"]
    elif row["mnemonic"] == "FRECIP":
        left = values["negative_zero"]
    return left, right, addend, src_type, dst_type


def scalar_fsu_alias_source_value(selector: int) -> int:
    values = {
        0: 0,
        5: 0x000000003F800005,
        24: 0x000000003F800011,
        25: 0x000000003F800012,
        26: 0x000000003F800013,
        27: 0x000000003F800014,
        28: 0x000000003F800021,
        29: 0x000000003F800022,
        30: 0x000000003F800023,
        31: 0x000000003F800024,
    }
    return values[selector]


def emit_scalar_fsu_alias_setup() -> None:
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    _SystemRegisters.core_state = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x3f800001);")
    print("    WriteGPR(2, Zeros{PTO_XLEN} + 0x40000002);")
    print("    WriteGPR(3, Zeros{PTO_XLEN} + 0x5555555555555555);")
    print("    WriteGPR(4, Zeros{PTO_XLEN} + 0x40400004);")
    print("    WriteGPR(5, Zeros{PTO_XLEN} + 0x3f800005);")
    for index, value in enumerate((0x3F800011, 0x3F800012, 0x3F800013, 0x3F800014)):
        print(f"    _TQueue[[{index}]] = {bit_literal(value, 64)};")
    for index, value in enumerate((0x3F800021, 0x3F800022, 0x3F800023, 0x3F800024)):
        print(f"    _UQueue[[{index}]] = {bit_literal(value, 64)};")


def scalar_fsu_alias_operand_values(
    field_values: dict[str, int],
) -> tuple[int, int, int]:
    def value(field: str, default_selector: int) -> int:
        selector = field_values.get(field, default_selector)
        if selector in {1, 2, 4}:
            return {1: 0x3F800001, 2: 0x40000002, 4: 0x40400004}[selector]
        return scalar_fsu_alias_source_value(selector)

    return value("SrcL", 1), value("SrcR", 2), value("SrcA", 4)


def emit_scalar_fsu_alias_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    label: str,
    field_values: dict[str, int],
) -> None:
    class_id = scalar_fsu_effect_class(row)
    dst_type = (
        9
        if class_id == "scalar-fp-to-integer"
        else 4
        if class_id in {"scalar-fp-format-convert", "scalar-integer-to-fp"}
        else 1
    )
    witness = scalar_fsu_witness(
        row,
        family_constraints,
        src_type=1,
        dst_type=dst_type,
        field_values=field_values,
    )
    left, right, addend = scalar_fsu_alias_operand_values(field_values)
    expected, expected_flags = scalar_fsu_expected(
        row, left, right, addend, 1, dst_type
    )
    destination = field_values.get("RegDst", 3)
    emit_scalar_fsu_alias_setup()
    print(f"    // FSU-ALIAS-DECODED: {label}")
    print(
        f"    let scalar_fsu_alias_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_fsu_alias_status_{case_index} == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print(f"    assert ScalarFPFlags() == {bit_literal(expected_flags, 5)};")
    if destination < 24:
        if destination != 0:
            print(f"    assert ReadGPR({destination}) == {bit_literal(expected, 64)};")
        for index, value in enumerate((0x3F800011, 0x3F800012, 0x3F800013, 0x3F800014)):
            print(
                f"    assert ReadTemporaryQueue(TRUE, {index}) == {bit_literal(value, 64)};"
            )
        for index, value in enumerate((0x3F800021, 0x3F800022, 0x3F800023, 0x3F800024)):
            print(
                f"    assert ReadTemporaryQueue(FALSE, {index}) == {bit_literal(value, 64)};"
            )
    elif destination == 30:
        print(
            f"    assert ReadTemporaryQueue(FALSE, 0) == {bit_literal(expected, 64)};"
        )
        print(
            "    assert ReadTemporaryQueue(FALSE, 1) == Zeros{PTO_XLEN} + 0x3f800021;"
        )
        print(
            "    assert ReadTemporaryQueue(FALSE, 2) == Zeros{PTO_XLEN} + 0x3f800022;"
        )
        print(
            "    assert ReadTemporaryQueue(FALSE, 3) == Zeros{PTO_XLEN} + 0x3f800023;"
        )
        for index, value in enumerate((0x3F800011, 0x3F800012, 0x3F800013, 0x3F800014)):
            print(
                f"    assert ReadTemporaryQueue(TRUE, {index}) == {bit_literal(value, 64)};"
            )
    elif destination == 31:
        print(f"    assert ReadTemporaryQueue(TRUE, 0) == {bit_literal(expected, 64)};")
        print("    assert ReadTemporaryQueue(TRUE, 1) == Zeros{PTO_XLEN} + 0x3f800011;")
        print("    assert ReadTemporaryQueue(TRUE, 2) == Zeros{PTO_XLEN} + 0x3f800012;")
        print("    assert ReadTemporaryQueue(TRUE, 3) == Zeros{PTO_XLEN} + 0x3f800013;")
        for index, value in enumerate((0x3F800021, 0x3F800022, 0x3F800023, 0x3F800024)):
            print(
                f"    assert ReadTemporaryQueue(FALSE, {index}) == {bit_literal(value, 64)};"
            )
    else:
        for index, value in enumerate((0x3F800011, 0x3F800012, 0x3F800013, 0x3F800014)):
            print(
                f"    assert ReadTemporaryQueue(TRUE, {index}) == {bit_literal(value, 64)};"
            )
        for index, value in enumerate((0x3F800021, 0x3F800022, 0x3F800023, 0x3F800024)):
            print(
                f"    assert ReadTemporaryQueue(FALSE, {index}) == {bit_literal(value, 64)};"
            )
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")


def scalar_fsu_alias_cases(row: dict) -> list[tuple[str, dict[str, int]]]:
    cases: list[tuple[str, dict[str, int]]] = []
    for destination in (0, 24, 25, 26, 27, 28, 29, 30, 31):
        cases.append(
            (f"{row['form_id']}-destination-{destination}", {"RegDst": destination})
        )
    source_fields = [
        field["name"]
        for field in row["fields"]
        if field["name"] in SCALAR_SOURCE_FIELDS
    ]
    for field in source_fields:
        for selector in (0, 5, 24, 25, 26, 27, 28, 29, 30, 31):
            cases.append(
                (
                    f"{row['form_id']}-{field.lower()}-selector-{selector}",
                    {field: selector},
                )
            )
        cases.append(
            (
                f"{row['form_id']}-{field.lower()}-overlaps-destination",
                {field: 5, "RegDst": 5},
            )
        )
    cases.append((f"{row['form_id']}-t1-push-t-snapshot", {"SrcL": 24, "RegDst": 31}))
    cases.append((f"{row['form_id']}-u1-push-u-snapshot", {"SrcL": 28, "RegDst": 30}))
    if len(source_fields) > 1:
        cases.append(
            (
                f"{row['form_id']}-all-sources-same-gpr",
                {field: 5 for field in source_fields},
            )
        )
    return cases


def tile_argument_expression(argument: dict) -> str:
    if set(argument) == {"operand"}:
        if argument["operand"] == "numeric_control":
            return "numeric_control"
        return f"operands.{argument['operand']}"
    if set(argument) == {"constant"}:
        return argument["constant"]
    if set(argument) == {"runtime"}:
        runtime = argument["runtime"]
        if runtime == "CurrentBundlePadValue":
            return "CurrentBundlePadValue()"
        raise ValueError(f"unknown tile runtime binding: {runtime}")
    raise ValueError(f"invalid tile binding argument: {argument!r}")


def agu_metadata(row: dict) -> dict:
    mnemonic_parts = row["mnemonic"].split(".")
    core_index = 1 if mnemonic_parts[0] in {"C", "HL"} else 0
    core = mnemonic_parts[core_index]
    suffixes = set(mnemonic_parts[core_index + 1 :])
    action_names = {
        "ExecuteScalarLoad": "Load",
        "ExecuteScalarLoadPair": "LoadPair",
        "ExecuteScalarStore": "Store",
        "ExecuteScalarStorePair": "StorePair",
        "ScalarPrefetch": "Prefetch",
    }
    action = action_names[row["semantic_handler"]]
    if action == "Prefetch":
        size_bytes = 1
    elif core.startswith(("LB", "SB")):
        size_bytes = 1
    elif core.startswith(("LH", "SH")):
        size_bytes = 2
    elif core.startswith(("LW", "SW")):
        size_bytes = 4
    elif core.startswith(("LD", "SD")):
        size_bytes = 8
    else:
        raise ValueError(f"unclassified AGU width: {row['mnemonic']}")

    field_names = {field["name"] for field in row["fields"]}
    if "PCR" in suffixes:
        address_kind = "PCRelative"
    elif mnemonic_parts[0] == "C":
        address_kind = "Compressed"
    elif "SrcRType" in field_names:
        address_kind = "Register"
    else:
        address_kind = "Immediate"

    if suffixes & {"PR", "UPR"}:
        update_mode = "PreIndex"
    elif suffixes & {"PO", "UPO"}:
        update_mode = "PostIndex"
    else:
        update_mode = "None"

    unscaled = bool(suffixes & {"U", "UPR", "UPO", "UA"})
    if address_kind == "PCRelative":
        offset_scale = 2
    elif address_kind == "Register" and "shamt" in field_names:
        offset_scale = 0
    elif unscaled:
        offset_scale = 0
    else:
        offset_scale = int(math.log2(size_bytes))

    signed_load = (
        action in {"Load", "LoadPair"}
        and core.startswith(("LB", "LH", "LW"))
        and not core.startswith(("LBU", "LHU", "LWU"))
    )
    return {
        "action": action,
        "address_kind": address_kind,
        "offset_scale": offset_scale,
        "prefetch_returns_address": row["mnemonic"] in {"HL.PRF.A", "HL.PRFI.UA"},
        "signed_load": signed_load,
        "size_bytes": size_bytes,
        "update_mode": update_mode,
    }


def scalar_agu_effect_class(row: dict) -> str | None:
    if row["semantic_family"] != "AGU":
        return None
    metadata = agu_metadata(row)
    action = metadata["action"]
    update_mode = metadata["update_mode"]
    if action == "Load":
        return (
            "scalar-agu-load" if update_mode == "None" else "scalar-agu-load-writeback"
        )
    if action == "LoadPair":
        return "scalar-agu-load-pair"
    if action == "Store":
        return (
            "scalar-agu-store"
            if update_mode == "None"
            else "scalar-agu-store-writeback"
        )
    if action == "StorePair":
        return "scalar-agu-store-pair"
    if action == "Prefetch":
        return (
            "scalar-agu-prefetch-address"
            if metadata["prefetch_returns_address"]
            else "scalar-agu-prefetch"
        )
    raise ValueError(f"unclassified AGU action: {row['form_id']}")


def signed_raw(value: int, width: int) -> int:
    return value & ((1 << width) - 1)


def align_up(value: int, alignment: int) -> int:
    return ((value + alignment - 1) // alignment) * alignment


def normalized_load_result(value: int, size_bytes: int, signed_load: bool) -> int:
    width = size_bytes * 8
    value &= (1 << width) - 1
    if signed_load and (value & (1 << (width - 1))):
        return (value | (MASK64 ^ ((1 << width) - 1))) & MASK64
    return value


def agu_load_raw_value(size_bytes: int, signed_load: bool, second: bool = False) -> int:
    if second:
        return {1: 0x7F, 2: 0x7001, 4: 0x70000002, 8: 0x7000000000000003}[size_bytes]
    if signed_load:
        return {1: 0x80, 2: 0x8001, 4: 0x80000002, 8: 0x8000000000000003}[size_bytes]
    return {1: 0x81, 2: 0x8001, 4: 0x80000002, 8: 0x8000000000000003}[size_bytes]


def agu_store_value(size_bytes: int, effect_index: int, second: bool = False) -> int:
    seed = 0x1122334455667788 if not second else 0x8877665544332211
    return (seed + effect_index) & MASK64


def agu_immediate_field(row: dict) -> dict | None:
    return next(
        (
            field
            for field in row["fields"]
            if field["name"] in {"simm", "simm5", "simm12", "simm17", "simm22"}
        ),
        None,
    )


def agu_offset_for_immediate(
    row: dict, metadata: dict, effect_index: int, fault_address: int | None
) -> tuple[int, int]:
    field = agu_immediate_field(row)
    if field is None:
        raise ValueError(f"AGU immediate form has no immediate field: {row['form_id']}")
    scale = metadata["offset_scale"]
    size_bytes = metadata["size_bytes"]
    if fault_address is not None:
        base = 0x100 if metadata["address_kind"] == "PCRelative" else 0
        offset = fault_address - base
        if offset % (1 << scale) != 0:
            raise ValueError(f"cannot align fault offset for {row['form_id']}")
        immediate = offset >> scale
    elif metadata["address_kind"] == "PCRelative":
        immediate = -2 if effect_index % 5 == 0 else 2
    elif row["mnemonic"].startswith("C."):
        immediate = -1 if effect_index % 2 == 0 else 1
    elif field["signedness"] == "signed" and effect_index % 7 == 0:
        immediate = -2 if scale > 0 else -size_bytes
    else:
        immediate = max(1, size_bytes >> scale)
    minimum = -(1 << (field["width"] - 1))
    maximum = (1 << (field["width"] - 1)) - 1
    if not minimum <= immediate <= maximum:
        raise ValueError(f"AGU immediate witness out of range for {row['form_id']}")
    return signed_raw(immediate, field["width"]), immediate << scale


def agu_register_offset(row: dict, metadata: dict) -> tuple[int, int, int, int]:
    if field_by_name(row, "shamt") is not None:
        modified = 2
        shift = 1
        return (-modified) & MASK64, 3, shift, modified << shift
    scale = metadata["offset_scale"]
    modified = max(1, metadata["size_bytes"] >> scale)
    return (-modified) & MASK64, 3, 0, modified << scale


def scalar_agu_witness(
    row: dict,
    family_constraints: list[dict],
    effect_index: int,
    *,
    fault: bool = False,
) -> dict:
    metadata = agu_metadata(row)
    action = metadata["action"]
    address_kind = metadata["address_kind"]
    update_mode = metadata["update_mode"]
    size_bytes = metadata["size_bytes"]
    instruction = legal_scalar_witness(row, family_constraints)
    fields: dict[str, int] = {}

    if field_by_name(row, "RegDst") is not None:
        fields["RegDst"] = 2 if action == "Store" and update_mode != "None" else 5
    if field_by_name(row, "RegDst0") is not None:
        fields["RegDst0"] = 5
    if field_by_name(row, "RegDst1") is not None:
        fields["RegDst1"] = 2 if action == "Load" and update_mode != "None" else 6
    if field_by_name(row, "SrcD") is not None:
        fields["SrcD"] = 4
    if field_by_name(row, "SrcD1") is not None:
        fields["SrcD1"] = 5
    if field_by_name(row, "model") is not None:
        fields["model"] = 7

    tpc = 0x102 if address_kind == "PCRelative" else 0x100
    aligned_tpc = tpc & ~0x3
    if fault:
        if action in {"LoadPair", "StorePair"}:
            address = 4096 - size_bytes
            fault_address = 4096
        else:
            address = 4096
            fault_address = 4096
    elif action == "Prefetch":
        address = 4096
        fault_address = None
    else:
        fault_address = None
        address = align_up(0x180 + effect_index * 16, size_bytes)

    if address_kind == "Register":
        src_r_value, src_r_type, shamt, offset = agu_register_offset(row, metadata)
        fields["SrcR"] = 3
        fields["SrcRType"] = src_r_type
        if field_by_name(row, "shamt") is not None:
            fields["shamt"] = shamt
    else:
        immediate_raw, offset = agu_offset_for_immediate(
            row,
            metadata,
            effect_index,
            address
            if (fault or action == "Prefetch") and address_kind == "PCRelative"
            else None,
        )
        immediate = agu_immediate_field(row)
        if immediate is not None:
            fields[immediate["name"]] = immediate_raw
        src_r_value = 0

    if address_kind == "PCRelative":
        base = aligned_tpc
        if not fault and action != "Prefetch":
            address = base + offset
    else:
        base = address if update_mode == "PostIndex" else address - offset
        if action == "Prefetch":
            base = address - offset

    if field_by_name(row, "SrcL") is not None:
        if (
            action == "Store"
            and address_kind in {"Immediate", "PCRelative"}
            and field_by_name(row, "SrcD") is None
        ):
            fields["SrcL"] = 4
        else:
            fields["SrcL"] = 2
    if field_by_name(row, "SrcR") is not None and address_kind != "Register":
        fields["SrcR"] = 2

    for field_name, value in fields.items():
        instruction = encode_field(row, field_name, instruction, value)
    for constraint in family_constraints:
        if family_constraint_applies(row, constraint) and decode_field(
            row, constraint["left_field"], instruction
        ) == decode_field(row, constraint["right_field"], instruction):
            raise ValueError(f"AGU witness violates constraint for {row['form_id']}")

    return {
        "instruction": instruction,
        "metadata": metadata,
        "address": address,
        "base": base,
        "offset": offset,
        "src_r_value": src_r_value,
        "tpc": tpc,
        "updated_base": base + offset,
        "fault_address": fault_address,
    }


def scalar_agu_instruction(
    row: dict, family_constraints: list[dict], field_values: dict[str, int]
) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    for field_name, value in field_values.items():
        if field_by_name(row, field_name) is None:
            raise ValueError(
                f"AGU totality witness requested absent {field_name} in "
                f"{row['form_id']}"
            )
        instruction = encode_field(row, field_name, instruction, value)
    for constraint in family_constraints:
        if family_constraint_applies(row, constraint) and decode_field(
            row, constraint["left_field"], instruction
        ) == decode_field(row, constraint["right_field"], instruction):
            raise ValueError(
                f"AGU totality witness violates constraint for {row['form_id']}"
            )
    return instruction


def encode_agu_witness_fields(
    row: dict,
    family_constraints: list[dict],
    witness_instruction: int,
    overrides: dict[str, int],
) -> int:
    instruction = witness_instruction
    for field_name, value in overrides.items():
        if field_by_name(row, field_name) is None:
            raise ValueError(
                f"AGU witness override requested absent {field_name} in "
                f"{row['form_id']}"
            )
        instruction = encode_field(row, field_name, instruction, value)
    for constraint in family_constraints:
        if family_constraint_applies(row, constraint) and decode_field(
            row, constraint["left_field"], instruction
        ) == decode_field(row, constraint["right_field"], instruction):
            raise ValueError(
                f"AGU witness override violates constraint for {row['form_id']}"
            )
    return instruction


def signed_field_value(raw: int, width: int) -> int:
    sign = 1 << (width - 1)
    return raw - (1 << width) if raw & sign else raw


def scalar_agu_immediate_boundary_cases(row: dict) -> list[tuple[str, int, int]]:
    field = agu_immediate_field(row)
    if field is None:
        return []
    width = field["width"]
    minimum = 1 << (width - 1)
    maximum = (1 << (width - 1)) - 1
    scale = agu_metadata(row)["offset_scale"]
    return [
        ("imm-min", minimum, (signed_field_value(minimum, width) << scale) & MASK64),
        ("imm-max", maximum, (maximum << scale) & MASK64),
    ]


def scalar_agu_modified_register_offset(
    source_value: int, src_r_type: int, shamt: int
) -> int:
    if src_r_type == 0:
        modified = source_value
    elif src_r_type == 1:
        modified = signed_field_value(source_value & MASK32, 32) & MASK64
    elif src_r_type == 2:
        modified = source_value & MASK32
    elif src_r_type == 3:
        modified = (-source_value) & MASK64
    else:
        raise ValueError(f"unsupported SrcRType value: {src_r_type}")
    return (modified << shamt) & MASK64


def scalar_agu_temp_source_value(selector: int) -> int:
    if 24 <= selector <= 27:
        return 0x7100000000000000 + selector - 23
    if 28 <= selector <= 31:
        return 0x7200000000000000 + selector - 27
    raise ValueError(f"unsupported temporary source selector: {selector}")


def emit_scalar_agu_decoded_setup() -> None:
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x111);")
    print("    WriteGPR(2, Zeros{PTO_XLEN} + 0x222);")
    print("    WriteGPR(3, Zeros{PTO_XLEN} + 0xffffffff80000002);")
    print("    WriteGPR(4, Zeros{PTO_XLEN} + 0x444);")
    print("    WriteGPR(5, Zeros{PTO_XLEN} + 0x555);")
    print("    WriteGPR(6, Zeros{PTO_XLEN} + 0x666);")
    for index, value in enumerate(
        (0x7100000000000001, 0x7100000000000002, 0x7100000000000003, 0x7100000000000004)
    ):
        print(f"    _TQueue[[{index}]] = {bit_literal(value, 64)};")
    for index, value in enumerate(
        (0x7200000000000001, 0x7200000000000002, 0x7200000000000003, 0x7200000000000004)
    ):
        print(f"    _UQueue[[{index}]] = {bit_literal(value, 64)};")


def emit_scalar_agu_decode_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    label: str,
    field_values: dict[str, int],
    *,
    witness_instruction: int | None = None,
) -> int:
    instruction = (
        scalar_agu_instruction(row, family_constraints, field_values)
        if witness_instruction is None
        else encode_agu_witness_fields(
            row, family_constraints, witness_instruction, field_values
        )
    )
    metadata = agu_metadata(row)
    print(f"    // AGU-TOTALITY-DECODED: {label}/{row['form_id']}")
    emit_scalar_agu_decoded_setup()
    print(
        f"    let scalar_agu_totality_form_{case_index} = "
        f"DecodeScalarForm({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(f"    assert scalar_agu_totality_form_{case_index} == {row['_form_index']};")
    print(
        f"    assert ScalarAGUActionOfForm({row['_form_index']}) "
        f"== ScalarAGU_{metadata['action']};"
    )
    print(
        f"    assert ScalarAGUAddressKindOfForm({row['_form_index']}) "
        f"== ScalarAGU_{metadata['address_kind']};"
    )
    print(
        f"    assert ScalarAGUUpdateModeOfForm({row['_form_index']}) "
        f"== AddressUpdate_{metadata['update_mode']};"
    )
    print(
        f"    assert ScalarAGUSizeOfForm({row['_form_index']}) == "
        f"{metadata['size_bytes']};"
    )
    for field_name, value in field_values.items():
        print(
            f"    assert DecodeScalarOperandRaw({bit_literal(instruction, 48)}, "
            f"{row['_form_index']}, ScalarField_{field_name}) "
            f"== {bit_literal(value, 48)};"
        )
    return instruction


def emit_scalar_agu_controlled_execution(
    row: dict,
    instruction: int,
    case_index: int,
    address: int,
    *,
    label: str,
    base: int | None = None,
    offset: int = 0,
    src_r_value: int = 0,
    tpc: int = 0x100,
    expected_fault: str = "Fault_None",
) -> None:
    metadata = agu_metadata(row)
    size_bytes = metadata["size_bytes"]
    action = metadata["action"]
    if base is None:
        base = address
    updated_base = (base + offset) & MASK64
    print(f"    // AGU-EXECUTION-DECODED: {label}/{row['form_id']}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print(f"    WriteTPC({bit_literal(tpc, 64)});")
    print(f"    WriteGPR(1, {bit_literal(base, 64)});")
    print(f"    WriteGPR(2, {bit_literal(base, 64)});")
    print(f"    WriteGPR(3, {bit_literal(src_r_value, 64)});")
    first_source = 0x5100000000000000 + case_index
    second_source = 0x5200000000000000 + case_index
    print(f"    WriteGPR(4, {bit_literal(first_source, 64)});")
    print(f"    WriteGPR(5, {bit_literal(0x5300000000000000 + case_index, 64)});")
    print(f"    WriteGPR(6, {bit_literal(0x5400000000000000 + case_index, 64)});")
    for index in range(4):
        print(f"    _TQueue[[{index}]] = {bit_literal(base, 64)};")
        print(f"    _UQueue[[{index}]] = {bit_literal(base, 64)};")
    if action in {"Load", "LoadPair"} and expected_fault == "Fault_None":
        first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
        second_raw = agu_load_raw_value(
            size_bytes, metadata["signed_load"], second=True
        )
        print(
            f"    Store({bit_literal(address, 64)}, {size_bytes}, {bit_literal(first_raw, 64)});"
        )
        if action == "LoadPair":
            second_address = (address + size_bytes) & MASK64
            print(
                f"    Store({bit_literal(second_address, 64)}, {size_bytes}, {bit_literal(second_raw, 64)});"
            )
    elif action in {"Store", "StorePair"}:
        print(f"    WriteGPR(4, {bit_literal(first_source, 64)});")
        print(f"    WriteGPR(5, {bit_literal(second_source, 64)});")
    print("    StartMemoryEventCapture(0);")
    print(
        f"    let scalar_agu_controlled_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    if expected_fault == "Fault_None":
        print(
            f"    assert scalar_agu_controlled_status_{case_index} == ScalarExecution_Executed;"
        )
        print("    assert _LastFault == Fault_None;")
        if action == "Prefetch":
            print("    assert _MemoryEventCount == 0;")
            if metadata["prefetch_returns_address"]:
                print(f"    assert ReadGPR(5) == {bit_literal(updated_base, 64)};")
        elif action == "Load":
            print("    assert _MemoryEventCount == 1;")
            first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
            expected = normalized_load_result(
                first_raw, size_bytes, metadata["signed_load"]
            )
            emit_agu_event_assertions("Load", address, size_bytes, first_raw, 0, 0)
            if metadata["address_kind"] == "Compressed":
                print(f"    assert _TQueue[[0]] == {bit_literal(expected, 64)};")
            else:
                print(f"    assert ReadGPR(5) == {bit_literal(expected, 64)};")
            if metadata["update_mode"] != "None":
                print(f"    assert ReadGPR(2) == {bit_literal(updated_base, 64)};")
        elif action == "LoadPair":
            print("    assert _MemoryEventCount == 2;")
            first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
            second_raw = agu_load_raw_value(
                size_bytes, metadata["signed_load"], second=True
            )
            emit_agu_event_assertions("Load", address, size_bytes, first_raw, 0, 0)
            emit_agu_event_assertions(
                "Load", (address + size_bytes) & MASK64, size_bytes, second_raw, 1, 0
            )
            print(
                f"    assert ReadGPR(5) == "
                f"{bit_literal(normalized_load_result(first_raw, size_bytes, metadata['signed_load']), 64)};"
            )
            print(
                f"    assert ReadGPR(6) == "
                f"{bit_literal(normalized_load_result(second_raw, size_bytes, metadata['signed_load']), 64)};"
            )
        elif action == "Store":
            print("    assert _MemoryEventCount == 1;")
            source = base if metadata["address_kind"] == "Compressed" else first_source
            stored = source & ((1 << (size_bytes * 8)) - 1)
            emit_agu_event_assertions("Store", address, size_bytes, stored, 0, 0)
            print("    StopMemoryEventCapture();")
            print(
                f"    let scalar_agu_controlled_store_{case_index} = "
                f"LoadUnsigned({bit_literal(address, 64)}, {size_bytes});"
            )
            print(
                f"    assert scalar_agu_controlled_store_{case_index} == "
                f"{bit_literal(stored, 64)};"
            )
            if metadata["update_mode"] != "None":
                print(f"    assert ReadGPR(2) == {bit_literal(updated_base, 64)};")
        elif action == "StorePair":
            print("    assert _MemoryEventCount == 2;")
            first_stored = first_source & ((1 << (size_bytes * 8)) - 1)
            second_stored = second_source & ((1 << (size_bytes * 8)) - 1)
            emit_agu_event_assertions("Store", address, size_bytes, first_stored, 0, 0)
            emit_agu_event_assertions(
                "Store",
                (address + size_bytes) & MASK64,
                size_bytes,
                second_stored,
                1,
                0,
            )
            print("    StopMemoryEventCapture();")
            print(
                f"    let scalar_agu_controlled_store_first_{case_index} = "
                f"LoadUnsigned({bit_literal(address, 64)}, {size_bytes});"
            )
            print(
                f"    let scalar_agu_controlled_store_second_{case_index} = "
                f"LoadUnsigned({bit_literal((address + size_bytes) & MASK64, 64)}, {size_bytes});"
            )
            print(
                f"    assert scalar_agu_controlled_store_first_{case_index} == "
                f"{bit_literal(first_stored, 64)};"
            )
            print(
                f"    assert scalar_agu_controlled_store_second_{case_index} == "
                f"{bit_literal(second_stored, 64)};"
            )
    else:
        print(
            f"    assert scalar_agu_controlled_status_{case_index} == ScalarExecution_Rejected;"
        )
        print(f"    assert _LastFault == {expected_fault};")
        print(f"    assert _FaultAddress == {bit_literal(address, 64)};")
        print("    assert _MemoryEventCount == 0;")
        if action == "Load":
            if metadata["address_kind"] == "Compressed":
                print(f"    assert _TQueue[[0]] == {bit_literal(base, 64)};")
            else:
                print(
                    f"    assert ReadGPR(5) == "
                    f"{bit_literal(0x5300000000000000 + case_index, 64)};"
                )
            if metadata["update_mode"] != "None":
                print(f"    assert ReadGPR(2) == {bit_literal(base, 64)};")
        elif action == "LoadPair":
            print(
                f"    assert ReadGPR(5) == "
                f"{bit_literal(0x5300000000000000 + case_index, 64)};"
            )
            print(
                f"    assert ReadGPR(6) == "
                f"{bit_literal(0x5400000000000000 + case_index, 64)};"
            )
        elif action == "Store" and metadata["update_mode"] != "None":
            print(f"    assert ReadGPR(2) == {bit_literal(base, 64)};")


def scalar_agu_nonpc_base_for_address(metadata: dict, address: int, offset: int) -> int:
    if metadata["update_mode"] == "PostIndex":
        return address & MASK64
    return (address - offset) & MASK64


def scalar_agu_zero_offset_instruction(
    row: dict, family_constraints: list[dict], witness: dict
) -> int:
    metadata = witness["metadata"]
    overrides: dict[str, int] = {}
    if metadata["address_kind"] == "Register":
        overrides.update({"SrcL": 2, "SrcR": 3, "SrcRType": 0})
        if field_by_name(row, "shamt") is not None:
            overrides["shamt"] = 0
    else:
        field = agu_immediate_field(row)
        if field is None:
            raise ValueError(f"zero-offset AGU form lacks immediate: {row['form_id']}")
        overrides[field["name"]] = 0
    return encode_agu_witness_fields(
        row, family_constraints, witness["instruction"], overrides
    )


def emit_scalar_agu_immediate_boundary_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    label: str,
    raw_value: int,
    expected_offset: int,
) -> None:
    field = agu_immediate_field(row)
    if field is None:
        raise ValueError(f"missing AGU immediate field: {row['form_id']}")
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = emit_scalar_agu_decode_case(
        row,
        family_constraints,
        case_index,
        label,
        {field["name"]: raw_value},
        witness_instruction=witness["instruction"],
    )
    print(
        f"    let scalar_agu_offset_{case_index} = ScalarDecodedAGUOffset("
        f"{bit_literal(instruction, 48)}, {row['_form_index']}, "
        f"ScalarAGU_{agu_metadata(row)['address_kind']});"
    )
    print(
        f"    assert scalar_agu_offset_{case_index} == "
        f"{bit_literal(expected_offset, 64)};"
    )
    metadata = agu_metadata(row)
    if metadata["address_kind"] == "PCRelative":
        address = expected_offset & MASK64
        if address % metadata["size_bytes"] != 0:
            fault = "Fault_DataAlignment"
        elif address > 4095:
            fault = "Fault_DataPage"
        else:
            fault = "Fault_None"
        emit_scalar_agu_controlled_execution(
            row,
            instruction,
            case_index,
            address,
            label=label,
            offset=expected_offset,
            tpc=0,
            expected_fault=fault,
        )
    else:
        address = 0x200
        base = scalar_agu_nonpc_base_for_address(metadata, address, expected_offset)
        emit_scalar_agu_controlled_execution(
            row,
            instruction,
            case_index,
            address,
            label=label,
            base=base,
            offset=expected_offset,
            src_r_value=witness["src_r_value"],
        )


def emit_scalar_agu_register_modifier_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    src_r_type: int,
) -> None:
    witness = scalar_agu_witness(row, family_constraints, case_index)
    shamt = (
        1
        if field_by_name(row, "shamt") is not None
        else agu_metadata(row)["offset_scale"]
    )
    instruction = emit_scalar_agu_decode_case(
        row,
        family_constraints,
        case_index,
        f"srcrtype-{src_r_type}",
        {
            "SrcRType": src_r_type,
            "SrcR": 3,
            **({"shamt": shamt} if field_by_name(row, "shamt") else {}),
        },
        witness_instruction=witness["instruction"],
    )
    expected = scalar_agu_modified_register_offset(1, src_r_type, shamt)
    print("    WriteGPR(3, Zeros{PTO_XLEN} + 1);")
    print(
        f"    let scalar_agu_srcrtype_offset_{case_index} = ScalarDecodedAGUOffset("
        f"{bit_literal(instruction, 48)}, {row['_form_index']}, "
        "ScalarAGU_Register);"
    )
    print(
        f"    assert scalar_agu_srcrtype_offset_{case_index} == "
        f"{bit_literal(expected, 64)};"
    )
    address = 0x200
    base = scalar_agu_nonpc_base_for_address(agu_metadata(row), address, expected)
    emit_scalar_agu_controlled_execution(
        row,
        instruction,
        case_index,
        address,
        label=f"srcrtype-{src_r_type}",
        base=base,
        offset=expected,
        src_r_value=1,
    )


def emit_scalar_agu_shamt_boundary_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    shamt: int,
) -> None:
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = emit_scalar_agu_decode_case(
        row,
        family_constraints,
        case_index,
        f"shamt-{shamt}",
        {"SrcRType": 2, "SrcR": 3, "shamt": shamt},
        witness_instruction=witness["instruction"],
    )
    expected = scalar_agu_modified_register_offset(1, 2, shamt)
    print("    WriteGPR(3, Zeros{PTO_XLEN} + 1);")
    print(
        f"    let scalar_agu_shamt_offset_{case_index} = ScalarDecodedAGUOffset("
        f"{bit_literal(instruction, 48)}, {row['_form_index']}, "
        "ScalarAGU_Register);"
    )
    print(
        f"    assert scalar_agu_shamt_offset_{case_index} == "
        f"{bit_literal(expected, 64)};"
    )
    address = 0x200
    base = scalar_agu_nonpc_base_for_address(agu_metadata(row), address, expected)
    emit_scalar_agu_controlled_execution(
        row,
        instruction,
        case_index,
        address,
        label=f"shamt-{shamt}",
        base=base,
        offset=expected,
        src_r_value=1,
    )


def emit_scalar_agu_wrap_case(
    row: dict, family_constraints: list[dict], case_index: int
) -> None:
    witness = scalar_agu_witness(row, family_constraints, case_index)
    metadata = witness["metadata"]
    overrides: dict[str, int] = {}
    src_r_value = witness["src_r_value"]
    if metadata["address_kind"] == "Register":
        src_r_value = 1
        overrides.update({"SrcR": 3, "SrcRType": 0})
        if field_by_name(row, "shamt") is not None:
            overrides["shamt"] = 0
        positive_offset = 1 << (
            0 if field_by_name(row, "shamt") is not None else metadata["offset_scale"]
        )
    else:
        field = agu_immediate_field(row)
        if field is None:
            raise ValueError(f"AGU wrap form has no offset field: {row['form_id']}")
        overrides[field["name"]] = 1
        positive_offset = 1 << metadata["offset_scale"]

    if metadata["update_mode"] == "PostIndex":
        if metadata["address_kind"] == "Register":
            overrides["SrcRType"] = 3
            negative_offset = (-positive_offset) & MASK64
        else:
            field = agu_immediate_field(row)
            assert field is not None
            overrides[field["name"]] = (1 << field["width"]) - 1
            negative_offset = (-(1 << metadata["offset_scale"])) & MASK64
        instruction = encode_agu_witness_fields(
            row, family_constraints, witness["instruction"], overrides
        )
        emit_scalar_agu_controlled_execution(
            row,
            instruction,
            case_index,
            0,
            label="address-wrap",
            base=0,
            offset=negative_offset,
            src_r_value=src_r_value,
        )
        print(
            f"    assert Zeros{{PTO_XLEN}} - {bit_literal(positive_offset, 64)} "
            f"== {bit_literal(negative_offset, 64)};"
        )
        return

    instruction = encode_agu_witness_fields(
        row, family_constraints, witness["instruction"], overrides
    )
    if metadata["address_kind"] == "PCRelative":
        base = MASK64 - 3
        tpc = base
    else:
        base = (-positive_offset) & MASK64
        tpc = witness["tpc"]
    emit_scalar_agu_controlled_execution(
        row,
        instruction,
        case_index,
        0,
        label="address-wrap",
        base=base,
        offset=positive_offset,
        src_r_value=src_r_value,
        tpc=tpc,
    )
    print(
        f"    assert {bit_literal(base, 64)} + "
        f"{bit_literal(positive_offset, 64)} == Zeros{{PTO_XLEN}};"
    )


def emit_scalar_agu_prefetch_invalid_case(
    row: dict, family_constraints: list[dict], case_index: int
) -> None:
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = witness["instruction"]
    print(f"    // AGU-PREFETCH-INVALID-NONFAULTING: {row['form_id']}")
    emit_scalar_agu_controlled_execution(
        row,
        instruction,
        case_index,
        4096,
        label="invalid-prefetch",
        base=(4096 - witness["offset"]) & MASK64,
        offset=witness["offset"],
        src_r_value=witness["src_r_value"],
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _MemoryEventCount == 0;")


def emit_scalar_agu_prefetch_model_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    model: int,
) -> None:
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = emit_scalar_agu_decode_case(
        row,
        family_constraints,
        case_index,
        f"prefetch-model-{model}",
        {"model": model},
        witness_instruction=witness["instruction"],
    )
    emit_scalar_agu_controlled_execution(
        row,
        instruction,
        case_index,
        witness["address"],
        label=f"prefetch-model-{model}",
        base=witness["base"],
        offset=witness["offset"],
        src_r_value=witness["src_r_value"],
        tpc=witness["tpc"],
    )


def emit_scalar_agu_prefetch_return_wrap_case(
    row: dict, family_constraints: list[dict], case_index: int, high: bool
) -> None:
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = witness["instruction"]
    expected = 0 if high else MASK64
    base = (expected - witness["offset"]) & MASK64
    print(
        f"    // AGU-PREFETCH-RETURN-WRAP: {'high' if high else 'low'}/{row['form_id']}"
    )
    emit_scalar_agu_controlled_execution(
        row,
        instruction,
        case_index,
        expected,
        label=f"address-return-prefetch-{'high' if high else 'low'}",
        base=base,
        offset=witness["offset"],
        src_r_value=witness["src_r_value"],
    )
    print(f"    assert ReadGPR(5) == {bit_literal(expected, 64)};")


def temp_queue_name(selector: int) -> tuple[str, int]:
    if 24 <= selector <= 27:
        return "_TQueue", selector - 24
    if 28 <= selector <= 31:
        return "_UQueue", selector - 28
    raise ValueError(f"not a temporary selector: {selector}")


def agu_load_expected_value(metadata: dict, second: bool = False) -> int:
    raw = agu_load_raw_value(metadata["size_bytes"], metadata["signed_load"], second)
    return normalized_load_result(raw, metadata["size_bytes"], metadata["signed_load"])


def emit_scalar_agu_alias_setup(
    row: dict, witness: dict, case_index: int, instruction: int
) -> None:
    metadata = witness["metadata"]
    size_bytes = metadata["size_bytes"]
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print(f"    WriteTPC(Zeros{{PTO_XLEN}} + 0x{witness['tpc']:x});")
    print(f"    WriteGPR(1, {bit_literal(witness['base'], 64)});")
    print(f"    WriteGPR(2, {bit_literal(witness['base'], 64)});")
    print(f"    WriteGPR(3, {bit_literal(witness['src_r_value'], 64)});")
    print(f"    WriteGPR(4, {bit_literal(0x6100000000000000 + case_index, 64)});")
    print(f"    WriteGPR(5, {bit_literal(0x6200000000000000 + case_index, 64)});")
    print(f"    WriteGPR(6, {bit_literal(0x6300000000000000 + case_index, 64)});")
    for index in range(4):
        print(f"    _TQueue[[{index}]] = Zeros{{PTO_XLEN}} + 0x700;")
        print(f"    _UQueue[[{index}]] = Zeros{{PTO_XLEN}} + 0x800;")
    if metadata["action"] in {"Load", "LoadPair"}:
        first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
        second_raw = agu_load_raw_value(
            size_bytes, metadata["signed_load"], second=True
        )
        print(
            f"    Store({bit_literal(witness['address'], 64)}, {size_bytes}, {bit_literal(first_raw, 64)});"
        )
        if metadata["action"] == "LoadPair":
            print(
                f"    Store({bit_literal(witness['address'] + size_bytes, 64)}, {size_bytes}, {bit_literal(second_raw, 64)});"
            )
    print("    StartMemoryEventCapture(0);")


def emit_scalar_agu_source_alias_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    field_name: str,
    selector: int,
) -> None:
    witness = scalar_agu_witness(row, family_constraints, row["_form_index"] % 128)
    instruction = encode_agu_witness_fields(
        row, family_constraints, witness["instruction"], {field_name: selector}
    )
    metadata = witness["metadata"]
    queue, index = temp_queue_name(selector)
    selected_value = 0x6500000000000000 + case_index
    source_role = "other"
    if field_name in {"SrcL", "SrcR"}:
        if (
            metadata["action"] == "Store"
            and field_name == "SrcL"
            and field_by_name(row, "SrcD") is None
            and metadata["address_kind"] != "Compressed"
        ):
            source_role = "store-data"
        elif metadata["address_kind"] == "Register" and field_name == "SrcR":
            source_role = "offset"
            selected_value = witness["src_r_value"]
        elif metadata["address_kind"] != "PCRelative":
            source_role = "base"
            selected_value = witness["base"]
    if field_name in {"SrcD", "SrcD1"}:
        source_role = "store-data"
        selected_value = 0x6600000000000000 + case_index
    print(f"    // AGU-SOURCE-TEMP-DECODED: {field_name}-{selector}/{row['form_id']}")
    emit_scalar_agu_alias_setup(row, witness, case_index, instruction)
    print(f"    {queue}[[{index}]] = {bit_literal(selected_value, 64)};")
    print(
        f"    let scalar_agu_source_alias_value_{case_index} = "
        f"ReadDecodedScalarRegister({bit_literal(instruction, 48)}, "
        f"{row['_form_index']}, ScalarField_{field_name});"
    )
    print(
        f"    assert scalar_agu_source_alias_value_{case_index} == "
        f"{bit_literal(selected_value, 64)};"
    )
    print(
        f"    let scalar_agu_source_alias_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_source_alias_status_{case_index} == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    if metadata["action"] in {"Load", "Store"}:
        print("    assert _MemoryEventCount == 1;")
    elif metadata["action"] in {"LoadPair", "StorePair"}:
        print("    assert _MemoryEventCount == 2;")
    else:
        print("    assert _MemoryEventCount == 0;")
    if source_role in {"base", "offset"} and metadata["action"] != "Prefetch":
        print(
            f"    assert _MemoryEvents[[0]].address == "
            f"{bit_literal(witness['address'], 64)};"
        )
    if metadata["action"] == "Load":
        expected_load = agu_load_expected_value(metadata)
        if metadata["address_kind"] == "Compressed":
            print(f"    assert _TQueue[[0]] == {bit_literal(expected_load, 64)};")
            preserved = selected_value if selector == 24 else 0x700
            print(f"    assert _TQueue[[1]] == {bit_literal(preserved, 64)};")
        else:
            print(f"    assert ReadGPR(5) == {bit_literal(expected_load, 64)};")
    elif metadata["action"] == "LoadPair":
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(agu_load_expected_value(metadata), 64)};"
        )
        print(
            f"    assert ReadGPR(6) == "
            f"{bit_literal(agu_load_expected_value(metadata, second=True), 64)};"
        )
    if metadata["action"] in {"Load", "Store"} and metadata["update_mode"] != "None":
        print(
            f"    assert ReadGPR(2) == "
            f"{bit_literal(witness['updated_base'] & MASK64, 64)};"
        )
    if field_name in {"SrcD", "SrcD1"} and metadata["action"] in {"Store", "StorePair"}:
        address = witness["address"] + (
            metadata["size_bytes"] if field_name == "SrcD1" else 0
        )
        stored = selected_value & ((1 << (metadata["size_bytes"] * 8)) - 1)
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_source_alias_memory_{case_index} = LoadUnsigned({bit_literal(address, 64)}, {metadata['size_bytes']});"
        )
        print(
            f"    assert scalar_agu_source_alias_memory_{case_index} == {bit_literal(stored, 64)};"
        )
    elif source_role == "store-data" and metadata["action"] == "Store":
        stored = selected_value & ((1 << (metadata["size_bytes"] * 8)) - 1)
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_source_alias_memory_{case_index} = "
            f"LoadUnsigned({bit_literal(witness['address'], 64)}, {metadata['size_bytes']});"
        )
        print(
            f"    assert scalar_agu_source_alias_memory_{case_index} == "
            f"{bit_literal(stored, 64)};"
        )
    elif metadata["action"] == "Store" and metadata["address_kind"] == "Compressed":
        compressed_source = selected_value if selector == 24 else 0x700
        stored = compressed_source & ((1 << (metadata["size_bytes"] * 8)) - 1)
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_source_alias_memory_{case_index} = "
            f"LoadUnsigned({bit_literal(witness['address'], 64)}, "
            f"{metadata['size_bytes']});"
        )
        print(
            f"    assert scalar_agu_source_alias_memory_{case_index} == "
            f"{bit_literal(stored, 64)};"
        )
    if metadata["action"] == "Prefetch" and metadata["prefetch_returns_address"]:
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(witness['updated_base'] & MASK64, 64)};"
        )


def emit_scalar_agu_destination_alias_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    field_name: str,
    selector: int,
) -> None:
    witness = scalar_agu_witness(row, family_constraints, row["_form_index"] % 128)
    instruction = encode_agu_witness_fields(
        row, family_constraints, witness["instruction"], {field_name: selector}
    )
    metadata = witness["metadata"]
    destination_writes = not (
        metadata["action"] == "Prefetch" and not metadata["prefetch_returns_address"]
    )
    if (
        field_name == "RegDst1"
        and metadata["action"] == "Load"
        and metadata["update_mode"] != "None"
    ):
        expected = witness["updated_base"] & MASK64
    elif field_name == "RegDst1" and metadata["action"] == "LoadPair":
        expected = agu_load_expected_value(metadata, second=True)
    elif field_name == "RegDst" and metadata["action"] in {"Store", "Prefetch"}:
        expected = witness["updated_base"] & MASK64
    else:
        expected = agu_load_expected_value(metadata)
    print(
        f"    // AGU-DESTINATION-SPECIAL-DECODED: {field_name}-{selector}/{row['form_id']}"
    )
    emit_scalar_agu_alias_setup(row, witness, case_index, instruction)
    print(
        f"    assert DecodeScalarOperandRaw({bit_literal(instruction, 48)}, "
        f"{row['_form_index']}, ScalarField_{field_name}) == "
        f"{bit_literal(selector, 48)};"
    )
    print(
        f"    let scalar_agu_destination_alias_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_destination_alias_status_{case_index} == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    if metadata["action"] in {"Load", "Store"}:
        print("    assert _MemoryEventCount == 1;")
    elif metadata["action"] == "LoadPair":
        print("    assert _MemoryEventCount == 2;")
    else:
        print("    assert _MemoryEventCount == 0;")
    if selector == 0:
        print("    assert ReadGPR(0) == Zeros{PTO_XLEN};")
    if selector == 30 and destination_writes:
        print(f"    assert _UQueue[[0]] == {bit_literal(expected, 64)};")
        print("    assert _TQueue[[0]] == Zeros{PTO_XLEN} + 0x700;")
    elif selector == 31 and destination_writes:
        print(f"    assert _TQueue[[0]] == {bit_literal(expected, 64)};")
        print("    assert _UQueue[[0]] == Zeros{PTO_XLEN} + 0x800;")
    else:
        print("    assert _TQueue[[0]] == Zeros{PTO_XLEN} + 0x700;")
        print("    assert _UQueue[[0]] == Zeros{PTO_XLEN} + 0x800;")
    if field_name == "RegDst1":
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(agu_load_expected_value(metadata), 64)};"
        )
    else:
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(0x6200000000000000 + case_index, 64)};"
        )
    if field_name == "RegDst0":
        if metadata["action"] == "LoadPair":
            other_expected = agu_load_expected_value(metadata, second=True)
            print(f"    assert ReadGPR(6) == {bit_literal(other_expected, 64)};")
        else:
            other_expected = witness["updated_base"] & MASK64
            print(f"    assert ReadGPR(2) == {bit_literal(other_expected, 64)};")
    if field_name == "RegDst" and metadata["action"] == "Store":
        print(f"    assert ReadGPR(2) == {bit_literal(witness['base'], 64)};")


def emit_scalar_agu_load_pair_alias_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    mode: str,
) -> None:
    values = {
        "same-gpr": {"RegDst0": 5, "RegDst1": 5},
        "t-t": {"RegDst0": 31, "RegDst1": 31},
        "u-u": {"RegDst0": 30, "RegDst1": 30},
        "t-u": {"RegDst0": 31, "RegDst1": 30},
        "u-t": {"RegDst0": 30, "RegDst1": 31},
    }[mode]
    witness = scalar_agu_witness(row, family_constraints, row["_form_index"] % 128)
    instruction = encode_agu_witness_fields(
        row, family_constraints, witness["instruction"], values
    )
    metadata = witness["metadata"]
    first = agu_load_expected_value(metadata)
    second = agu_load_expected_value(metadata, second=True)
    print(f"    // AGU-PAIR-DESTINATION-ORDER: {mode}/{row['form_id']}")
    emit_scalar_agu_alias_setup(row, witness, case_index, instruction)
    print(
        f"    let scalar_agu_pair_alias_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_pair_alias_status_{case_index} == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _MemoryEventCount == 2;")
    emit_agu_event_assertions(
        "Load",
        witness["address"],
        metadata["size_bytes"],
        agu_load_raw_value(metadata["size_bytes"], metadata["signed_load"]),
        0,
        0,
    )
    emit_agu_event_assertions(
        "Load",
        witness["address"] + metadata["size_bytes"],
        metadata["size_bytes"],
        agu_load_raw_value(
            metadata["size_bytes"], metadata["signed_load"], second=True
        ),
        1,
        0,
    )
    if mode == "same-gpr":
        print(f"    assert ReadGPR(5) == {bit_literal(second, 64)};")
    elif mode == "t-t":
        print(f"    assert _TQueue[[0]] == {bit_literal(second, 64)};")
        print(f"    assert _TQueue[[1]] == {bit_literal(first, 64)};")
    elif mode == "u-u":
        print(f"    assert _UQueue[[0]] == {bit_literal(second, 64)};")
        print(f"    assert _UQueue[[1]] == {bit_literal(first, 64)};")
    elif mode == "t-u":
        print(f"    assert _TQueue[[0]] == {bit_literal(first, 64)};")
        print(f"    assert _UQueue[[0]] == {bit_literal(second, 64)};")
    elif mode == "u-t":
        print(f"    assert _UQueue[[0]] == {bit_literal(first, 64)};")
        print(f"    assert _TQueue[[0]] == {bit_literal(second, 64)};")


def emit_scalar_agu_store_pair_alias_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    mode: str,
) -> None:
    values = {
        "same-gpr": {"SrcD": 4, "SrcD1": 4},
        "t-t": {"SrcD": 24, "SrcD1": 24},
        "u-u": {"SrcD": 28, "SrcD1": 28},
    }[mode]
    witness = scalar_agu_witness(row, family_constraints, row["_form_index"] % 128)
    instruction = encode_agu_witness_fields(
        row, family_constraints, witness["instruction"], values
    )
    metadata = witness["metadata"]
    source = 0x6700000000000000 + case_index
    stored = source & ((1 << (metadata["size_bytes"] * 8)) - 1)
    print(f"    // AGU-STORE-SOURCE-SNAPSHOT: {mode}/{row['form_id']}")
    emit_scalar_agu_alias_setup(row, witness, case_index, instruction)
    print(f"    WriteGPR(4, {bit_literal(source, 64)});")
    print(f"    _TQueue[[0]] = {bit_literal(source, 64)};")
    print(f"    _UQueue[[0]] = {bit_literal(source, 64)};")
    print(
        f"    let scalar_agu_store_pair_alias_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_store_pair_alias_status_{case_index} == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _MemoryEventCount == 2;")
    emit_agu_event_assertions(
        "Store", witness["address"], metadata["size_bytes"], stored, 0, 0
    )
    emit_agu_event_assertions(
        "Store",
        witness["address"] + metadata["size_bytes"],
        metadata["size_bytes"],
        stored,
        1,
        0,
    )
    print("    StopMemoryEventCapture();")
    print(
        f"    let scalar_agu_store_pair_first_{case_index} = LoadUnsigned({bit_literal(witness['address'], 64)}, {metadata['size_bytes']});"
    )
    print(
        f"    let scalar_agu_store_pair_second_{case_index} = LoadUnsigned({bit_literal(witness['address'] + metadata['size_bytes'], 64)}, {metadata['size_bytes']});"
    )
    print(
        f"    assert scalar_agu_store_pair_first_{case_index} == {bit_literal(stored, 64)};"
    )
    print(
        f"    assert scalar_agu_store_pair_second_{case_index} == {bit_literal(stored, 64)};"
    )


def emit_scalar_agu_pair_preflight_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    first_fault: bool,
) -> None:
    metadata = agu_metadata(row)
    size_bytes = metadata["size_bytes"]
    address = 4096 if first_fault else 4096 - size_bytes
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = scalar_agu_zero_offset_instruction(row, family_constraints, witness)
    base = address
    src_r_value = 0
    print(
        f"    // AGU-PAIR-PREFLIGHT-DECODED: "
        f"{'first' if first_fault else 'second'}/{row['form_id']}"
    )
    print("    ResetProfileState();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    ResetMemoryExecution();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print(f"    WriteGPR(2, {bit_literal(base, 64)});")
    print(f"    WriteGPR(3, {bit_literal(src_r_value, 64)});")
    print(f"    WriteGPR(4, {bit_literal(0x1111000000000000 + case_index, 64)});")
    print(f"    WriteGPR(5, {bit_literal(0x2222000000000000 + case_index, 64)});")
    print(f"    WriteGPR(6, {bit_literal(0x3333000000000000 + case_index, 64)});")
    for index in range(4):
        print(f"    _TQueue[[{index}]] = {bit_literal(base, 64)};")
        print(f"    _UQueue[[{index}]] = {bit_literal(base, 64)};")
    memory_sentinel = 0x5A
    if metadata["action"] == "StorePair" and not first_fault:
        print(
            f"    Store({bit_literal(address, 64)}, {size_bytes}, "
            f"{bit_literal(memory_sentinel, 64)});"
        )
    print("    StartMemoryEventCapture(0);")
    print(
        f"    let scalar_agu_pair_preflight_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_pair_preflight_status_{case_index} == "
        "ScalarExecution_Rejected;"
    )
    print("    assert _LastFault == Fault_DataPage;")
    fault_address = address if first_fault else 4096
    print(f"    assert _FaultAddress == {bit_literal(fault_address, 64)};")
    print("    assert _MemoryEventCount == 0;")
    if metadata["action"] == "LoadPair":
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(0x2222000000000000 + case_index, 64)};"
        )
        print(
            f"    assert ReadGPR(6) == "
            f"{bit_literal(0x3333000000000000 + case_index, 64)};"
        )
    elif not first_fault:
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_pair_preflight_memory_{case_index} = "
            f"LoadUnsigned({bit_literal(address, 64)}, {size_bytes});"
        )
        print(
            f"    assert scalar_agu_pair_preflight_memory_{case_index} == "
            f"{bit_literal(memory_sentinel, 64)};"
        )


def emit_scalar_agu_page_precedence_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    label: str,
    acr: int,
    address: int,
) -> None:
    metadata = agu_metadata(row)
    if metadata["action"] == "Prefetch":
        raise ValueError(
            f"prefetch has no faulting page-precedence case: {row['form_id']}"
        )
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = scalar_agu_zero_offset_instruction(row, family_constraints, witness)
    print(f"    // AGU-FAULT-PRECEDENCE-DECODED: {label}/{row['form_id']}")
    print("    ResetProfileState();")
    print(f"    SetCurrentACR({acr});")
    print("    ClearFault();")
    print("    ResetMemoryExecution();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    if metadata["address_kind"] == "PCRelative":
        print(f"    WriteTPC({bit_literal(address, 64)});")
    else:
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print(f"    WriteGPR(2, {bit_literal(address, 64)});")
    print("    WriteGPR(3, Zeros{PTO_XLEN});")
    print(f"    WriteGPR(4, {bit_literal(0x5555000000000000 + case_index, 64)});")
    print(f"    WriteGPR(5, {bit_literal(0x6666000000000000 + case_index, 64)});")
    print(f"    WriteGPR(6, {bit_literal(0x7777000000000000 + case_index, 64)});")
    for index in range(4):
        print(f"    _TQueue[[{index}]] = {bit_literal(address, 64)};")
        print(f"    _UQueue[[{index}]] = {bit_literal(address, 64)};")
    print("    StartMemoryEventCapture(0);")
    print(
        f"    let scalar_agu_page_precedence_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_page_precedence_status_{case_index} == "
        "ScalarExecution_Rejected;"
    )
    expected_fault = "Fault_DataAlignment" if label == "alignment" else "Fault_DataPage"
    print(f"    assert _LastFault == {expected_fault};")
    print(f"    assert _FaultAddress == {bit_literal(address, 64)};")
    print("    assert _MemoryEventCount == 0;")
    if metadata["action"] == "Load":
        if metadata["address_kind"] == "Compressed":
            print(f"    assert _TQueue[[0]] == {bit_literal(address, 64)};")
        else:
            print(
                f"    assert ReadGPR(5) == "
                f"{bit_literal(0x6666000000000000 + case_index, 64)};"
            )
        if metadata["update_mode"] != "None":
            print(f"    assert ReadGPR(2) == {bit_literal(address, 64)};")
    elif metadata["action"] == "LoadPair":
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(0x6666000000000000 + case_index, 64)};"
        )
        print(
            f"    assert ReadGPR(6) == "
            f"{bit_literal(0x7777000000000000 + case_index, 64)};"
        )
    elif metadata["action"] == "Store" and metadata["update_mode"] != "None":
        print(f"    assert ReadGPR(2) == {bit_literal(address, 64)};")


def emit_scalar_agu_restart_case(
    row: dict, family_constraints: list[dict], case_index: int
) -> None:
    metadata = agu_metadata(row)
    action = metadata["action"]
    size_bytes = metadata["size_bytes"]
    witness = scalar_agu_witness(row, family_constraints, case_index)
    instruction = scalar_agu_zero_offset_instruction(row, family_constraints, witness)
    first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
    second_raw = agu_load_raw_value(size_bytes, metadata["signed_load"], second=True)
    first_source = 0x4400000000000000 + case_index
    second_source = 0x5500000000000000 + case_index
    first_stored = first_source & ((1 << (size_bytes * 8)) - 1)
    second_stored = second_source & ((1 << (size_bytes * 8)) - 1)
    if metadata["address_kind"] == "Compressed" and action == "Store":
        first_stored = 3072 & ((1 << (size_bytes * 8)) - 1)
    destination_sentinel = 0x6600000000000000 + case_index
    second_destination_sentinel = 0x7700000000000000 + case_index
    print(f"    // AGU-RESTART-BY-REISSUE: {row['form_id']}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    if action in {"Load", "LoadPair"}:
        print(
            f"    Store(Zeros{{PTO_XLEN}} + 3072, {size_bytes}, "
            f"{bit_literal(first_raw, 64)});"
        )
        if action == "LoadPair":
            print(
                f"    Store({bit_literal(3072 + size_bytes, 64)}, {size_bytes}, "
                f"{bit_literal(second_raw, 64)});"
            )
    elif action in {"Store", "StorePair"}:
        print(
            f"    Store(Zeros{{PTO_XLEN}} + 3072, {size_bytes}, "
            "Zeros{PTO_XLEN} + 0x5a);"
        )
        if action == "StorePair":
            print(
                f"    Store({bit_literal(3072 + size_bytes, 64)}, {size_bytes}, "
                "Zeros{PTO_XLEN} + 0xa5);"
            )
    print("    SetCurrentACR(2);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    if metadata["address_kind"] == "PCRelative":
        print("    WriteTPC(Zeros{PTO_XLEN} + 3072);")
    else:
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 3072);")
    print("    WriteGPR(2, Zeros{PTO_XLEN} + 3072);")
    print("    WriteGPR(3, Zeros{PTO_XLEN});")
    print(f"    WriteGPR(4, {bit_literal(first_source, 64)});")
    print(
        f"    WriteGPR(5, "
        f"{bit_literal(second_source if action == 'StorePair' else destination_sentinel, 64)});"
    )
    print(f"    WriteGPR(6, {bit_literal(second_destination_sentinel, 64)});")
    for index in range(4):
        print(f"    _TQueue[[{index}]] = Zeros{{PTO_XLEN}} + 3072;")
        print(f"    _UQueue[[{index}]] = Zeros{{PTO_XLEN}} + 3072;")
    print("    StartMemoryEventCapture(0);")
    print(
        f"    let scalar_agu_restart_fault_{case_index} = ExecuteScalarInstruction("
        f"{bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_restart_fault_{case_index} == ScalarExecution_Rejected;"
    )
    print("    assert _LastFault == Fault_DataPage;")
    if action == "Load":
        if metadata["address_kind"] == "Compressed":
            print("    assert _TQueue[[0]] == Zeros{PTO_XLEN} + 3072;")
        else:
            print(f"    assert ReadGPR(5) == {bit_literal(destination_sentinel, 64)};")
        if metadata["update_mode"] != "None":
            print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 3072;")
    elif action == "LoadPair":
        print(f"    assert ReadGPR(5) == {bit_literal(destination_sentinel, 64)};")
        print(
            f"    assert ReadGPR(6) == {bit_literal(second_destination_sentinel, 64)};"
        )
    elif action == "Store" and metadata["update_mode"] != "None":
        print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 3072;")
    expected_tpc = 3072 if metadata["address_kind"] == "PCRelative" else 0x100
    print(f"    assert _TrapContexts[[1]].tpc == {bit_literal(expected_tpc, 64)};")
    print("    assert _MemoryEventCount == 0;")
    if action in {"Store", "StorePair"}:
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_restart_preserved_first_{case_index} = "
            f"LoadUnsigned(Zeros{{PTO_XLEN}} + 3072, {size_bytes});"
        )
        print(
            f"    assert scalar_agu_restart_preserved_first_{case_index} == "
            "Zeros{PTO_XLEN} + 0x5a;"
        )
        if action == "StorePair":
            print(
                f"    let scalar_agu_restart_preserved_second_{case_index} = "
                f"LoadUnsigned({bit_literal(3072 + size_bytes, 64)}, {size_bytes});"
            )
            print(
                f"    assert scalar_agu_restart_preserved_second_{case_index} == "
                "Zeros{PTO_XLEN} + 0xa5;"
            )
    print(f"    let scalar_agu_restart_recovered_{case_index} = RecoverTrapContext(1);")
    print(f"    assert scalar_agu_restart_recovered_{case_index};")
    print(f"    assert ReadTPC() == {bit_literal(expected_tpc, 64)};")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    StartMemoryEventCapture(0);")
    print(
        f"    let scalar_agu_restart_ok_{case_index} = ExecuteScalarInstruction("
        f"{bit_literal(instruction, 48)}, {row['length_bits']});"
    )
    print(f"    assert scalar_agu_restart_ok_{case_index} == ScalarExecution_Executed;")
    print("    assert _LastFault == Fault_None;")
    print(
        f"    assert ReadTPC() == "
        f"{bit_literal(expected_tpc + row['length_bits'] // 8, 64)};"
    )
    if action == "Load":
        print("    assert _MemoryEventCount == 1;")
        emit_agu_event_assertions("Load", 3072, size_bytes, first_raw, 0, 0)
        expected = normalized_load_result(
            first_raw, size_bytes, metadata["signed_load"]
        )
        if metadata["address_kind"] == "Compressed":
            print(f"    assert _TQueue[[0]] == {bit_literal(expected, 64)};")
        else:
            print(f"    assert ReadGPR(5) == {bit_literal(expected, 64)};")
        if metadata["update_mode"] != "None":
            print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 3072;")
    elif action == "LoadPair":
        print("    assert _MemoryEventCount == 2;")
        emit_agu_event_assertions("Load", 3072, size_bytes, first_raw, 0, 0)
        emit_agu_event_assertions(
            "Load", 3072 + size_bytes, size_bytes, second_raw, 1, 0
        )
        print(
            f"    assert ReadGPR(5) == "
            f"{bit_literal(normalized_load_result(first_raw, size_bytes, metadata['signed_load']), 64)};"
        )
        print(
            f"    assert ReadGPR(6) == "
            f"{bit_literal(normalized_load_result(second_raw, size_bytes, metadata['signed_load']), 64)};"
        )
    elif action == "Store":
        print("    assert _MemoryEventCount == 1;")
        emit_agu_event_assertions("Store", 3072, size_bytes, first_stored, 0, 0)
        if metadata["update_mode"] != "None":
            print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 3072;")
    elif action == "StorePair":
        print("    assert _MemoryEventCount == 2;")
        emit_agu_event_assertions("Store", 3072, size_bytes, first_stored, 0, 0)
        emit_agu_event_assertions(
            "Store", 3072 + size_bytes, size_bytes, second_stored, 1, 0
        )


def emit_agu_common_setup(
    witness: dict, effect_index: int, *, destination_sentinel: int
) -> None:
    metadata = witness["metadata"]
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _TrapContexts[[0]].valid = FALSE;")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print(f"    WriteTPC(Zeros{{PTO_XLEN}} + 0x{witness['tpc']:x});")
    print("    WriteBPC(Zeros{PTO_XLEN} + 0x55);")
    print("    _CommitArgument = Zeros{PTO_XLEN} + 0x66;")
    print(f"    WriteGPR(2, {bit_literal(witness['base'], 64)});")
    print(f"    WriteGPR(3, {bit_literal(witness['src_r_value'], 64)});")
    print(
        f"    WriteGPR(4, {bit_literal(agu_store_value(metadata['size_bytes'], effect_index), 64)});"
    )
    print(f"    WriteGPR(5, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(6, {bit_literal(destination_sentinel, 64)});")
    print(
        f"    PushTemporaryQueue(TRUE, {bit_literal(agu_store_value(metadata['size_bytes'], effect_index), 64)});"
    )
    print(f"    assert ReadTPC() == Zeros{{PTO_XLEN}} + 0x{witness['tpc']:x};")


def emit_agu_event_assertions(
    kind: str,
    address: int,
    size_bytes: int,
    value: int,
    event_index: int,
    agent: int,
) -> None:
    print(f"    assert _MemoryEvents[[{event_index}]].kind == MemoryEvent_{kind};")
    print(f"    assert _MemoryEvents[[{event_index}]].agent == {agent};")
    print(
        f"    assert _MemoryEvents[[{event_index}]].address == {bit_literal(address, 64)};"
    )
    print(f"    assert _MemoryEvents[[{event_index}]].size_bytes == {size_bytes};")
    if kind == "Load":
        print(f"    assert !_MemoryEvents[[{event_index}]].write_performed;")
        print(
            f"    assert _MemoryEvents[[{event_index}]].read_value == {bit_literal(value, 64)};"
        )
    else:
        print(f"    assert _MemoryEvents[[{event_index}]].write_performed;")
        print(
            f"    assert _MemoryEvents[[{event_index}]].write_value == {bit_literal(value, 64)};"
        )
    print(f"    assert _MemoryEvents[[{event_index}]].order == MemoryOrder_Relaxed;")


def emit_agu_source_preservation(witness: dict, effect_index: int) -> None:
    metadata = witness["metadata"]
    action = metadata["action"]
    if metadata["address_kind"] == "Register":
        print(f"    assert ReadGPR(3) == {bit_literal(witness['src_r_value'], 64)};")
    if metadata["update_mode"] == "None" and metadata["address_kind"] != "PCRelative":
        print(f"    assert ReadGPR(2) == {bit_literal(witness['base'], 64)};")
    if action in {"Store", "StorePair"}:
        print(
            f"    assert ReadGPR(4) == {bit_literal(agu_store_value(metadata['size_bytes'], effect_index), 64)};"
        )
    if metadata["address_kind"] == "Compressed":
        preserved_index = 1 if action == "Load" else 0
        print(
            f"    assert ReadTemporaryQueue(TRUE, {preserved_index}) == "
            f"{bit_literal(agu_store_value(metadata['size_bytes'], effect_index), 64)};"
        )


def emit_scalar_agu_success(
    row: dict, family_constraints: list[dict], effect_index: int
) -> None:
    witness = scalar_agu_witness(row, family_constraints, effect_index)
    metadata = witness["metadata"]
    action = metadata["action"]
    size_bytes = metadata["size_bytes"]
    destination_sentinel = 0x5555555555555555
    print(
        f"    // {row['form_id']}: {row['mnemonic']} [{scalar_agu_effect_class(row)}]"
    )
    emit_agu_common_setup(
        witness, effect_index, destination_sentinel=destination_sentinel
    )
    print(
        f"    assert {bit_literal(witness['base'], 64)} + {bit_literal(witness['offset'] & MASK64, 64)} == "
        f"{bit_literal(witness['updated_base'], 64)};"
    )
    if action in {"Load", "LoadPair"}:
        first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
        print(
            f"    Store({bit_literal(witness['address'], 64)}, {size_bytes}, {bit_literal(first_raw, 64)});"
        )
        if action == "LoadPair":
            second_raw = agu_load_raw_value(
                size_bytes, metadata["signed_load"], second=True
            )
            second_address = witness["address"] + size_bytes
            print(
                f"    Store({bit_literal(second_address, 64)}, {size_bytes}, {bit_literal(second_raw, 64)});"
            )
    elif action == "StorePair":
        second = agu_store_value(size_bytes, effect_index, second=True)
        print(f"    WriteGPR(5, {bit_literal(second, 64)});")
    print("    ClearFault();")
    agent = effect_index % 4
    print(f"    StartMemoryEventCapture({agent});")
    print(
        f"    let scalar_agu_status_{effect_index} = ExecuteScalarInstruction("
        f"{bit_literal(witness['instruction'], 48)}, {row['length_bits']});"
    )
    print(f"    assert scalar_agu_status_{effect_index} == ScalarExecution_Executed;")
    print("    assert _LastFault == Fault_None;")
    print(
        "    assert ReadTPC() == Zeros{PTO_XLEN} + "
        f"0x{witness['tpc'] + row['length_bits'] // 8:x};"
    )
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print("    assert !_TrapContexts[[0]].valid;")

    if action == "Load":
        first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
        expected = normalized_load_result(
            first_raw, size_bytes, metadata["signed_load"]
        )
        if metadata["address_kind"] == "Compressed":
            print(
                f"    assert ReadTemporaryQueue(TRUE, 0) == {bit_literal(expected, 64)};"
            )
        elif metadata["update_mode"] == "None":
            print(f"    assert ReadGPR(5) == {bit_literal(expected, 64)};")
        else:
            print(f"    assert ReadGPR(5) == {bit_literal(expected, 64)};")
            print(
                f"    assert ReadGPR(2) == {bit_literal(witness['updated_base'], 64)};"
            )
        print("    assert _MemoryEventCount == 1;")
        emit_agu_event_assertions(
            "Load", witness["address"], size_bytes, first_raw, 0, agent
        )
    elif action == "LoadPair":
        first_raw = agu_load_raw_value(size_bytes, metadata["signed_load"])
        second_raw = agu_load_raw_value(
            size_bytes, metadata["signed_load"], second=True
        )
        print(
            f"    assert ReadGPR(5) == {bit_literal(normalized_load_result(first_raw, size_bytes, metadata['signed_load']), 64)};"
        )
        print(
            f"    assert ReadGPR(6) == {bit_literal(normalized_load_result(second_raw, size_bytes, metadata['signed_load']), 64)};"
        )
        print("    assert _MemoryEventCount == 2;")
        emit_agu_event_assertions(
            "Load", witness["address"], size_bytes, first_raw, 0, agent
        )
        emit_agu_event_assertions(
            "Load", witness["address"] + size_bytes, size_bytes, second_raw, 1, agent
        )
    elif action == "Store":
        source = agu_store_value(size_bytes, effect_index)
        stored = source & ((1 << (size_bytes * 8)) - 1)
        print("    assert _MemoryEventCount == 1;")
        emit_agu_event_assertions(
            "Store", witness["address"], size_bytes, stored, 0, agent
        )
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_stored_{effect_index} = LoadUnsigned({bit_literal(witness['address'], 64)}, {size_bytes});"
        )
        print(
            f"    assert scalar_agu_stored_{effect_index} == {bit_literal(stored, 64)};"
        )
        if metadata["update_mode"] != "None":
            print(
                f"    assert ReadGPR(2) == {bit_literal(witness['updated_base'], 64)};"
            )
        else:
            print(f"    assert ReadGPR(2) == {bit_literal(witness['base'], 64)};")
    elif action == "StorePair":
        first = agu_store_value(size_bytes, effect_index)
        second = agu_store_value(size_bytes, effect_index, second=True)
        first_stored = first & ((1 << (size_bytes * 8)) - 1)
        second_stored = second & ((1 << (size_bytes * 8)) - 1)
        print("    assert _MemoryEventCount == 2;")
        emit_agu_event_assertions(
            "Store", witness["address"], size_bytes, first_stored, 0, agent
        )
        emit_agu_event_assertions(
            "Store",
            witness["address"] + size_bytes,
            size_bytes,
            second_stored,
            1,
            agent,
        )
        print("    StopMemoryEventCapture();")
        print(
            f"    let scalar_agu_pair_first_{effect_index} = LoadUnsigned({bit_literal(witness['address'], 64)}, {size_bytes});"
        )
        print(
            f"    let scalar_agu_pair_second_{effect_index} = LoadUnsigned({bit_literal(witness['address'] + size_bytes, 64)}, {size_bytes});"
        )
        print(
            f"    assert scalar_agu_pair_first_{effect_index} == {bit_literal(first_stored, 64)};"
        )
        print(
            f"    assert scalar_agu_pair_second_{effect_index} == {bit_literal(second_stored, 64)};"
        )
    elif action == "Prefetch":
        print("    assert _MemoryEventCount == 0;")
        print("    assert _LastFault == Fault_None;")
        if metadata["prefetch_returns_address"]:
            print(
                f"    assert ReadGPR(5) == {bit_literal(witness['updated_base'], 64)};"
            )
        else:
            print(f"    assert ReadGPR(5) == {bit_literal(destination_sentinel, 64)};")
    else:
        raise ValueError(f"unhandled AGU success action: {action}")
    emit_agu_source_preservation(witness, effect_index)


def emit_scalar_agu_fault(
    row: dict, family_constraints: list[dict], effect_index: int
) -> None:
    witness = scalar_agu_witness(row, family_constraints, effect_index, fault=True)
    metadata = witness["metadata"]
    action = metadata["action"]
    if action == "Prefetch":
        return
    size_bytes = metadata["size_bytes"]
    destination_sentinel = 0x5555555555555555
    print(f"    // {row['form_id']}: {row['mnemonic']} fault/no-partial-effect")
    emit_agu_common_setup(
        witness, effect_index, destination_sentinel=destination_sentinel
    )
    if action == "StorePair":
        print(
            f"    Store({bit_literal(witness['address'], 64)}, {size_bytes}, Zeros{{PTO_XLEN}} + 0xaa);"
        )
    print("    ClearFault();")
    print(f"    StartMemoryEventCapture({(effect_index + 1) % 4});")
    print(
        f"    let scalar_agu_fault_status_{effect_index} = ExecuteScalarInstruction("
        f"{bit_literal(witness['instruction'], 48)}, {row['length_bits']});"
    )
    print(
        f"    assert scalar_agu_fault_status_{effect_index} == ScalarExecution_Rejected;"
    )
    print("    assert _LastFault == Fault_DataPage;")
    print(f"    assert _FaultAddress == {bit_literal(witness['fault_address'], 64)};")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print(
        f"    assert _TrapContexts[[0]].tpc == Zeros{{PTO_XLEN}} + 0x{witness['tpc']:x};"
    )
    print("    assert _TrapContexts[[0]].valid;")
    print(f"    assert ReadTPC() == {bit_literal(witness['fault_address'], 64)};")
    print("    assert _MemoryEventCount == 0;")
    if metadata["address_kind"] == "Register":
        print(f"    assert ReadGPR(3) == {bit_literal(witness['src_r_value'], 64)};")
    if metadata["address_kind"] == "Compressed":
        print(
            f"    assert ReadTemporaryQueue(TRUE, 0) == {bit_literal(agu_store_value(size_bytes, effect_index), 64)};"
        )
    if action in {"Load", "LoadPair"}:
        if metadata["address_kind"] == "Compressed":
            print(
                f"    assert ReadTemporaryQueue(TRUE, 0) == {bit_literal(agu_store_value(size_bytes, effect_index), 64)};"
            )
        else:
            print(f"    assert ReadGPR(5) == {bit_literal(destination_sentinel, 64)};")
        print(f"    assert ReadGPR(2) == {bit_literal(witness['base'], 64)};")
    elif action == "Store":
        print(f"    assert ReadGPR(2) == {bit_literal(witness['base'], 64)};")
        print(
            f"    assert ReadGPR(4) == {bit_literal(agu_store_value(size_bytes, effect_index), 64)};"
        )
    elif action == "StorePair":
        print(
            f"    let scalar_agu_pair_preserved_{effect_index} = LoadUnsigned({bit_literal(witness['address'], 64)}, {size_bytes});"
        )
        print(
            f"    assert scalar_agu_pair_preserved_{effect_index} == Zeros{{PTO_XLEN}} + 0xaa;"
        )
        print(
            f"    assert ReadGPR(4) == {bit_literal(agu_store_value(size_bytes, effect_index), 64)};"
        )


def command_bundle_kind(row: dict) -> str:
    mnemonic = row["mnemonic"]
    if ".FP" in mnemonic:
        return "Floating"
    if ".SYS" in mnemonic:
        return "System"
    if ".MPAR" in mnemonic:
        return "MachineParallel"
    if ".MSEQ" in mnemonic:
        return "MachineSequential"
    if any(
        token in mnemonic
        for token in (".MGATHER", ".MSCATTER", ".TLOAD", ".TSTORE", ".TPREFETCH")
    ):
        return "TileMemory"
    if any(token in mnemonic for token in (".CUBE", ".TGEMV", ".TMATMUL")):
        return "TileMatrix"
    if any(token in mnemonic for token in (".TEPL", ".FIXP", ".TMOV")):
        return "TileElement"
    if mnemonic.startswith("F"):
        return "FrameTemplate"
    return "Standard"


def command_bundle_operation_class(row: dict) -> str:
    if row["semantic_handler"] != "ExecuteBundleStart":
        return "Control"
    mnemonic = row["mnemonic"]
    if ".MPAR" in mnemonic or ".MSEQ" in mnemonic:
        return "Machine"
    if ".TEPL" in mnemonic:
        return "TileElement"
    if ".FIXP" in mnemonic:
        return "FixedPoint"
    if any(
        token in mnemonic
        for token in (
            ".MGATHER",
            ".MSCATTER",
            ".TLOAD",
            ".TSTORE",
            ".TMOV",
            ".GMOV",
            ".TPREFETCH",
        )
    ):
        return "TileMemory"
    if any(token in mnemonic for token in (".CUBE", ".TGEMV", ".TMATMUL")):
        return "TileMatrix"
    return "Control"


def command_bundle_selector(row: dict, tile_selectors: dict[str, int]) -> int | None:
    if row["semantic_handler"] != "ExecuteBundleStart":
        return None
    mnemonic = row["mnemonic"]
    if mnemonic in {"BSTART.TEPL", "BSTART.CUBE", "BSTART.FIXP"}:
        return None
    if not mnemonic.startswith("BSTART."):
        return None
    operation = mnemonic.removeprefix("BSTART.")
    operation = operation.replace("TMATMULMX", "TMATMUL_MX")
    operation = operation.replace("TGEMVMX", "TGEMV_MX")
    operation = operation.replace(".", "_")
    return tile_selectors.get(operation)


def command_bundle_start_rejected(row: dict) -> bool:
    """Return whether the canonical start witness is intentionally unsupported."""
    return row["mnemonic"] in {"BSTART.CUBE", "BSTART.FIXP"}


PTO_V0_UNSUPPORTED_COMMAND_HANDLERS = {
    "SaveExecutionContext",
    "RecoverExecutionContext",
    "ExecuteFrameEntry",
    "ExecuteFrameExit",
    "ExecuteFrameReturnAddress",
    "ExecuteFrameReturnStack",
    "ExecuteQueueMove",
    "ExecuteQueuePop",
    "ExecuteQueuePush",
    "ExecuteCrossBlockTransfer",
}

BUNDLE_ARGUMENT_KINDS = {
    "B.ARG NORM.normal": 0,
    "B.ARG format": 1,
    "B.ARG NZ2DN.canon": 2,
    "B.ARG ND2ZN.normal, FP16, Null": 3,
    "B.ARG DN2ZN.normal, FP16, Null": 4,
    "B.ARG DN2NZ.normal, FP32, Null": 5,
}


def command_execution_rejected(row: dict) -> bool:
    return row["semantic_handler"] in PTO_V0_UNSUPPORTED_COMMAND_HANDLERS or (
        row["semantic_handler"] == "ExecuteBundleStart"
        and command_bundle_start_rejected(row)
    )


def command_bundle_transfer(row: dict) -> str:
    asm = row["asm"]
    if "{DIRECT, CALL}" in asm:
        return "Direct"
    if "ICALL" in asm:
        return "IndirectCall"
    if "CALL" in asm:
        return "Call"
    if "RET" in asm:
        return "Return"
    if "COND" in asm:
        return "Conditional"
    if "IND" in asm:
        return "Indirect"
    if "DIRECT" in asm:
        return "Direct"
    return "Fallthrough"


def command_signed_offset_field(row: dict) -> dict | None:
    signed_fields = [
        field
        for field in row["fields"]
        if field["signedness"] == "signed" and field["name"].startswith("simm")
    ]
    if not signed_fields:
        return None
    if len(signed_fields) != 1:
        raise ValueError(f"ambiguous command offset field: {row['form_id']}")
    return signed_fields[0]


def emit_enum(type_name: str, members: list[str], columns: int = 3) -> None:
    print(f"type {type_name} of enumeration {{")
    for offset in range(0, len(members), columns):
        row = members[offset : offset + columns]
        suffix = "," if offset + columns < len(members) else ""
        print(f"    {', '.join(row)}{suffix}")
    print("};")


def encoded_form_witness(row: dict) -> int:
    instruction = 0
    for part in row["encoding"]:
        instruction |= int(part["match"], 16) << (part["index"] * 32)
    for constraint in row["constraints"]:
        operator = constraint["operator"]
        field_name = constraint["field"]
        if operator == "not-equal":
            if decode_field(row, field_name, instruction) == constraint["value"]:
                field = next(
                    field for field in row["fields"] if field["name"] == field_name
                )
                replacement = (constraint["value"] + 1) % (1 << field["width"])
                instruction = encode_field(
                    row, field_name, instruction, replacement
                )
        elif operator == "one-of":
            allowed = constraint["values"]
            if decode_field(row, field_name, instruction) not in allowed:
                instruction = encode_field(row, field_name, instruction, allowed[0])
        else:
            raise ValueError(f"unsupported encoded-form constraint: {constraint!r}")
    return instruction


def encoding_alternatives(row: dict) -> list[list[dict]]:
    return [row["encoding"], *[variant["encoding"] for variant in row.get("encoding_variants", [])]]


def catalog_decode_order(rows: list[dict]) -> list[tuple[int, dict]]:
    return sorted(
        enumerate(rows),
        key=lambda pair: (
            -sum(bin(int(part["mask"], 16)).count("1") for part in pair[1]["encoding"]),
            pair[1]["form_id"],
        ),
    )


def form_encoding_matches(row: dict, instruction: int) -> bool:
    for encoding in encoding_alternatives(row):
        for part in encoding:
            low = part["index"] * 32
            width = part["width_bits"]
            word = (instruction >> low) & ((1 << width) - 1)
            mask = int(part["mask"], 16)
            if word & mask != int(part["match"], 16):
                break
        else:
            return True
    return False


def form_constraints_hold(row: dict, instruction: int) -> bool:
    for constraint in row["constraints"]:
        value = decode_field(row, constraint["field"], instruction)
        if constraint["operator"] == "not-equal":
            if value == constraint["value"]:
                return False
        elif constraint["operator"] == "one-of":
            if value not in constraint["values"]:
                return False
        else:
            raise ValueError(f"unsupported encoded-form constraint: {constraint!r}")
    return True


def encoded_catalog_witnesses(rows: list[dict]) -> list[int]:
    """Find legal witnesses that select each row under the emitted priority decoder."""
    ordered = catalog_decode_order(rows)
    witnesses: list[int] = []
    for target, row in enumerate(rows):
        base = encoded_form_witness(row)
        candidates = [base]
        for attempt in range(1, 65536):
            candidate = base
            state = ((target + 1) << 32) ^ attempt ^ 0x9E3779B97F4A7C15
            for field in row["fields"]:
                state = (state * 6364136223846793005 + 1442695040888963407) & (
                    (1 << 64) - 1
                )
                value = (state >> 17) & ((1 << field["width"]) - 1)
                candidate = encode_field(row, field["name"], candidate, value)
            candidates.append(candidate)
        for candidate in candidates:
            if not form_constraints_hold(row, candidate):
                continue
            decoded = next(
                (
                    index
                    for index, candidate_row in ordered
                    if candidate_row["length_bits"] == row["length_bits"]
                    and form_encoding_matches(candidate_row, candidate)
                ),
                len(rows),
            )
            if decoded == target:
                witnesses.append(candidate)
                break
        else:
            raise ValueError(
                f"command form has no legal priority-decode witness: {row['form_id']}"
            )
    return witnesses


def emit_encoded_catalog(
    prefix: str,
    rows: list[dict],
    tile_selectors: dict[str, int] | None = None,
    witnesses: list[int] | None = None,
) -> None:
    """Emit decode, identity, handler, and operand metadata for CMD/BBD or VEC."""
    upper = prefix.upper()
    count_name = f"PTO_{upper}_FORM_COUNT"
    index_type = f"{prefix}FormIndex"
    operation_type = f"{prefix}Operation"
    handler_type = f"{prefix}SemanticHandler"
    operand_type = f"{prefix}OperandField"
    operations = [f"{prefix}Operation_{asl_identifier(row['form_id'])}" for row in rows]
    handlers = sorted({row["semantic_handler"] for row in rows})
    operands = sorted({field["name"] for row in rows for field in row["fields"]})

    print(f"constant {count_name} = {len(rows)};")
    print(f"type {index_type} of integer {{0..{count_name}}};")
    emit_enum(operation_type, operations, 2)
    emit_enum(
        handler_type,
        [f"{prefix}Handler_{asl_identifier(name)}" for name in handlers],
        2,
    )
    emit_enum(
        operand_type, [f"{prefix}Field_{asl_identifier(name)}" for name in operands], 3
    )
    print()
    print(f"pure func Decode{prefix}Form(instruction: bits(64),")
    print("                          length_bits: integer {16,32,48,64})")
    print(f"                          => {index_type}")
    print("begin")
    ordered = catalog_decode_order(rows)
    for index, row in ordered:
        alternatives = []
        for encoding in encoding_alternatives(row):
            tests = [f"length_bits == {row['length_bits']}"]
            for part in encoding:
                low = part["index"] * 32
                width = part["width_bits"]
                mask = bit_literal(int(part["mask"], 16), width)
                match = bit_literal(int(part["match"], 16), width)
                tests.append(f"(instruction[{low} +: {width}] AND {mask}) == {match}")
            alternatives.append(f"({' && '.join(tests)})")
        print(f"    if {' || '.join(alternatives)} then return {index}; end;")
    print(f"    return {count_name};")
    print("end;")
    print()
    if prefix == "Command":
        if tile_selectors is None:
            raise ValueError("command catalog generation requires tile selectors")
        print("pure func CommandBundleKindOfForm(")
        print(f"    form: integer {{0..{count_name}-1}}) => BundleKind")
        print("begin")
        for index, row in enumerate(rows):
            print(
                f"    if form == {index} then return BundleKind_"
                f"{command_bundle_kind(row)}; end;"
            )
        print("    unreachable;")
        print("end;")
        print()
        print("pure func CommandBundleOperationClassOfForm(")
        print(f"    form: integer {{0..{count_name}-1}}) => BundleOperationClass")
        print("begin")
        for index, row in enumerate(rows):
            print(
                f"    if form == {index} then return BundleOperation_"
                f"{command_bundle_operation_class(row)}; end;"
            )
        print("    unreachable;")
        print("end;")
        print()
        print("pure func CommandBundleArgumentKindOfForm(")
        print(f"    form: integer {{0..{count_name}-1}}) => bits(3)")
        print("begin")
        for index, row in enumerate(rows):
            if row["semantic_handler"] == "SetBundleArgument":
                print(
                    f"    if form == {index} then return "
                    f"{bit_literal(BUNDLE_ARGUMENT_KINDS[row['asm']], 3)}; end;"
                )
        print("    return Zeros{3};")
        print("end;")
        print()
        print("pure func CommandBundleSelectorConstantPresent(")
        print(f"    form: integer {{0..{count_name}-1}}) => boolean")
        print("begin")
        for index, row in enumerate(rows):
            value = command_bundle_selector(row, tile_selectors)
            if value is not None:
                print(f"    if form == {index} then return TRUE; end;")
        print("    return FALSE;")
        print("end;")
        print()
        print("pure func CommandBundleSelectorUsesEncodingVariant(")
        print(f"    form: integer {{0..{count_name}-1}}) => boolean")
        print("begin")
        for index, row in enumerate(rows):
            if row.get("encoding_variants"):
                print(f"    if form == {index} then return TRUE; end;")
        print("    return FALSE;")
        print("end;")
        print()
        print("pure func CommandBundleSelectorConstantOfForm(")
        print("    instruction: bits(64),")
        print(f"    form: integer {{0..{count_name}-1}}) => bits(10)")
        print("begin")
        for index, row in enumerate(rows):
            value = command_bundle_selector(row, tile_selectors)
            if value is not None:
                if row.get("encoding_variants"):
                    print(
                        f"    if form == {index} then return "
                        "ZeroExtend{10}(instruction[20 +: 5]); end;"
                    )
                else:
                    print(
                        f"    if form == {index} then return {bit_literal(value, 10)}; end;"
                    )
        print("    return Zeros{10};")
        print("end;")
        print()
        print("pure func CommandBundleTransferOfForm(")
        print(f"    form: integer {{0..{count_name}-1}}) => BundleTransfer")
        print("begin")
        for index, row in enumerate(rows):
            print(
                f"    if form == {index} then return BundleTransfer_"
                f"{command_bundle_transfer(row)}; end;"
            )
        print("    unreachable;")
        print("end;")
        print()
        print("pure func CommandHasSignedOffset(")
        print(f"    form: integer {{0..{count_name}-1}}) => boolean")
        print("begin")
        for index, row in enumerate(rows):
            value = "TRUE" if command_signed_offset_field(row) is not None else "FALSE"
            print(f"    if form == {index} then return {value}; end;")
        print("    unreachable;")
        print("end;")
        print()
        print("pure func CommandSignedOffsetOfForm(")
        print("    instruction: bits(64),")
        print(f"    form: integer {{0..{count_name}-1}}) => Word")
        print("begin")
        for index, row in enumerate(rows):
            field = command_signed_offset_field(row)
            if field is None:
                print(f"    if form == {index} then return Zeros{{PTO_XLEN}}; end;")
            else:
                name = asl_identifier(field["name"])
                width = field["width"]
                print(
                    f"    if form == {index} then return SignExtend{{PTO_XLEN}}("
                    f"Decode{prefix}OperandRaw(instruction, form, "
                    f"{prefix}Field_{name})[{width - 1}:0]); end;"
                )
        print("    unreachable;")
        print("end;")
        print()
    print(f"pure func {prefix}OperationOfForm(form: integer {{0..{count_name}-1}})")
    print(f"                                 => {operation_type}")
    print("begin")
    for index, operation in enumerate(operations):
        print(f"    if form == {index} then return {operation}; end;")
    print("    unreachable;")
    print("end;")
    print()
    print(f"pure func {prefix}HandlerOfForm(form: integer {{0..{count_name}-1}})")
    print(f"                               => {handler_type}")
    print("begin")
    for index, row in enumerate(rows):
        print(
            f"    if form == {index} then return {prefix}Handler_"
            f"{asl_identifier(row['semantic_handler'])}; end;"
        )
    print("    unreachable;")
    print("end;")
    print()
    print(f"pure func {prefix}OperandPresent(form: integer {{0..{count_name}-1}},")
    print(f"                                field: {operand_type}) => boolean")
    print("begin")
    for index, row in enumerate(rows):
        for field in row["fields"]:
            print(
                f"    if form == {index} && field == {prefix}Field_"
                f"{asl_identifier(field['name'])} then return TRUE; end;"
            )
    print("    return FALSE;")
    print("end;")
    print()
    print(f"pure func {prefix}OperandWidth(form: integer {{0..{count_name}-1}},")
    print(f"                              field: {operand_type}) => integer {{0..64}}")
    print("begin")
    for index, row in enumerate(rows):
        for field in row["fields"]:
            print(
                f"    if form == {index} && field == {prefix}Field_"
                f"{asl_identifier(field['name'])} then return {field['width']}; end;"
            )
    print("    return 0;")
    print("end;")
    print()
    print(f"pure func {prefix}OperandSignedness(form: integer {{0..{count_name}-1}},")
    print(
        f"                                   field: {operand_type}) => ScalarFieldSignedness"
    )
    print("begin")
    signedness_names = {
        "encoding-defined": "EncodingDefined",
        "signed": "Signed",
        "unsigned": "Unsigned",
    }
    for index, row in enumerate(rows):
        for field in row["fields"]:
            print(
                f"    if form == {index} && field == {prefix}Field_"
                f"{asl_identifier(field['name'])} then return ScalarField_"
                f"{signedness_names[field['signedness']]}; end;"
            )
    print("    return ScalarField_EncodingDefined;")
    print("end;")
    print()
    print(f"pure func Decode{prefix}OperandRaw(instruction: bits(64),")
    print(f"                                  form: integer {{0..{count_name}-1}},")
    print(f"                                  field: {operand_type}) => bits(64)")
    print("begin")
    for index, row in enumerate(rows):
        for field in row["fields"]:
            print(
                f"    if form == {index} && field == {prefix}Field_"
                f"{asl_identifier(field['name'])} then"
            )
            print("        var value = Zeros{64};")
            for piece in field["pieces"]:
                print(
                    f"        value[{piece['value_lsb']} +: {piece['width']}] = "
                    f"instruction[{piece['instruction_lsb']} +: {piece['width']}];"
                )
            print("        return value;")
            print("    end;")
    print("    return Zeros{64};")
    print("end;")
    print()
    print(f"pure func {prefix}FormOperandsLegal(instruction: bits(64),")
    print(
        f"                                      form: integer {{0..{count_name}-1}}) => boolean"
    )
    print("begin")
    for index, row in enumerate(rows):
        for constraint in row["constraints"]:
            width = next(
                field["width"]
                for field in row["fields"]
                if field["name"] == constraint["field"]
            )
            decoded = (
                f"Decode{prefix}OperandRaw(instruction, form, "
                f"{prefix}Field_{asl_identifier(constraint['field'])})"
                f"[{width - 1}:0]"
            )
            if constraint["operator"] == "not-equal":
                print(
                    f"    if form == {index} && {decoded} == "
                    f"{bit_literal(constraint['value'], width)} then return FALSE; end;"
                )
            elif constraint["operator"] == "one-of":
                allowed = " || ".join(
                    f"{decoded} == {bit_literal(value, width)}"
                    for value in constraint["values"]
                )
                print(
                    f"    if form == {index} && !({allowed}) "
                    "then return FALSE; end;"
                )
            else:
                raise ValueError(f"unsupported {prefix} constraint: {constraint!r}")
    print("    return TRUE;")
    print("end;")
    print()
    print(f"func Validate{prefix}CatalogDecode()")
    print("begin")
    for index, row in enumerate(rows):
        witness_value = (
            witnesses[index] if witnesses is not None else encoded_form_witness(row)
        )
        witness = bit_literal(witness_value, 64)
        print(
            f"    assert Decode{prefix}Form({witness}, {row['length_bits']}) == {index};"
        )
        print(f"    assert {prefix}OperationOfForm({index}) == {operations[index]};")
        print(
            f"    assert {prefix}HandlerOfForm({index}) == {prefix}Handler_"
            f"{asl_identifier(row['semantic_handler'])};"
        )
        print(f"    assert {prefix}FormOperandsLegal({witness}, {index});")
        for field in row["fields"]:
            print(
                f"    assert {prefix}OperandPresent({index}, {prefix}Field_"
                f"{asl_identifier(field['name'])});"
            )
            print(
                f"    assert {prefix}OperandWidth({index}, {prefix}Field_"
                f"{asl_identifier(field['name'])}) == {field['width']};"
            )
    print("end;")
    print()


def main() -> None:
    scalar_catalog = load("spec/catalog/scalar-forms.json")
    scalar = scalar_catalog["forms"]
    for index, row in enumerate(scalar):
        row["_form_index"] = index
    family_constraints = scalar_catalog["family_constraints"]
    command = load("spec/catalog/command-forms.json")["forms"]
    tile_catalog = load("spec/catalog/tile-operations.json")
    tile = tile_catalog["operations"]
    numeric_applicability = load("spec/catalog/numeric-profile-applicability.json")
    numeric_applicability_rules = numeric_applicability["rules"]
    system_register_catalog = load("spec/catalog/system-registers.json")
    system_registers = system_register_catalog["registers"]
    system_register_behaviors = {
        name: behavior
        for behavior in system_register_catalog["behavior_classes"]
        for name in behavior["registers"]
    }
    operand_fields = sorted(
        {field["name"] for row in scalar for field in row["fields"]}
    )
    scalar_operations = [
        f"ScalarOperation_{asl_identifier(row['mnemonic'])}" for row in scalar
    ]
    scalar_handlers = sorted({row["semantic_handler"] for row in scalar})
    scalar_binary_effect_rows = [
        row for row in scalar if scalar_binary_effect_metadata(row) is not None
    ]
    if len(scalar_binary_effect_rows) != 53:
        raise ValueError(
            "reviewed scalar binary effect class must contain exactly 53 forms"
        )
    scalar_nonbinary_alu_effect_rows = [
        row
        for row in scalar
        if scalar_alu_effect_class(row) is not None
        and scalar_binary_effect_metadata(row) is None
    ]
    scalar_alu_effect_rows = [
        row for row in scalar if scalar_alu_effect_class(row) is not None
    ]
    expected_alu_effect_classes = {
        "scalar-arithmetic-value": 16,
        "scalar-binary-value": 53,
        "scalar-bitfield-value": 9,
        "scalar-control-value": 2,
        "scalar-materialize-value": 12,
        "scalar-pair-value": 14,
        "scalar-select-value": 1,
    }
    actual_alu_effect_classes = {
        class_id: sum(
            scalar_alu_effect_class(row) == class_id for row in scalar_alu_effect_rows
        )
        for class_id in expected_alu_effect_classes
    }
    if actual_alu_effect_classes != expected_alu_effect_classes:
        raise ValueError(
            "reviewed ALU effect-class inventory drift: "
            f"expected {expected_alu_effect_classes}, got {actual_alu_effect_classes}"
        )
    if len(scalar_nonbinary_alu_effect_rows) != 54:
        raise ValueError(
            "reviewed non-binary ALU effect classes must contain exactly 54 forms"
        )
    scalar_alu_boundary_case_count = sum(
        len(scalar_alu_boundary_labels(row)) for row in scalar_alu_effect_rows
    )
    scalar_bru_effect_rows = [
        row for row in scalar if scalar_bru_effect_class(row) is not None
    ]
    expected_bru_effect_classes = {
        "scalar-branch-control": 8,
        "scalar-commit-value": 26,
        "scalar-compare-value": 26,
        "scalar-jump-control": 2,
        "scalar-pc-relative-value": 2,
        "scalar-return-address": 2,
    }
    actual_bru_effect_classes = {
        class_id: sum(
            scalar_bru_effect_class(row) == class_id for row in scalar_bru_effect_rows
        )
        for class_id in expected_bru_effect_classes
    }
    if actual_bru_effect_classes != expected_bru_effect_classes:
        raise ValueError(
            "reviewed BRU effect-class inventory drift: "
            f"expected {expected_bru_effect_classes}, got {actual_bru_effect_classes}"
        )
    scalar_bru_totality_case_count = sum(
        len(scalar_bru_totality_labels(row)) for row in scalar_bru_effect_rows
    )
    scalar_amo_effect_rows = [
        row for row in scalar if scalar_amo_effect_class(row) is not None
    ]
    actual_amo_effect_classes = {
        class_id: sum(
            scalar_amo_effect_class(row) == class_id for row in scalar_amo_effect_rows
        )
        for class_id in SCALAR_AMO_EFFECT_CLASS_COUNTS
    }
    if actual_amo_effect_classes != SCALAR_AMO_EFFECT_CLASS_COUNTS:
        raise ValueError(
            "reviewed AMO effect-class inventory drift: "
            f"expected {SCALAR_AMO_EFFECT_CLASS_COUNTS}, got {actual_amo_effect_classes}"
        )
    scalar_amo_modifier_case_count = sum(
        len(scalar_amo_modifier_cases(row)) for row in scalar_amo_effect_rows
    )
    scalar_amo_value_case_count = sum(
        len(scalar_amo_value_cases(row)) for row in scalar_amo_effect_rows
    )
    scalar_amo_source_occurrence_count = sum(
        len(scalar_amo_source_fields(row)) for row in scalar_amo_effect_rows
    )
    scalar_amo_temp_source_case_count = scalar_amo_source_occurrence_count * len(
        SCALAR_AMO_TEMP_SOURCE_SELECTORS
    )
    scalar_amo_destination_occurrence_count = sum(
        field_by_name(row, "RegDst") is not None for row in scalar_amo_effect_rows
    )
    scalar_amo_special_destination_case_count = (
        scalar_amo_destination_occurrence_count
        * len(SCALAR_AMO_SPECIAL_DESTINATION_SELECTORS)
    )
    scalar_amo_absolute_overlap_case_count = sum(
        len(scalar_amo_source_fields(row))
        for row in scalar_amo_effect_rows
        if field_by_name(row, "RegDst") is not None
    )
    scalar_amo_ignored_src_zero_case_count = sum(
        field_by_name(row, "SrcZero") is not None for row in scalar_amo_effect_rows
    ) * len(range(32))
    scalar_amo_alias_case_count = (
        scalar_amo_temp_source_case_count
        + scalar_amo_special_destination_case_count
        + scalar_amo_absolute_overlap_case_count
        + scalar_amo_ignored_src_zero_case_count
    )
    actual_amo_stage4_stable_counts = (
        scalar_amo_modifier_case_count,
        scalar_amo_value_case_count,
        scalar_amo_source_occurrence_count,
        scalar_amo_temp_source_case_count,
        scalar_amo_destination_occurrence_count,
        scalar_amo_special_destination_case_count,
        scalar_amo_absolute_overlap_case_count,
        scalar_amo_ignored_src_zero_case_count,
        scalar_amo_alias_case_count,
    )
    expected_amo_stage4_stable_counts = (337, 320, 110, 880, 36, 324, 76, 128, 1408)
    if actual_amo_stage4_stable_counts != expected_amo_stage4_stable_counts:
        raise ValueError(
            "reviewed AMO stable Stage 4 inventory drift: expected "
            f"{expected_amo_stage4_stable_counts}, got "
            f"{actual_amo_stage4_stable_counts}"
        )
    scalar_amo_fault_case_count = sum(
        len(scalar_amo_fault_cases(row)) for row in scalar_amo_effect_rows
    )
    scalar_amo_restart_case_count = scalar_amo_fault_case_count
    scalar_amo_sc_miss_no_probe_case_count = sum(
        len(scalar_amo_fault_cases(row))
        for row in scalar_amo_effect_rows
        if scalar_amo_effect_class(row) == "scalar-amo-store-conditional"
    )
    scalar_amo_fault_restart_case_count = (
        scalar_amo_fault_case_count
        + scalar_amo_restart_case_count
        + scalar_amo_sc_miss_no_probe_case_count
    )
    scalar_amo_reservation_case_count = 16 + 16 + 8 + 16 + 12 + 8 + 5
    scalar_amo_dma_case_count = 15
    scalar_amo_totality_case_count = (
        scalar_amo_modifier_case_count
        + scalar_amo_value_case_count
        + scalar_amo_fault_restart_case_count
        + scalar_amo_reservation_case_count
        + scalar_amo_dma_case_count
    )
    scalar_amo_stage4_case_count = (
        scalar_amo_totality_case_count + scalar_amo_alias_case_count
    )
    scalar_amo_retained_stage1_case_count = (
        len(scalar_amo_effect_rows)
        + SCALAR_AMO_EFFECT_CLASS_COUNTS["scalar-amo-store-conditional"]
        + SCALAR_AMO_EFFECT_CLASS_COUNTS["scalar-amo-cas"]
        + SCALAR_AMO_EFFECT_CLASS_COUNTS["scalar-dma-copy"]
    )
    scalar_amo_executable_case_count = (
        scalar_amo_retained_stage1_case_count + scalar_amo_stage4_case_count
    )
    actual_amo_closure_counts = (
        scalar_amo_fault_case_count,
        scalar_amo_restart_case_count,
        scalar_amo_sc_miss_no_probe_case_count,
        scalar_amo_fault_restart_case_count,
        scalar_amo_reservation_case_count,
        scalar_amo_dma_case_count,
        scalar_amo_totality_case_count,
        scalar_amo_stage4_case_count,
        scalar_amo_retained_stage1_case_count,
        scalar_amo_executable_case_count,
    )
    expected_amo_closure_counts = (151, 151, 11, 313, 81, 15, 1066, 2474, 66, 2540)
    if actual_amo_closure_counts != expected_amo_closure_counts:
        raise ValueError(
            "reviewed AMO closure inventory drift: expected "
            f"{expected_amo_closure_counts}, got {actual_amo_closure_counts}"
        )
    scalar_fsu_effect_rows = [
        row for row in scalar if scalar_fsu_effect_class(row) is not None
    ]
    actual_fsu_effect_classes = {
        class_id: sum(
            scalar_fsu_effect_class(row) == class_id for row in scalar_fsu_effect_rows
        )
        for class_id in SCALAR_FSU_EFFECT_CLASS_COUNTS
    }
    if actual_fsu_effect_classes != SCALAR_FSU_EFFECT_CLASS_COUNTS:
        raise ValueError(
            "reviewed FSU effect-class inventory drift: "
            f"expected {SCALAR_FSU_EFFECT_CLASS_COUNTS}, got {actual_fsu_effect_classes}"
        )
    scalar_fsu_type_case_count = sum(
        len(scalar_fsu_type_cases(row)) for row in scalar_fsu_effect_rows
    )
    scalar_fsu_type_fault_case_count = sum(
        not legal
        for row in scalar_fsu_effect_rows
        for _, _, _, legal in scalar_fsu_type_cases(row)
    )
    scalar_fsu_boundary_case_count = sum(
        len(scalar_fsu_boundary_cases(row)) for row in scalar_fsu_effect_rows
    )
    scalar_fsu_rounding_case_count = sum(
        8
        for row in scalar_fsu_effect_rows
        if scalar_fsu_active_rounding_consumer(row)
        or scalar_fsu_fixed_rounding_consumer(row)
    )
    scalar_fsu_alias_case_count = sum(
        len(scalar_fsu_alias_cases(row)) for row in scalar_fsu_effect_rows
    )
    scalar_fsu_sticky_case_count = len(scalar_fsu_effect_rows) * 7
    scalar_fsu_totality_case_count = (
        scalar_fsu_type_case_count
        + scalar_fsu_boundary_case_count
        + scalar_fsu_rounding_case_count
        + scalar_fsu_alias_case_count
        + scalar_fsu_sticky_case_count
    )
    expected_fsu_counts = (488, 204, 500, 152, 920, 210, 2270)
    actual_fsu_counts = (
        scalar_fsu_type_case_count,
        scalar_fsu_type_fault_case_count,
        scalar_fsu_boundary_case_count,
        scalar_fsu_rounding_case_count,
        scalar_fsu_alias_case_count,
        scalar_fsu_sticky_case_count,
        scalar_fsu_totality_case_count,
    )
    if actual_fsu_counts != expected_fsu_counts:
        raise ValueError(
            "reviewed FSU totality inventory drift: "
            f"expected {expected_fsu_counts}, got {actual_fsu_counts}"
        )
    scalar_sys_effect_rows = [
        row for row in scalar if scalar_sys_effect_class(row) is not None
    ]
    scalar_sys_by_mnemonic = {row["mnemonic"]: row for row in scalar_sys_effect_rows}
    actual_sys_effect_classes = {
        class_id: sum(
            scalar_sys_effect_class(row) == class_id for row in scalar_sys_effect_rows
        )
        for class_id in SCALAR_SYS_EFFECT_CLASS_COUNTS
    }
    if actual_sys_effect_classes != SCALAR_SYS_EFFECT_CLASS_COUNTS:
        raise ValueError(
            "reviewed SYS effect-class inventory drift: "
            f"expected {SCALAR_SYS_EFFECT_CLASS_COUNTS}, got {actual_sys_effect_classes}"
        )
    scalar_sys_register_transfer_rows = [
        row
        for row in scalar_sys_effect_rows
        if scalar_sys_effect_class(row)
        in {
            "scalar-system-register-read",
            "scalar-system-register-write",
            "scalar-system-register-swap",
        }
    ]
    scalar_sys_register_transfer_cases = []
    for row in scalar_sys_register_transfer_rows:
        address_field = scalar_sys_register_address_field(row)
        address_limit = 1 << address_field["width"]
        for register in system_registers:
            behavior = system_register_behaviors[register["name"]]
            for address in system_register_addresses(register):
                if address < address_limit:
                    scalar_sys_register_transfer_cases.append(
                        (row, register, behavior, address, address_field["name"])
                    )
    if len(scalar_sys_register_transfer_cases) != 1937:
        raise ValueError(
            "reviewed bank-expanded SYS register-transfer inventory drift: "
            f"expected 1937, got {len(scalar_sys_register_transfer_cases)}"
        )
    scalar_sys_selector_read_rows = [
        row
        for row in scalar_sys_register_transfer_rows
        if scalar_sys_effect_class(row) == "scalar-system-register-read"
        and field_by_name(row, "RegDst") is not None
    ]
    scalar_sys_selector_write_rows = [
        row
        for row in scalar_sys_register_transfer_rows
        if scalar_sys_effect_class(row) == "scalar-system-register-write"
    ]
    scalar_sys_selector_swap_rows = [
        row
        for row in scalar_sys_register_transfer_rows
        if scalar_sys_effect_class(row) == "scalar-system-register-swap"
    ]
    scalar_sys_selector_read_case_count = len(scalar_sys_selector_read_rows) * 32
    scalar_sys_selector_write_case_count = len(scalar_sys_selector_write_rows) * 32
    scalar_sys_selector_swap_case_count = len(scalar_sys_selector_swap_rows) * 32 * 32
    scalar_sys_selector_case_count = (
        scalar_sys_selector_read_case_count
        + scalar_sys_selector_write_case_count
        + scalar_sys_selector_swap_case_count
    )
    if (
        scalar_sys_selector_read_case_count,
        scalar_sys_selector_write_case_count,
        scalar_sys_selector_swap_case_count,
        scalar_sys_selector_case_count,
    ) != (96, 64, 1024, 1184):
        raise ValueError("reviewed SYS Reg5 selector/alias inventory drift")
    scalar_sys_fence_mask_case_count = 16 * 16
    scalar_sys_breakpoint_tag_case_count = 32 + 16
    scalar_sys_acrc_case_count = 16 * 16
    scalar_sys_acre_case_count = 22
    # Selector zero is the hard-wired zero register, so it has no distinct
    # nonzero ASSERT scenario.
    scalar_sys_assert_selector_case_count = 32 + 31
    scalar_sys_control_selector_case_count = 4 * 32
    scalar_sys_commit_selector_case_count = 32
    scalar_sys_maintenance_selector_case_count = 12 * 32
    scalar_sys_tlb_privilege_case_count = 4 * 15
    scalar_sys_tlb_operand_case_count = 13
    scalar_sys_cache_operand_case_count = 9 * 2
    scalar_sys_control_totality_case_count = sum(
        (
            scalar_sys_fence_mask_case_count,
            scalar_sys_breakpoint_tag_case_count,
            scalar_sys_acrc_case_count,
            scalar_sys_acre_case_count,
            scalar_sys_assert_selector_case_count,
            scalar_sys_control_selector_case_count,
            scalar_sys_commit_selector_case_count,
            scalar_sys_maintenance_selector_case_count,
            scalar_sys_tlb_privilege_case_count,
            scalar_sys_tlb_operand_case_count,
            scalar_sys_cache_operand_case_count,
        )
    )
    if scalar_sys_control_totality_case_count != 1280:
        raise ValueError("reviewed SYS control/maintenance totality inventory drift")
    scalar_sys_stage4_case_count = (
        len(scalar_sys_register_transfer_cases)
        + scalar_sys_selector_case_count
        + scalar_sys_control_totality_case_count
    )
    if scalar_sys_stage4_case_count != 4401:
        raise ValueError("reviewed SYS Stage 4 case inventory drift")
    scalar_agu_effect_rows = [
        row for row in scalar if scalar_agu_effect_class(row) is not None
    ]
    actual_agu_effect_classes = {
        class_id: sum(
            scalar_agu_effect_class(row) == class_id for row in scalar_agu_effect_rows
        )
        for class_id in SCALAR_AGU_EFFECT_CLASS_COUNTS
    }
    if actual_agu_effect_classes != SCALAR_AGU_EFFECT_CLASS_COUNTS:
        raise ValueError(
            "reviewed AGU effect-class inventory drift: "
            f"expected {SCALAR_AGU_EFFECT_CLASS_COUNTS}, got {actual_agu_effect_classes}"
        )
    actual_agu_address_kinds = Counter(
        agu_metadata(row)["address_kind"] for row in scalar_agu_effect_rows
    )
    if actual_agu_address_kinds != SCALAR_AGU_ADDRESS_KIND_COUNTS:
        raise ValueError(
            "reviewed AGU address-kind inventory drift: "
            f"expected {SCALAR_AGU_ADDRESS_KIND_COUNTS}, got {dict(actual_agu_address_kinds)}"
        )
    actual_agu_update_modes = Counter(
        (
            "None"
            if agu_metadata(row)["update_mode"] == "None"
            else "Pre"
            if agu_metadata(row)["update_mode"] == "PreIndex"
            else "Post"
        )
        for row in scalar_agu_effect_rows
    )
    canonical_update_modes = {
        "None": actual_agu_update_modes["None"],
        "PreIndex": actual_agu_update_modes["Pre"],
        "PostIndex": actual_agu_update_modes["Post"],
    }
    if canonical_update_modes != SCALAR_AGU_UPDATE_MODE_COUNTS:
        raise ValueError(
            "reviewed AGU update-mode inventory drift: "
            f"expected {SCALAR_AGU_UPDATE_MODE_COUNTS}, got {canonical_update_modes}"
        )
    scalar_agu_immediate_boundary_case_count = sum(
        len(scalar_agu_immediate_boundary_cases(row)) for row in scalar_agu_effect_rows
    )
    scalar_agu_src_r_type_case_count = sum(
        len(SCALAR_AGU_SRC_R_TYPE_VALUES)
        for row in scalar_agu_effect_rows
        if field_by_name(row, "SrcRType") is not None
    )
    scalar_agu_shamt_boundary_case_count = sum(
        len(SCALAR_AGU_SHAMT_BOUNDARY_VALUES)
        for row in scalar_agu_effect_rows
        if field_by_name(row, "shamt") is not None
    )
    scalar_agu_prefetch_model_case_count = sum(
        len(SCALAR_AGU_PREFETCH_MODEL_VALUES)
        for row in scalar_agu_effect_rows
        if field_by_name(row, "model") is not None
    )
    scalar_agu_pair_preflight_case_count = 2 * sum(
        agu_metadata(row)["action"] in {"LoadPair", "StorePair"}
        for row in scalar_agu_effect_rows
    )
    scalar_agu_fault_precedence_case_count = sum(
        agu_metadata(row)["action"] != "Prefetch" for row in scalar_agu_effect_rows
    )
    scalar_agu_permission_case_count = scalar_agu_fault_precedence_case_count
    scalar_agu_restart_case_count = scalar_agu_fault_precedence_case_count
    scalar_agu_prefetch_invalid_case_count = sum(
        agu_metadata(row)["action"] == "Prefetch" for row in scalar_agu_effect_rows
    )
    scalar_agu_prefetch_return_wrap_case_count = 2 * sum(
        agu_metadata(row)["prefetch_returns_address"] for row in scalar_agu_effect_rows
    )
    scalar_agu_totality_case_count = (
        scalar_agu_immediate_boundary_case_count
        + scalar_agu_src_r_type_case_count
        + scalar_agu_shamt_boundary_case_count
        + scalar_agu_prefetch_model_case_count
        + len(scalar_agu_effect_rows)
        + scalar_agu_fault_precedence_case_count
        + scalar_agu_permission_case_count
        + scalar_agu_pair_preflight_case_count
        + scalar_agu_restart_case_count
        + scalar_agu_prefetch_invalid_case_count
        + scalar_agu_prefetch_return_wrap_case_count
    )
    if scalar_agu_totality_case_count != 1464:
        raise ValueError(
            "reviewed AGU totality inventory drift: "
            f"expected 1464, got {scalar_agu_totality_case_count}"
        )
    scalar_agu_temp_source_case_count = sum(
        field["name"] in {"SrcL", "SrcR", "SrcD", "SrcD1"}
        for row in scalar_agu_effect_rows
        for field in row["fields"]
    ) * len(SCALAR_AGU_TEMP_SOURCE_SELECTORS)
    scalar_agu_destination_special_case_count = sum(
        field["name"] in {"RegDst", "RegDst0", "RegDst1"}
        for row in scalar_agu_effect_rows
        for field in row["fields"]
    ) * len(SCALAR_AGU_DESTINATION_SPECIAL_SELECTORS)
    scalar_agu_pair_destination_order_case_count = 5 * sum(
        agu_metadata(row)["action"] == "LoadPair" for row in scalar_agu_effect_rows
    )
    scalar_agu_store_source_snapshot_case_count = 3 * sum(
        agu_metadata(row)["action"] == "StorePair" for row in scalar_agu_effect_rows
    )
    scalar_agu_alias_case_count = (
        scalar_agu_temp_source_case_count
        + scalar_agu_destination_special_case_count
        + scalar_agu_pair_destination_order_case_count
        + scalar_agu_store_source_snapshot_case_count
    )
    if scalar_agu_alias_case_count != 4296:
        raise ValueError(
            "reviewed AGU alias inventory drift: "
            f"expected 4296, got {scalar_agu_alias_case_count}"
        )
    tile_operations = [f"TileOperation_{asl_identifier(row['name'])}" for row in tile]
    tile_handlers = sorted({row["semantic_handler"] for row in tile})
    tile_operand_fields = sorted(
        {operand["field"] for row in tile for operand in row["operands"]}
    )
    if len(scalar_operations) != len(set(scalar_operations)):
        raise ValueError("scalar operation identifiers are not unique")
    if len(tile_operations) != len(set(tile_operations)):
        raise ValueError("tile operation identifiers are not unique")
    command_indices_by_mnemonic: dict[str, list[int]] = {}
    for index, row in enumerate(command):
        command_indices_by_mnemonic.setdefault(row["mnemonic"], []).append(index)
    tile_command_mnemonics = {row["command_mnemonic"] for row in tile}
    for mnemonic in tile_command_mnemonics:
        if len(command_indices_by_mnemonic.get(mnemonic, [])) != 1:
            raise ValueError(
                f"tile command mnemonic must identify exactly one form: {mnemonic}"
            )
    tile_command_rows = [
        (
            command_indices_by_mnemonic[mnemonic][0],
            next(row for row in command if row["mnemonic"] == mnemonic),
            (
                "TEPL"
                if mnemonic == "BSTART.TEPL"
                else next(
                    row["family"]
                    for row in tile
                    if row["command_mnemonic"] == mnemonic
                )
            ),
        )
        for mnemonic in sorted(tile_command_mnemonics)
    ]
    tile_indices_by_key = {
        f"tile:{row['family']}:{row['name']}": index for index, row in enumerate(tile)
    }
    applicability_rule_set_asl = {
        "pto-a2a3-numeric-v1": "NumericApplicabilityRules_A2A3MxRejection",
    }
    for rule in numeric_applicability_rules:
        if rule["profile_id"] not in applicability_rule_set_asl:
            raise ValueError(
                f"unsupported numeric applicability profile: {rule['profile_id']}"
            )
        if rule["operation_key"] not in tile_indices_by_key:
            raise ValueError(
                "numeric applicability operation is not in the tile catalog: "
                f"{rule['operation_key']}"
            )
        if (
            rule["disposition"] != "unsupported-in-profile"
            or rule["rejection"]["fault"] != "IllegalInstruction"
            or rule["rejection"]["phase"] != "before-operation-effects"
            or rule["result_rule_id"] is not None
        ):
            raise ValueError(
                "numeric applicability decoder only accepts fail-closed rejection rules"
            )

    print("// Generated from the normative PTO catalogs. Do not edit.")
    print("// PTO-REQ-ENCODING-001: complete scalar and tile decode witnesses.")
    print("// PTO-REQ-SCALAR-CONSTRAINT-001: catalog-generated family legality.")
    print("// PTO-REQ-SCALAR-EFFECT-CLOSURE-001: decoded before/after effects.")
    print("// PTO-REQ-TILE-DISPATCH-001: total decoded direct-tile execution.")
    print(f"constant PTO_SCALAR_FORM_COUNT = {len(scalar)};")
    print(
        "constant PTO_SCALAR_BINARY_EFFECT_FORM_COUNT = "
        f"{len(scalar_binary_effect_rows)};"
    )
    print(
        "constant PTO_SCALAR_NONBINARY_ALU_EFFECT_FORM_COUNT = "
        f"{len(scalar_nonbinary_alu_effect_rows)};"
    )
    print(f"constant PTO_SCALAR_ALU_EFFECT_FORM_COUNT = {len(scalar_alu_effect_rows)};")
    print(
        "constant PTO_SCALAR_ALU_BOUNDARY_CASE_COUNT = "
        f"{scalar_alu_boundary_case_count};"
    )
    print(f"constant PTO_SCALAR_BRU_EFFECT_FORM_COUNT = {len(scalar_bru_effect_rows)};")
    print(
        "constant PTO_SCALAR_BRU_TOTALITY_CASE_COUNT = "
        f"{scalar_bru_totality_case_count};"
    )
    print(
        "constant PTO_SCALAR_BRU_ALIAS_FAULT_CASE_COUNT = "
        f"{len(SCALAR_BRU_ALIAS_FAULT_CASE_IDS)};"
    )
    print(f"constant PTO_SCALAR_AMO_EFFECT_FORM_COUNT = {len(scalar_amo_effect_rows)};")
    print(
        "constant PTO_SCALAR_AMO_MODIFIER_CASE_COUNT = "
        f"{scalar_amo_modifier_case_count};"
    )
    print(f"constant PTO_SCALAR_AMO_VALUE_CASE_COUNT = {scalar_amo_value_case_count};")
    print(
        "constant PTO_SCALAR_AMO_SEMANTIC_SOURCE_OCCURRENCE_COUNT = "
        f"{scalar_amo_source_occurrence_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_TEMP_SOURCE_CASE_COUNT = "
        f"{scalar_amo_temp_source_case_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_SPECIAL_DESTINATION_CASE_COUNT = "
        f"{scalar_amo_special_destination_case_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_ABSOLUTE_OVERLAP_CASE_COUNT = "
        f"{scalar_amo_absolute_overlap_case_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_IGNORED_SRC_ZERO_CASE_COUNT = "
        f"{scalar_amo_ignored_src_zero_case_count};"
    )
    print(f"constant PTO_SCALAR_AMO_ALIAS_CASE_COUNT = {scalar_amo_alias_case_count};")
    print(f"constant PTO_SCALAR_AMO_FAULT_CASE_COUNT = {scalar_amo_fault_case_count};")
    print(
        f"constant PTO_SCALAR_AMO_RESTART_CASE_COUNT = {scalar_amo_restart_case_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_SC_MISS_NO_PROBE_CASE_COUNT = "
        f"{scalar_amo_sc_miss_no_probe_case_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_FAULT_RESTART_CASE_COUNT = "
        f"{scalar_amo_fault_restart_case_count};"
    )
    print(
        "constant PTO_SCALAR_AMO_RESERVATION_CASE_COUNT = "
        f"{scalar_amo_reservation_case_count};"
    )
    print(f"constant PTO_SCALAR_AMO_DMA_CASE_COUNT = {scalar_amo_dma_case_count};")
    print(
        "constant PTO_SCALAR_AMO_TOTALITY_CASE_COUNT = "
        f"{scalar_amo_totality_case_count};"
    )
    print(
        f"constant PTO_SCALAR_AMO_STAGE4_CASE_COUNT = {scalar_amo_stage4_case_count};"
