            )
            print("    assert _LastFault == Fault_None;")
            print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x240;")
            print("    assert ReadBPC() == Zeros{PTO_XLEN} + 0x80;")
            print("    assert !_TrapContexts[[0]].valid;")
            print("    assert _ArchitectureRequestEpoch == 51;")
            print("    assert _ControlRequestOperand[3:0] == '0001';")
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

            invalid_witness = scalar_sys_witness(
                row, family_constraints, {"RRA_Type": 2}
            )
            print("    ResetProfileState();")
