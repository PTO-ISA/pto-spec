MASK32 = (1 << 32) - 1
MASK64 = (1 << 64) - 1
MASK128 = (1 << 128) - 1


def load(path: str):
    return json.loads((ROOT / path).read_text(encoding="utf-8"))


def hex_bits(value: int, width: int) -> str:
    return f"0x{value:0{width // 4}x}"


def bit_literal(value: int, width: int) -> str:
    return f"'{value:0{width}b}'"


def tile_operation_code(row: dict) -> int:
    if row["family"] == "TEPL":
        mode = row["mode"]
        function = row["function"]
        selector = int(row["selector"], 0)
        if selector != (mode << 5) | function:
            raise ValueError(
                f"TEPL mode/function/selector formula drift for {row['name']}"
            )
        return (mode << 5) | function
    return row["function"]


def system_register_addresses(row: dict) -> list[int]:
    if row["scope"] == "base":
        return [int(row["address"], 0)]
    low_index = int(row["low_index"], 0)
    if "fixed_context" in row:
        return [(row["fixed_context"] << 12) | low_index]
    return [(ring << 12) | low_index for ring in range(16)]


def system_register_reset_expression(behavior: dict) -> str:
    reset = behavior["reset"]
    if reset == "zero":
        return "Zeros{PTO_XLEN}"
    if reset == "one":
        return "Zeros{PTO_XLEN} + 1"
    if reset == "pto-model-max-tile-capacity-bytes":
        return "Zeros{PTO_XLEN} + PTO_MODEL_MAX_TILE_CAPACITY_BYTES"
    if reset == "external-and-timer-enabled":
        return "Zeros{PTO_XLEN} + 3"
    raise ValueError(f"unsupported system-register reset: {reset}")


def decode_field(row: dict, field_name: str, instruction: int) -> int:
    field = next(field for field in row["fields"] if field["name"] == field_name)
    value = 0
    for piece in field["pieces"]:
        piece_mask = (1 << piece["width"]) - 1
        value |= ((instruction >> piece["instruction_lsb"]) & piece_mask) << piece[
            "value_lsb"
        ]
    return value


def encode_field(row: dict, field_name: str, instruction: int, value: int) -> int:
    field = next(field for field in row["fields"] if field["name"] == field_name)
    if not 0 <= value < 1 << field["width"]:
        raise ValueError(f"field value exceeds {field_name} in {row['form_id']}")
    for piece in field["pieces"]:
        piece_mask = (1 << piece["width"]) - 1
        instruction &= ~(piece_mask << piece["instruction_lsb"])
        piece_value = (value >> piece["value_lsb"]) & piece_mask
        instruction |= piece_value << piece["instruction_lsb"]
    return instruction


def family_constraint_applies(row: dict, constraint: dict) -> bool:
    selector = constraint["applies_to"]
    field_names = {field["name"] for field in row["fields"]}
    return (
        row["semantic_family"] in selector["semantic_families"]
        and row["semantic_handler"] in selector["semantic_handlers"]
        and set(selector["required_fields"]) <= field_names
    )


def legal_scalar_witness(row: dict, family_constraints: list[dict]) -> int:
    instruction = int(row["encoding"][0]["match"], 16)
    for constraint in row["constraints"]:
        if constraint["operator"] != "not-equal":
            raise ValueError(f"unsupported form constraint: {constraint!r}")
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            replacement = 1 if constraint["value"] == 0 else 0
            instruction = encode_field(
                row, constraint["field"], instruction, replacement
            )
    for constraint in family_constraints:
        if not family_constraint_applies(row, constraint):
            continue
        if constraint["operator"] != "fields-not-equal":
            raise ValueError(f"unsupported family constraint: {constraint!r}")
        left = decode_field(row, constraint["left_field"], instruction)
        right = decode_field(row, constraint["right_field"], instruction)
        if left == right:
            right_field = next(
                field
                for field in row["fields"]
                if field["name"] == constraint["right_field"]
            )
            instruction = encode_field(
                row,
                constraint["right_field"],
                instruction,
                (left + 1) % (1 << right_field["width"]),
            )
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(f"cannot synthesize legal witness for {row['form_id']}")
    for constraint in family_constraints:
        if family_constraint_applies(row, constraint) and decode_field(
            row, constraint["left_field"], instruction
        ) == decode_field(row, constraint["right_field"], instruction):
            raise ValueError(f"cannot synthesize legal witness for {row['form_id']}")
    return instruction


def asl_identifier(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_]", "_", value)


def scalar_binary_effect_metadata(row: dict) -> tuple[str, bool] | None:
    """Classify forms whose complete visible result is ScalarBinary{W}."""
    if row["semantic_handler"] not in {"ScalarBinary", "ScalarBinaryW"}:
        return None
    core = row["mnemonic"].split(".")[-1]
    word_operation = core.endswith("W")
    if word_operation:
        core = core[:-1]
    if core.endswith("I"):
        core = core[:-1]
    operation = SCALAR_BINARY_EFFECT_OPERATIONS.get(core)
    if operation is None:
        raise ValueError(
            f"scalar binary handler has no reviewed effect class: {row['form_id']}"
        )
    return operation, word_operation


def field_by_name(row: dict, field_name: str) -> dict | None:
    return next((field for field in row["fields"] if field["name"] == field_name), None)


def scalar_sys_effect_class(row: dict) -> str | None:
    """Return the reviewed decoded-effect class for one accepted SYS form."""
    if row["semantic_family"] != "SYS":
        return None
    handler = row["semantic_handler"]
    mnemonic = row["mnemonic"]
    if handler in {
        "ExecuteCompressedSystemRegisterGet",
        "ExecuteSystemRegisterGet",
    }:
        return "scalar-system-register-read"
    if handler == "ExecuteSystemRegisterSet":
        return "scalar-system-register-write"
    if handler == "ExecuteSystemRegisterSwap":
        return "scalar-system-register-swap"
    if handler == "ExecuteMaintenance":
        if mnemonic.startswith("TLB."):
            return "scalar-tlb-maintenance"
        return "scalar-cache-maintenance"
    if handler == "ExecuteControlRequest":
        return "scalar-execution-control-request"
    if handler == "SoftwareBreakpoint":
        return "scalar-software-breakpoint"
    if handler == "FenceData":
        return "scalar-data-fence"
    if handler == "FenceInstruction":
        return "scalar-instruction-fence"
    if handler == "ArchitectureAssert":
        return "scalar-architecture-assert"
    if handler == "ArchitectureCloseRequest":
        return "scalar-architecture-close-request"
    if handler == "ArchitectureEnterRequest":
        return "scalar-architecture-enter-request"
    if handler == "SetCommitTarget":
        return "scalar-set-commit-target"
    raise ValueError(f"SYS form has no reviewed effect class: {row['form_id']}")


def scalar_sys_witness(
    row: dict, family_constraints: list[dict], overrides: dict[str, int] | None = None
) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    for field_name, value in (overrides or {}).items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    return instruction


def scalar_sys_register_address_field(row: dict) -> dict:
    """Return the encoded system-register address field for a transfer form."""
    for name in ("SSRID", "SSR_ID", "LSR_ID"):
        field = field_by_name(row, name)
        if field is not None:
            return field
    raise ValueError(f"SYS register transfer lacks address field: {row['form_id']}")


def scalar_binary_effect_witness(
    row: dict, family_constraints: list[dict]
) -> tuple[int, str, str, str, str]:
    """Return instruction, left, right, and destination expressions for one form."""
    instruction = legal_scalar_witness(row, family_constraints)
    left_value = 0x8000000000000011
    right_value = 3

    for field_name, value in (
        ("RegDst", 3),
        ("SrcL", 1),
        ("SrcR", 2),
        ("SrcRType", 0),
    ):
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)

    shift_field = field_by_name(row, "shamt")
    if shift_field is not None:
        shift_value = 0 if field_by_name(row, "SrcR") is not None else 3
        instruction = encode_field(row, "shamt", instruction, shift_value)
        right_value = shift_value

    immediate_field = next(
        (
            field
            for field in row["fields"]
            if field["name"]
            in {"simm5", "simm12", "simm24", "uimm5", "uimm12", "uimm24"}
        ),
        None,
    )
    if immediate_field is not None:
        width = immediate_field["width"]
        if immediate_field["signedness"] == "signed":
            raw_immediate = (1 << width) - 3
            right_value = (1 << 64) - 3
        else:
            raw_immediate = 3
            right_value = 3
        instruction = encode_field(
            row, immediate_field["name"], instruction, raw_immediate
        )

    implicit_t_source = row["mnemonic"] in {"C.SLLI", "C.SRLI"}
    destination_expression = (
        "ReadTemporaryQueue(TRUE, 0)"
        if row["mnemonic"].startswith("C.")
        else "ReadGPR(3)"
    )
    source_setup = (
        f"    PushTemporaryQueue(TRUE, {bit_literal(left_value, 64)});"
        if implicit_t_source
        else f"    WriteGPR(1, {bit_literal(left_value, 64)});"
    )
    return (
        instruction,
        source_setup,
        bit_literal(left_value, 64),
        bit_literal(right_value, 64),
        destination_expression,
    )


def scalar_alu_effect_class(row: dict) -> str | None:
    """Return the reviewed decoded-effect class for one accepted ALU form."""
    if row["semantic_family"] != "ALU":
        return None
    if scalar_binary_effect_metadata(row) is not None:
        return "scalar-binary-value"
    matches = [
        class_id
        for class_id, handlers in SCALAR_ALU_EFFECT_HANDLER_CLASSES.items()
        if row["semantic_handler"] in handlers
    ]
    if len(matches) != 1:
        raise ValueError(
            "non-binary ALU form does not have exactly one reviewed effect class: "
            f"{row['form_id']} ({row['semantic_handler']})"
        )
    return matches[0]


def signed_integer(value: int, width: int) -> int:
    value &= (1 << width) - 1
    if value & (1 << (width - 1)):
        return value - (1 << width)
    return value


def sign_extended(value: int, width: int) -> int:
    return signed_integer(value, width) & MASK64


def scalar_binary_result_py(
    operation: str, left: int, right: int, word_operation: bool
) -> int:
    width = 32 if word_operation else 64
    mask = (1 << width) - 1
    left &= mask
    right &= mask
    shift = right & (31 if word_operation else 63)
    if operation == "ScalarBinary_ADD":
        result = left + right
    elif operation == "ScalarBinary_SUB":
        result = left - right
    elif operation == "ScalarBinary_AND":
        result = left & right
    elif operation == "ScalarBinary_OR":
        result = left | right
    elif operation == "ScalarBinary_XOR":
        result = left ^ right
    elif operation == "ScalarBinary_SLL":
        result = left << shift
    elif operation == "ScalarBinary_SRL":
        result = left >> shift
    elif operation == "ScalarBinary_SRA":
        result = signed_integer(left, width) >> shift
    elif operation == "ScalarBinary_MIN":
        result = (
            left
            if signed_integer(left, width) < signed_integer(right, width)
            else right
        )
    elif operation == "ScalarBinary_MINU":
        result = left if left < right else right
    elif operation == "ScalarBinary_MAX":
        result = (
            left
            if signed_integer(left, width) > signed_integer(right, width)
            else right
        )
    elif operation == "ScalarBinary_MAXU":
        result = left if left > right else right
    else:
        raise ValueError(f"unclassified scalar binary operation: {operation}")
    result &= mask
    return sign_extended(result, 32) if word_operation else result


def apply_scalar_right_modifier_py(
    value: int, modifier: int, logical_family: bool
) -> int:
    if modifier == 0:
        return value & MASK64
    if modifier == 1:
        return sign_extended(value, 32)
    if modifier == 2:
        return value & MASK32
    if modifier == 3:
        return (~value if logical_family else -value) & MASK64
    raise ValueError(f"invalid scalar right modifier: {modifier}")


def truncating_signed_division(dividend: int, divisor: int) -> int:
    if divisor == 0:
        return 0
    magnitude = abs(dividend) // abs(divisor)
    return -magnitude if (dividend < 0) != (divisor < 0) else magnitude


def scalar_division_result(
    dividend: int, divisor: int, signed_operation: bool, word_operation: bool
) -> tuple[int, int]:
    width = 32 if word_operation else 64
    raw_dividend = dividend & ((1 << width) - 1)
    raw_divisor = divisor & ((1 << width) - 1)
    if signed_operation:
        effective_dividend = signed_integer(raw_dividend, width)
        effective_divisor = signed_integer(raw_divisor, width)
        quotient = truncating_signed_division(effective_dividend, effective_divisor)
        remainder = (
            effective_dividend
            if effective_divisor == 0
            else effective_dividend - quotient * effective_divisor
        )
    else:
        effective_dividend = raw_dividend
        effective_divisor = raw_divisor
        quotient = (
            0 if effective_divisor == 0 else effective_dividend // effective_divisor
        )
        remainder = (
            effective_dividend
            if effective_divisor == 0
            else effective_dividend % effective_divisor
        )
    if word_operation:
        return sign_extended(quotient, 32), sign_extended(remainder, 32)
    return quotient & MASK64, remainder & MASK64


def rotate_right_64(value: int, amount: int) -> int:
    amount %= 64
    if amount == 0:
        return value & MASK64
    return ((value >> amount) | (value << (64 - amount))) & MASK64


def rotate_left_64(value: int, amount: int) -> int:
    amount %= 64
    if amount == 0:
        return value & MASK64
    return ((value << amount) | (value >> (64 - amount))) & MASK64


def extracted_bitfield(value: int, width: int, offset: int) -> int:
    return rotate_right_64(value, offset) & ((1 << width) - 1)


def scalar_nonbinary_alu_witness(row: dict, family_constraints: list[dict]) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    values = {
        "RegDst": 3,
        "RegDst0": 4,
        "RegDst1": 5,
        "SrcD": 6,
        "SrcL": 1,
        "SrcP": 7,
        "SrcR": 2,
        "SrcRType": 3,
        "imm": 0x80000003,
        "imm20": 0x80001,
        "imml": 15 if row["mnemonic"] == "REV" else 7,
        "immr": 8 if row["mnemonic"] == "REV" else 4,
        "imms": 7 if row["mnemonic"] == "HL.BFI" else 4,
        "shamt": 4,
        "simm5": 0x1D,
        "simm32": 0x80000003,
        "uimm5": 3,
        "uimm19": 3,
        "uimm32": 0x80000003,
    }
    for field_name, value in values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"ALU effect witness violates constraint for {row['form_id']}"
            )
    return instruction


def scalar_nonbinary_alu_sources(class_id: str) -> tuple[int, int, int, int]:
    if class_id == "scalar-bitfield-value":
        return 0x8123456789ABCDEF, 0x0F0E0D0C0B0A0908, 5, 1
    if class_id == "scalar-materialize-value":
        return 0x1234567880ABCDEF, 3, 5, 1
    if class_id == "scalar-select-value":
        return 0x1111222233334444, 3, 5, 1
    return MASK64 - 5, 3, 5, 1


def scalar_arithmetic_expected(
    mnemonic: str, left: int, right: int, addend: int, immediate: int = 3
) -> int:
    if mnemonic in {"DIV", "DIVU", "DIVW", "DIVUW", "REM", "REMU", "REMW", "REMUW"}:
        signed_operation = mnemonic in {"DIV", "DIVW", "REM", "REMW"}
        word_operation = mnemonic.endswith("W")
        quotient, remainder = scalar_division_result(
            left, right, signed_operation, word_operation
        )
        return remainder if mnemonic.startswith("REM") else quotient
    if mnemonic in {"MUL", "MULU"}:
        return (left * right) & MASK64
    if mnemonic in {"MULW", "MULUW"}:
        return sign_extended((left & MASK32) * (right & MASK32), 32)
    if mnemonic == "MADD":
        return (addend + left * right) & MASK64
    if mnemonic == "MADDW":
        return sign_extended(addend + left * right, 32)
    if mnemonic == "HL.MIADD":
        return (left + right * immediate) & MASK64
    if mnemonic == "HL.MISUB":
        return (left - right * immediate) & MASK64
    raise ValueError(f"unclassified scalar arithmetic effect: {mnemonic}")


def scalar_pair_expected(
    mnemonic: str, left: int, right: int, addend: int, shift: int = 4
) -> tuple[int, int]:
    if mnemonic in {
        "HL.DIV",
        "HL.DIVU",
        "HL.DIVW",
        "HL.DIVUW",
        "HL.REM",
        "HL.REMU",
        "HL.REMW",
        "HL.REMUW",
    }:
        signed_operation = mnemonic in {"HL.DIV", "HL.DIVW", "HL.REM", "HL.REMW"}
        return scalar_division_result(
            left, right, signed_operation, mnemonic.endswith("W")
        )
    if mnemonic in {"HL.MUL", "HL.MULU"}:
        if mnemonic == "HL.MUL":
            product = signed_integer(left, 64) * signed_integer(right, 64)
        else:
            product = left * right
        product &= MASK128
        return product & MASK64, (product >> 64) & MASK64
    if mnemonic in {"HL.MADD", "HL.MADDW"}:
        if mnemonic.endswith("W"):
            effective_addend = signed_integer(addend, 32)
            effective_left = signed_integer(left, 32)
            effective_right = signed_integer(right, 32)
        else:
            effective_addend = signed_integer(addend, 64)
            effective_left = signed_integer(left, 64)
            effective_right = signed_integer(right, 64)
        accumulator = (effective_left * effective_right + effective_addend) & MASK128
        return accumulator & MASK64, (accumulator >> 64) & MASK64
    if mnemonic == "HL.CCAT":
        if shift == 0:
            return right & MASK64, left & MASK64
        if shift < 64:
            low = ((right >> shift) | (left << (64 - shift))) & MASK64
            return low, (left >> shift) & MASK64
        return (left >> (shift - 64)) & MASK64, 0
    if mnemonic == "HL.CCATW":
        if shift >= 64:
            return 0, 0
        packed = ((left & MASK32) << 32) | (right & MASK32)
        shifted = packed >> shift
        return sign_extended(shifted, 32), sign_extended(shifted >> 32, 32)
    raise ValueError(f"unclassified scalar pair effect: {mnemonic}")


def scalar_bitfield_expected(
    mnemonic: str,
    left: int,
    right: int,
    width: int = 8,
    offset: int = 4,
    last: int = 7,
) -> int:
    if mnemonic in {"BXS", "BXU"}:
        field = extracted_bitfield(left, width, offset)
        return sign_extended(field, width) if mnemonic == "BXS" else field
    if mnemonic in {"CLZ", "CTZ", "BCNT"}:
        field = extracted_bitfield(left, width, offset)
        bits = f"{field:0{width}b}"
        if mnemonic == "CLZ":
            return len(bits) - len(bits.lstrip("0"))
        if mnemonic == "CTZ":
            return len(bits) - len(bits.rstrip("0"))
        return bits.count("1")
    if mnemonic in {"BIC", "BIS"}:
        rotated = rotate_right_64(left, offset)
        field_mask = (1 << width) - 1
        if mnemonic == "BIS":
            rotated |= field_mask
        else:
            rotated &= ~field_mask
        return rotate_left_64(rotated, offset)
    if mnemonic == "REV":
        if width % 8 != 0:
            return 0
        field = extracted_bitfield(left, width, offset)
        byte_count = width // 8
        result = 0
        for byte_index in range(byte_count):
            result |= ((field >> (byte_index * 8)) & 0xFF) << (
                (byte_count - 1 - byte_index) * 8
            )
        return result
    if mnemonic == "HL.BFI":
        result = left
        insert_width = ((last - offset + 64) % 64) + 1
        for bit_index in range(insert_width):
            destination = (offset + bit_index) % 64
            result &= ~(1 << destination)
            result |= ((right >> bit_index) & 1) << destination
        return result & MASK64
    raise ValueError(f"unclassified scalar bitfield effect: {mnemonic}")


def scalar_materialize_expected(
    mnemonic: str, left: int, raw_immediate: int | None = None
) -> int:
    if mnemonic == "LUI":
        immediate = 0x80001 if raw_immediate is None else raw_immediate
        return (sign_extended(immediate, 20) << 12) & MASK64
    if mnemonic in {"HL.LUI", "HL.LIS"}:
        immediate = 0x80000003 if raw_immediate is None else raw_immediate
        return sign_extended(immediate, 32)
    if mnemonic == "HL.LIU":
        return 0x80000003 if raw_immediate is None else raw_immediate
    if mnemonic == "C.MOVI":
        immediate = 0x1D if raw_immediate is None else raw_immediate
        return sign_extended(immediate, 5)
    if mnemonic == "C.MOVR":
        return left
    if mnemonic.startswith("C.SEXT."):
        width = {"B": 8, "H": 16, "W": 32}[mnemonic[-1]]
        return sign_extended(left, width)
    if mnemonic.startswith("C.ZEXT."):
        width = {"B": 8, "H": 16, "W": 32}[mnemonic[-1]]
        return left & ((1 << width) - 1)
    raise ValueError(f"unclassified scalar materialize effect: {mnemonic}")


SCALAR_ALU_BASE_BOUNDARY_LABELS = ("zero", "lower", "upper")


def scalar_alu_boundary_labels(row: dict) -> tuple[str, ...]:
    """Return the decoded boundary cases required by one accepted ALU form."""
    mnemonic = row["mnemonic"]
    if mnemonic == "HL.CCAT":
        return ("zero", "shift-63", "shift-64", "shift-127")
    if mnemonic == "HL.CCATW":
        return (
            "zero",
            "shift-31",
            "shift-32",
            "shift-63",
            "shift-64",
            "shift-127",
        )
    if mnemonic == "CSEL":
        return ("zero", "lower", "modifier-two", "upper", "predicate-true")
    if field_by_name(row, "SrcRType") is not None:
        return SCALAR_ALU_BASE_BOUNDARY_LABELS + ("modifier-two",)
    return SCALAR_ALU_BASE_BOUNDARY_LABELS


def scalar_alu_boundary_sources(row: dict, label: str) -> tuple[int, int, int, int]:
    class_id = scalar_alu_effect_class(row)
    if class_id is None:
        raise ValueError(f"non-ALU boundary row: {row['form_id']}")
    if class_id == "scalar-binary-value":
        metadata = scalar_binary_effect_metadata(row)
        if metadata is None:
            raise ValueError(
                f"missing scalar binary boundary metadata: {row['form_id']}"
            )
        operation, word_operation = metadata
        if label == "zero":
            return 0, 0, 0, 0
        if operation in {"ScalarBinary_SLL", "ScalarBinary_SRL", "ScalarBinary_SRA"}:
            width = 32 if word_operation else 64
            right = width - 1 if label == "lower" else width
            return 0x8000000080000001, right, MASK64, 1
        if word_operation:
            if label == "lower":
                return 0x80000000, 0x7FFFFFFF, MASK64, 0
            return 0xFFFFFFFF, 1, 1, MASK64
        if label == "lower":
            return 0x8000000000000000, 0x7FFFFFFFFFFFFFFF, MASK64, 0
        return MASK64, 1, 1, MASK64
    if class_id in {"scalar-arithmetic-value", "scalar-pair-value"}:
        mnemonic = row["mnemonic"]
        if label == "zero":
            if "DIV" in mnemonic or "REM" in mnemonic:
                return 5, 0, 0, 0
            return 0, 0, 0, 0
        if label.startswith("shift-"):
            return 0x8000000080000001, 2, MASK64, 0
        if label == "lower":
            left = 0x80000000 if mnemonic.endswith("W") else 0x8000000000000000
            return left, MASK64, MASK64, 0
        return MASK64, MASK64, 1, MASK64
    if class_id == "scalar-bitfield-value":
        if label == "zero":
            return 0, 0, 0, 0
        if label == "lower":
            return 0x8000000000000001, 3, MASK64, 0
        return 0x8123456789ABCDEF, MASK64, 1, MASK64
    if class_id == "scalar-materialize-value":
        if label == "zero":
            return 0, 0, 0, 0
        if label == "lower":
            return 0xFFFFFFFF80008080, 0, 0, 0
        return MASK64, 0, 0, MASK64
    if class_id == "scalar-select-value":
        if label == "zero":
            return 0, 0, 0, 0
        if label == "lower":
            return 0x8000000000000000, 1, 0, 0
        if label == "modifier-two":
            return 0x8000000000000000, MASK64, 0, 0
        if label == "predicate-true":
            return 0x7FFFFFFFFFFFFFFF, 1, 0, MASK64
        return 0x7FFFFFFFFFFFFFFF, 1, 0, 0
    if class_id == "scalar-control-value":
        if label == "zero":
            return 0, 0, 0, 0
        return (MASK64 if label == "lower" else 0x7FFFFFFFFFFFFFFF), 0, 0, 0
    raise ValueError(f"unsupported scalar ALU boundary class: {class_id}")


def scalar_alu_boundary_field_values(row: dict, label: str) -> dict[str, int]:
    values = {
        "RegDst": 3,
        "RegDst0": 4,
        "RegDst1": 5,
        "SrcD": 6,
        "SrcL": 1,
        "SrcP": 7,
        "SrcR": 2,
    }
    for field in row["fields"]:
        name = field["name"]
        width = field["width"]
        maximum = (1 << width) - 1
        if name == "SrcRType":
            values[name] = {
                "zero": 0,
                "lower": 1,
                "modifier-two": 2,
                "upper": 3,
                "predicate-true": 3,
            }[label]
        elif name == "imml":
            values[name] = 63 if label == "upper" else 0
        elif name == "immr":
            if row["mnemonic"] == "HL.BFI":
                values[name] = {"zero": 0, "lower": 63, "upper": 0}[label]
            else:
                values[name] = 63 if label == "lower" else 0
        elif name == "imms":
            if row["mnemonic"] == "HL.BFI":
                values[name] = {"zero": 0, "lower": 0, "upper": 63}[label]
            else:
                values[name] = 63 if label == "lower" else 0
        elif name == "shamt":
            values[name] = (
                int(label.removeprefix("shift-"))
                if label.startswith("shift-")
                else {
                    "zero": 0,
                    "lower": max(0, maximum - 1),
                    "upper": maximum,
                    "modifier-two": maximum,
                }[label]
            )
        elif name in {"imm", "imm20"}:
            values[name] = {
                "zero": 0,
                "lower": 1 << (width - 1),
                "upper": (1 << (width - 1)) - 1,
            }[label]
        elif name.startswith("simm"):
            values[name] = {
                "zero": 0,
                "lower": 1 << (width - 1),
                "upper": (1 << (width - 1)) - 1,
            }[label]
        elif name.startswith("uimm"):
            values[name] = {"zero": 0, "lower": min(1, maximum), "upper": maximum}[
                label
            ]
    return values


def scalar_alu_boundary_witness(
    row: dict, family_constraints: list[dict], label: str
) -> tuple[int, dict[str, int]]:
    instruction = legal_scalar_witness(row, family_constraints)
    values = scalar_alu_boundary_field_values(row, label)
    for field_name, value in values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"ALU boundary witness violates constraint for {row['form_id']}"
            )
    return instruction, values


def decoded_scalar_field_word(field: dict, raw: int) -> int:
    if field["signedness"] == "signed":
        return sign_extended(raw, field["width"])
    return raw & MASK64


def scalar_binary_boundary_expected(
    row: dict, left: int, right: int, field_values: dict[str, int]
) -> int:
    metadata = scalar_binary_effect_metadata(row)
    if metadata is None:
        raise ValueError(f"missing scalar binary boundary metadata: {row['form_id']}")
    operation, word_operation = metadata
    logical_family = operation in {
        "ScalarBinary_AND",
        "ScalarBinary_OR",
        "ScalarBinary_XOR",
    }
    if field_by_name(row, "SrcR") is not None:
        effective_right = right
        if field_by_name(row, "SrcRType") is not None:
            effective_right = apply_scalar_right_modifier_py(
                effective_right, field_values["SrcRType"], logical_family
            )
            effective_right = (effective_right << field_values.get("shamt", 0)) & MASK64
    else:
        immediate_field = next(
            (
                field
                for field in row["fields"]
                if field["name"].startswith(("simm", "uimm"))
            ),
            None,
        )
        if immediate_field is not None:
            effective_right = decoded_scalar_field_word(
                immediate_field, field_values[immediate_field["name"]]
            )
        elif field_by_name(row, "shamt") is not None:
            effective_right = field_values["shamt"]
        else:
            raise ValueError(f"missing scalar binary right operand: {row['form_id']}")
    return scalar_binary_result_py(operation, left, effective_right, word_operation)


def scalar_alu_boundary_expected(
    row: dict,
    left: int,
    right: int,
    addend: int,
    predicate: int,
    field_values: dict[str, int],
) -> tuple[int, ...]:
    class_id = scalar_alu_effect_class(row)
    mnemonic = row["mnemonic"]
    if class_id == "scalar-binary-value":
        return (scalar_binary_boundary_expected(row, left, right, field_values),)
    if class_id == "scalar-arithmetic-value":
        return (
            scalar_arithmetic_expected(
                mnemonic,
                left,
                right,
                addend,
                field_values.get("uimm19", 3),
            ),
        )
    if class_id == "scalar-pair-value":
        return scalar_pair_expected(
            mnemonic,
            left,
            right,
            addend,
            field_values.get("shamt", 4),
        )
    if class_id == "scalar-bitfield-value":
        return (
            scalar_bitfield_expected(
                mnemonic,
                left,
                right,
                field_values.get("imml", 7) + 1,
                field_values.get("immr", field_values.get("imms", 4)),
                field_values.get("imms", 7),
            ),
        )
    if class_id == "scalar-materialize-value":
        immediate_name = next(
            (
                name
                for name in ("imm", "imm20", "simm5", "simm32", "uimm32")
                if name in field_values
            ),
            None,
        )
        raw_immediate = None if immediate_name is None else field_values[immediate_name]
        return (scalar_materialize_expected(mnemonic, left, raw_immediate),)
    if class_id == "scalar-select-value":
        modifier = field_values.get("SrcRType", 0)
        selected_false = (-right) & MASK64 if modifier == 3 else right
        return (left if predicate != 0 else selected_false,)
    if class_id == "scalar-control-value":
        if mnemonic == "C.SETC.TGT":
            return (left,)
        if mnemonic == "C.SETRET":
            return (field_values["uimm5"],)
    raise ValueError(f"unsupported scalar ALU boundary effect: {row['form_id']}")


def emit_scalar_alu_boundary_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    label: str,
) -> None:
    """Emit one raw decoded ALU boundary witness and its architectural effects."""
    witness, field_values = scalar_alu_boundary_witness(row, family_constraints, label)
    left, right, addend, predicate = scalar_alu_boundary_sources(row, label)
    expected = scalar_alu_boundary_expected(
        row, left, right, addend, predicate, field_values
    )
    class_id = scalar_alu_effect_class(row)
    if class_id is None:
        raise ValueError(f"missing ALU boundary effect class: {row['form_id']}")
    mnemonic = row["mnemonic"]
    destination_sentinel = 0x5555555555555555
    control_sentinel = 0xAAAAAAAAAAAAAAAA
    queue_sentinel = 0x7777777777777777
    implicit_t_result = (
        class_id != "scalar-control-value"
        and field_by_name(row, "RegDst") is None
        and field_by_name(row, "RegDst0") is None
    )
    implicit_t_source = mnemonic in {"C.SLLI", "C.SRLI"}
    pre_tpc = MASK64 - 1 if mnemonic == "C.SETRET" and label == "lower" else 0x100
    post_tpc = (pre_tpc + row["length_bits"] // 8) & MASK64

    print(f"    // {row['form_id']}: {mnemonic} [boundary-{label}]")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print(f"    WriteTPC({bit_literal(pre_tpc, 64)});")
    print(f"    WriteGPR(1, {bit_literal(left, 64)});")
    print(f"    WriteGPR(2, {bit_literal(right, 64)});")
    print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(4, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(5, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(6, {bit_literal(addend, 64)});")
    print(f"    WriteGPR(7, {bit_literal(predicate, 64)});")
    print(f"    WriteGPR(10, {bit_literal(control_sentinel, 64)});")
    print(f"    _CommitArgument = {bit_literal(control_sentinel, 64)};")
    print(f"    _ReturnAddress = {bit_literal(control_sentinel, 64)};")
    if implicit_t_result:
        print(f"    PushTemporaryQueue(TRUE, {bit_literal(queue_sentinel, 64)});")
    if implicit_t_source:
        print(f"    PushTemporaryQueue(TRUE, {bit_literal(left, 64)});")
    print(
        f"    let scalar_alu_boundary_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
        f"{row['length_bits']});"
    )
    print(
        f"    assert scalar_alu_boundary_status_{case_index} == "
        "ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")

    if class_id == "scalar-pair-value":
        print(f"    assert ReadGPR(4) == {bit_literal(expected[0], 64)};")
        print(f"    assert ReadGPR(5) == {bit_literal(expected[1], 64)};")
        print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
    elif class_id == "scalar-control-value":
        if mnemonic == "C.SETC.TGT":
            print(f"    assert _CommitArgument == {bit_literal(expected[0], 64)};")
        elif mnemonic == "C.SETRET":
            return_target = (pre_tpc + (expected[0] << 1)) & MASK64
            print(f"    assert ReadGPR(10) == {bit_literal(return_target, 64)};")
            print(f"    assert _ReturnAddress == {bit_literal(return_target, 64)};")
        else:
            raise ValueError(f"unclassified ALU control boundary: {row['form_id']}")
    elif field_by_name(row, "RegDst") is not None:
        print(f"    assert ReadGPR(3) == {bit_literal(expected[0], 64)};")
    elif implicit_t_result:
        print(
            f"    assert ReadTemporaryQueue(TRUE, 0) == {bit_literal(expected[0], 64)};"
        )
        if implicit_t_source:
            print(f"    assert ReadTemporaryQueue(TRUE, 1) == {bit_literal(left, 64)};")
            print(
                "    assert ReadTemporaryQueue(TRUE, 2) == "
                f"{bit_literal(queue_sentinel, 64)};"
            )
        else:
            print(
                "    assert ReadTemporaryQueue(TRUE, 1) == "
                f"{bit_literal(queue_sentinel, 64)};"
            )
    else:
        raise ValueError(f"unclassified ALU boundary destination: {row['form_id']}")

    print(f"    assert ReadTPC() == {bit_literal(post_tpc, 64)};")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    if field_by_name(row, "SrcL") is not None:
        print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
    if field_by_name(row, "SrcR") is not None:
        print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
    if field_by_name(row, "SrcD") is not None:
        print(f"    assert ReadGPR(6) == {bit_literal(addend, 64)};")
    if field_by_name(row, "SrcP") is not None:
        print(f"    assert ReadGPR(7) == {bit_literal(predicate, 64)};")
    if mnemonic != "C.SETC.TGT":
        print(f"    assert _CommitArgument == {bit_literal(control_sentinel, 64)};")
    if mnemonic != "C.SETRET":
        print(f"    assert _ReturnAddress == {bit_literal(control_sentinel, 64)};")
        print(f"    assert ReadGPR(10) == {bit_literal(control_sentinel, 64)};")


SCALAR_BRU_BASE_BOUNDARY_LABELS = ("zero", "lower", "upper")
SCALAR_BRU_ALIAS_FAULT_CASE_IDS = (
    "compare-dst-overlaps-left",
    "compare-dst-overlaps-right",
    "compare-destination-discard",
    "compare-push-t-source-snapshot",
    "compare-push-u-source-snapshot",
    "source-selector-t1",
    "source-selector-t2",
    "source-selector-t3",
    "source-selector-t4",
    "source-selector-u1",
    "source-selector-u2",
    "source-selector-u3",
    "source-selector-u4",
    "compressed-implicit-t-source-push",
    "commit-queue-sources",
    "branch-queue-sources",
    "addtpc-destination-discard",
    "addtpc-push-t",
    "addtpc-push-u",
    "setret-overwrites-r10-and-return",
    "b-z-outside-zero",
    "b-z-outside-one",
    "b-z-outside-all-ones",
    "b-nz-outside-zero",
    "b-nz-outside-one",
    "b-nz-outside-all-ones",
    "b-z-exec-mask-precedence",
    "b-nz-exec-mask-precedence",
    "successful-branch-preserves-bundle-state",
    "jr-srczero-zero-max-alias",
    "jr-odd-fault-outside",
    "jr-odd-fault-inside-bundle",
)


def scalar_bru_totality_labels(row: dict) -> tuple[str, ...]:
    """Return the fail-closed decoded totality dimensions for one BRU form."""
    class_id = scalar_bru_effect_class(row)
    if class_id in {"scalar-compare-value", "scalar-commit-value"}:
        labels = SCALAR_BRU_BASE_BOUNDARY_LABELS
        if field_by_name(row, "SrcRType") is not None:
            labels += ("modifier-01", "modifier-10", "modifier-11")
        if (
            class_id == "scalar-commit-value"
            and field_by_name(row, "shamt") is not None
        ):
            labels += ("shamt-max",)
        return labels
    if class_id == "scalar-branch-control":
        return ("zero", "lower", "upper", "lower-not-taken", "upper-not-taken")
    if class_id == "scalar-jump-control":
        if row["mnemonic"] == "JR":
            return (
                "zero",
                "lower",
                "upper",
                "srczero-max-alias",
                "odd-target-fault",
            )
        return SCALAR_BRU_BASE_BOUNDARY_LABELS
    if class_id in {"scalar-pc-relative-value", "scalar-return-address"}:
        return ("zero", "lower", "upper", "wrap")
    raise ValueError(f"unsupported BRU totality class: {row['form_id']}")


def scalar_bru_totality_immediate(row: dict) -> dict | None:
    return next(
        (
            field
            for field in row["fields"]
            if field["name"].startswith(("imm", "simm", "uimm"))
        ),
        None,
    )


def scalar_bru_totality_field_values(row: dict, label: str) -> dict[str, int]:
    values = {
        "RegDst": 3,
        "SrcL": 1,
        "SrcR": 2,
        "SrcRType": {
            "modifier-01": 1,
            "modifier-10": 2,
            "modifier-11": 3,
        }.get(label, 0),
        "SrcZero": 31 if label == "srczero-max-alias" else 0,
        "shamt": 31 if label == "shamt-max" else 0,
    }
    immediate = scalar_bru_totality_immediate(row)
    if immediate is not None:
        width = immediate["width"]
        maximum = (1 << width) - 1
        signed_boundary = (
            immediate["signedness"] == "signed"
            or scalar_bru_effect_class(row) == "scalar-pc-relative-value"
        )
        if label in {"lower", "lower-not-taken"}:
            raw = 1 << (width - 1) if signed_boundary else 1
        elif label in {"upper", "upper-not-taken"}:
            raw = (1 << (width - 1)) - 1 if signed_boundary else maximum
        elif label in {"wrap", "shamt-max"}:
            raw = 1
        else:
            raw = 0
        values[immediate["name"]] = raw
    return values


def scalar_bru_totality_witness(
    row: dict, family_constraints: list[dict], label: str
) -> tuple[int, dict[str, int]]:
    instruction = legal_scalar_witness(row, family_constraints)
    values = scalar_bru_totality_field_values(row, label)
    for field_name, value in values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"BRU totality witness violates constraint for {row['form_id']}"
            )
    decoded_values = {
        field["name"]: decode_field(row, field["name"], instruction)
        for field in row["fields"]
    }
    return instruction, decoded_values


def scalar_bru_totality_sources(
    row: dict, label: str, field_values: dict[str, int]
) -> tuple[int, int, int]:
    """Return left, unmodified right, and the outside-bundle branch predicate."""
    class_id = scalar_bru_effect_class(row)
    if class_id == "scalar-branch-control":
        desired = not label.endswith("not-taken")
        condition = scalar_bru_condition(row["mnemonic"])
        if condition in {"Z", "NZ"}:
            predicate = 0 if (condition == "Z") == desired else 1
            return 5, 3, predicate
        if condition is None:
            raise ValueError(f"missing branch condition for {row['form_id']}")
        left, right = scalar_bru_relational_inputs(condition, desired, None)
        return left, right, 0
    if class_id == "scalar-jump-control":
        return (0x201 if label == "odd-target-fault" else 0x200), 3, 0
    if label.startswith("modifier-"):
        right = 0x1234567880000001
        if row["semantic_handler"] in {
            "ExecuteCompareLogical",
            "ExecuteSetCommitLogical",
        }:
            if ".AND" in row["mnemonic"]:
                # Bit zero distinguishes logical NOT from arithmetic negation.
                left = 1
            else:
                # NOT(all-ones) is zero, while arithmetic negation is one.
                left = 0
                right = MASK64
        else:
            modifier = int(label.removeprefix("modifier-"), 2)
            effective_right = (
                right
                if modifier == 3
                else apply_scalar_right_modifier_py(right, modifier, False)
            )
            condition = scalar_bru_condition(row["mnemonic"])
            if condition in {"EQ", "NE", "GE"}:
                left = effective_right
            elif condition == "LT":
                left = 0x8000000000000000 if modifier == 1 else 0
            elif condition in {"LTU", "GEU"} and modifier in {1, 2}:
                left = 0x100000000
            elif condition in {"LTU", "GEU"}:
                left = effective_right
            else:
                raise ValueError(
                    f"missing restricted modifier condition for {row['form_id']}"
                )
        return left, right, 0
    if label == "zero":
        return 0, 0, 0
    if label == "lower":
        return 0x8000000000000000, 0x7FFFFFFFFFFFFFFF, 0
    if label == "upper":
        return MASK64, 1, 0
    if label == "shamt-max":
        return 0x80000000, 0, 0
    return 5, 3, 0


def scalar_bru_decoded_immediate(row: dict, field_values: dict[str, int]) -> int | None:
    field = scalar_bru_totality_immediate(row)
    if field is None:
        return None
    raw = field_values[field["name"]]
    if field["signedness"] == "signed":
        return sign_extended(raw, field["width"])
    return raw & MASK64


def scalar_bru_condition_expected(condition: str, left: int, right: int) -> bool:
    left &= MASK64
    right &= MASK64
    if condition == "EQ":
        return left == right
    if condition == "NE":
        return left != right
    if condition == "LT":
        return signed_integer(left, 64) < signed_integer(right, 64)
    if condition == "GE":
        return signed_integer(left, 64) >= signed_integer(right, 64)
    if condition == "LTU":
        return left < right
    if condition == "GEU":
        return left >= right
    if condition == "Z":
        return left == 0
    if condition == "NZ":
        return left != 0
    raise ValueError(f"unsupported BRU condition: {condition}")


def scalar_bru_totality_expected(
    row: dict,
    label: str,
    left: int,
    right: int,
    branch_predicate: int,
    pre_tpc: int,
    field_values: dict[str, int],
) -> dict[str, int | bool]:
    """Calculate one BRU result solely from raw decoded fields and inputs."""
    class_id = scalar_bru_effect_class(row)
    mnemonic = row["mnemonic"]
    immediate = scalar_bru_decoded_immediate(row, field_values)
    length_bytes = row["length_bits"] // 8
    expected: dict[str, int | bool] = {
        "fault": label == "odd-target-fault",
        "tpc": (pre_tpc + length_bytes) & MASK64,
    }
    if class_id in {"scalar-compare-value", "scalar-commit-value"}:
        logical = row["semantic_handler"] in {
            "ExecuteCompareLogical",
            "ExecuteSetCommitLogical",
        }
        if immediate is None:
            modifier = field_values.get("SrcRType", 0)
            if logical:
                effective_right = apply_scalar_right_modifier_py(right, modifier, True)
            elif modifier == 3:
                # Relational code 11 is a reviewed unmodified alias.
                effective_right = right & MASK64
            else:
                effective_right = apply_scalar_right_modifier_py(right, modifier, False)
        else:
            effective_right = immediate
            if class_id == "scalar-commit-value" and "shamt" in field_values:
                effective_right = (
                    effective_right << field_values.get("shamt", 0)
                ) & MASK64
        if logical:
            logical_result = (
                left | effective_right if ".OR" in mnemonic else left & effective_right
            )
            result = 1 if logical_result & MASK64 else 0
        else:
            condition = scalar_bru_condition(mnemonic)
            if condition is None:
                raise ValueError(f"missing totality condition for {row['form_id']}")
            result = (
                1
                if scalar_bru_condition_expected(condition, left, effective_right)
                else 0
            )
        expected["result"] = result
    elif class_id == "scalar-branch-control":
        condition = scalar_bru_condition(mnemonic)
        if condition is None or immediate is None:
            raise ValueError(f"missing branch totality metadata for {row['form_id']}")
        condition_left = branch_predicate if condition in {"Z", "NZ"} else left
        taken = scalar_bru_condition_expected(condition, condition_left, right)
        expected["taken"] = taken
        expected["tpc"] = (
            pre_tpc + ((immediate << 1) & MASK64) if taken else pre_tpc + 4
        ) & MASK64
    elif class_id == "scalar-jump-control":
        if immediate is None:
            raise ValueError(f"missing jump totality immediate for {row['form_id']}")
        target = (
            pre_tpc + ((immediate << 1) & MASK64)
            if mnemonic == "J"
            else left + ((immediate << 1) & MASK64)
        ) & MASK64
        expected["target"] = target
        expected["tpc"] = target
    elif class_id == "scalar-pc-relative-value":
        if immediate is None:
            raise ValueError(f"missing ADDTPC immediate for {row['form_id']}")
        signed_immediate = sign_extended(
            field_values[scalar_bru_totality_immediate(row)["name"]],
            scalar_bru_totality_immediate(row)["width"],
        )
        expected["result"] = (pre_tpc + ((signed_immediate << 1) & MASK64)) & MASK64
    elif class_id == "scalar-return-address":
        if immediate is None:
            raise ValueError(f"missing SETRET immediate for {row['form_id']}")
        expected["result"] = (pre_tpc + ((immediate << 1) & MASK64)) & MASK64
    else:
        raise ValueError(f"unsupported BRU totality expected class: {row['form_id']}")
    return expected


def emit_scalar_bru_totality_case(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    label: str,
) -> None:
    witness, field_values = scalar_bru_totality_witness(row, family_constraints, label)
    left, right, branch_predicate = scalar_bru_totality_sources(
        row, label, field_values
    )
    pre_tpc = MASK64 - 1 if label == "wrap" else 0x100
    expected = scalar_bru_totality_expected(
        row, label, left, right, branch_predicate, pre_tpc, field_values
    )
    class_id = scalar_bru_effect_class(row)
    mnemonic = row["mnemonic"]
    destination_sentinel = 0x5555555555555555
    control_sentinel = 0xAAAAAAAAAAAAAAAA
    queue_sentinel = 0x7777777777777777

    print(f"    // {row['form_id']}: {mnemonic} [bru-totality-{label}]")
    print("    ResetBundleControlState();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print(f"    WriteTPC({bit_literal(pre_tpc, 64)});")
    print(f"    WriteGPR(1, {bit_literal(left, 64)});")
    print(f"    WriteGPR(2, {bit_literal(right, 64)});")
    print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(10, {bit_literal(control_sentinel, 64)});")
    print(f"    _CommitArgument = {bit_literal(branch_predicate, 64)};")
    print(f"    _ReturnAddress = {bit_literal(control_sentinel, 64)};")
    if mnemonic in {"C.CMP.EQI", "C.CMP.NEI"}:
        print(f"    PushTemporaryQueue(TRUE, {bit_literal(queue_sentinel, 64)});")
        print(f"    PushTemporaryQueue(TRUE, {bit_literal(left, 64)});")
    print(
        f"    let scalar_bru_totality_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
    )
    expected_status = (
        "ScalarExecution_Rejected"
        if bool(expected["fault"])
        else "ScalarExecution_Executed"
    )
    print(f"    assert scalar_bru_totality_status_{case_index} == {expected_status};")
    print(
        "    assert _LastFault == "
        + ("Fault_InstructionPC;" if bool(expected["fault"]) else "Fault_None;")
    )
    if bool(expected["fault"]):
        target = int(expected["target"])
        print(f"    assert _FaultAddress == {bit_literal(target, 64)};")
        print("    assert _TrapContexts[[0]].valid;")
        print(f"    assert _TrapContexts[[0]].tpc == {bit_literal(pre_tpc, 64)};")
        print(f"    assert ReadTPC() == {bit_literal(target, 64)};")
    else:
        print("    assert _FaultAddress == Zeros{PTO_XLEN};")
        print(f"    assert ReadTPC() == {bit_literal(int(expected['tpc']), 64)};")

    if class_id == "scalar-compare-value":
        result = int(expected["result"])
        if mnemonic in {"C.CMP.EQI", "C.CMP.NEI"}:
            print(
                f"    assert ReadTemporaryQueue(TRUE, 0) == {bit_literal(result, 64)};"
            )
            print(f"    assert ReadTemporaryQueue(TRUE, 1) == {bit_literal(left, 64)};")
            print(
                "    assert ReadTemporaryQueue(TRUE, 2) == "
                f"{bit_literal(queue_sentinel, 64)};"
            )
            print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
        else:
            print(f"    assert ReadGPR(3) == {bit_literal(result, 64)};")
    elif class_id == "scalar-commit-value":
        print(
            f"    assert _CommitArgument == {bit_literal(int(expected['result']), 64)};"
        )
        print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
    elif class_id == "scalar-pc-relative-value":
        print(f"    assert ReadGPR(3) == {bit_literal(int(expected['result']), 64)};")
    elif class_id == "scalar-return-address":
        result = int(expected["result"])
        print(f"    assert ReadGPR(10) == {bit_literal(result, 64)};")
        print(f"    assert _ReturnAddress == {bit_literal(result, 64)};")
        print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
    else:
        print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")

    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    if field_by_name(row, "SrcL") is not None:
        print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
    if field_by_name(row, "SrcR") is not None:
        print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
    if class_id != "scalar-commit-value":
        print(f"    assert _CommitArgument == {bit_literal(branch_predicate, 64)};")
    if class_id != "scalar-return-address":
        print(f"    assert _ReturnAddress == {bit_literal(control_sentinel, 64)};")
        print(f"    assert ReadGPR(10) == {bit_literal(control_sentinel, 64)};")


def scalar_bru_alias_witness(
    row: dict, family_constraints: list[dict], values: dict[str, int]
) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    for field_name, value in values.items():
        if field_by_name(row, field_name) is None:
            raise ValueError(
                f"BRU alias witness requested absent {field_name} in {row['form_id']}"
            )
        instruction = encode_field(row, field_name, instruction, value)
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"BRU alias witness violates constraint for {row['form_id']}"
            )
    return instruction


def emit_scalar_bru_alias_and_faults(
    rows: list[dict], family_constraints: list[dict]
) -> None:
    """Emit the compact decoded Reg5, predicate, and JR fault topology matrix."""
    by_mnemonic = {row["mnemonic"]: row for row in rows}
    required = {
        "CMP.EQ",
        "C.CMP.EQI",
        "C.SETC.EQ",
        "B.EQ",
        "ADDTPC",
        "SETRET",
        "B.Z",
        "B.NZ",
        "JR",
    }
    missing = required - by_mnemonic.keys()
    if missing:
        raise ValueError(f"missing BRU alias representative forms: {sorted(missing)}")
    emitted_ids: list[str] = []
    case_index = 0
    destination_sentinel = 0x5555555555555555
    control_sentinel = 0xAAAAAAAAAAAAAAAA
    queue_sentinel = 0x7777777777777777

    def begin(case_id: str, pre_tpc: int = 0x100, reset_bundle: bool = True) -> int:
        nonlocal case_index
        if case_index >= len(SCALAR_BRU_ALIAS_FAULT_CASE_IDS):
            raise ValueError(f"unexpected BRU alias case: {case_id}")
        expected_id = SCALAR_BRU_ALIAS_FAULT_CASE_IDS[case_index]
        if case_id != expected_id:
            raise ValueError(
                f"BRU alias case order drift: expected {expected_id}, got {case_id}"
            )
        emitted_ids.append(case_id)
        print(f"    // BRU-ALIAS-FAULT-DECODED: {case_id}")
        if reset_bundle:
            print("    ResetBundleControlState();")
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
        print(f"    WriteTPC({bit_literal(pre_tpc, 64)});")
        current = case_index
        case_index += 1
        return current

    def execute(index: int, witness: int, row: dict, rejected: bool = False) -> None:
        print(
            f"    let scalar_bru_alias_fault_status_{index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
        )
        status = "ScalarExecution_Rejected" if rejected else "ScalarExecution_Executed"
        print(f"    assert scalar_bru_alias_fault_status_{index} == {status};")
        print(
            "    assert _LastFault == "
            + ("Fault_InstructionPC;" if rejected else "Fault_None;")
        )
        if not rejected:
            print("    assert _FaultAddress == Zeros{PTO_XLEN};")
        print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

    compare = by_mnemonic["CMP.EQ"]
    for case_id, destination, left_selector, right_selector in (
        ("compare-dst-overlaps-left", 1, 1, 2),
        ("compare-dst-overlaps-right", 2, 1, 2),
        ("compare-destination-discard", 0, 1, 2),
    ):
        witness = scalar_bru_alias_witness(
            compare,
            family_constraints,
            {
                "RegDst": destination,
                "SrcL": left_selector,
                "SrcR": right_selector,
                "SrcRType": 0,
            },
        )
        index = begin(case_id)
        print("    WriteGPR(1, Zeros{PTO_XLEN} + 5);")
        print("    WriteGPR(2, Zeros{PTO_XLEN} + 5);")
        print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
        execute(index, witness, compare)
        if destination == 1:
            print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 1;")
            print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 5;")
        elif destination == 2:
            print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 5;")
            print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 1;")
        else:
            print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 5;")
            print("    assert ReadGPR(2) == Zeros{PTO_XLEN} + 5;")
            print("    assert ReadGPR(0) == Zeros{PTO_XLEN};")
            print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
        print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")

    for case_id, destination, source_selector, queue_t in (
        ("compare-push-t-source-snapshot", 31, 24, True),
        ("compare-push-u-source-snapshot", 30, 28, False),
    ):
        witness = scalar_bru_alias_witness(
            compare,
            family_constraints,
            {
                "RegDst": destination,
                "SrcL": source_selector,
                "SrcR": 1,
                "SrcRType": 0,
            },
        )
        index = begin(case_id)
        print("    WriteGPR(1, Zeros{PTO_XLEN} + 5);")
        print(
            f"    PushTemporaryQueue({'TRUE' if queue_t else 'FALSE'}, "
            f"{bit_literal(queue_sentinel, 64)});"
        )
        print(
            f"    PushTemporaryQueue({'TRUE' if queue_t else 'FALSE'}, "
            "Zeros{PTO_XLEN} + 5);"
        )
        execute(index, witness, compare)
        queue = "TRUE" if queue_t else "FALSE"
        print(f"    assert ReadTemporaryQueue({queue}, 0) == Zeros{{PTO_XLEN}} + 1;")
        print(f"    assert ReadTemporaryQueue({queue}, 1) == Zeros{{PTO_XLEN}} + 5;")
        print(
            f"    assert ReadTemporaryQueue({queue}, 2) == "
            f"{bit_literal(queue_sentinel, 64)};"
        )
        print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 5;")
        print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")

    for queue_t, base_selector, prefix in ((True, 24, "t"), (False, 28, "u")):
        for value in range(4, 0, -1):
            queue_value = value if queue_t else value + 10
            print(
                f"    PushTemporaryQueue({'TRUE' if queue_t else 'FALSE'}, "
                f"Zeros{{PTO_XLEN}} + {queue_value});"
            )
        for queue_index in range(4):
            case_id = f"source-selector-{prefix}{queue_index + 1}"
            source_value = queue_index + 1 + (0 if queue_t else 10)
            witness = scalar_bru_alias_witness(
                compare,
                family_constraints,
                {
                    "RegDst": 3,
                    "SrcL": base_selector + queue_index,
                    "SrcR": 1,
                    "SrcRType": 0,
                },
            )
            index = begin(case_id)
            print(f"    WriteGPR(1, Zeros{{PTO_XLEN}} + {source_value});")
            print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
            execute(index, witness, compare)
            print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 1;")
            print(
                f"    assert ReadTemporaryQueue({'TRUE' if queue_t else 'FALSE'}, "
                f"{queue_index}) == Zeros{{PTO_XLEN}} + {source_value};"
            )

    compressed_compare = by_mnemonic["C.CMP.EQI"]
    compressed_witness = scalar_bru_alias_witness(
        compressed_compare, family_constraints, {"simm5": 5}
    )
    index = begin("compressed-implicit-t-source-push")
    print(f"    PushTemporaryQueue(TRUE, {bit_literal(queue_sentinel, 64)});")
    print("    PushTemporaryQueue(TRUE, Zeros{PTO_XLEN} + 5);")
    execute(index, compressed_witness, compressed_compare)
    print("    assert ReadTemporaryQueue(TRUE, 0) == Zeros{PTO_XLEN} + 1;")
    print("    assert ReadTemporaryQueue(TRUE, 1) == Zeros{PTO_XLEN} + 5;")
    print(
        f"    assert ReadTemporaryQueue(TRUE, 2) == {bit_literal(queue_sentinel, 64)};"
    )

    commit = by_mnemonic["C.SETC.EQ"]
    commit_witness = scalar_bru_alias_witness(
        commit, family_constraints, {"SrcL": 24, "SrcR": 28}
    )
    index = begin("commit-queue-sources")
    print("    PushTemporaryQueue(TRUE, Zeros{PTO_XLEN} + 9);")
    print("    PushTemporaryQueue(FALSE, Zeros{PTO_XLEN} + 9);")
    execute(index, commit_witness, commit)
    print("    assert _CommitArgument == Zeros{PTO_XLEN} + 1;")
    print("    assert ReadTemporaryQueue(TRUE, 0) == Zeros{PTO_XLEN} + 9;")
    print("    assert ReadTemporaryQueue(FALSE, 0) == Zeros{PTO_XLEN} + 9;")

    branch = by_mnemonic["B.EQ"]
    branch_witness = scalar_bru_alias_witness(
        branch, family_constraints, {"SrcL": 27, "SrcR": 31, "simm12": 1}
    )
    index = begin("branch-queue-sources")
    for value in (33, 44, 45, 46):
        print(f"    PushTemporaryQueue(TRUE, Zeros{{PTO_XLEN}} + {value});")
    for value in (33, 54, 55, 56):
        print(f"    PushTemporaryQueue(FALSE, Zeros{{PTO_XLEN}} + {value});")
    execute(index, branch_witness, branch)
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x102;")
    print("    assert ReadTemporaryQueue(TRUE, 3) == Zeros{PTO_XLEN} + 33;")
    print("    assert ReadTemporaryQueue(FALSE, 3) == Zeros{PTO_XLEN} + 33;")

    addtpc = by_mnemonic["ADDTPC"]
    for case_id, destination, queue_t in (
        ("addtpc-destination-discard", 0, None),
        ("addtpc-push-t", 31, True),
        ("addtpc-push-u", 30, False),
    ):
        witness = scalar_bru_alias_witness(
            addtpc, family_constraints, {"RegDst": destination, "imm20": 1}
        )
        index = begin(case_id)
        print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
        if queue_t is not None:
            print(
                f"    PushTemporaryQueue({'TRUE' if queue_t else 'FALSE'}, "
                f"{bit_literal(queue_sentinel, 64)});"
            )
        execute(index, witness, addtpc)
        if queue_t is None:
            print("    assert ReadGPR(0) == Zeros{PTO_XLEN};")
            print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
        else:
            queue = "TRUE" if queue_t else "FALSE"
            print(
                f"    assert ReadTemporaryQueue({queue}, 0) == Zeros{{PTO_XLEN}} + 0x102;"
            )
            print(
                f"    assert ReadTemporaryQueue({queue}, 1) == "
                f"{bit_literal(queue_sentinel, 64)};"
            )
        print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")

    setret = by_mnemonic["SETRET"]
    setret_witness = scalar_bru_alias_witness(setret, family_constraints, {"imm20": 1})
    index = begin("setret-overwrites-r10-and-return")
    print(f"    WriteGPR(10, {bit_literal(control_sentinel, 64)});")
    print(f"    _ReturnAddress = {bit_literal(control_sentinel, 64)};")
    execute(index, setret_witness, setret)
    print("    assert ReadGPR(10) == Zeros{PTO_XLEN} + 0x102;")
    print("    assert _ReturnAddress == Zeros{PTO_XLEN} + 0x102;")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")

    for mnemonic in ("B.Z", "B.NZ"):
        row = by_mnemonic[mnemonic]
        witness = scalar_bru_alias_witness(row, family_constraints, {"simm22": 1})
        slug = mnemonic.lower().replace(".", "-")
        for value, value_name in ((0, "zero"), (1, "one"), (MASK64, "all-ones")):
            index = begin(f"{slug}-outside-{value_name}")
            print(f"    _CommitArgument = {bit_literal(value, 64)};")
            execute(index, witness, row)
            taken = (value == 0) if mnemonic == "B.Z" else (value != 0)
            target = 0x102 if taken else 0x104
            print(f"    assert ReadTPC() == Zeros{{PTO_XLEN}} + 0x{target:x};")
            print(f"    assert _CommitArgument == {bit_literal(value, 64)};")

    for mnemonic, predicate, outside in (("B.Z", 0, 1), ("B.NZ", 1, 0)):
        row = by_mnemonic[mnemonic]
        witness = scalar_bru_alias_witness(row, family_constraints, {"simm22": 1})
        index = begin(f"{mnemonic.lower().replace('.', '-')}-exec-mask-precedence")
        print(f"    _CommitArgument = {bit_literal(outside, 64)};")
        print(
            "    BeginBundle(BundleKind_MachineParallel, BundleTransfer_Direct, "
            "Zeros{PTO_XLEN} + 0x100, Zeros{PTO_XLEN} + 0x104, "
            "Zeros{PTO_XLEN} + 0x108, TRUE);"
        )
        print("    EnterBundleBody();")
        print(f"    WriteExecutionMask({bit_literal(predicate, 64)});")
        execute(index, witness, row)
        print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x102;")
        print("    assert BundleIsActive();")
        print("    assert _BundleBodyActive;")
        print(f"    assert ReadExecutionMask() == {bit_literal(predicate, 64)};")
        print(f"    assert _CommitArgument == {bit_literal(outside, 64)};")

    bz = by_mnemonic["B.Z"]
    bz_witness = scalar_bru_alias_witness(bz, family_constraints, {"simm22": 1})
    index = begin("successful-branch-preserves-bundle-state")
    print("    _CommitArgument = Zeros{PTO_XLEN};")
    print(
        "    BeginBundle(BundleKind_Standard, BundleTransfer_Direct, "
        "Zeros{PTO_XLEN} + 0x100, Zeros{PTO_XLEN} + 0x104, "
        "Zeros{PTO_XLEN} + 0x108, TRUE);"
    )
    print("    EnterBundleBody();")
    print("    WriteExecutionMask(Zeros{PTO_XLEN} + 0x55);")
    execute(index, bz_witness, bz)
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x102;")
    print("    assert ReadBPC() == Zeros{PTO_XLEN} + 0x100;")
    print("    assert BundleIsActive();")
    print("    assert _BundleBodyActive;")
    print("    assert _BundleTarget == Zeros{PTO_XLEN} + 0x100;")
    print("    assert _BundleFallthrough == Zeros{PTO_XLEN} + 0x104;")
    print("    assert _BundleReturnTarget == Zeros{PTO_XLEN} + 0x108;")
    print("    assert ReadExecutionMask() == Zeros{PTO_XLEN} + 0x55;")
    print("    assert _CommitArgument == Zeros{PTO_XLEN};")

    jr = by_mnemonic["JR"]
    jr_zero = scalar_bru_alias_witness(
        jr, family_constraints, {"SrcL": 1, "SrcZero": 0, "simm12": 0}
    )
    jr_max = scalar_bru_alias_witness(
        jr, family_constraints, {"SrcL": 1, "SrcZero": 31, "simm12": 0}
    )
    index = begin("jr-srczero-zero-max-alias")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x200);")
    print(
        f"    let scalar_bru_alias_fault_status_{index}_zero = "
        f"ExecuteScalarInstruction({bit_literal(jr_zero, 48)}, {jr['length_bits']});"
    )
    print(
        f"    assert scalar_bru_alias_fault_status_{index}_zero == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _FaultAddress == Zeros{PTO_XLEN};")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x200;")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print(
        f"    let scalar_bru_alias_fault_status_{index}_max = "
        f"ExecuteScalarInstruction({bit_literal(jr_max, 48)}, {jr['length_bits']});"
    )
    print(
        f"    assert scalar_bru_alias_fault_status_{index}_max == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _FaultAddress == Zeros{PTO_XLEN};")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x200;")
    print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 0x200;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

    jr_odd = scalar_bru_alias_witness(
        jr, family_constraints, {"SrcL": 1, "SrcZero": 0, "simm12": 0}
    )
    index = begin("jr-odd-fault-outside")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x201);")
    print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(10, {bit_literal(control_sentinel, 64)});")
    print(f"    _CommitArgument = {bit_literal(control_sentinel, 64)};")
    print(f"    _ReturnAddress = {bit_literal(control_sentinel, 64)};")
    execute(index, jr_odd, jr, rejected=True)
    print("    assert _FaultAddress == Zeros{PTO_XLEN} + 0x201;")
    print("    assert _TrapContexts[[0]].valid;")
    print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")
    print("    assert !_TrapContexts[[0]].bundle_active;")
    print("    assert !_TrapContexts[[0]].bundle_body_active;")
    print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 0x201;")
    print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
    print(f"    assert _CommitArgument == {bit_literal(control_sentinel, 64)};")
    print(f"    assert _ReturnAddress == {bit_literal(control_sentinel, 64)};")
    print(f"    assert ReadGPR(10) == {bit_literal(control_sentinel, 64)};")

    index = begin("jr-odd-fault-inside-bundle")
    print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x201);")
    print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
    print(f"    WriteGPR(10, {bit_literal(control_sentinel, 64)});")
    print(f"    _CommitArgument = {bit_literal(control_sentinel, 64)};")
    print(f"    _ReturnAddress = {bit_literal(control_sentinel, 64)};")
    print("    PushTemporaryQueue(TRUE, Zeros{PTO_XLEN} + 0x11);")
    print("    PushTemporaryQueue(FALSE, Zeros{PTO_XLEN} + 0x22);")
    print(
        "    BeginBundle(BundleKind_Standard, BundleTransfer_Direct, "
        "Zeros{PTO_XLEN} + 0x100, Zeros{PTO_XLEN} + 0x104, "
        "Zeros{PTO_XLEN} + 0x108, TRUE);"
    )
    print("    EnterBundleBody();")
    print("    WriteExecutionMask(Zeros{PTO_XLEN} + 0x55);")
    execute(index, jr_odd, jr, rejected=True)
    print("    assert _FaultAddress == Zeros{PTO_XLEN} + 0x201;")
    print("    assert _TrapContexts[[0]].valid;")
    print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")
    print("    assert _TrapContexts[[0]].bpc == Zeros{PTO_XLEN} + 0x100;")
    print("    assert _TrapContexts[[0]].bundle_active;")
    print("    assert _TrapContexts[[0]].bundle_body_active;")
    print("    assert _TrapContexts[[0]].bundle_target == Zeros{PTO_XLEN} + 0x100;")
    print(
        "    assert _TrapContexts[[0]].bundle_fallthrough == Zeros{PTO_XLEN} + 0x104;"
    )
    print(
        "    assert _TrapContexts[[0]].bundle_return_target == Zeros{PTO_XLEN} + 0x108;"
    )
    print(
        f"    assert _TrapContexts[[0]].commit_argument == {bit_literal(control_sentinel, 64)};"
    )
    print("    assert _TrapContexts[[0]].execution_mask == Zeros{PTO_XLEN} + 0x55;")
    print("    assert _TrapContexts[[0]].t_queue[[0]] == Zeros{PTO_XLEN} + 0x11;")
    print("    assert _TrapContexts[[0]].u_queue[[0]] == Zeros{PTO_XLEN} + 0x22;")
    print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 0x201;")
    print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
    print(f"    assert _ReturnAddress == {bit_literal(control_sentinel, 64)};")
    print(f"    assert ReadGPR(10) == {bit_literal(control_sentinel, 64)};")

    if tuple(emitted_ids) != SCALAR_BRU_ALIAS_FAULT_CASE_IDS:
        raise ValueError("scalar BRU alias/fault case inventory drift during emission")


def scalar_bru_effect_class(row: dict) -> str | None:
    if row["semantic_family"] != "BRU":
        return None
    matches = [
        class_id
        for class_id, handlers in SCALAR_BRU_EFFECT_HANDLER_CLASSES.items()
        if row["semantic_handler"] in handlers
    ]
    if len(matches) != 1:
        raise ValueError(
            "BRU form does not have exactly one reviewed effect class: "
            f"{row['form_id']} ({row['semantic_handler']})"
        )
    return matches[0]


def scalar_bru_condition(mnemonic: str) -> str | None:
    final = mnemonic.split(".")[-1]
    for suffix in ("LTUI", "GEUI", "LTI", "GEI", "EQI", "NEI"):
        if final == suffix:
            return suffix.removesuffix("I")
    if final in {"EQ", "NE", "LT", "GE", "LTU", "GEU", "Z", "NZ"}:
        return final
    return None


def scalar_bru_immediate_raw(row: dict) -> tuple[str, int] | None:
    immediate = next(
        (
            field
            for field in row["fields"]
            if field["name"]
            in {
                "imm20",
                "imm32",
                "simm5",
                "simm12",
                "simm22",
                "simm24",
                "uimm12",
                "uimm24",
            }
        ),
        None,
    )
    if immediate is None:
        return None
    if row["semantic_handler"] in {
        "ExecuteCompareLogical",
        "ExecuteSetCommitLogical",
    }:
        raw = 0 if row["mnemonic"].endswith("ORI") else 1
    else:
        raw = 3
    return immediate["name"], raw


def scalar_bru_effect_witness(row: dict, family_constraints: list[dict]) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    values = {
        "RegDst": 3,
        "SrcL": 1,
        "SrcR": 2,
        "SrcRType": 3,
        "SrcZero": 0,
        "shamt": 1,
    }
    for field_name, value in values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    immediate = scalar_bru_immediate_raw(row)
    if immediate is not None:
        instruction = encode_field(row, immediate[0], instruction, immediate[1])
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"BRU effect witness violates constraint for {row['form_id']}"
            )
    return instruction


def scalar_bru_effective_immediate(row: dict) -> int | None:
    immediate = scalar_bru_immediate_raw(row)
    if immediate is None:
        return None
    field = field_by_name(row, immediate[0])
    if field is None:
        raise ValueError(f"missing BRU immediate metadata: {row['form_id']}")
    raw = immediate[1]
    value = (
        sign_extended(raw, field["width"]) if field["signedness"] == "signed" else raw
    )
    if (
        row["semantic_handler"]
        in {
            "ExecuteSetCommit",
            "ExecuteSetCommitLogical",
        }
        and field_by_name(row, "shamt") is not None
    ):
        value = (value << 1) & MASK64
    return value


def scalar_bru_relational_inputs(
    condition: str, desired: bool, fixed_right: int | None
) -> tuple[int, int]:
    if fixed_right is not None:
        right = fixed_right
        if condition == "EQ":
            return (right if desired else right + 1) & MASK64, right
        if condition == "NE":
            return (right + 1 if desired else right) & MASK64, right
        if condition in {"LT", "LTU"}:
            return (right - 1 if desired else right) & MASK64, right
        if condition in {"GE", "GEU"}:
            return (right if desired else right - 1) & MASK64, right
        raise ValueError(f"condition does not accept two operands: {condition}")
    cases = {
        ("EQ", True): (5, 5),
        ("EQ", False): (5, 3),
        ("NE", True): (5, 3),
        ("NE", False): (5, 5),
        ("LT", True): (MASK64, 1),
        ("LT", False): (1, MASK64),
        ("GE", True): (1, MASK64),
        ("GE", False): (MASK64, 1),
        ("LTU", True): (1, 3),
        ("LTU", False): (3, 1),
        ("GEU", True): (3, 1),
        ("GEU", False): (1, 3),
    }
    return cases[(condition, desired)]


def scalar_bru_scenario(row: dict, desired: bool) -> tuple[int, int, int]:
    """Return encoded source-left, source-right, and branch predicate values."""
    condition = scalar_bru_condition(row["mnemonic"])
    if row["semantic_handler"] in {
        "ExecuteCompareLogical",
        "ExecuteSetCommitLogical",
    }:
        immediate = scalar_bru_effective_immediate(row)
        combine_or = ".OR" in row["mnemonic"]
        if immediate is not None:
            if combine_or:
                return (1 if desired else 0), 3, 0
            return (immediate if desired else 0), 3, 0
        if combine_or:
            return (1 if desired else 0), MASK64, 0
        return 1, ((~1) & MASK64) if desired else MASK64, 0
    if condition in {"Z", "NZ"}:
        predicate = 0 if (condition == "Z") == desired else 1
        return 5, 3, predicate
    if condition is not None:
        left, right = scalar_bru_relational_inputs(
            condition, desired, scalar_bru_effective_immediate(row)
        )
        return left, right, 0
    if row["mnemonic"] == "JR":
        return 0x200, 3, 0
    return 5, 3, 0


def scalar_amo_effect_class(row: dict) -> str | None:
    if row["semantic_family"] != "AMO":
        return None
    handler = row["semantic_handler"]
    mnemonic = row["mnemonic"]
    if handler == "LoadReserved":
        return "scalar-amo-load-reserved"
    if handler == "StoreConditional":
        return "scalar-amo-store-conditional"
    if handler == "CompareAndSwap":
        return "scalar-amo-cas"
    if handler == "ExecuteScalarDMACopy64":
        return "scalar-dma-copy"
    if handler == "AtomicReadModifyWrite":
        if mnemonic.startswith("SWAP"):
            return "scalar-amo-swap"
        if mnemonic.startswith(("LW.", "LD.")):
            return "scalar-amo-load-rmw"
        if mnemonic.startswith(("SW.", "SD.")):
            return "scalar-amo-store-rmw"
    raise ValueError(
        f"AMO form does not have exactly one reviewed effect class: "
        f"{row['form_id']} ({row['semantic_handler']})"
    )


def scalar_amo_size_bytes(mnemonic: str) -> int:
    core = mnemonic.split(".")[-1]
    if mnemonic.startswith("LR.") or mnemonic.startswith("SC."):
        suffix = core
    elif mnemonic.startswith("SWAP"):
        suffix = mnemonic.removeprefix("SWAP")
    elif mnemonic.startswith("CAS") or mnemonic.startswith("HL.CAS"):
        suffix = core.removeprefix("CAS")
    elif mnemonic.startswith(("LW.", "SW.")):
        return 4
    elif mnemonic.startswith(("LD.", "SD.")):
        return 8
    else:
        raise ValueError(f"unclassified AMO width: {mnemonic}")
    return {"B": 1, "H": 2, "W": 4, "D": 8}[suffix]


def scalar_amo_effect_witness(row: dict, family_constraints: list[dict]) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    values = {
        "RegDst": 3,
        "SrcL": 1,
        "SrcR": 2,
        "SrcD": 4,
        "SrcZero": 5,
        "aq": 1,
        "far": 1,
        "rl": 1,
    }
    for field_name, value in values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"AMO effect witness violates constraint for {row['form_id']}"
            )
    return instruction


def scalar_amo_memory_order(row: dict) -> str:
    has_aq = field_by_name(row, "aq") is not None
    has_rl = field_by_name(row, "rl") is not None
    if has_aq and has_rl:
        return "MemoryOrder_AcquireRelease"
    if has_aq:
        return "MemoryOrder_Acquire"
    if has_rl:
        return "MemoryOrder_Release"
    return "MemoryOrder_Relaxed"


def scalar_amo_old_value(size_bytes: int) -> int:
    return {
        1: 0x80,
        2: 0x8001,
        4: 0x80000001,
        8: 0x8000000000000001,
    }[size_bytes]


def scalar_amo_operand_value(size_bytes: int) -> int:
    return {
        1: 0x7F,
        2: 0x7FFE,
        4: 0x7FFFFFFE,
        8: 0x7FFFFFFFFFFFFFFE,
    }[size_bytes]


def scalar_amo_desired_value(size_bytes: int) -> int:
    return {
        1: 0x5A,
        2: 0x55AA,
        4: 0x55667788,
        8: 0x1122334455667788,
    }[size_bytes]


def normalize_atomic_unsigned_py(value: int, size_bytes: int) -> int:
    return value & ((1 << (size_bytes * 8)) - 1)


def normalize_atomic_return_py(value: int, size_bytes: int) -> int:
    if size_bytes == 4:
        return sign_extended(value, 32)
    return normalize_atomic_unsigned_py(value, size_bytes)


def scalar_amo_operation(mnemonic: str) -> str:
    if mnemonic.startswith("SWAP"):
        return "SWAP"
    return mnemonic.split(".")[-1]


def scalar_amo_rmw_result(
    mnemonic: str, old_value: int, operand: int, size_bytes: int
) -> int:
    mask = (1 << (size_bytes * 8)) - 1
    op = scalar_amo_operation(mnemonic)
    old_unsigned = old_value & mask
    operand_unsigned = operand & mask
    old_signed = signed_integer(old_unsigned, size_bytes * 8)
    operand_signed = signed_integer(operand_unsigned, size_bytes * 8)
    if op == "SWAP":
        result = operand_unsigned
    elif op == "ADD":
        result = old_unsigned + operand_unsigned
    elif op == "AND":
        result = old_unsigned & operand_unsigned
    elif op == "OR":
        result = old_unsigned | operand_unsigned
    elif op == "XOR":
        result = old_unsigned ^ operand_unsigned
    elif op == "SMIN":
        result = old_unsigned if old_signed < operand_signed else operand_unsigned
    elif op == "SMAX":
        result = old_unsigned if old_signed > operand_signed else operand_unsigned
    elif op == "UMIN":
        result = old_unsigned if old_unsigned < operand_unsigned else operand_unsigned
    elif op == "UMAX":
        result = old_unsigned if old_unsigned > operand_unsigned else operand_unsigned
    else:
        raise ValueError(f"unclassified AMO RMW operation: {mnemonic}")
    return result & mask


def scalar_amo_source_fields(row: dict) -> tuple[str, ...]:
    return tuple(
        field["name"]
        for field in row["fields"]
        if field["name"] in {"SrcL", "SrcR", "SrcD"}
    )


def scalar_amo_instruction(
    row: dict,
    family_constraints: list[dict],
    *,
    selectors: dict[str, int] | None = None,
    modifiers: dict[str, int] | None = None,
    destination: int = 3,
    src_zero: int = 5,
) -> int:
    instruction = legal_scalar_witness(row, family_constraints)
    selector_values = {"SrcL": 1, "SrcR": 2, "SrcD": 4}
    selector_values.update(selectors or {})
    for field_name, value in selector_values.items():
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(row, field_name, instruction, value)
    if field_by_name(row, "RegDst") is not None:
        instruction = encode_field(row, "RegDst", instruction, destination)
    if field_by_name(row, "SrcZero") is not None:
        instruction = encode_field(row, "SrcZero", instruction, src_zero)
    for field_name in ("aq", "rl", "far"):
        if field_by_name(row, field_name) is not None:
            instruction = encode_field(
                row, field_name, instruction, (modifiers or {}).get(field_name, 0)
            )
    for constraint in row["constraints"]:
        if decode_field(row, constraint["field"], instruction) == constraint["value"]:
            raise ValueError(
                f"AMO totality witness violates constraint for {row['form_id']}"
            )
    return instruction


def scalar_amo_order_from_modifiers(modifiers: dict[str, int]) -> str:
    aq = modifiers.get("aq", 0)
    rl = modifiers.get("rl", 0)
    if aq and rl:
        return "MemoryOrder_AcquireRelease"
    if aq:
        return "MemoryOrder_Acquire"
    if rl:
        return "MemoryOrder_Release"
    return "MemoryOrder_Relaxed"


def scalar_amo_modifier_cases(row: dict) -> tuple[dict[str, int], ...]:
    fields = tuple(
        field_name
        for field_name in ("aq", "rl", "far")
        if field_by_name(row, field_name) is not None
    )
    return tuple(
        {
            field_name: (combination >> field_index) & 1
            for field_index, field_name in enumerate(fields)
        }
        for combination in range(1 << len(fields))
    )


def scalar_amo_value_cases(row: dict) -> tuple[tuple[str, int, int, int, bool], ...]:
    """Return label, old, operand/expected, desired, and conditional outcome."""
    class_id = scalar_amo_effect_class(row)
    if class_id == "scalar-dma-copy":
        return ()
    size_bytes = scalar_amo_size_bytes(row["mnemonic"])
    bits = size_bytes * 8
    mask = (1 << bits) - 1
    maximum_signed = (1 << (bits - 1)) - 1
    sign_bit = 1 << (bits - 1)
    upper_junk = (0xA5A5A5A5A5A5A5A5 & ~mask) if size_bytes < 8 else 0
    boundaries = (0, maximum_signed, sign_bit | upper_junk, mask | upper_junk)
    if class_id == "scalar-amo-load-reserved":
        return tuple(
            (f"old-{index}", old, 0, 0, True) for index, old in enumerate(boundaries)
        )
    if class_id == "scalar-amo-store-conditional":
        return tuple(
            (f"source-{index}-{outcome}", 0x5A, source, 0, outcome == "success")
            for index, source in enumerate(boundaries)
            for outcome in ("success", "miss")
        )
    if class_id == "scalar-amo-cas":
        patterns = (
            (0, 0, 1),
            (1, 1 | upper_junk, mask | upper_junk),
            (maximum_signed, maximum_signed, sign_bit | upper_junk),
            (sign_bit, sign_bit | upper_junk, maximum_signed),
            (mask, mask | upper_junk, 0),
            (0, 1, 2),
            (1, 0, 2),
            (maximum_signed, sign_bit | upper_junk, 1),
            (sign_bit, maximum_signed, 1),
            (mask, 0, 1),
        )
        cases = tuple(
            (
                f"cas-{index}",
                old,
                expected,
                desired,
                normalize_atomic_unsigned_py(old, size_bytes)
                == normalize_atomic_unsigned_py(expected, size_bytes),
            )
            for index, (old, expected, desired) in enumerate(patterns)
        )
        normalized = {
            (
                normalize_atomic_unsigned_py(old, size_bytes),
                normalize_atomic_unsigned_py(expected, size_bytes),
                normalize_atomic_unsigned_py(desired, size_bytes),
            )
            for _, old, expected, desired, _ in cases
        }
        if len(normalized) != len(cases):
            raise ValueError(f"duplicate normalized CAS scenario: {row['form_id']}")
        return cases
    if class_id == "scalar-amo-swap":
        return tuple(
            (f"swap-{index}", 0x80000001, operand, 0, True)
            for index, operand in enumerate(boundaries)
        )
    operation = scalar_amo_operation(row["mnemonic"])
    if operation in {"ADD", "AND", "OR", "XOR"}:
        cases = tuple(
            (f"{operation.lower()}-{index}", old, operand, 0, True)
            for index, (old, operand) in enumerate(
                (
                    (0, 0),
                    (1, 1),
                    (maximum_signed, 1 | upper_junk),
                    (mask, sign_bit | upper_junk),
                )
            )
        )
        normalized = {
            (
                normalize_atomic_unsigned_py(old, size_bytes),
                normalize_atomic_unsigned_py(operand, size_bytes),
            )
            for _, old, operand, _, _ in cases
        }
        if len(normalized) != len(cases):
            raise ValueError(f"duplicate normalized RMW scenario: {row['form_id']}")
        return cases
    if operation in {"SMIN", "SMAX", "UMIN", "UMAX"}:
        patterns = (
            (0, 0),
            (0, 1),
            (1, 0),
            (maximum_signed, sign_bit | upper_junk),
            (sign_bit, maximum_signed),
            (mask, 0),
            (0, mask | upper_junk),
        )
        cases = tuple(
            (f"{operation.lower()}-{index}", old, operand, 0, True)
            for index, (old, operand) in enumerate(patterns)
        )
        normalized = {
            (
                normalize_atomic_unsigned_py(old, size_bytes),
                normalize_atomic_unsigned_py(operand, size_bytes),
            )
            for _, old, operand, _, _ in cases
        }
        if len(normalized) != len(cases):
            raise ValueError(f"duplicate normalized min/max scenario: {row['form_id']}")
        return cases
    raise ValueError(f"unclassified AMO value matrix: {row['form_id']}")


def emit_scalar_amo_selector_setup(selector: int, value: int) -> None:
    if selector < 24:
        print(f"    WriteGPR({selector}, {bit_literal(value, 64)});")
    elif selector < 28:
        print(f"    _TQueue[[{selector - 24}]] = {bit_literal(value, 64)};")
    else:
        print(f"    _UQueue[[{selector - 28}]] = {bit_literal(value, 64)};")


def emit_scalar_amo_decoded_success(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    marker: str,
    *,
    old_value: int,
    operand: int,
    desired: int,
    conditional_success: bool = True,
    selectors: dict[str, int] | None = None,
    destination: int = 3,
    modifiers: dict[str, int] | None = None,
    src_zero: int = 5,
    reservation_mode: str = "none",
    address: int = 0x400,
    prior_reservation: tuple[bool, int, int] | None = None,
) -> None:
    """Emit one exact decoded non-DMA AMO transition."""
    if reservation_mode not in {"none", "overlap", "nonoverlap"}:
        raise ValueError(f"invalid AMO reservation mode: {reservation_mode}")
    class_id = scalar_amo_effect_class(row)
    if class_id in {None, "scalar-dma-copy"}:
        raise ValueError(f"non-DMA AMO case requested for {row['form_id']}")
    size_bytes = scalar_amo_size_bytes(row["mnemonic"])
    selector_values = {"SrcL": 1, "SrcR": 2, "SrcD": 4}
    selector_values.update(selectors or {})
    source_values: dict[str, int]
    if class_id == "scalar-amo-load-reserved":
        source_values = {"SrcL": address}
    elif class_id == "scalar-amo-store-conditional":
        source_values = {"SrcL": operand, "SrcR": address}
    elif class_id == "scalar-amo-cas":
        source_values = {"SrcL": address, "SrcR": operand, "SrcD": desired}
    else:
        source_values = {"SrcL": address, "SrcR": operand}
    instruction = scalar_amo_instruction(
        row,
        family_constraints,
        selectors=selector_values,
        modifiers=modifiers,
        destination=destination,
        src_zero=src_zero,
    )
    order = scalar_amo_order_from_modifiers(modifiers or {})
    old_unsigned = normalize_atomic_unsigned_py(old_value, size_bytes)
    old_return = normalize_atomic_return_py(old_value, size_bytes)
    rmw_result = (
        scalar_amo_rmw_result(row["mnemonic"], old_value, operand, size_bytes)
        if class_id
        in {"scalar-amo-swap", "scalar-amo-load-rmw", "scalar-amo-store-rmw"}
        else 0
    )
    if class_id == "scalar-amo-store-conditional":
        destination_value = 0 if conditional_success else 1
    else:
        destination_value = old_return
    pre_t = [0x1111000000000000 + index for index in range(4)]
    pre_u = [0x2222000000000000 + index for index in range(4)]
    selected_values: dict[int, int] = {}
    for field_name, value in source_values.items():
        selector = selector_values[field_name]
        if selector in selected_values and selected_values[selector] != value:
            raise ValueError(
                f"conflicting AMO selector values in {marker}: selector {selector}"
            )
        selected_values[selector] = value
        if 24 <= selector < 28:
            pre_t[selector - 24] = value
        elif selector >= 28:
            pre_u[selector - 28] = value

    print(f"    // AMO-S4 {marker}")
    print("    StopMemoryEventCapture();")

    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    for index, value in enumerate(pre_t):
        print(f"    _TQueue[[{index}]] = {bit_literal(value, 64)};")
    for index, value in enumerate(pre_u):
        print(f"    _UQueue[[{index}]] = {bit_literal(value, 64)};")
    for selector, value in sorted(selected_values.items()):
        emit_scalar_amo_selector_setup(selector, value)
    if field_by_name(row, "RegDst") is not None and destination < 24:
        if destination not in selected_values:
            print(
                f"    WriteGPR({destination}, {bit_literal(0x5555555555555555, 64)});"
            )
    print(
        f"    Store(Zeros{{PTO_XLEN}} + 0x{address:x}, {size_bytes}, "
        f"{bit_literal(old_value, 64)});"
    )
    if class_id == "scalar-amo-store-conditional":
        reservation = prior_reservation or (conditional_success, address, 8)
        print(f"    _ReservationValid = {'TRUE' if reservation[0] else 'FALSE'};")
        print(f"    _ReservationAddress = Zeros{{PTO_XLEN}} + 0x{reservation[1]:x};")
        print(f"    _ReservationSize = {reservation[2]};")
    elif prior_reservation is not None:
        print(f"    _ReservationValid = {'TRUE' if prior_reservation[0] else 'FALSE'};")
        print(
            f"    _ReservationAddress = Zeros{{PTO_XLEN}} + 0x{prior_reservation[1]:x};"
        )
        print(f"    _ReservationSize = {prior_reservation[2]};")
    elif reservation_mode != "none":
        reservation_address = address if reservation_mode == "overlap" else 0x900
        print("    _ReservationValid = TRUE;")
        print(
            f"    _ReservationAddress = Zeros{{PTO_XLEN}} + 0x{reservation_address:x};"
        )
        print("    _ReservationSize = 4;")
    else:
        print("    _ReservationValid = FALSE;")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, "
        f"{row['length_bits']});"
    )
    print(f"    assert scalar_amo_s4_status_{case_index} == ScalarExecution_Executed;")
    print("    assert _LastFault == Fault_None;")
    print(
        "    assert ReadTPC() == Zeros{PTO_XLEN} + "
        f"0x{0x100 + row['length_bits'] // 8:x};"
    )
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    expected_event_count = (
        0
        if (class_id == "scalar-amo-store-conditional" and not conditional_success)
        else 1
    )
    print(f"    assert _MemoryEventCount == {expected_event_count};")
    if expected_event_count:
        expected_kind = (
            "Load"
            if class_id == "scalar-amo-load-reserved"
            else "Store"
            if class_id == "scalar-amo-store-conditional"
            else "Atomic"
        )
        print(f"    assert _MemoryEvents[[0]].kind == MemoryEvent_{expected_kind};")
        print(f"    assert _MemoryEvents[[0]].agent == {case_index % 4};")
        print(
            f"    assert _MemoryEvents[[0]].address == Zeros{{PTO_XLEN}} + 0x{address:x};"
        )
        print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
        print(f"    assert _MemoryEvents[[0]].order == {order};")
        if expected_kind in {"Load", "Atomic"}:
            print(
                "    assert _MemoryEvents[[0]].read_value == "
                f"{bit_literal(old_unsigned, 64)};"
            )
        if expected_kind == "Load":
            print("    assert !_MemoryEvents[[0]].write_performed;")
        elif expected_kind == "Store":
            print("    assert _MemoryEvents[[0]].write_performed;")
            print(
                "    assert _MemoryEvents[[0]].write_value == "
                f"{bit_literal(normalize_atomic_unsigned_py(operand, size_bytes), 64)};"
            )
        else:
            write_performed = class_id != "scalar-amo-cas" or conditional_success
            performed_expression = (
                "_MemoryEvents[[0]].write_performed"
                if write_performed
                else "!_MemoryEvents[[0]].write_performed"
            )
            print(f"    assert {performed_expression};")
            write_value = desired if class_id == "scalar-amo-cas" else rmw_result
            print(
                "    assert _MemoryEvents[[0]].write_value == "
                f"{bit_literal(normalize_atomic_unsigned_py(write_value, size_bytes), 64)};"
            )

    if class_id == "scalar-amo-load-reserved":
        print("    assert _ReservationValid;")
        print(f"    assert _ReservationAddress == Zeros{{PTO_XLEN}} + 0x{address:x};")
        print(f"    assert _ReservationSize == {size_bytes};")
        expected_memory = old_unsigned
    elif class_id == "scalar-amo-store-conditional":
        print("    assert !_ReservationValid;")
        expected_memory = (
            normalize_atomic_unsigned_py(operand, size_bytes)
            if conditional_success
            else old_unsigned
        )
    elif class_id == "scalar-amo-cas":
        expected_memory = (
            normalize_atomic_unsigned_py(desired, size_bytes)
            if conditional_success
            else old_unsigned
        )
    else:
        expected_memory = rmw_result
    if reservation_mode != "none" and class_id not in {
        "scalar-amo-load-reserved",
        "scalar-amo-store-conditional",
    }:
        invalidates = reservation_mode == "overlap" and (
            class_id != "scalar-amo-cas" or conditional_success
        )
        if invalidates:
            print("    assert !_ReservationValid;")
        else:
            expected_reservation = address if reservation_mode == "overlap" else 0x900
            print("    assert _ReservationValid;")
            print(
                "    assert _ReservationAddress == Zeros{PTO_XLEN} + "
                f"0x{expected_reservation:x};"
            )
            print("    assert _ReservationSize == 4;")
    print(
        f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
        f"{size_bytes}) == {bit_literal(expected_memory, 64)};"
    )

    if field_by_name(row, "RegDst") is not None:
        if destination < 24:
            expected_destination = 0 if destination == 0 else destination_value
            print(
                f"    assert ReadGPR({destination}) == "
                f"{bit_literal(expected_destination, 64)};"
            )
        elif destination == 30:
            print(f"    assert _UQueue[[0]] == {bit_literal(destination_value, 64)};")
            for index in range(1, 4):
                print(
                    f"    assert _UQueue[[{index}]] == "
                    f"{bit_literal(pre_u[index - 1], 64)};"
                )
        elif destination == 31:
            print(f"    assert _TQueue[[0]] == {bit_literal(destination_value, 64)};")
            for index in range(1, 4):
                print(
                    f"    assert _TQueue[[{index}]] == "
                    f"{bit_literal(pre_t[index - 1], 64)};"
                )

    for field_name, value in source_values.items():
        selector = selector_values[field_name]
        if selector < 24 and selector != destination:
            print(f"    assert ReadGPR({selector}) == {bit_literal(value, 64)};")
    if destination != 31:
        for index, value in enumerate(pre_t):
            print(f"    assert _TQueue[[{index}]] == {bit_literal(value, 64)};")
    if destination != 30:
        for index, value in enumerate(pre_u):
            print(f"    assert _UQueue[[{index}]] == {bit_literal(value, 64)};")
    print("    StopMemoryEventCapture();")


def scalar_amo_dma_chunk_value(chunk: int) -> int:
    return sum((((chunk * 8 + byte) * 3 + 1) & 0xFF) << (byte * 8) for byte in range(8))


def emit_scalar_amo_dma_success(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    marker: str,
    *,
    source_address: int,
    destination_address: int,
    selectors: dict[str, int] | None = None,
    reservation_overlap: bool = False,
) -> None:
    selector_values = {"SrcL": 1, "SrcR": 2}
    selector_values.update(selectors or {})
    instruction = scalar_amo_instruction(
        row, family_constraints, selectors=selector_values
    )
    source_values = {"SrcL": source_address, "SrcR": destination_address}
    pre_t = [0x3333000000000000 + index for index in range(4)]
    pre_u = [0x4444000000000000 + index for index in range(4)]
    selected_values: dict[int, int] = {}
    for field_name, value in source_values.items():
        selector = selector_values[field_name]
        selected_values[selector] = value
        if 24 <= selector < 28:
            pre_t[selector - 24] = value
        elif selector >= 28:
            pre_u[selector - 28] = value
    print(f"    // AMO-S4 {marker}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    for index, value in enumerate(pre_t):
        print(f"    _TQueue[[{index}]] = {bit_literal(value, 64)};")
    for index, value in enumerate(pre_u):
        print(f"    _UQueue[[{index}]] = {bit_literal(value, 64)};")
    for selector, value in sorted(selected_values.items()):
        emit_scalar_amo_selector_setup(selector, value)
    print("    for dma_init_byte = 0 to 63 do")
    print(
        f"        WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{destination_address:x} + "
        "NaturalToWord(dma_init_byte as integer {0..262144}), Zeros{8} + 0xa5);"
    )
    print("    end;")
    print("    for dma_source_byte = 0 to 63 do")
    print(
        f"        WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{source_address:x} + "
        "NaturalToWord(dma_source_byte as integer {0..262144}), "
        "Zeros{8} + ((dma_source_byte * 3 + 1) MOD 256));"
    )
    print("    end;")
    reservation_address = destination_address if reservation_overlap else 0x900
    print("    _ReservationValid = TRUE;")
    print(f"    _ReservationAddress = Zeros{{PTO_XLEN}} + 0x{reservation_address:x};")
    print("    _ReservationSize = 4;")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_dma_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, "
        f"{row['length_bits']});"
    )
    print(
        f"    assert scalar_amo_dma_s4_status_{case_index} == ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print("    assert _MemoryEventCount == 16;")
    for chunk in range(8):
        source_chunk = source_address + chunk * 8
        chunk_value = scalar_amo_dma_chunk_value(chunk)
        print(f"    assert _MemoryEvents[[{chunk}]].kind == MemoryEvent_Load;")
        print(f"    assert _MemoryEvents[[{chunk}]].agent == {case_index % 4};")
        print(
            f"    assert _MemoryEvents[[{chunk}]].address == "
            f"Zeros{{PTO_XLEN}} + 0x{source_chunk:x};"
        )
        print(f"    assert _MemoryEvents[[{chunk}]].size_bytes == 8;")
        print(f"    assert !_MemoryEvents[[{chunk}]].write_performed;")
        print(
            f"    assert _MemoryEvents[[{chunk}]].read_value == "
            f"{bit_literal(chunk_value, 64)};"
        )
        print(f"    assert _MemoryEvents[[{chunk}]].order == MemoryOrder_Relaxed;")
        event_index = chunk + 8
        destination_chunk = destination_address + chunk * 8
        print(f"    assert _MemoryEvents[[{event_index}]].kind == MemoryEvent_Store;")
        print(f"    assert _MemoryEvents[[{event_index}]].agent == {case_index % 4};")
        print(
            f"    assert _MemoryEvents[[{event_index}]].address == "
            f"Zeros{{PTO_XLEN}} + 0x{destination_chunk:x};"
        )
        print(f"    assert _MemoryEvents[[{event_index}]].size_bytes == 8;")
        print(f"    assert _MemoryEvents[[{event_index}]].write_performed;")
        print(
            f"    assert _MemoryEvents[[{event_index}]].write_value == "
            f"{bit_literal(chunk_value, 64)};"
        )
        print(
            f"    assert _MemoryEvents[[{event_index}]].order == MemoryOrder_Relaxed;"
        )
    print("    for dma_check_byte = 0 to 63 do")
    print(
        f"        assert ReadMemoryByte(Zeros{{PTO_XLEN}} + 0x{destination_address:x} + "
        "NaturalToWord(dma_check_byte as integer {0..262144})) == "
        "Zeros{8} + ((dma_check_byte * 3 + 1) MOD 256);"
    )
    print("    end;")
    if reservation_overlap:
        print("    assert !_ReservationValid;")
    else:
        print("    assert _ReservationValid;")
        print("    assert _ReservationAddress == Zeros{PTO_XLEN} + 0x900;")
        print("    assert _ReservationSize == 4;")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    for field_name, value in source_values.items():
        selector = selector_values[field_name]
        if selector < 24:
            print(f"    assert ReadGPR({selector}) == {bit_literal(value, 64)};")
    for index, value in enumerate(pre_t):
        print(f"    assert _TQueue[[{index}]] == {bit_literal(value, 64)};")
    for index, value in enumerate(pre_u):
        print(f"    assert _UQueue[[{index}]] == {bit_literal(value, 64)};")
    print("    StopMemoryEventCapture();")


def scalar_amo_fault_cases(row: dict) -> tuple[tuple[str, int, int, str], ...]:
    if scalar_amo_effect_class(row) == "scalar-dma-copy":
        return ()
    size_bytes = scalar_amo_size_bytes(row["mnemonic"])
    cases: list[tuple[str, int, int, str]] = []
    if size_bytes > 1:
        cases.append(("alignment", 0x401, 0, "Fault_DataAlignment"))
    cases.append(("bounded-page", 0x1000, 0, "Fault_DataPage"))
    cases.append(("acr2-permission", 0xC00, 2, "Fault_DataPage"))
    return tuple(cases)


def emit_scalar_amo_fault_or_restart(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    marker: str,
    *,
    fault_address: int,
    source_acr: int,
    expected_fault: str,
    restart: bool,
) -> None:
    class_id = scalar_amo_effect_class(row)
    if class_id in {None, "scalar-dma-copy"}:
        raise ValueError(f"invalid AMO fault form: {row['form_id']}")
    size_bytes = scalar_amo_size_bytes(row["mnemonic"])
    address_field = "SrcR" if class_id == "scalar-amo-store-conditional" else "SrcL"
    source_values = {"SrcL": 0x33, "SrcR": 0x22, "SrcD": 0x44}
    source_values[address_field] = fault_address
    if class_id == "scalar-amo-cas":
        source_values["SrcR"] = 0x22
        source_values["SrcD"] = 0x44
    instruction = scalar_amo_instruction(row, family_constraints)
    target_ring = 1 if source_acr >= 2 else source_acr
    print(f"    // AMO-S4 {marker}")
    print("    StopMemoryEventCapture();")
    print("    ResetMemoryExecution();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
    print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
    print(f"    WriteGPR(1, {bit_literal(source_values['SrcL'], 64)});")
    if field_by_name(row, "SrcR") is not None:
        print(f"    WriteGPR(2, {bit_literal(source_values['SrcR'], 64)});")
    if field_by_name(row, "SrcD") is not None:
        print(f"    WriteGPR(4, {bit_literal(source_values['SrcD'], 64)});")
    if field_by_name(row, "RegDst") is not None:
        print("    WriteGPR(3, Zeros{PTO_XLEN} + 0x55);")
    print("    WriteMemoryByte(Zeros{PTO_XLEN} + 0x700, Zeros{8} + 0xa5);")
    if fault_address < 0x1000:
        print(
            f"    WriteMemoryByte(Zeros{{PTO_XLEN}} + 0x{fault_address:x}, "
            "Zeros{8} + 0x22);"
        )
    if class_id == "scalar-amo-store-conditional":
        print("    _ReservationValid = TRUE;")
        print(f"    _ReservationAddress = Zeros{{PTO_XLEN}} + 0x{fault_address:x};")
        print("    _ReservationSize = 8;")
    else:
        print("    _ReservationValid = TRUE;")
        print("    _ReservationAddress = Zeros{PTO_XLEN} + 0x900;")
        print("    _ReservationSize = 4;")
    print(f"    SetCurrentACR({source_acr});")
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_fault_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, "
        f"{row['length_bits']});"
    )
    print(
        f"    assert scalar_amo_fault_s4_status_{case_index} == "
        "ScalarExecution_Rejected;"
    )
    print(f"    assert _LastFault == {expected_fault};")
    print(f"    assert _FaultAddress == Zeros{{PTO_XLEN}} + 0x{fault_address:x};")
    print("    assert _MemoryEventCount == 0;")
    print("    assert ReadMemoryByte(Zeros{PTO_XLEN} + 0x700) == Zeros{8} + 0xa5;")
    if fault_address < 0x1000:
        print(
            f"    assert ReadMemoryByte(Zeros{{PTO_XLEN}} + 0x{fault_address:x}) == "
            "Zeros{8} + 0x22;"
        )
    if field_by_name(row, "RegDst") is not None:
        print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 0x55;")
    print(f"    assert _TrapContexts[[{target_ring}]].valid;")
    print(f"    assert _TrapContexts[[{target_ring}]].source_acr == {source_acr};")
    print(
        f"    assert _TrapContexts[[{target_ring}]].tpc == Zeros{{PTO_XLEN}} + 0x100;"
    )
    print(
        f"    assert ReadTPC() == TrapVectorEntry({target_ring}, "
        f"Zeros{{PTO_XLEN}} + 0x{fault_address:x});"
    )
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    if class_id == "scalar-amo-store-conditional":
        print("    assert !_ReservationValid;")
    else:
        print("    assert _ReservationValid;")
        print("    assert _ReservationAddress == Zeros{PTO_XLEN} + 0x900;")
        print("    assert _ReservationSize == 4;")
    print("    StopMemoryEventCapture();")
    if not restart:
        return

    print(
        f"    let scalar_amo_recover_s4_{case_index} = "
        f"RecoverTrapContext({target_ring});"
    )
    print(f"    assert scalar_amo_recover_s4_{case_index};")
    print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x100;")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    repaired_address = 0x600
    address_selector = 2 if address_field == "SrcR" else 1
    print(
        f"    WriteGPR({address_selector}, Zeros{{PTO_XLEN}} + 0x{repaired_address:x});"
    )
    print(
        f"    Store(Zeros{{PTO_XLEN}} + 0x{repaired_address:x}, {size_bytes}, "
        "Zeros{PTO_XLEN} + 0x22);"
    )
    print(f"    StartMemoryEventCapture({case_index % 4});")
    print(
        f"    let scalar_amo_restart_s4_status_{case_index} = "
        f"ExecuteScalarInstruction({bit_literal(instruction, 48)}, "
        f"{row['length_bits']});"
    )
    print(
        f"    assert scalar_amo_restart_s4_status_{case_index} == "
        "ScalarExecution_Executed;"
    )
    print("    assert _LastFault == Fault_None;")
    print(
        "    assert ReadTPC() == Zeros{PTO_XLEN} + "
        f"0x{0x100 + row['length_bits'] // 8:x};"
    )
    print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 2;")
    if class_id == "scalar-amo-store-conditional":
        print("    assert _MemoryEventCount == 0;")
        print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 1;")
        print("    assert !_ReservationValid;")
        print(
            f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + "
            f"0x{repaired_address:x}, {size_bytes}) == Zeros{{PTO_XLEN}} + 0x22;"
        )
    else:
        expected_kind = "Load" if class_id == "scalar-amo-load-reserved" else "Atomic"
        print("    assert _MemoryEventCount == 1;")
        print(f"    assert _MemoryEvents[[0]].kind == MemoryEvent_{expected_kind};")
        print(
            f"    assert _MemoryEvents[[0]].address == Zeros{{PTO_XLEN}} + "
            f"0x{repaired_address:x};"
        )
        print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
        print("    assert _MemoryEvents[[0]].order == MemoryOrder_Relaxed;")
        print("    assert _MemoryEvents[[0]].read_value == Zeros{PTO_XLEN} + 0x22;")
        if class_id == "scalar-amo-load-reserved":
            print("    assert !_MemoryEvents[[0]].write_performed;")
            print("    assert _ReservationValid;")
            print(
                f"    assert _ReservationAddress == Zeros{{PTO_XLEN}} + "
                f"0x{repaired_address:x};"
            )
            print(f"    assert _ReservationSize == {size_bytes};")
            print(
                "    assert ReadGPR(3) == "
                f"{bit_literal(normalize_atomic_return_py(0x22, size_bytes), 64)};"
            )
        else:
            print("    assert _MemoryEvents[[0]].write_performed;")
            expected_write = (
                0x44
                if class_id == "scalar-amo-cas"
                else scalar_amo_rmw_result(
                    row["mnemonic"], 0x22, source_values["SrcR"], size_bytes
                )
            )
            print(
                "    assert _MemoryEvents[[0]].write_value == "
                f"{bit_literal(normalize_atomic_unsigned_py(expected_write, size_bytes), 64)};"
            )
            print("    assert _ReservationValid;")
            print("    assert _ReservationAddress == Zeros{PTO_XLEN} + 0x900;")
            print("    assert _ReservationSize == 4;")
            if class_id != "scalar-amo-store-rmw":
                print(
                    "    assert ReadGPR(3) == "
                    f"{bit_literal(normalize_atomic_return_py(0x22, size_bytes), 64)};"
                )
            print(
                f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + "
                f"0x{repaired_address:x}, {size_bytes}) == "
                f"{bit_literal(normalize_atomic_unsigned_py(expected_write, size_bytes), 64)};"
            )
    print("    StopMemoryEventCapture();")


def emit_scalar_amo_sc_miss_no_probe(
    row: dict,
    family_constraints: list[dict],
    case_index: int,
    marker: str,
    *,
    address: int,
    source_acr: int,
) -> None:
    instruction = scalar_amo_instruction(row, family_constraints)
