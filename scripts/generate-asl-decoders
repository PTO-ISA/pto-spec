    print("constant PTO_SCALAR_FSU_DIRECT_FLAG_CASE_COUNT = 35;")
    print(f"constant PTO_SCALAR_SYS_EFFECT_FORM_COUNT = {len(scalar_sys_effect_rows)};")
    print(
        "constant PTO_SCALAR_SYS_REGISTER_TRANSFER_CASE_COUNT = "
