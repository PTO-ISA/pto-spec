            )
            print("    assert _LastFault == Fault_None;")
            print("    assert _CommitArgument == Zeros{PTO_XLEN} + 0xabc;")
            print("    assert ReadGPR(5) == Zeros{PTO_XLEN} + 0xabc;")
            print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

        else:
            raise ValueError(f"unhandled SYS effect class: {class_id}")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("// PTO-REQ-SCALAR-SYS-001, PTO-REQ-SCALAR-SSR-001: every concrete")
    print("// catalog address through every encoding-width-applicable SYS transfer.")
    print("func ValidateCanonicalScalarSYSRegisterTransfers0To255()")
    print("begin")
    active_form_id = None
    destination_sentinel = 0x5555555555555555
    for case_index, (
        row,
        register,
        behavior,
        address,
        address_field_name,
    ) in enumerate(scalar_sys_register_transfer_cases):
        if case_index > 0 and case_index % 256 == 0:
            print("    ResetProfileState();")
            print("end;")
            print()
            last_case = min(
                case_index + 255, len(scalar_sys_register_transfer_cases) - 1
            )
            print(
                f"func ValidateCanonicalScalarSYSRegisterTransfers{case_index}To{last_case}()"
            )
            print("begin")
            active_form_id = None
        if row["form_id"] != active_form_id:
            print("    ResetProfileState();")
            active_form_id = row["form_id"]
        class_id = scalar_sys_effect_class(row)
        access = register["access"]
        overrides = {address_field_name: address}
        if field_by_name(row, "RegDst") is not None:
            overrides["RegDst"] = 3
        if field_by_name(row, "SrcL") is not None:
            overrides["SrcL"] = 5
        witness = scalar_sys_witness(row, family_constraints, overrides)
        marker = f"transfer/{row['form_id']}/{register['name']}/0x{address:06x}"
        print(f"    // SYS-S4 {marker}")
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(
            f"    let scalar_sys_transfer_cycle_before_{case_index} = "
            "_SystemRegisters.cycle;"
        )

        if class_id == "scalar-system-register-read":
            if row["mnemonic"] != "C.SSRGET":
                print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
            if access != "WO" and behavior["read"] != "architectural-time":
                print(
                    f"    let scalar_sys_transfer_before_{case_index} = "
                    f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                )
            print(
                f"    let scalar_sys_transfer_status_{case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            if access == "WO":
                print(
                    f"    assert scalar_sys_transfer_status_{case_index} == "
                    "ScalarExecution_Rejected;"
                )
                print("    assert _LastFault == Fault_IllegalInstruction;")
                if row["mnemonic"] != "C.SSRGET":
                    print(
                        f"    assert ReadGPR(3) == "
                        f"{bit_literal(destination_sentinel, 64)};"
                    )
            else:
                print(
                    f"    assert scalar_sys_transfer_status_{case_index} == "
                    "ScalarExecution_Executed;"
                )
                print("    assert _LastFault == Fault_None;")
                if behavior["read"] == "architectural-time":
                    expected = f"scalar_sys_transfer_cycle_before_{case_index} + 1"
                else:
                    expected = f"scalar_sys_transfer_before_{case_index}"
                destination = (
                    "ReadTemporaryQueue(TRUE, 0)"
                    if row["mnemonic"] == "C.SSRGET"
                    else "ReadGPR(3)"
                )
                print(f"    assert {destination} == {expected};")

        elif class_id == "scalar-system-register-write":
            if behavior["write"] == "unpack-trap-status":
                write_value = 4
            elif register["name"] == "CORE_STATE":
                write_value = 0x100
            else:
                write_value = 0x100000 + case_index
            print(f"    WriteGPR(5, Zeros{{PTO_XLEN}} + {write_value});")
            if access == "RO" and behavior["read"] != "architectural-time":
                print(
                    f"    let scalar_sys_transfer_before_{case_index} = "
                    f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                )
            print(
                f"    let scalar_sys_transfer_status_{case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            if access == "RO":
                print(
                    f"    assert scalar_sys_transfer_status_{case_index} == "
                    "ScalarExecution_Rejected;"
                )
                print("    assert _LastFault == Fault_IllegalInstruction;")
                print(f"    assert ReadGPR(5) == Zeros{{PTO_XLEN}} + {write_value};")
                print("    ClearFault();")
                if behavior["read"] != "architectural-time":
                    print(
                        f"    let scalar_sys_transfer_after_{case_index} = "
                        f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                    )
                    print(
                        f"    assert scalar_sys_transfer_after_{case_index} == "
                        f"scalar_sys_transfer_before_{case_index};"
                    )
            else:
                print(
                    f"    assert scalar_sys_transfer_status_{case_index} == "
                    "ScalarExecution_Executed;"
                )
                print("    assert _LastFault == Fault_None;")
                print(f"    assert ReadGPR(5) == Zeros{{PTO_XLEN}} + {write_value};")
                if access == "RW":
                    print(
                        f"    let scalar_sys_transfer_after_{case_index} = "
                        f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                    )
                    print(
                        f"    assert scalar_sys_transfer_after_{case_index} == "
                        f"Zeros{{PTO_XLEN}} + {write_value};"
                    )

        elif class_id == "scalar-system-register-swap":
            if behavior["write"] == "unpack-trap-status":
                write_value = 4
            elif register["name"] == "CORE_STATE":
                write_value = 0x100
            else:
                write_value = 0x200000 + case_index
            print(f"    WriteGPR(5, Zeros{{PTO_XLEN}} + {write_value});")
            print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
            if access != "WO":
                print(
                    f"    let scalar_sys_transfer_before_{case_index} = "
                    f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                )
            print(
                f"    let scalar_sys_transfer_status_{case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            if access == "RW":
                print(
                    f"    assert scalar_sys_transfer_status_{case_index} == "
                    "ScalarExecution_Executed;"
                )
                print("    assert _LastFault == Fault_None;")
                print(
                    f"    assert ReadGPR(3) == scalar_sys_transfer_before_{case_index};"
                )
                print(
                    f"    let scalar_sys_transfer_after_{case_index} = "
                    f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                )
                print(
                    f"    assert scalar_sys_transfer_after_{case_index} == "
                    f"Zeros{{PTO_XLEN}} + {write_value};"
                )
            else:
                print(
                    f"    assert scalar_sys_transfer_status_{case_index} == "
                    "ScalarExecution_Rejected;"
                )
                print("    assert _LastFault == Fault_IllegalInstruction;")
                print(
                    f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};"
                )
                print(f"    assert ReadGPR(5) == Zeros{{PTO_XLEN}} + {write_value};")
                print("    ClearFault();")
                if access == "RO" and behavior["read"] != "architectural-time":
                    print(
                        f"    let scalar_sys_transfer_after_{case_index} = "
                        f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
                    )
                    print(
                        f"    assert scalar_sys_transfer_after_{case_index} == "
                        f"scalar_sys_transfer_before_{case_index};"
                    )
        else:
            raise ValueError(f"unexpected SYS transfer class: {class_id}")

        print(
            f"    assert _SystemRegisters.cycle == "
            f"scalar_sys_transfer_cycle_before_{case_index} + 1;"
        )
    print("    ResetProfileState();")
    print("end;")
    print()
    print("// PTO-REQ-SCALAR-OPERAND-001: exhaustive Reg5 selector and alias")
    print("// coverage for every decoded SYS register-transfer shape.")
    print("func ValidateCanonicalScalarSYSSelectorReadWriteAliases()")
    print("begin")
    selector_case_index = 0
    selector_state_base = 0x400000

    for row in scalar_sys_selector_read_rows:
        address_field = scalar_sys_register_address_field(row)["name"]
        for destination in range(32):
            witness = scalar_sys_witness(
                row,
                family_constraints,
                {address_field: 0, "RegDst": destination},
            )
            read_value = 0x110000 + selector_case_index
            print(f"    // SYS-S4 selector/read/{row['form_id']}/dst-{destination}")
            print("    ResetProfileState();")
            print(
                f"    _SystemRegisters.thread_ptr = Zeros{{PTO_XLEN}} + {read_value};"
            )
            print(
                f"    let scalar_sys_selector_cycle_{selector_case_index} = _SystemRegisters.cycle;"
            )
            print(
                f"    let scalar_sys_selector_status_{selector_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_sys_selector_status_{selector_case_index} == "
                "ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            if destination < 24:
                expected = 0 if destination == 0 else read_value
                print(
                    f"    assert ReadGPR({destination}) == Zeros{{PTO_XLEN}} + {expected};"
                )
            elif destination < 28:
                print(f"    assert _TQueue[[{destination - 24}]] == Zeros{{PTO_XLEN}};")
            elif destination < 30:
                print(f"    assert _UQueue[[{destination - 28}]] == Zeros{{PTO_XLEN}};")
            elif destination == 30:
                print(
                    f"    assert ReadTemporaryQueue(FALSE, 0) == "
                    f"Zeros{{PTO_XLEN}} + {read_value};"
                )
            else:
                print(
                    f"    assert ReadTemporaryQueue(TRUE, 0) == "
                    f"Zeros{{PTO_XLEN}} + {read_value};"
                )
            print(
                f"    assert _SystemRegisters.cycle == "
                f"scalar_sys_selector_cycle_{selector_case_index} + 1;"
            )
            selector_case_index += 1

    for row in scalar_sys_selector_write_rows:
        address_field = scalar_sys_register_address_field(row)["name"]
        for source in range(32):
            witness = scalar_sys_witness(
                row,
                family_constraints,
                {address_field: 0, "SrcL": source},
            )
            print(f"    // SYS-S4 selector/write/{row['form_id']}/src-{source}")
            print("    ResetProfileState();")
            print("    for scalar_sys_init = 0 to PTO_ABSOLUTE_GPR_COUNT - 1 do")
            print(
                f"        _GPR[[scalar_sys_init]] = Zeros{{PTO_XLEN}} + "
                f"{selector_state_base + selector_case_index * 64} + scalar_sys_init;"
            )
            print("    end;")
            print("    for scalar_sys_init = 0 to PTO_TEMPORARY_QUEUE_DEPTH - 1 do")
            print(
                f"        _TQueue[[scalar_sys_init]] = Zeros{{PTO_XLEN}} + "
                f"{selector_state_base + selector_case_index * 64 + 24} + scalar_sys_init;"
            )
            print(
                f"        _UQueue[[scalar_sys_init]] = Zeros{{PTO_XLEN}} + "
                f"{selector_state_base + selector_case_index * 64 + 28} + scalar_sys_init;"
            )
            print("    end;")
            print(
                f"    let scalar_sys_selector_source_{selector_case_index} = "
                f"ReadScalarRegisterOperand({source});"
            )
            print(
                f"    let scalar_sys_selector_cycle_{selector_case_index} = _SystemRegisters.cycle;"
            )
            print(
                f"    let scalar_sys_selector_status_{selector_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_sys_selector_status_{selector_case_index} == "
                "ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print(
                f"    assert _SystemRegisters.thread_ptr == "
                f"scalar_sys_selector_source_{selector_case_index};"
            )
            print(
                f"    assert _SystemRegisters.cycle == "
                f"scalar_sys_selector_cycle_{selector_case_index} + 1;"
            )
            selector_case_index += 1

    if len(scalar_sys_selector_swap_rows) != 1:
        raise ValueError("reviewed SYS swap-form inventory drift")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarSYSSwapAliases0To7()")
    print("begin")
    for row in scalar_sys_selector_swap_rows:
        address_field = scalar_sys_register_address_field(row)["name"]
        for source in range(32):
            if source in {8, 16, 24}:
                print("    ResetProfileState();")
                print("end;")
                print()
                print(
                    f"func ValidateCanonicalScalarSYSSwapAliases{source}To{source + 7}()"
                )
                print("begin")
            for destination in range(32):
                witness = scalar_sys_witness(
                    row,
                    family_constraints,
                    {
                        address_field: 0,
                        "SrcL": source,
                        "RegDst": destination,
                    },
                )
                old_value = 0x220000 + selector_case_index
                print(
                    f"    // SYS-S4 selector/swap/{row['form_id']}/"
                    f"src-{source}/dst-{destination}"
                )
                print("    ResetProfileState();")
                print("    for scalar_sys_init = 0 to PTO_ABSOLUTE_GPR_COUNT - 1 do")
                print(
                    f"        _GPR[[scalar_sys_init]] = Zeros{{PTO_XLEN}} + "
                    f"{selector_state_base + selector_case_index * 64} + scalar_sys_init;"
                )
                print("    end;")
                print("    for scalar_sys_init = 0 to PTO_TEMPORARY_QUEUE_DEPTH - 1 do")
                print(
                    f"        _TQueue[[scalar_sys_init]] = Zeros{{PTO_XLEN}} + "
                    f"{selector_state_base + selector_case_index * 64 + 24} + scalar_sys_init;"
                )
                print(
                    f"        _UQueue[[scalar_sys_init]] = Zeros{{PTO_XLEN}} + "
                    f"{selector_state_base + selector_case_index * 64 + 28} + scalar_sys_init;"
                )
                print("    end;")
                print(
                    f"    _SystemRegisters.thread_ptr = Zeros{{PTO_XLEN}} + {old_value};"
                )
                print(
                    f"    let scalar_sys_selector_source_{selector_case_index} = "
                    f"ReadScalarRegisterOperand({source});"
                )
                print(
                    f"    let scalar_sys_selector_cycle_{selector_case_index} = _SystemRegisters.cycle;"
                )
                print(
                    f"    let scalar_sys_selector_status_{selector_case_index} = "
                    f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                    f"{row['length_bits']});"
                )
                print(
                    f"    assert scalar_sys_selector_status_{selector_case_index} == "
                    "ScalarExecution_Executed;"
                )
                print("    assert _LastFault == Fault_None;")
                print(
                    f"    assert _SystemRegisters.thread_ptr == "
                    f"scalar_sys_selector_source_{selector_case_index};"
                )
                if destination < 24:
                    expected = 0 if destination == 0 else old_value
                    print(
                        f"    assert ReadGPR({destination}) == "
                        f"Zeros{{PTO_XLEN}} + {expected};"
                    )
                elif destination < 28:
                    expected = (
                        selector_state_base + selector_case_index * 64 + destination
                    )
                    print(
                        f"    assert _TQueue[[{destination - 24}]] == "
                        f"Zeros{{PTO_XLEN}} + {expected};"
                    )
                elif destination < 30:
                    expected = (
                        selector_state_base + selector_case_index * 64 + destination
                    )
                    print(
                        f"    assert _UQueue[[{destination - 28}]] == "
                        f"Zeros{{PTO_XLEN}} + {expected};"
                    )
                elif destination == 30:
                    print(
                        f"    assert ReadTemporaryQueue(FALSE, 0) == "
                        f"Zeros{{PTO_XLEN}} + {old_value};"
                    )
                else:
                    print(
                        f"    assert ReadTemporaryQueue(TRUE, 0) == "
                        f"Zeros{{PTO_XLEN}} + {old_value};"
                    )
                print(
                    f"    assert _SystemRegisters.cycle == "
                    f"scalar_sys_selector_cycle_{selector_case_index} + 1;"
                )
                selector_case_index += 1

    if selector_case_index != scalar_sys_selector_case_count:
        raise ValueError("SYS selector/alias emission count drift")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("// PTO-REQ-SCALAR-SYS-001: decoded mask, tag, request, recovery,")
    print("// selector, maintenance privilege, and operand-boundary totality.")
    print("func ValidateCanonicalScalarSYSFenceTotality()")
    print("begin")
    control_case_index = 0

    fence_row = scalar_sys_by_mnemonic["FENCE.D"]
    for predecessor in range(16):
        for successor in range(16):
            witness = scalar_sys_witness(
                fence_row,
                family_constraints,
                {"PRED_IMM": predecessor, "SUCC_IMM": successor},
            )
            print(f"    // SYS-S4 fence/{predecessor}/{successor}")
            print("    ResetProfileState();")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Executed;"
            )
            print(f"    assert _LastFencePredecessor == {bit_literal(predecessor, 4)};")
            print(f"    assert _LastFenceSuccessor == {bit_literal(successor, 4)};")
            control_case_index += 1

    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarSYSTrapAndRecoveryTotality()")
    print("begin")
    for mnemonic, tag_field, values in (
        ("C.EBREAK", "imm5", range(32)),
        ("EBREAK", "imm4", range(16)),
    ):
        row = scalar_sys_by_mnemonic[mnemonic]
        for tag in values:
            witness = scalar_sys_witness(row, family_constraints, {tag_field: tag})
            print(f"    // SYS-S4 breakpoint/{row['form_id']}/{tag}")
            print("    ResetProfileState();")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Rejected;"
            )
            print("    assert _LastFault == Fault_SoftwareBreakpoint;")
            print(f"    assert _BreakpointTag == {bit_literal(tag, 5)};")
            control_case_index += 1

    acrc_row = scalar_sys_by_mnemonic["ACRC"]
    for ring in range(16):
        for request_type in range(16):
            witness = scalar_sys_witness(
                acrc_row,
                family_constraints,
                {"RST_Type": request_type},
            )
            permitted = (ring == 1 and request_type in {0, 2}) or (
                ring >= 2 and request_type <= 2
            )
            target = (
                (1 if request_type == 1 else 0)
                if permitted
                else (0 if ring == 0 else 1)
            )
            print(f"    // SYS-S4 acrc/ring-{ring}/type-{request_type}")
            print("    ResetProfileState();")
            print(f"    SetCurrentACR({ring});")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Rejected;"
            )
            if permitted:
                print("    assert _LastFault == Fault_ServiceRequest;")
                print("    assert _ArchitectureRequestEpoch == 1;")
                print(
                    f"    assert _ControlRequestOperand[3:0] == {bit_literal(request_type, 4)};"
                )
                print(f"    assert _ACRTrapNumber[[{target}]] == Zeros{{6}} + 6;")
                print(
                    f"    assert _TrapContexts[[{target}]].tpc == "
                    "Zeros{PTO_XLEN} + 0x104;"
                )
            else:
                print("    assert _LastFault == Fault_IllegalInstruction;")
                print("    assert _ArchitectureRequestEpoch == 0;")
                print(f"    assert _ACRTrapNumber[[{target}]] == Zeros{{6}} + 4;")
            print(f"    assert CurrentACR() == {target};")
            control_case_index += 1

    acre_row = scalar_sys_by_mnemonic["ACRE"]
    for request_type in (0, 1):
        witness = scalar_sys_witness(
            acre_row, family_constraints, {"RRA_Type": request_type}
        )
        print(f"    // SYS-S4 acre/success/type-{request_type}")
        print("    ResetProfileState();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x240);")
        print("    WriteBPC(Zeros{PTO_XLEN} + 0x80);")
        print("    SaveTrapContext(0, 0);")
        print("    ClearFault();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            "ScalarExecution_Executed;"
        )
        print("    assert _LastFault == Fault_None;")
        print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x240;")
        control_case_index += 1

        print(f"    // SYS-S4 acre/missing/type-{request_type}")
        print("    ResetProfileState();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            "ScalarExecution_Rejected;"
        )
        print("    assert _LastFault == Fault_ExecutionStateCheck;")
        control_case_index += 1

        print(f"    // SYS-S4 acre/malformed-control/type-{request_type}")
        print("    ResetProfileState();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x240);")
        print("    SaveTrapContext(0, 0);")
        print("    WriteSystemRegisterAddress(Zeros{24} + 0x0f40, Zeros{PTO_XLEN});")
        print("    ClearFault();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            "ScalarExecution_Rejected;"
        )
        print("    assert _LastFault == Fault_ExecutionStateCheck;")
        control_case_index += 1

        print(f"    // SYS-S4 acre/odd-tpc/type-{request_type}")
        print("    ResetProfileState();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x241);")
        print("    SaveTrapContext(0, 0);")
        print("    ClearFault();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            "ScalarExecution_Rejected;"
        )
        print("    assert _LastFault == Fault_ExecutionStateCheck;")
        control_case_index += 1

    for request_type in range(2, 16):
        witness = scalar_sys_witness(
            acre_row, family_constraints, {"RRA_Type": request_type}
        )
        print(f"    // SYS-S4 acre/invalid/type-{request_type}")
        print("    ResetProfileState();")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            "ScalarExecution_Rejected;"
        )
        print("    assert _LastFault == Fault_IllegalInstruction;")
        control_case_index += 1

    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarSYSRequestTotality()")
    print("begin")
    assert_row = scalar_sys_by_mnemonic["ASSERT"]
    for source in range(32):
        values = (0,) if source == 0 else (0, 1)
        for value in values:
            witness = scalar_sys_witness(
                assert_row, family_constraints, {"SrcL": source}
            )
            print(f"    // SYS-S4 assert/src-{source}/value-{value}")
            print("    ResetProfileState();")
            if source < 24:
                print(f"    WriteGPR({source}, Zeros{{PTO_XLEN}} + {value});")
            elif source < 28:
                print(f"    _TQueue[[{source - 24}]] = Zeros{{PTO_XLEN}} + {value};")
            else:
                print(f"    _UQueue[[{source - 28}]] = Zeros{{PTO_XLEN}} + {value};")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            expected_fault = value == 0
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                + (
                    "ScalarExecution_Rejected;"
                    if expected_fault
                    else "ScalarExecution_Executed;"
                )
            )
            print(
                "    assert _LastFault == "
                + ("Fault_Assert;" if expected_fault else "Fault_None;")
            )
            control_case_index += 1

    for mnemonic, request_name in (
        ("BSE", "SendEvent"),
        ("BWE", "WaitEvent"),
        ("BWI", "WaitInterrupt"),
        ("BWT", "WaitTimeout"),
    ):
        row = scalar_sys_by_mnemonic[mnemonic]
        for source in range(32):
            value = 0 if source == 0 else 0x300000 + control_case_index
            witness = scalar_sys_witness(row, family_constraints, {"SrcL": source})
            print(f"    // SYS-S4 control/{row['form_id']}/src-{source}")
            print("    ResetProfileState();")
            if source < 24:
                print(f"    WriteGPR({source}, Zeros{{PTO_XLEN}} + {value});")
            elif source < 28:
                print(f"    _TQueue[[{source - 24}]] = Zeros{{PTO_XLEN}} + {value};")
            else:
                print(f"    _UQueue[[{source - 28}]] = Zeros{{PTO_XLEN}} + {value};")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Executed;"
            )
            print(f"    assert _LastControlRequest == ExecutionControl_{request_name};")
            print(f"    assert _ControlRequestOperand == Zeros{{PTO_XLEN}} + {value};")
            control_case_index += 1

    commit_row = scalar_sys_by_mnemonic["SETC.TGT"]
    for source in range(32):
        value = 0 if source == 0 else 0x500000 + control_case_index
        witness = scalar_sys_witness(commit_row, family_constraints, {"SrcL": source})
        print(f"    // SYS-S4 commit/src-{source}")
        print("    ResetProfileState();")
        if source < 24:
            print(f"    WriteGPR({source}, Zeros{{PTO_XLEN}} + {value});")
        elif source < 28:
            print(f"    _TQueue[[{source - 24}]] = Zeros{{PTO_XLEN}} + {value};")
        else:
            print(f"    _UQueue[[{source - 28}]] = Zeros{{PTO_XLEN}} + {value};")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            "ScalarExecution_Executed;"
        )
        print(f"    assert _CommitArgument == Zeros{{PTO_XLEN}} + {value};")
        control_case_index += 1

    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarSYSMaintenanceSelectorTotality()")
    print("begin")
    operand_maintenance_rows = [
        row
        for row in scalar_sys_effect_rows
        if row["semantic_handler"] == "ExecuteMaintenance"
        and field_by_name(row, "SrcL") is not None
    ]
    if len(operand_maintenance_rows) != 12:
        raise ValueError("operand-bearing maintenance inventory drift")
    for row in operand_maintenance_rows:
        operation = asl_identifier(row["mnemonic"])
        for source in range(32):
            value = 0 if source == 0 else 0x1000 + source
            witness = scalar_sys_witness(row, family_constraints, {"SrcL": source})
            print(f"    // SYS-S4 maintenance-selector/{row['form_id']}/src-{source}")
            print("    ResetProfileState();")
            if source < 24:
                print(f"    WriteGPR({source}, Zeros{{PTO_XLEN}} + {value});")
            elif source < 28:
                print(f"    _TQueue[[{source - 24}]] = Zeros{{PTO_XLEN}} + {value};")
            else:
                print(f"    _UQueue[[{source - 28}]] = Zeros{{PTO_XLEN}} + {value};")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Executed;"
            )
            print(f"    assert _LastMaintenanceOperation == Maintenance_{operation};")
            print(f"    assert _LastMaintenanceOperand == Zeros{{PTO_XLEN}} + {value};")
            control_case_index += 1

    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarSYSMaintenanceLegalityTotality()")
    print("begin")
    tlb_rows = [
        row
        for row in scalar_sys_effect_rows
        if scalar_sys_effect_class(row) == "scalar-tlb-maintenance"
    ]
    for row in tlb_rows:
        overrides = {"SrcL": 5} if field_by_name(row, "SrcL") is not None else {}
        witness = scalar_sys_witness(row, family_constraints, overrides)
        for ring in range(1, 16):
            print(f"    // SYS-S4 maintenance-privilege/{row['form_id']}/ring-{ring}")
            print("    ResetProfileState();")
            print(f"    SetCurrentACR({ring});")
            if field_by_name(row, "SrcL") is not None:
                print("    WriteGPR(5, Zeros{PTO_XLEN} + 0x1000);")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Rejected;"
            )
            print("    assert _LastFault == Fault_IllegalInstruction;")
            print("    assert _TLBEpoch == 0;")
            control_case_index += 1

    for mnemonic in ("TLB.IV", "TLB.IAV"):
        row = scalar_sys_by_mnemonic[mnemonic]
        witness = scalar_sys_witness(row, family_constraints, {"SrcL": 5})
        for label, value, legal in (
            ("zero", 0, True),
            ("positive-max", 0x00007FFFFFFFFFFF, True),
            ("negative-min", 0xFFFF800000000000, True),
            ("positive-overflow", 0x0000800000000000, False),
            ("negative-underflow", 0xFFFF7FFFFFFFFFFF, False),
        ):
            print(f"    // SYS-S4 tlb-operand/{row['form_id']}/{label}")
            print("    ResetProfileState();")
            print(f"    WriteGPR(5, {bit_literal(value, 64)});")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                + (
                    "ScalarExecution_Executed;"
                    if legal
                    else "ScalarExecution_Rejected;"
                )
            )
            print(f"    assert _TLBEpoch == {1 if legal else 0};")
            control_case_index += 1

    tlb_ia_row = scalar_sys_by_mnemonic["TLB.IA"]
    tlb_ia_witness = scalar_sys_witness(tlb_ia_row, family_constraints, {"SrcL": 5})
    for label, value, legal in (
        ("zero", 0, True),
        ("asid-max", 0xFFFF, True),
        ("high-bit", 0x10000, False),
    ):
        print(f"    // SYS-S4 tlb-operand/{tlb_ia_row['form_id']}/{label}")
        print("    ResetProfileState();")
        print(f"    WriteGPR(5, Zeros{{PTO_XLEN}} + {value});")
        print(
            f"    let scalar_sys_control_status_{control_case_index} = "
            f"ExecuteScalarInstruction({bit_literal(tlb_ia_witness, 48)}, 32);"
        )
        print(
            f"    assert scalar_sys_control_status_{control_case_index} == "
            + ("ScalarExecution_Executed;" if legal else "ScalarExecution_Rejected;")
        )
        print(f"    assert _TLBEpoch == {1 if legal else 0};")
        control_case_index += 1

    cache_operand_rows = [
        row
        for row in operand_maintenance_rows
        if scalar_sys_effect_class(row) == "scalar-cache-maintenance"
    ]
    if len(cache_operand_rows) != 9:
        raise ValueError("operand-bearing cache-maintenance inventory drift")
    for row in cache_operand_rows:
        witness = scalar_sys_witness(row, family_constraints, {"SrcL": 5})
        operation = asl_identifier(row["mnemonic"])
        for label, value in (("zero", 0), ("ones", (1 << 64) - 1)):
            print(f"    // SYS-S4 cache-operand/{row['form_id']}/{label}")
            print("    ResetProfileState();")
            print(f"    WriteGPR(5, {bit_literal(value, 64)});")
            print(
                f"    let scalar_sys_control_status_{control_case_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, 32);"
            )
            print(
                f"    assert scalar_sys_control_status_{control_case_index} == "
                "ScalarExecution_Executed;"
            )
            print(f"    assert _LastMaintenanceOperation == Maintenance_{operation};")
            print(f"    assert _LastMaintenanceOperand == {bit_literal(value, 64)};")
            control_case_index += 1

    if control_case_index != scalar_sys_control_totality_case_count:
        raise ValueError(
            "SYS control/maintenance totality emission drift: "
            f"expected {scalar_sys_control_totality_case_count}, got "
            f"{control_case_index}"
        )
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalCommandExecution()")
    print("begin")
    for index, row in enumerate(command):
        witness_value = command_witnesses[index]
        witness = bit_literal(witness_value, 64)
        handler = row["semantic_handler"]
        print("    ResetProfileState();")
        if handler == "ExecuteBundleStop":
            print(
                "    BeginBundle(BundleKind_Standard, BundleTransfer_Direct, "
                "Zeros{PTO_XLEN}, Zeros{PTO_XLEN} + 4, Zeros{PTO_XLEN} + 4, TRUE);"
            )
            print("    ClearFault();")
        print(
            f"    let command_status_{index} = ExecuteCommandInstruction("
            f"{witness}, {row['length_bits']});"
        )
        rejected = command_execution_rejected(row)
        rejected_start = handler == "ExecuteBundleStart" and rejected
        if rejected:
            print(f"    assert command_status_{index} == CommandExecution_Rejected;")
            print("    assert _LastFault == Fault_IllegalInstruction;")
            print("    assert ReadTPC() == Zeros{PTO_XLEN};")
            if rejected_start:
                print("    assert !_BundleOperation.valid;")
        else:
            print(f"    assert command_status_{index} == CommandExecution_Executed;")
            print("    assert _LastFault == Fault_None;")
            if handler == "ExecuteBundleStop":
                print("    assert ReadTPC() == Zeros{PTO_XLEN};")
            else:
                print(
                    "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                    f"{row['length_bits'] // 8};"
                )
            if handler == "SetBundleArgument":
                print(
                    "    assert _BundleArgumentKind == "
                    f"{bit_literal(BUNDLE_ARGUMENT_KINDS[row['asm']], 3)};"
                )
            if handler == "SetBundleHint":
                print(f"    assert _LastBundleHintPayload == {witness};")
        if handler == "ExecuteBundleStart" and not rejected_start:
            operation_class = command_bundle_operation_class(row)
            selector = command_bundle_selector(row, tile_selectors)
            print("    assert _BundleOperation.valid;")
            print(f"    assert _BundleOperation.form_identity == Zeros{{7}} + {index};")
            print(
                "    assert _BundleOperation.operation_class == "
                f"BundleOperation_{operation_class};"
            )
            selector_field = next(
                (
                    name
                    for name in ("TileOpcode", "Function")
                    if any(field["name"] == name for field in row["fields"])
                ),
                None,
            )
            if selector_field is not None:
                selector_value = decode_field(row, selector_field, witness_value)
                print("    assert _BundleOperation.selector_valid;")
                print(
                    "    assert _BundleOperation.selector == "
                    f"Zeros{{10}} + {selector_value};"
                )
            elif selector is not None:
                print("    assert _BundleOperation.selector_valid;")
                print(
                    f"    assert _BundleOperation.selector == Zeros{{10}} + {selector};"
                )
            else:
                print("    assert !_BundleOperation.selector_valid;")
            for field_name, valid_name, value_name, width in (
                ("DataType", "data_type_valid", "data_type", 5),
                ("Mode", "mode_valid", "mode", 2),
                ("BrType", "branch_type_valid", "branch_type", 3),
            ):
                present = any(field["name"] == field_name for field in row["fields"])
                if present:
                    value = decode_field(row, field_name, witness_value)
                    print(f"    assert _BundleOperation.{valid_name};")
                    print(
                        f"    assert _BundleOperation.{value_name} == "
                        f"Zeros{{{width}}} + {value};"
                    )
                else:
                    print(f"    assert !_BundleOperation.{valid_name};")
    variant_case = 0
    for row in command:
        for variant in row.get("encoding_variants", []):
            instruction = 0
            for part in variant["encoding"]:
                instruction |= int(part["match"], 16) << (part["index"] * 32)
            print("    ResetProfileState();")
            print(
                f"    let command_variant_status_{variant_case} = ExecuteCommandInstruction("
                f"{bit_literal(instruction, 64)}, {row['length_bits']});"
            )
            print(
                f"    assert command_variant_status_{variant_case} == "
                "CommandExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print("    assert _BundleOperation.valid;")
            print(
                "    assert _BundleOperation.selector == Zeros{10} + "
                f"{variant['function']};"
            )
            variant_case += 1
    print("end;")
    print()
    print("pure func ScalarFamilyOfForm(form: integer {0..PTO_SCALAR_FORM_COUNT-1})")
    print("                             => ScalarSemanticFamily")
    print("begin")
    for index, row in enumerate(scalar):
        print(
            f"    if form == {index} then return ScalarSemantic_{row['semantic_family']}; end;"
        )
    print("    unreachable;")
    print("end;")
    print()
    print("pure func SystemRegisterAccessOf(address: SystemRegisterAddress)")
    print("                                 => SystemRegisterAccess")
    print("begin")
    access_names = {
        "RO": "ReadOnly",
        "WO": "WriteOnly",
        "RW": "ReadWrite",
    }
    for row in system_registers:
        access = access_names[row["access"]]
        if row["scope"] == "base":
            condition = f"address == {bit_literal(int(row['address'], 0), 24)}"
        else:
            low_index = int(row["low_index"], 0)
            if "fixed_context" in row:
                address = (row["fixed_context"] << 12) | low_index
                condition = f"address == {bit_literal(address, 24)}"
            else:
                condition = (
                    f"address[23:16] == Zeros{{8}} && "
                    f"address[11:0] == {bit_literal(low_index, 12)}"
                )
        print(f"    if {condition} then return SystemRegisterAccess_{access}; end;")
    print("    return SystemRegisterAccess_Unknown;")
    print("end;")
    print()
    print("// PTO-REQ-SCALAR-SSR-001: generated reset and access witnesses for")
    print("// every visible register and every addressable ACR bank.")
    print("func ValidateSystemRegisterResetAndAccess()")
    print("begin")
    print("    ResetProfileState();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    reset_witnessed_behaviors: set[str] = set()
    for row_index, row in enumerate(system_registers):
        behavior = system_register_behaviors[row["name"]]
        expected = system_register_reset_expression(behavior)
        addresses = system_register_addresses(row)
        if behavior["read"] == "reject-write-only":
            for address in addresses:
                if row["scope"] == "base":
                    raise ValueError("write-only base register lacks reset backing")
                if behavior["id"] not in reset_witnessed_behaviors:
                    print(f"    // SYSREG-WITNESS class/{behavior['id']}/reset")
                    reset_witnessed_behaviors.add(behavior["id"])
                print(
                    f"    assert _ExtendedSystemRegisters[[{address}]] == {expected};"
                )
            continue
        for address_index, address in enumerate(addresses):
            print(
                f"    let reset_value_{row_index}_{address_index} = "
                f"ReadSystemRegisterAddress({bit_literal(address, 24)});"
            )
            if behavior["id"] not in reset_witnessed_behaviors:
                print(f"    // SYSREG-WITNESS class/{behavior['id']}/reset")
                reset_witnessed_behaviors.add(behavior["id"])
            print(f"    assert reset_value_{row_index}_{address_index} == {expected};")
            print("    assert _LastFault == Fault_None;")
    print("    ResetProfileState();")
    print("    SetCurrentACR(0);")
    print("    ClearFault();")
    access_witnessed_behaviors: set[str] = set()
    for row_index, row in enumerate(system_registers):
        behavior = system_register_behaviors[row["name"]]
        addresses = system_register_addresses(row)
        canonical_address = addresses[0]
        first_behavior_access = behavior["id"] not in access_witnessed_behaviors
        if behavior["read"] == "reject-write-only":
            print(
                f"    - = ReadSystemRegisterAddress({bit_literal(canonical_address, 24)});"
            )
            if first_behavior_access:
                print(f"    // SYSREG-WITNESS class/{behavior['id']}/access")
                for effect in behavior["side_effects"]:
                    print(
                        f"    // SYSREG-WITNESS effect/{behavior['id']}/"
                        f"{re.sub(r'[^a-z0-9]+', '-', effect.lower()).strip('-')}"
                    )
            print("    assert _LastFault == Fault_IllegalInstruction;")
            print("    ClearFault();")
        elif row["access"] == "RO":
            print(
                f"    let readonly_before_{row_index} = "
                f"ReadSystemRegisterAddress({bit_literal(canonical_address, 24)});"
            )
            print(
                f"    WriteSystemRegisterAddress({bit_literal(canonical_address, 24)}, "
                "Ones{PTO_XLEN});"
            )
            print("    assert _LastFault == Fault_IllegalInstruction;")
            print("    ClearFault();")
            print(
                f"    let readonly_after_{row_index} = "
                f"ReadSystemRegisterAddress({bit_literal(canonical_address, 24)});"
            )
            if first_behavior_access:
                print(f"    // SYSREG-WITNESS class/{behavior['id']}/access")
                for effect in behavior["side_effects"]:
                    print(
                        f"    // SYSREG-WITNESS effect/{behavior['id']}/"
                        f"{re.sub(r'[^a-z0-9]+', '-', effect.lower()).strip('-')}"
                    )
            print(
                f"    assert readonly_after_{row_index} == readonly_before_{row_index};"
            )
            print("    assert _LastFault == Fault_None;")
        else:
            if row["name"] == "CORE_STATE":
                write_value = 0x100
            elif behavior["write"] == "unpack-trap-status":
                write_value = 4
            else:
                write_value = 0x100 + row_index
            print(
                f"    WriteSystemRegisterAddress({bit_literal(canonical_address, 24)}, "
                f"Zeros{{PTO_XLEN}} + {write_value});"
            )
            print("    assert _LastFault == Fault_None;")
            print(
                f"    let written_value_{row_index} = "
                f"ReadSystemRegisterAddress({bit_literal(canonical_address, 24)});"
            )
            if first_behavior_access:
                print(f"    // SYSREG-WITNESS class/{behavior['id']}/access")
                for effect in behavior["side_effects"]:
                    print(
                        f"    // SYSREG-WITNESS effect/{behavior['id']}/"
                        f"{re.sub(r'[^a-z0-9]+', '-', effect.lower()).strip('-')}"
                    )
            print(
                f"    assert written_value_{row_index} == Zeros{{PTO_XLEN}} + {write_value};"
            )
            print("    assert _LastFault == Fault_None;")
        if first_behavior_access:
            access_witnessed_behaviors.add(behavior["id"])
    print("    ResetProfileState();")
    print("end;")
    print()
    print("pure func ScalarOperationOfForm(form: integer {0..PTO_SCALAR_FORM_COUNT-1})")
    print("                                => ScalarOperation")
    print("begin")
    for index, operation in enumerate(scalar_operations):
