    print("pure func DecodeScalarOperandRaw(instruction: bits(48),")
    print(
        "                                 form: integer {0..PTO_SCALAR_FORM_COUNT-1},"
    )
    print("                                 field: ScalarOperandField) => bits(48)")
    print("begin")
    for index, row in enumerate(scalar):
        for field in row["fields"]:
            print(
                f"    if form == {index} && field == ScalarField_{field['name']} then"
            )
            print("        var value = Zeros{48};")
            for piece in field["pieces"]:
                print(
                    f"        value[{piece['value_lsb']} +: {piece['width']}] = "
                    f"instruction[{piece['instruction_lsb']} +: {piece['width']}];"
                )
            print("        return value;")
            print("    end;")
    print("    return Zeros{48};")
    print("end;")
    print()
    print("pure func ScalarFormOperandsLegal(instruction: bits(48),")
    print(
        "                                  form: integer {0..PTO_SCALAR_FORM_COUNT-1}) => boolean"
    )
    print("begin")
    for index, row in enumerate(scalar):
        for constraint in row["constraints"]:
            if constraint["operator"] != "not-equal":
                raise ValueError(
                    f"unsupported scalar operand constraint: {constraint!r}"
                )
            print(
                f"    if form == {index} && DecodeScalarOperandRaw(instruction, form, "
                f"ScalarField_{constraint['field']}) == {bit_literal(constraint['value'], 48)} "
                "then return FALSE; end;"
            )
        for constraint in family_constraints:
            if not family_constraint_applies(row, constraint):
                continue
            if constraint["operator"] != "fields-not-equal":
                raise ValueError(
                    f"unsupported scalar family constraint: {constraint!r}"
                )
            print(
                f"    if form == {index} && DecodeScalarOperandRaw(instruction, form, "
                f"ScalarField_{constraint['left_field']}) == "
                "DecodeScalarOperandRaw(instruction, form, "
                f"ScalarField_{constraint['right_field']}) then return FALSE; end;"
            )
    print("    return TRUE;")
    print("end;")
    print()
    print("readonly func ScalarRegisterOperandsLegal(")
    print("    instruction: bits(48),")
    print("    form: integer {0..PTO_SCALAR_FORM_COUNT-1}) => boolean")
    print("begin")
    for index, row in enumerate(scalar):
        for field in row["fields"]:
            name = field["name"]
            if name in SCALAR_SOURCE_FIELDS:
                predicate = "ScalarSourceSelectorLegal"
            elif name in SCALAR_DESTINATION_FIELDS:
                predicate = "ScalarDestinationSelectorLegal"
            else:
                continue
            print(
                f"    if form == {index} && !{predicate}(UInt("
                f"DecodeScalarOperandRaw(instruction, form, ScalarField_{name})[4:0]) "
                "as Reg5Selector) then return FALSE; end;"
            )
    print("    return TRUE;")
    print("end;")
    print()
