    print(
        f"constant PTO_SCALAR_SYS_STAGE4_CASE_COUNT = {scalar_sys_stage4_case_count};"
    )
    print(f"constant PTO_SCALAR_AGU_EFFECT_FORM_COUNT = {len(scalar_agu_effect_rows)};")
    print(
        "constant PTO_SCALAR_AGU_TOTALITY_CASE_COUNT = "
        f"{scalar_agu_totality_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_IMMEDIATE_BOUNDARY_CASE_COUNT = "
        f"{scalar_agu_immediate_boundary_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_SRCRTYPE_CASE_COUNT = "
        f"{scalar_agu_src_r_type_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_SHAMT_BOUNDARY_CASE_COUNT = "
        f"{scalar_agu_shamt_boundary_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_PREFETCH_MODEL_CASE_COUNT = "
        f"{scalar_agu_prefetch_model_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_ADDRESS_WRAP_CASE_COUNT = "
        f"{len(scalar_agu_effect_rows)};"
    )
    print(
        "constant PTO_SCALAR_AGU_FAULT_PRECEDENCE_CASE_COUNT = "
        f"{scalar_agu_fault_precedence_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_PERMISSION_CASE_COUNT = "
        f"{scalar_agu_permission_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_PAIR_PREFLIGHT_CASE_COUNT = "
        f"{scalar_agu_pair_preflight_case_count};"
    )
    print(
        f"constant PTO_SCALAR_AGU_RESTART_CASE_COUNT = {scalar_agu_restart_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_PREFETCH_INVALID_CASE_COUNT = "
        f"{scalar_agu_prefetch_invalid_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_PREFETCH_RETURN_WRAP_CASE_COUNT = "
        f"{scalar_agu_prefetch_return_wrap_case_count};"
    )
    print(f"constant PTO_SCALAR_AGU_ALIAS_CASE_COUNT = {scalar_agu_alias_case_count};")
    print(
        "constant PTO_SCALAR_AGU_TEMP_SOURCE_CASE_COUNT = "
        f"{scalar_agu_temp_source_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_DESTINATION_SPECIAL_CASE_COUNT = "
        f"{scalar_agu_destination_special_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_PAIR_DESTINATION_ORDER_CASE_COUNT = "
        f"{scalar_agu_pair_destination_order_case_count};"
    )
    print(
        "constant PTO_SCALAR_AGU_STORE_SOURCE_SNAPSHOT_CASE_COUNT = "
        f"{scalar_agu_store_source_snapshot_case_count};"
    )
    print(
        f"constant PTO_ENCODED_INSTRUCTION_FORM_COUNT = {len(scalar) + len(command)};"
    )
    print(f"constant PTO_TILE_OPERATION_COUNT = {len(tile)};")
    print(f"constant PTO_SYSTEM_REGISTER_DEFINITION_COUNT = {len(system_registers)};")
    print(f"constant PTO_SCALAR_SEMANTIC_HANDLER_COUNT = {len(scalar_handlers)};")
    print(f"constant PTO_TILE_SEMANTIC_HANDLER_COUNT = {len(tile_handlers)};")
    print("type ScalarFormIndex of integer {0..PTO_SCALAR_FORM_COUNT};")
    print("type TileOperationIndex of integer {0..PTO_TILE_OPERATION_COUNT};")
    print("type TileDecodeFamily of enumeration {")
    print("    TileDecode_TEPL, TileDecode_TMA, TileDecode_CUBE")
    print("};")
    print("type ScalarSemanticFamily of enumeration {")
    print("    ScalarSemantic_AGU, ScalarSemantic_ALU, ScalarSemantic_AMO,")
    print("    ScalarSemantic_BRU, ScalarSemantic_FSU, ScalarSemantic_SYS")
    print("};")
    emit_enum("ScalarOperation", scalar_operations)
    emit_enum(
        "ScalarSemanticHandler", [f"ScalarHandler_{name}" for name in scalar_handlers]
    )
    emit_enum("TileOperation", tile_operations)
    emit_enum("TileSemanticHandler", [f"TileHandler_{name}" for name in tile_handlers])
    emit_enum(
        "TileDATRField",
        [f"TileDATRField_{name}" for name in TILE_DATR_FIELD_ORDER],
    )
    emit_enum(
        "TileDATRPadUnion",
        [
            "TileDATRPadUnion_PadValue",
            "TileDATRPadUnion_HistogramByteId",
            "TileDATRPadUnion_MustZero",
        ],
    )
    emit_enum(
        "TileOperandField", [f"TileOperand_{name}" for name in tile_operand_fields], 4
    )
    emit_enum(
        "ScalarOperandField", [f"ScalarField_{name}" for name in operand_fields], 4
    )
    print("type ScalarFieldSignedness of enumeration {")
    print("    ScalarField_EncodingDefined, ScalarField_Signed, ScalarField_Unsigned")
    print("};")
    print()
    tile_selectors = {
        row["name"]: int(row.get("selector", row.get("function")), 0)
        if isinstance(row.get("selector", row.get("function")), str)
        else row.get("selector", row.get("function"))
        for row in tile
    }
    command_witnesses = encoded_catalog_witnesses(command)
    emit_encoded_catalog("Command", command, tile_selectors, command_witnesses)
    print("pure func DecodeScalarForm(instruction: bits(48),")
    print(
        "                           length_bits: integer {16,32,48}) => ScalarFormIndex"
    )
    print("begin")
    ordered = sorted(
        enumerate(scalar),
        key=lambda pair: (
            -bin(int(pair[1]["encoding"][0]["mask"], 16)).count("1"),
            pair[1]["form_id"],
        ),
    )
    for index, row in ordered:
        encoding = row["encoding"][0]
        mask = bit_literal(int(encoding["mask"], 16), 48)
        match = bit_literal(int(encoding["match"], 16), 48)
        print(
            f"    if length_bits == {row['length_bits']} && "
            f"(instruction AND {mask}) == {match} then return {index}; end;"
        )
    print("    return PTO_SCALAR_FORM_COUNT;")
    print("end;")
    print()
    print("func ValidateCanonicalScalarExecution()")
    print("begin")
    execution_witness_index = 0
    for row in scalar:
        if row["semantic_family"] not in EXECUTABLE_SCALAR_FAMILIES:
            continue
        match = bit_literal(legal_scalar_witness(row, family_constraints), 48)
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    WriteTPC(Zeros{PTO_XLEN});")
        print("    WriteBPC(Zeros{PTO_XLEN});")
        print("    _CommitArgument = Zeros{PTO_XLEN};")
        if row["mnemonic"] == "ACRC":
            print("    SetCurrentACR(2);")
        if row["mnemonic"] == "ACRE":
            print("    SaveTrapContext(0, 0);")
            print("    ClearFault();")
        print(
            f"    let execution_status_{execution_witness_index} = "
            f"ExecuteScalarInstruction({match}, {row['length_bits']});"
        )
        expected_fault = CANONICAL_EXECUTION_FAULTS.get(row["mnemonic"], "Fault_None")
        expected_status = (
            "ScalarExecution_Executed"
            if expected_fault == "Fault_None"
            else "ScalarExecution_Rejected"
        )
        print(
            f"    assert execution_status_{execution_witness_index} "
            f"== {expected_status};"
        )
        print(f"    assert _LastFault == {expected_fault};")
        execution_witness_index += 1
    print("    ClearFault();")
    print(
        f"    let rejected_status = ExecuteScalarInstruction({bit_literal(0, 48)}, 32);"
    )
    print("    assert rejected_status == ScalarExecution_Rejected;")
    print("    assert _LastFault == Fault_IllegalInstruction;")
    print("end;")
    print()
    print("func ValidateCanonicalScalarBinaryEffects()")
    print("begin")
    print("    ResetProfileState();")
    for effect_index, row in enumerate(scalar_binary_effect_rows):
        metadata = scalar_binary_effect_metadata(row)
        if metadata is None:
            raise ValueError(f"missing scalar binary metadata: {row['form_id']}")
        operation, word_operation = metadata
        (
            witness,
            source_setup,
            left_expression,
            right_expression,
            destination_expression,
        ) = scalar_binary_effect_witness(row, family_constraints)
        value_function = "ScalarBinaryW" if word_operation else "ScalarBinary"
        print(f"    // {row['form_id']}: {row['mnemonic']}")
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(source_setup)
        print(f"    WriteGPR(2, {right_expression});")
        if not row["mnemonic"].startswith("C."):
            print("    WriteGPR(3, Zeros{PTO_XLEN} + 0x55);")
        print(
            f"    let scalar_binary_status_{effect_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
            f"{row['length_bits']});"
        )
        print(
            f"    assert scalar_binary_status_{effect_index} == "
            "ScalarExecution_Executed;"
        )
        print("    assert _LastFault == Fault_None;")
        print(
            f"    assert {destination_expression} == {value_function}("
            f"{operation}, {left_expression}, {right_expression});"
        )
        print(
            "    assert ReadTPC() == Zeros{PTO_XLEN} + "
            f"{0x100 + row['length_bits'] // 8};"
        )
        print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
        if row["mnemonic"] in {"C.SLLI", "C.SRLI"}:
            print(f"    assert ReadTemporaryQueue(TRUE, 1) == {left_expression};")
        elif field_by_name(row, "SrcL") is not None:
            print(f"    assert ReadGPR(1) == {left_expression};")
        if field_by_name(row, "SrcR") is not None:
            print(f"    assert ReadGPR(2) == {right_expression};")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarAGUEffects()")
    print("begin")
    print("    ResetProfileState();")
    for effect_index, row in enumerate(scalar_agu_effect_rows):
        if scalar_agu_effect_class(row) is None:
            raise ValueError(f"missing AGU effect metadata: {row['form_id']}")
        emit_scalar_agu_success(row, family_constraints, effect_index)
        emit_scalar_agu_fault(row, family_constraints, effect_index)
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarAGUTotality()")
    print("begin")
    print("    ResetProfileState();")
    agu_totality_case_index = 0
    for row in scalar_agu_effect_rows:
        for label, raw_value, expected_offset in scalar_agu_immediate_boundary_cases(
            row
        ):
            emit_scalar_agu_immediate_boundary_case(
                row,
                family_constraints,
                agu_totality_case_index,
                label,
                raw_value,
                expected_offset,
            )
            agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if field_by_name(row, "SrcRType") is None:
            continue
        for src_r_type in SCALAR_AGU_SRC_R_TYPE_VALUES:
            emit_scalar_agu_register_modifier_case(
                row, family_constraints, agu_totality_case_index, src_r_type
            )
            agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if field_by_name(row, "shamt") is None:
            continue
        for shamt in SCALAR_AGU_SHAMT_BOUNDARY_VALUES:
            emit_scalar_agu_shamt_boundary_case(
                row, family_constraints, agu_totality_case_index, shamt
            )
            agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if field_by_name(row, "model") is None:
            continue
        for model in SCALAR_AGU_PREFETCH_MODEL_VALUES:
            emit_scalar_agu_prefetch_model_case(
                row, family_constraints, agu_totality_case_index, model
            )
            agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        print(f"    // AGU-ADDRESS-WRAP-DECODED: {row['form_id']}")
        emit_scalar_agu_wrap_case(row, family_constraints, agu_totality_case_index)
        agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] == "Prefetch":
            continue
        precedence_label = (
            "alignment"
            if agu_metadata(row)["size_bytes"] > 1
            and agu_metadata(row)["address_kind"] != "PCRelative"
            else "page"
        )
        if (
            agu_metadata(row)["size_bytes"] == 8
            and agu_metadata(row)["address_kind"] == "PCRelative"
        ):
            precedence_label = "alignment"
        precedence_address = (
            4100
            if precedence_label == "alignment"
            and agu_metadata(row)["address_kind"] == "PCRelative"
            else 4097
            if precedence_label == "alignment"
            else 4096
        )
        emit_scalar_agu_page_precedence_case(
            row,
            family_constraints,
            agu_totality_case_index,
            precedence_label,
            0,
            precedence_address,
        )
        agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] == "Prefetch":
            continue
        emit_scalar_agu_page_precedence_case(
            row,
            family_constraints,
            agu_totality_case_index,
            "acr2-permission",
            2,
            3072,
        )
        agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] not in {"LoadPair", "StorePair"}:
            continue
        emit_scalar_agu_pair_preflight_case(
            row, family_constraints, agu_totality_case_index, True
        )
        agu_totality_case_index += 1
        emit_scalar_agu_pair_preflight_case(
            row, family_constraints, agu_totality_case_index, False
        )
        agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] == "Prefetch":
            continue
        emit_scalar_agu_restart_case(row, family_constraints, agu_totality_case_index)
        agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] != "Prefetch":
            continue
        emit_scalar_agu_prefetch_invalid_case(
            row, family_constraints, agu_totality_case_index
        )
        agu_totality_case_index += 1
    for row in scalar_agu_effect_rows:
        if not agu_metadata(row)["prefetch_returns_address"]:
            continue
        for high in (False, True):
            emit_scalar_agu_prefetch_return_wrap_case(
                row, family_constraints, agu_totality_case_index, high
            )
            agu_totality_case_index += 1
    if agu_totality_case_index != scalar_agu_totality_case_count:
        raise ValueError("scalar AGU totality count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarAGUAliases()")
    print("begin")
    print("    ResetProfileState();")
    agu_alias_case_index = 0
    for row in scalar_agu_effect_rows:
        for field in row["fields"]:
            if field["name"] not in {"SrcL", "SrcR", "SrcD", "SrcD1"}:
                continue
            for selector in SCALAR_AGU_TEMP_SOURCE_SELECTORS:
                emit_scalar_agu_source_alias_case(
                    row,
                    family_constraints,
                    agu_alias_case_index,
                    field["name"],
                    selector,
                )
                agu_alias_case_index += 1
    for row in scalar_agu_effect_rows:
        for field in row["fields"]:
            if field["name"] not in {"RegDst", "RegDst0", "RegDst1"}:
                continue
            for selector in SCALAR_AGU_DESTINATION_SPECIAL_SELECTORS:
                emit_scalar_agu_destination_alias_case(
                    row,
                    family_constraints,
                    agu_alias_case_index,
                    field["name"],
                    selector,
                )
                agu_alias_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] == "LoadPair":
            for label in ("same-gpr", "t-t", "u-u", "t-u", "u-t"):
                emit_scalar_agu_load_pair_alias_case(
                    row, family_constraints, agu_alias_case_index, label
                )
                agu_alias_case_index += 1
    for row in scalar_agu_effect_rows:
        if agu_metadata(row)["action"] == "StorePair":
            for lane in ("same-gpr", "t-t", "u-u"):
                emit_scalar_agu_store_pair_alias_case(
                    row, family_constraints, agu_alias_case_index, lane
                )
                agu_alias_case_index += 1
    if agu_alias_case_index != scalar_agu_alias_case_count:
        raise ValueError("scalar AGU alias count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarALUEffects()")
    print("begin")
    print("    ResetProfileState();")
    destination_sentinel = 0x5555555555555555
    control_sentinel = 0xAAAAAAAAAAAAAAAA
    queue_sentinel = 0x7777777777777777
    for effect_index, row in enumerate(scalar_nonbinary_alu_effect_rows):
        class_id = scalar_alu_effect_class(row)
        if class_id is None or class_id == "scalar-binary-value":
            raise ValueError(f"missing non-binary ALU metadata: {row['form_id']}")
        witness = scalar_nonbinary_alu_witness(row, family_constraints)
        left, right, addend, predicate = scalar_nonbinary_alu_sources(class_id)
        mnemonic = row["mnemonic"]
        print(f"    // {row['form_id']}: {mnemonic} [{class_id}]")
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(f"    WriteGPR(1, {bit_literal(left, 64)});")
        print(f"    WriteGPR(2, {bit_literal(right, 64)});")
        print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
        print(f"    WriteGPR(4, {bit_literal(destination_sentinel, 64)});")
        print(f"    WriteGPR(5, {bit_literal(destination_sentinel, 64)});")
        print(f"    WriteGPR(6, {bit_literal(addend, 64)});")
        print(f"    WriteGPR(7, {bit_literal(predicate, 64)});")
        print(f"    WriteGPR(10, {bit_literal(control_sentinel, 64)});")
        print(f"    _CommitArgument = {bit_literal(control_sentinel, 64)};")
        print(f"    _ReturnAddress = {bit_literal(control_sentinel, 64)};")
        if mnemonic.startswith(("C.SEXT.", "C.ZEXT.")):
            print(f"    PushTemporaryQueue(TRUE, {bit_literal(queue_sentinel, 64)});")
        print(
            f"    let scalar_alu_status_{effect_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
            f"{row['length_bits']});"
        )
        print(
            f"    assert scalar_alu_status_{effect_index} == ScalarExecution_Executed;"
        )
        print("    assert _LastFault == Fault_None;")

        if class_id == "scalar-arithmetic-value":
            expected = scalar_arithmetic_expected(mnemonic, left, right, addend)
            print(f"    assert ReadGPR(3) == {bit_literal(expected, 64)};")
        elif class_id == "scalar-pair-value":
            expected_low, expected_high = scalar_pair_expected(
                mnemonic, left, right, addend
            )
            print(f"    assert ReadGPR(4) == {bit_literal(expected_low, 64)};")
            print(f"    assert ReadGPR(5) == {bit_literal(expected_high, 64)};")
            print(f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};")
        elif class_id == "scalar-bitfield-value":
            width = (
                decode_field(row, "imml", witness) + 1
                if field_by_name(row, "imml") is not None
                else 8
            )
            offset_field = "immr" if mnemonic in {"REV", "HL.BFI"} else "imms"
            offset = decode_field(row, offset_field, witness)
            last = (
                decode_field(row, "imms", witness)
                if field_by_name(row, "imms") is not None
                else 7
            )
            expected = scalar_bitfield_expected(
                mnemonic, left, right, width, offset, last
            )
            print(f"    assert ReadGPR(3) == {bit_literal(expected, 64)};")
        elif class_id == "scalar-materialize-value":
            expected = scalar_materialize_expected(mnemonic, left)
            if mnemonic.startswith(("C.SEXT.", "C.ZEXT.")):
                print(
                    f"    assert ReadTemporaryQueue(TRUE, 0) == "
                    f"{bit_literal(expected, 64)};"
                )
                print(
                    f"    assert ReadTemporaryQueue(TRUE, 1) == "
                    f"{bit_literal(queue_sentinel, 64)};"
                )
                print(
                    f"    assert ReadGPR(3) == {bit_literal(destination_sentinel, 64)};"
                )
            else:
                print(f"    assert ReadGPR(3) == {bit_literal(expected, 64)};")
        elif class_id == "scalar-select-value":
            print(f"    assert ReadGPR(3) == {bit_literal(left, 64)};")
        elif class_id == "scalar-control-value":
            if mnemonic == "C.SETC.TGT":
                print(f"    assert _CommitArgument == {bit_literal(left, 64)};")
            elif mnemonic == "C.SETRET":
                print("    assert ReadGPR(10) == Zeros{PTO_XLEN} + 0x106;")
                print("    assert _ReturnAddress == Zeros{PTO_XLEN} + 0x106;")
            else:
                raise ValueError(f"unclassified scalar control effect: {mnemonic}")
        else:
            raise ValueError(f"unhandled scalar ALU effect class: {class_id}")

        print(
            "    assert ReadTPC() == Zeros{PTO_XLEN} + "
            f"{0x100 + row['length_bits'] // 8};"
        )
        print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
        if field_by_name(row, "SrcL") is not None:
            print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
        if field_by_name(row, "SrcR") is not None:
            print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
        if field_by_name(row, "SrcD") is not None:
            print(f"    assert ReadGPR(6) == {bit_literal(addend, 64)};")
        if field_by_name(row, "SrcP") is not None:
            print(f"    assert ReadGPR(7) == {bit_literal(predicate, 64)};")
        if mnemonic != "C.SETC.TGT":
            print(f"    assert _CommitArgument == {bit_literal(control_sentinel, 64)};")
        if mnemonic != "C.SETRET":
            print(f"    assert _ReturnAddress == {bit_literal(control_sentinel, 64)};")
            print(f"    assert ReadGPR(10) == {bit_literal(control_sentinel, 64)};")

        if class_id == "scalar-select-value":
            false_expected = (-right) & MASK64
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print("    WriteGPR(7, Zeros{PTO_XLEN});")
            print(f"    WriteGPR(3, {bit_literal(destination_sentinel, 64)});")
            print(
                "    let scalar_alu_select_false_status = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                "    assert scalar_alu_select_false_status == ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print(f"    assert ReadGPR(3) == {bit_literal(false_expected, 64)};")
            print(
                "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                f"{0x100 + row['length_bits'] // 8};"
            )
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
            print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
            print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
            print("    assert ReadGPR(7) == Zeros{PTO_XLEN};")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarALUTotality()")
    print("begin")
    print("    ResetProfileState();")
    boundary_case_index = 0
    for row in scalar_alu_effect_rows:
        for label in scalar_alu_boundary_labels(row):
            emit_scalar_alu_boundary_case(
                row, family_constraints, boundary_case_index, label
            )
            boundary_case_index += 1
    if boundary_case_index != scalar_alu_boundary_case_count:
        raise ValueError("scalar ALU boundary case-count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarBRUEffects()")
    print("begin")
    print("    ResetProfileState();")
    bru_destination_sentinel = 0x5555555555555555
    bru_control_sentinel = 0xAAAAAAAAAAAAAAAA
    bru_queue_sentinel = 0x7777777777777777
    for effect_index, row in enumerate(scalar_bru_effect_rows):
        class_id = scalar_bru_effect_class(row)
        if class_id is None:
            raise ValueError(f"missing BRU effect metadata: {row['form_id']}")
        mnemonic = row["mnemonic"]
        witness = scalar_bru_effect_witness(row, family_constraints)
        dual_outcome = class_id in {
            "scalar-branch-control",
            "scalar-commit-value",
            "scalar-compare-value",
        }
        scenarios = (True, False) if dual_outcome else (True,)
        print(f"    // {row['form_id']}: {mnemonic} [{class_id}]")
        for scenario_index, desired in enumerate(scenarios):
            left, right, branch_predicate = scalar_bru_scenario(row, desired)
            print("    SetCurrentACR(0);")
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print(f"    WriteGPR(1, {bit_literal(left, 64)});")
            print(f"    WriteGPR(2, {bit_literal(right, 64)});")
            print(f"    WriteGPR(3, {bit_literal(bru_destination_sentinel, 64)});")
            print(f"    WriteGPR(10, {bit_literal(bru_control_sentinel, 64)});")
            print(f"    _ReturnAddress = {bit_literal(bru_control_sentinel, 64)};")
            print(
                f"    _CommitArgument = {bit_literal(branch_predicate, 64)};"
                if mnemonic in {"B.Z", "B.NZ"}
                else f"    _CommitArgument = {bit_literal(bru_control_sentinel, 64)};"
            )
            if mnemonic in {"C.CMP.EQI", "C.CMP.NEI"}:
                print(
                    f"    PushTemporaryQueue(TRUE, "
                    f"{bit_literal(bru_queue_sentinel, 64)});"
                )
                print(f"    PushTemporaryQueue(TRUE, {bit_literal(left, 64)});")
            print(
                f"    let scalar_bru_status_{effect_index}_{scenario_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_bru_status_{effect_index}_{scenario_index} == "
                "ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")

            if class_id == "scalar-compare-value":
                expected = 1 if desired else 0
                if mnemonic in {"C.CMP.EQI", "C.CMP.NEI"}:
                    print(
                        f"    assert ReadTemporaryQueue(TRUE, 0) == "
                        f"{bit_literal(expected, 64)};"
                    )
                    print(
                        f"    assert ReadTemporaryQueue(TRUE, 1) == "
                        f"{bit_literal(left, 64)};"
                    )
                    print(
                        f"    assert ReadTemporaryQueue(TRUE, 2) == "
                        f"{bit_literal(bru_queue_sentinel, 64)};"
                    )
                    print(
                        f"    assert ReadGPR(3) == "
                        f"{bit_literal(bru_destination_sentinel, 64)};"
                    )
                else:
                    print(f"    assert ReadGPR(3) == {bit_literal(expected, 64)};")
                print(
                    "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                    f"{0x100 + row['length_bits'] // 8};"
                )
            elif class_id == "scalar-commit-value":
                expected = 1 if desired else 0
                print(f"    assert _CommitArgument == {bit_literal(expected, 64)};")
                print(
                    f"    assert ReadGPR(3) == "
                    f"{bit_literal(bru_destination_sentinel, 64)};"
                )
                print(
                    "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                    f"{0x100 + row['length_bits'] // 8};"
                )
            elif class_id == "scalar-branch-control":
                target = 0x106 if desired else 0x104
                print(f"    assert ReadTPC() == Zeros{{PTO_XLEN}} + 0x{target:x};")
                print(
                    f"    assert ReadGPR(3) == "
                    f"{bit_literal(bru_destination_sentinel, 64)};"
                )
            elif class_id == "scalar-jump-control":
                target = 0x206 if mnemonic == "JR" else 0x106
                print(f"    assert ReadTPC() == Zeros{{PTO_XLEN}} + 0x{target:x};")
            elif class_id == "scalar-pc-relative-value":
                print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 0x106;")
                print(
                    "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                    f"{0x100 + row['length_bits'] // 8};"
                )
            elif class_id == "scalar-return-address":
                print("    assert ReadGPR(10) == Zeros{PTO_XLEN} + 0x106;")
                print("    assert _ReturnAddress == Zeros{PTO_XLEN} + 0x106;")
                print(
                    "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                    f"{0x100 + row['length_bits'] // 8};"
                )
            else:
                raise ValueError(f"unhandled scalar BRU effect class: {class_id}")

            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
            if field_by_name(row, "SrcL") is not None:
                print(f"    assert ReadGPR(1) == {bit_literal(left, 64)};")
            if field_by_name(row, "SrcR") is not None:
                print(f"    assert ReadGPR(2) == {bit_literal(right, 64)};")
            if class_id not in {"scalar-commit-value", "scalar-branch-control"}:
                print(
                    f"    assert _CommitArgument == "
                    f"{bit_literal(bru_control_sentinel, 64)};"
                )
            if class_id != "scalar-return-address":
                print(
                    f"    assert _ReturnAddress == "
                    f"{bit_literal(bru_control_sentinel, 64)};"
                )
                print(
                    f"    assert ReadGPR(10) == "
                    f"{bit_literal(bru_control_sentinel, 64)};"
                )

        if mnemonic == "JR":
            print("    SetCurrentACR(0);")
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print("    WriteGPR(1, Zeros{PTO_XLEN} + 0x201);")
            print(
                "    let scalar_bru_jr_alignment_status = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                "    assert scalar_bru_jr_alignment_status == ScalarExecution_Rejected;"
            )
            print("    assert _LastFault == Fault_InstructionPC;")
            print("    assert _FaultAddress == Zeros{PTO_XLEN} + 0x207;")
            print("    assert _TrapContexts[[0]].valid;")
            print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")
            print("    assert ReadGPR(1) == Zeros{PTO_XLEN} + 0x201;")
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
        if mnemonic in {"B.Z", "B.NZ"}:
            for bundle_scenario_index, desired in enumerate((True, False)):
                _, _, body_predicate = scalar_bru_scenario(row, desired)
                _, _, outside_predicate = scalar_bru_scenario(row, not desired)
                expected_tpc = 0x106 if desired else 0x104
                print("    ResetBundleControlState();")
                print("    SetCurrentACR(0);")
                print("    ClearFault();")
                print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
                print(f"    _CommitArgument = {bit_literal(outside_predicate, 64)};")
                print(
                    "    BeginBundle(BundleKind_MachineParallel, "
                    "BundleTransfer_Direct, Zeros{PTO_XLEN} + 0x100, "
                    "Zeros{PTO_XLEN} + 0x104, "
                    "Zeros{PTO_XLEN} + 0x104, TRUE);"
                )
                print("    EnterBundleBody();")
                print(
                    f"    WriteExecutionMask({bit_literal(body_predicate, 64)});"
                )
                print(
                    f"    let scalar_bru_bundle_predicate_status_"
                    f"{effect_index}_{bundle_scenario_index} = "
                    f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                    f"{row['length_bits']});"
                )
                print(
                    f"    assert scalar_bru_bundle_predicate_status_"
                    f"{effect_index}_{bundle_scenario_index} == "
                    "ScalarExecution_Executed;"
                )
                print("    assert _LastFault == Fault_None;")
                print(
                    f"    assert ReadTPC() == Zeros{{PTO_XLEN}} + 0x{expected_tpc:x};"
                )
                print("    assert BundleIsActive();")
                print("    assert _BundleBodyActive;")
                print(
                    f"    assert ReadExecutionMask() == "
                    f"{bit_literal(body_predicate, 64)};"
                )
                print(
                    f"    assert _CommitArgument == "
                    f"{bit_literal(outside_predicate, 64)};"
                )
                print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
                print("    ResetBundleControlState();")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarBRUTotality()")
    print("begin")
    print("    ResetProfileState();")
    bru_totality_case_index = 0
    for row in scalar_bru_effect_rows:
        for label in scalar_bru_totality_labels(row):
            emit_scalar_bru_totality_case(
                row, family_constraints, bru_totality_case_index, label
            )
            bru_totality_case_index += 1
    if bru_totality_case_index != scalar_bru_totality_case_count:
        raise ValueError("scalar BRU totality case-count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarBRUAliasAndFaults()")
    print("begin")
    print("    ResetProfileState();")
    emit_scalar_bru_alias_and_faults(scalar_bru_effect_rows, family_constraints)
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarAMOEffects()")
    print("begin")
    print("    ResetProfileState();")
    amo_control_sentinel = 0xAAAAAAAAAAAAAAAA
    amo_source_sentinel = 0x5555555555555555
    for effect_index, row in enumerate(scalar_amo_effect_rows):
        class_id = scalar_amo_effect_class(row)
        if class_id is None:
            raise ValueError(f"missing AMO effect metadata: {row['form_id']}")
        mnemonic = row["mnemonic"]
        witness = scalar_amo_effect_witness(row, family_constraints)
        order = scalar_amo_memory_order(row)
        print(f"    // {row['form_id']}: {mnemonic} [{class_id}]")
        if class_id == "scalar-dma-copy":
            source_address = 0x300
            destination_address = 0x320
            print("    StopMemoryEventCapture();")
            print("    SetCurrentACR(0);")
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print(f"    WriteGPR(1, Zeros{{PTO_XLEN}} + 0x{source_address:x});")
            print(f"    WriteGPR(2, Zeros{{PTO_XLEN}} + 0x{destination_address:x});")
            print(f"    _CommitArgument = {bit_literal(amo_control_sentinel, 64)};")
            print(f"    _ReturnAddress = {bit_literal(amo_control_sentinel, 64)};")
            print("    for dma_byte = 0 to 63 do")
            print(
                f"        Store(Zeros{{PTO_XLEN}} + 0x{source_address:x} + "
                "NaturalToWord(dma_byte as integer {0..262144}), 1, "
                "Zeros{PTO_XLEN} + dma_byte + 1);"
            )
            print("    end;")
            print("    StartMemoryEventCapture(3);")
            print(
                f"    let scalar_amo_status_{effect_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_amo_status_{effect_index} == "
                "ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print("    assert _MemoryEventCount == PTO_MODEL_MEMORY_EVENTS;")
            print("    for dma_event = 0 to 7 do")
            print("        assert _MemoryEvents[[dma_event]].kind == MemoryEvent_Load;")
            print("        assert _MemoryEvents[[dma_event]].agent == 3;")
            print("        assert _MemoryEvents[[dma_event]].size_bytes == 8;")
            print(
                "        assert _MemoryEvents[[dma_event]].order == MemoryOrder_Relaxed;"
            )
            print("    end;")
            print("    for dma_event = 8 to 15 do")
            print(
                "        assert _MemoryEvents[[dma_event]].kind == MemoryEvent_Store;"
            )
            print("        assert _MemoryEvents[[dma_event]].agent == 3;")
            print("        assert _MemoryEvents[[dma_event]].size_bytes == 8;")
            print(
                "        assert _MemoryEvents[[dma_event]].order == MemoryOrder_Relaxed;"
            )
            print("    end;")
            print("    StopMemoryEventCapture();")
            print("    for dma_byte = 0 to 63 do")
            print(
                f"        assert ReadMemoryByte(Zeros{{PTO_XLEN}} + 0x{destination_address:x} + "
                "NaturalToWord(dma_byte as integer {0..262144})) == "
                "Zeros{8} + dma_byte + 1;"
            )
            print("    end;")
            print(f"    assert ReadGPR(1) == Zeros{{PTO_XLEN}} + 0x{source_address:x};")
            print(
                f"    assert ReadGPR(2) == Zeros{{PTO_XLEN}} + 0x{destination_address:x};"
            )
            print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
            print(
                f"    assert _CommitArgument == {bit_literal(amo_control_sentinel, 64)};"
            )
            print(
                f"    assert _ReturnAddress == {bit_literal(amo_control_sentinel, 64)};"
            )
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print(f"    WriteGPR(1, Zeros{{PTO_XLEN}} + 0x{source_address:x});")
            print("    WriteGPR(2, Zeros{PTO_XLEN} + 0xfe0);")
            print("    Store(Zeros{PTO_XLEN} + 0xfd0, 1, Zeros{PTO_XLEN} + 0x77);")
            print("    StartMemoryEventCapture(3);")
            print(
                f"    let scalar_amo_dma_fault_status_{effect_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_amo_dma_fault_status_{effect_index} == "
                "ScalarExecution_Rejected;"
            )
            print("    assert _LastFault == Fault_DataPage;")
            print("    assert _FaultAddress == Zeros{PTO_XLEN} + 0xfe0;")
            print("    assert _MemoryEventCount == 0;")
            print("    StopMemoryEventCapture();")
            print(
                "    assert ReadMemoryByte(Zeros{PTO_XLEN} + 0xfd0) == Zeros{8} + 0x77;"
            )
            print("    assert _TrapContexts[[0]].valid;")
            print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
            continue

        size_bytes = scalar_amo_size_bytes(mnemonic)
        address = 0x480 + effect_index * 16
        old_value = scalar_amo_old_value(size_bytes)
        operand = scalar_amo_operand_value(size_bytes)
        desired = scalar_amo_desired_value(size_bytes)
        old_return = normalize_atomic_return_py(old_value, size_bytes)
        old_unsigned = normalize_atomic_unsigned_py(old_value, size_bytes)
        register2_value = old_unsigned if class_id == "scalar-amo-cas" else operand
        source_left_value = (
            operand if class_id == "scalar-amo-store-conditional" else address
        )
        source_right_value = (
            address if class_id == "scalar-amo-store-conditional" else register2_value
        )
        rmw_result = (
            scalar_amo_rmw_result(mnemonic, old_value, operand, size_bytes)
            if class_id
            in {"scalar-amo-swap", "scalar-amo-load-rmw", "scalar-amo-store-rmw"}
            else 0
        )
        expected_write = desired if class_id == "scalar-amo-cas" else rmw_result
        print("    StopMemoryEventCapture();")
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print(f"    WriteGPR(1, {bit_literal(source_left_value, 64)});")
        print(f"    WriteGPR(2, {bit_literal(source_right_value, 64)});")
        print(f"    WriteGPR(3, {bit_literal(amo_source_sentinel, 64)});")
        print(f"    WriteGPR(4, {bit_literal(desired, 64)});")
        print(f"    WriteGPR(5, {bit_literal(amo_source_sentinel, 64)});")
        print(f"    _CommitArgument = {bit_literal(amo_control_sentinel, 64)};")
        print(f"    _ReturnAddress = {bit_literal(amo_control_sentinel, 64)};")
        print(
            f"    Store(Zeros{{PTO_XLEN}} + 0x{address:x}, {size_bytes}, "
            f"{bit_literal(old_value, 64)});"
        )
        if class_id == "scalar-amo-store-conditional":
            print("    _ReservationValid = TRUE;")
            print(f"    _ReservationAddress = Zeros{{PTO_XLEN}} + 0x{address:x};")
            print(f"    _ReservationSize = {size_bytes};")
        print(f"    StartMemoryEventCapture({effect_index % 4});")
        print(
            f"    let scalar_amo_status_{effect_index} = "
            f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
            f"{row['length_bits']});"
        )
        print(
            f"    assert scalar_amo_status_{effect_index} == ScalarExecution_Executed;"
        )
        print("    assert _LastFault == Fault_None;")
        if class_id == "scalar-amo-load-reserved":
            print("    assert _MemoryEventCount == 1;")
            print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Load;")
            print("    assert !_MemoryEvents[[0]].write_performed;")
            print(f"    assert _MemoryEvents[[0]].order == {order};")
            print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
            print(
                f"    assert _MemoryEvents[[0]].read_value == {bit_literal(old_unsigned, 64)};"
            )
            print(f"    assert ReadGPR(3) == {bit_literal(old_return, 64)};")
            print("    assert _ReservationValid;")
            print(
                f"    assert _ReservationAddress == Zeros{{PTO_XLEN}} + 0x{address:x};"
            )
            print(f"    assert _ReservationSize == {size_bytes};")
            print(
                f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
                f"{size_bytes}) == {bit_literal(old_unsigned, 64)};"
            )
        elif class_id == "scalar-amo-store-conditional":
            stored_operand = normalize_atomic_unsigned_py(operand, size_bytes)
            print("    assert _MemoryEventCount == 1;")
            print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Store;")
            print("    assert _MemoryEvents[[0]].write_performed;")
            print(f"    assert _MemoryEvents[[0]].order == {order};")
            print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
            print(
                f"    assert _MemoryEvents[[0]].write_value == {bit_literal(stored_operand, 64)};"
            )
            print("    assert ReadGPR(3) == Zeros{PTO_XLEN};")
            print("    assert !_ReservationValid;")
            print(
                f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
                f"{size_bytes}) == {bit_literal(stored_operand, 64)};"
            )
        elif class_id in {
            "scalar-amo-swap",
            "scalar-amo-load-rmw",
            "scalar-amo-store-rmw",
        }:
            print("    assert _MemoryEventCount == 1;")
            print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Atomic;")
            print("    assert _MemoryEvents[[0]].write_performed;")
            print(f"    assert _MemoryEvents[[0]].order == {order};")
            print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
            print(
                f"    assert _MemoryEvents[[0]].read_value == {bit_literal(old_unsigned, 64)};"
            )
            print(
                f"    assert _MemoryEvents[[0]].write_value == {bit_literal(rmw_result, 64)};"
            )
            if class_id == "scalar-amo-store-rmw":
                print(
                    f"    assert ReadGPR(3) == {bit_literal(amo_source_sentinel, 64)};"
                )
            else:
                print(f"    assert ReadGPR(3) == {bit_literal(old_return, 64)};")
            print(
                f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
                f"{size_bytes}) == {bit_literal(rmw_result, 64)};"
            )
        elif class_id == "scalar-amo-cas":
            desired_unsigned = normalize_atomic_unsigned_py(expected_write, size_bytes)
            print("    assert _MemoryEventCount == 1;")
            print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Atomic;")
            print("    assert _MemoryEvents[[0]].write_performed;")
            print(f"    assert _MemoryEvents[[0]].order == {order};")
            print(f"    assert _MemoryEvents[[0]].size_bytes == {size_bytes};")
            print(
                f"    assert _MemoryEvents[[0]].read_value == {bit_literal(old_unsigned, 64)};"
            )
            print(
                f"    assert _MemoryEvents[[0]].write_value == {bit_literal(desired_unsigned, 64)};"
            )
            print(f"    assert ReadGPR(3) == {bit_literal(old_return, 64)};")
            print(
                f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
                f"{size_bytes}) == {bit_literal(desired_unsigned, 64)};"
            )
        else:
            raise ValueError(f"unhandled AMO effect class: {class_id}")
        print("    StopMemoryEventCapture();")
        print(f"    assert ReadGPR(1) == {bit_literal(source_left_value, 64)};")
        print(f"    assert ReadGPR(2) == {bit_literal(source_right_value, 64)};")
        print(f"    assert ReadGPR(4) == {bit_literal(desired, 64)};")
        if class_id == "scalar-amo-load-reserved":
            print(f"    assert ReadGPR(5) == {bit_literal(amo_source_sentinel, 64)};")
        print(
            "    assert ReadTPC() == Zeros{PTO_XLEN} + "
            f"{0x100 + row['length_bits'] // 8};"
        )
        print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
        print(f"    assert _CommitArgument == {bit_literal(amo_control_sentinel, 64)};")
        print(f"    assert _ReturnAddress == {bit_literal(amo_control_sentinel, 64)};")

        if class_id == "scalar-amo-store-conditional":
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print("    _ReservationValid = FALSE;")
            print("    WriteGPR(2, Ones{PTO_XLEN});")
            print(f"    WriteGPR(3, {bit_literal(amo_source_sentinel, 64)});")
            print("    StartMemoryEventCapture(1);")
            print(
                f"    let scalar_amo_sc_fail_status_{effect_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_amo_sc_fail_status_{effect_index} == "
                "ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print("    assert _MemoryEventCount == 0;")
            print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 1;")
            print("    assert !_ReservationValid;")
            print("    StopMemoryEventCapture();")
            print("    assert ReadTPC() == Zeros{PTO_XLEN} + 0x104;")
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
        elif class_id == "scalar-amo-cas":
            print("    ClearFault();")
            print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
            print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
            print(f"    WriteGPR(1, Zeros{{PTO_XLEN}} + 0x{address:x});")
            print(f"    WriteGPR(2, {bit_literal((old_unsigned + 1) & MASK64, 64)});")
            print(f"    WriteGPR(3, {bit_literal(amo_source_sentinel, 64)});")
            print(f"    WriteGPR(4, {bit_literal(desired, 64)});")
            print(
                f"    Store(Zeros{{PTO_XLEN}} + 0x{address:x}, {size_bytes}, "
                f"{bit_literal(old_value, 64)});"
            )
            print("    StartMemoryEventCapture(2);")
            print(
                f"    let scalar_amo_cas_fail_status_{effect_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, "
                f"{row['length_bits']});"
            )
            print(
                f"    assert scalar_amo_cas_fail_status_{effect_index} == "
                "ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print("    assert _MemoryEventCount == 1;")
            print("    assert _MemoryEvents[[0]].kind == MemoryEvent_Atomic;")
            print("    assert !_MemoryEvents[[0]].write_performed;")
            print(f"    assert _MemoryEvents[[0]].order == {order};")
            print(
                f"    assert _MemoryEvents[[0]].read_value == {bit_literal(old_unsigned, 64)};"
            )
            print(
                f"    assert _MemoryEvents[[0]].write_value == {bit_literal(desired_unsigned, 64)};"
            )
            print(f"    assert ReadGPR(3) == {bit_literal(old_return, 64)};")
            print(
                f"    assert LoadTranslatedUnsigned(Zeros{{PTO_XLEN}} + 0x{address:x}, "
                f"{size_bytes}) == {bit_literal(old_unsigned, 64)};"
            )
            print("    StopMemoryEventCapture();")
            print(
                "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                f"{0x100 + row['length_bits'] // 8};"
            )
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarAMOTotality()")
    print("begin")
    print("    ResetProfileState();")
    amo_totality_case_index = 0
    dma_row = next(
        row
        for row in scalar_amo_effect_rows
        if scalar_amo_effect_class(row) == "scalar-dma-copy"
    )
    for row in scalar_amo_effect_rows:
        for modifier_index, modifiers in enumerate(scalar_amo_modifier_cases(row)):
            modifier_id = (
                "-".join(
                    f"{field_name}{value}"
                    for field_name, value in sorted(modifiers.items())
                )
                or "none"
            )
            marker = f"modifier/{row['form_id']}/{modifier_index}/{modifier_id}"
            if scalar_amo_effect_class(row) == "scalar-dma-copy":
                emit_scalar_amo_dma_success(
                    row,
                    family_constraints,
                    amo_totality_case_index,
                    marker,
                    source_address=0x200,
                    destination_address=0x300,
                )
            else:
                emit_scalar_amo_decoded_success(
                    row,
                    family_constraints,
                    amo_totality_case_index,
                    marker,
                    old_value=0x80000001,
                    operand=0x80000001
                    if scalar_amo_effect_class(row) == "scalar-amo-cas"
                    else 0x23,
                    desired=0x45,
                    conditional_success=True,
                    modifiers=modifiers,
                )
            amo_totality_case_index += 1
    if amo_totality_case_index != scalar_amo_modifier_case_count:
        raise ValueError("AMO modifier case-count drift during emission")
    for row in scalar_amo_effect_rows:
        for value_index, (
            label,
            old_value,
            operand,
            desired,
            conditional_success,
        ) in enumerate(scalar_amo_value_cases(row)):
            class_id = scalar_amo_effect_class(row)
            reservation_mode = "none"
            if class_id in {
                "scalar-amo-swap",
                "scalar-amo-load-rmw",
                "scalar-amo-store-rmw",
            }:
                if value_index == 0:
                    reservation_mode = "overlap"
                elif value_index == 1:
                    reservation_mode = "nonoverlap"
            elif class_id == "scalar-amo-cas":
                if not conditional_success or value_index == 0:
                    reservation_mode = "overlap"
                elif value_index == 1:
                    reservation_mode = "nonoverlap"
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_totality_case_index,
                f"value/{row['form_id']}/{value_index}/{label}",
                old_value=old_value,
                operand=operand,
                desired=desired,
                conditional_success=conditional_success,
                reservation_mode=reservation_mode,
            )
            amo_totality_case_index += 1
    if amo_totality_case_index != (
        scalar_amo_modifier_case_count + scalar_amo_value_case_count
    ):
        raise ValueError("AMO value case-count drift during emission")
    fault_package_start = amo_totality_case_index
    for row in scalar_amo_effect_rows:
        for fault_index, (
            fault_label,
            fault_address,
            source_acr,
            expected_fault,
        ) in enumerate(scalar_amo_fault_cases(row)):
            emit_scalar_amo_fault_or_restart(
                row,
                family_constraints,
                amo_totality_case_index,
                f"fault/{row['form_id']}/{fault_index}/{fault_label}",
                fault_address=fault_address,
                source_acr=source_acr,
                expected_fault=expected_fault,
                restart=False,
            )
            amo_totality_case_index += 1
    if amo_totality_case_index - fault_package_start != scalar_amo_fault_case_count:
        raise ValueError("AMO fault case-count drift during emission")
    restart_package_start = amo_totality_case_index
    for row in scalar_amo_effect_rows:
        for fault_index, (
            fault_label,
            fault_address,
            source_acr,
            expected_fault,
        ) in enumerate(scalar_amo_fault_cases(row)):
            emit_scalar_amo_fault_or_restart(
                row,
                family_constraints,
                amo_totality_case_index,
                f"restart/{row['form_id']}/{fault_index}/{fault_label}",
                fault_address=fault_address,
                source_acr=source_acr,
                expected_fault=expected_fault,
                restart=True,
            )
            amo_totality_case_index += 1
    if amo_totality_case_index - restart_package_start != scalar_amo_restart_case_count:
        raise ValueError("AMO restart case-count drift during emission")
    sc_miss_package_start = amo_totality_case_index
    for row in scalar_amo_effect_rows:
        if scalar_amo_effect_class(row) != "scalar-amo-store-conditional":
            continue
        for miss_index, (fault_label, address, source_acr, _) in enumerate(
            scalar_amo_fault_cases(row)
        ):
            emit_scalar_amo_sc_miss_no_probe(
                row,
                family_constraints,
                amo_totality_case_index,
                f"sc-miss-no-probe/{row['form_id']}/{miss_index}/{fault_label}",
                address=address,
                source_acr=source_acr,
            )
            amo_totality_case_index += 1
    if (
        amo_totality_case_index - sc_miss_package_start
        != scalar_amo_sc_miss_no_probe_case_count
    ):
        raise ValueError("AMO SC no-probe case-count drift during emission")
    if (
        amo_totality_case_index - fault_package_start
        != scalar_amo_fault_restart_case_count
    ):
        raise ValueError("AMO fault/restart package count drift during emission")

    reservation_package_start = amo_totality_case_index
    lr_rows = [
        row
        for row in scalar_amo_effect_rows
        if scalar_amo_effect_class(row) == "scalar-amo-load-reserved"
    ]
    for row in lr_rows:
        size_bytes = scalar_amo_size_bytes(row["mnemonic"])
        prior_states = (
            ("invalid", (False, 0x900, 4)),
            ("same-address-size", (True, 0x800, size_bytes)),
            ("same-line-other", (True, 0x820, 8)),
            ("other-line", (True, 0x900, 2)),
        )
        for prior_index, (prior_label, prior_reservation) in enumerate(prior_states):
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_totality_case_index,
                f"reservation/lr-prior/{row['form_id']}/{prior_index}/{prior_label}",
                old_value=0x80000001,
                operand=0,
                desired=0,
                address=0x800,
                prior_reservation=prior_reservation,
            )
            amo_totality_case_index += 1
    sc_rows = [
        row
        for row in scalar_amo_effect_rows
        if scalar_amo_effect_class(row) == "scalar-amo-store-conditional"
    ]
    for row in sc_rows:
        for lr_width in (1, 2, 4, 8):
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_totality_case_index,
                f"reservation/sc-cross-width/{row['form_id']}/lr{lr_width}",
                old_value=0x22,
                operand=0x33,
                desired=0,
                conditional_success=True,
                address=0x800,
                prior_reservation=(True, 0x800, lr_width),
            )
            amo_totality_case_index += 1
    for row in sc_rows:
        size_bytes = scalar_amo_size_bytes(row["mnemonic"])
        for offset_label, offset in (
            ("interior", 32),
            ("highest-aligned", 64 - size_bytes),
        ):
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_totality_case_index,
                f"reservation/sc-same-line/{row['form_id']}/{offset_label}",
                old_value=0x22,
                operand=0x33,
                desired=0,
                conditional_success=True,
                address=0x800 + offset,
                prior_reservation=(True, 0x800, 4),
            )
            amo_totality_case_index += 1
    for row in sc_rows:
        mismatch_states = (
            ("invalid", (False, 0x800, 4)),
            ("previous-line", (True, 0x7C0, 4)),
            ("next-line", (True, 0x840, 4)),
            ("far-line", (True, 0x900, 4)),
        )
        for mismatch_label, prior_reservation in mismatch_states:
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_totality_case_index,
                f"reservation/sc-mismatch/{row['form_id']}/{mismatch_label}",
                old_value=0x22,
                operand=0x33,
                desired=0,
                conditional_success=False,
                address=0x800,
                prior_reservation=prior_reservation,
            )
            amo_totality_case_index += 1
    for size_bytes in (1, 2, 4, 8):
        for position_label, address in (
            ("base", 0x800),
            ("interior", 0x820),
            ("highest-aligned", 0x840 - size_bytes),
        ):
            emit_scalar_amo_ordinary_store_reservation(
                amo_totality_case_index,
                f"reservation/store-overlap/{size_bytes}/{position_label}",
                size_bytes=size_bytes,
                address=address,
                preserves=False,
            )
            amo_totality_case_index += 1
    for size_bytes in (1, 2, 4, 8):
        for position_label, address in (
            ("before", 0x800 - size_bytes),
            ("after", 0x840),
        ):
            emit_scalar_amo_ordinary_store_reservation(
                amo_totality_case_index,
                f"reservation/store-nonoverlap/{size_bytes}/{position_label}",
                size_bytes=size_bytes,
                address=address,
                preserves=True,
            )
            amo_totality_case_index += 1
    for fence_index, (predecessor, successor) in enumerate(
        ((1, 2), (2, 1), (3, 3), (15, 15))
    ):
        emit_scalar_amo_fence_reservation(
            amo_totality_case_index,
            f"reservation/fence-data/{fence_index}/{predecessor}-{successor}",
            predecessor=predecessor,
            successor=successor,
        )
        amo_totality_case_index += 1
    emit_scalar_amo_fence_reservation(
        amo_totality_case_index,
        "reservation/fence-instruction/0",
        predecessor=None,
        successor=None,
    )
    amo_totality_case_index += 1
    if (
        amo_totality_case_index - reservation_package_start
        != scalar_amo_reservation_case_count
    ):
        raise ValueError("AMO reservation package count drift during emission")

    dma_package_start = amo_totality_case_index
    dma_success_scenarios = (
        ("disjoint", 0x200, 0x300, False),
        ("exact", 0x400, 0x400, True),
        ("dst-plus-1", 0x400, 0x401, True),
        ("dst-plus-8", 0x400, 0x408, True),
        ("dst-plus-63", 0x400, 0x43F, True),
        ("src-plus-1", 0x401, 0x400, True),
        ("src-plus-8", 0x408, 0x400, True),
        ("src-plus-63", 0x43F, 0x400, True),
        ("highest-source", 0xFC0, 0x200, False),
        ("highest-destination", 0x200, 0xFC0, False),
    )
    for dma_index, (label, source, destination, overlap) in enumerate(
        dma_success_scenarios
    ):
        emit_scalar_amo_dma_success(
            dma_row,
            family_constraints,
            amo_totality_case_index,
            f"dma/{dma_index}/{label}",
            source_address=source,
            destination_address=destination,
            reservation_overlap=overlap,
        )
        amo_totality_case_index += 1
    dma_fault_scenarios = (
        ("source-only", 0x1000, 0x300, 0x1000),
        ("destination-only", 0x200, 0x1000, 0x1000),
        ("both-invalid-source-first", 0x1000, 0x1040, 0x1000),
    )
    for dma_index, (label, source, destination, fault_address) in enumerate(
        dma_fault_scenarios
    ):
        emit_scalar_amo_dma_fault_or_restart(
            dma_row,
            family_constraints,
            amo_totality_case_index,
            f"dma/fault/{dma_index}/{label}",
            source_address=source,
            destination_address=destination,
            expected_fault_address=fault_address,
            restart=False,
        )
        amo_totality_case_index += 1
    for dma_index, (label, source, destination, fault_address) in enumerate(
        dma_fault_scenarios[:2]
    ):
        emit_scalar_amo_dma_fault_or_restart(
            dma_row,
            family_constraints,
            amo_totality_case_index,
            f"dma/restart/{dma_index}/{label}",
            source_address=source,
            destination_address=destination,
            expected_fault_address=fault_address,
            restart=True,
        )
        amo_totality_case_index += 1
    if amo_totality_case_index - dma_package_start != scalar_amo_dma_case_count:
        raise ValueError("AMO DMA package count drift during emission")
    if amo_totality_case_index != scalar_amo_totality_case_count:
        raise ValueError("AMO totality case-count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarAMOAliases()")
    print("begin")
    print("    ResetProfileState();")
    amo_alias_case_index = 0
    for row in scalar_amo_effect_rows:
        for field_name in scalar_amo_source_fields(row):
            for selector in SCALAR_AMO_TEMP_SOURCE_SELECTORS:
                marker = f"alias/temp-source/{row['form_id']}/{field_name}/{selector}"
                if scalar_amo_effect_class(row) == "scalar-dma-copy":
                    emit_scalar_amo_dma_success(
                        row,
                        family_constraints,
                        amo_alias_case_index,
                        marker,
                        source_address=0x200,
                        destination_address=0x300,
                        selectors={field_name: selector},
                    )
                else:
                    emit_scalar_amo_decoded_success(
                        row,
                        family_constraints,
                        amo_alias_case_index,
                        marker,
                        old_value=0x22,
                        operand=0x22
                        if scalar_amo_effect_class(row) == "scalar-amo-cas"
                        else 0x33,
                        desired=0x44,
                        conditional_success=True,
                        selectors={field_name: selector},
                    )
                amo_alias_case_index += 1
    if amo_alias_case_index != scalar_amo_temp_source_case_count:
        raise ValueError("AMO temporary-source alias count drift during emission")
    for row in scalar_amo_effect_rows:
        if field_by_name(row, "RegDst") is None:
            continue
        for destination in SCALAR_AMO_SPECIAL_DESTINATION_SELECTORS:
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_alias_case_index,
                f"alias/special-destination/{row['form_id']}/{destination}",
                old_value=0x80000001,
                operand=0x80000001
                if scalar_amo_effect_class(row) == "scalar-amo-cas"
                else 0x33,
                desired=0x44,
                conditional_success=True,
                destination=destination,
            )
            amo_alias_case_index += 1
    if amo_alias_case_index != (
        scalar_amo_temp_source_case_count + scalar_amo_special_destination_case_count
    ):
        raise ValueError("AMO special-destination alias count drift during emission")
    for row in scalar_amo_effect_rows:
        if field_by_name(row, "RegDst") is None:
            continue
        for field_name in scalar_amo_source_fields(row):
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_alias_case_index,
                f"alias/absolute-overlap/{row['form_id']}/{field_name}/5",
                old_value=0x22,
                operand=0x22
                if scalar_amo_effect_class(row) == "scalar-amo-cas"
                else 0x33,
                desired=0x44,
                conditional_success=True,
                selectors={field_name: 5},
                destination=5,
            )
            amo_alias_case_index += 1
    if amo_alias_case_index != (
        scalar_amo_temp_source_case_count
        + scalar_amo_special_destination_case_count
        + scalar_amo_absolute_overlap_case_count
    ):
        raise ValueError("AMO absolute-overlap alias count drift during emission")
    for row in scalar_amo_effect_rows:
        if field_by_name(row, "SrcZero") is None:
            continue
        for src_zero in range(32):
            emit_scalar_amo_decoded_success(
                row,
                family_constraints,
                amo_alias_case_index,
                f"alias/ignored-srczero/{row['form_id']}/{src_zero}",
                old_value=0x80000001,
                operand=0,
                desired=0,
                conditional_success=True,
                src_zero=src_zero,
            )
            amo_alias_case_index += 1
    if amo_alias_case_index != scalar_amo_alias_case_count:
        raise ValueError("AMO alias total count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarFSUEffects()")
    print("begin")
    print("    ResetProfileState();")
    for effect_index, row in enumerate(scalar_fsu_effect_rows):
        class_id = scalar_fsu_effect_class(row)
        if class_id is None:
            raise ValueError(f"missing FSU effect metadata: {row['form_id']}")
        mnemonic = row["mnemonic"]
        left, right, addend, src_type, dst_type = scalar_fsu_success_inputs(row)
        witness = scalar_fsu_witness(
            row, family_constraints, src_type=src_type, dst_type=dst_type
        )
        expected, expected_flags = scalar_fsu_expected(
            row, left, right, addend, src_type, dst_type
        )
        print(f"    // {row['form_id']}: {mnemonic} [{class_id}]")
        emit_scalar_fsu_success(
            row,
            effect_index,
            "success",
            witness,
            left,
            right,
            addend,
            expected,
            expected_flags,
            sticky_flags=0x10,
        )

        sensitive_left, sensitive_right, sensitive_addend, _, _ = (
            scalar_fsu_sensitivity_inputs(row)
        )
        sensitive_expected, sensitive_flags = scalar_fsu_expected(
            row, sensitive_left, sensitive_right, sensitive_addend, src_type, dst_type
        )
        if sensitive_expected == expected:
            raise ValueError(f"FSU sensitivity witness is unchanged: {row['form_id']}")
        emit_scalar_fsu_success(
            row,
            effect_index,
            "sensitive",
            witness,
            sensitive_left,
            sensitive_right,
            sensitive_addend,
            sensitive_expected,
            sensitive_flags,
            compare_against=expected,
        )

        if mnemonic == "FDIV":
            zero_expected, zero_flags = scalar_fsu_expected(
                row, left, 0, addend, src_type, dst_type
            )
            emit_scalar_fsu_success(
                row,
                effect_index,
                "divide_zero",
                witness,
                left,
                0,
                addend,
                zero_expected,
                zero_flags,
            )
        if mnemonic == "FRECIP":
            zero_expected, zero_flags = scalar_fsu_expected(
                row, 0, right, addend, src_type, dst_type
            )
            emit_scalar_fsu_success(
                row,
                effect_index,
                "recip_zero",
                witness,
                0,
                right,
                addend,
                zero_expected,
                zero_flags,
            )
        if mnemonic in {"FEQ", "FEQS"}:
            for nan_index, nan_value in enumerate((0x7FC00000, 0x7FA00000)):
                nan_expected, nan_flags = scalar_fsu_expected(
                    row, nan_value, 0x3F800000, addend, src_type, dst_type
                )
                emit_scalar_fsu_success(
                    row,
                    effect_index,
                    f"nan_{nan_index}",
                    witness,
                    nan_value,
                    0x3F800000,
                    addend,
                    nan_expected,
                    nan_flags,
                )
        if mnemonic in {"FMIN", "FMAX"}:
            minmax_nan_inputs = (
                (0x7FC00000, 0x3F800000),
                (0x7FC00000, 0x7FC00000),
                (0x7FA00000, 0x3F800000),
            )
            for nan_index, (nan_left, nan_right) in enumerate(minmax_nan_inputs):
                nan_expected, nan_flags = scalar_fsu_expected(
                    row, nan_left, nan_right, addend, src_type, dst_type
                )
                emit_scalar_fsu_success(
                    row,
                    effect_index,
                    f"minmax_nan_{nan_index}",
                    witness,
                    nan_left,
                    nan_right,
                    addend,
                    nan_expected,
                    nan_flags,
                )
        if mnemonic == "FADD":
            invalid_source_witness = scalar_fsu_witness(
                row, family_constraints, src_type=2, dst_type=dst_type
            )
            emit_scalar_fsu_fault(
                row,
                effect_index,
                "invalid_source",
                invalid_source_witness,
                left,
                right,
                addend,
            )
        if mnemonic == "FCVT":
            invalid_destination_witness = scalar_fsu_witness(
                row, family_constraints, src_type=src_type, dst_type=15
            )
            emit_scalar_fsu_fault(
                row,
                effect_index,
                "invalid_destination",
                invalid_destination_witness,
                left,
                right,
                addend,
            )
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarFSUTotality()")
    print("begin")
    print("    ResetProfileState();")
    fsu_totality_case_index = 0
    fsu_fault_case_index = 0
    for row in scalar_fsu_effect_rows:
        base_left, base_right, base_addend, _, base_dst_type = (
            scalar_fsu_success_inputs(row)
        )
        for label, src_type, dst_type, legal in scalar_fsu_type_cases(row):
            witness = scalar_fsu_witness(
                row, family_constraints, src_type=src_type, dst_type=dst_type
            )
            print(f"    // FSU-TOTALITY-DECODED: type/{row['form_id']}/{label}")
            if legal:
                expected, flags = scalar_fsu_expected(
                    row, base_left, base_right, base_addend, src_type, dst_type
                )
                emit_scalar_fsu_success(
                    row,
                    fsu_totality_case_index,
                    "totality_type",
                    witness,
                    base_left,
                    base_right,
                    base_addend,
                    expected,
                    flags,
                    sticky_flags=0x1F,
                )
            else:
                emit_scalar_fsu_fault(
                    row,
                    fsu_totality_case_index,
                    "totality_type",
                    witness,
                    base_left,
                    base_right,
                    base_addend,
                )
                fsu_fault_case_index += 1
            fsu_totality_case_index += 1

        for label, left, right, addend, src_type, dst_type in scalar_fsu_boundary_cases(
            row
        ):
            witness = scalar_fsu_witness(
                row, family_constraints, src_type=src_type, dst_type=dst_type
            )
            expected, flags = scalar_fsu_expected(
                row, left, right, addend, src_type, dst_type
            )
            print(f"    // FSU-TOTALITY-DECODED: boundary/{row['form_id']}/{label}")
            emit_scalar_fsu_success(
                row,
                fsu_totality_case_index,
                "totality_boundary",
                witness,
                left,
                right,
                addend,
                expected,
                flags,
                sticky_flags=0x1C,
            )
            fsu_totality_case_index += 1

        if scalar_fsu_active_rounding_consumer(
            row
        ) or scalar_fsu_fixed_rounding_consumer(row):
            left, right, addend, src_type, dst_type = scalar_fsu_success_inputs(row)
            witness = scalar_fsu_witness(
                row, family_constraints, src_type=src_type, dst_type=dst_type
            )
            expected, flags = scalar_fsu_expected(
                row, left, right, addend, src_type, dst_type
            )
            for rounding_mode in range(8):
                print(
                    f"    // FSU-TOTALITY-DECODED: rounding/{row['form_id']}/"
                    f"active-{rounding_mode}"
                )
                emit_scalar_fsu_success(
                    row,
                    fsu_totality_case_index,
                    "totality_rounding",
                    witness,
                    left,
                    right,
                    addend,
                    expected,
                    flags,
                    rounding_mode=rounding_mode,
                )
                fsu_totality_case_index += 1

        left, right, addend, src_type, dst_type = scalar_fsu_sticky_inputs(row)
        witness = scalar_fsu_witness(
            row, family_constraints, src_type=src_type, dst_type=dst_type
        )
        expected, flags = scalar_fsu_expected(
            row, left, right, addend, src_type, dst_type
        )
        for seed in (0, 1, 2, 4, 8, 16, 31):
            print(f"    // FSU-TOTALITY-DECODED: flags/{row['form_id']}/seed-{seed}")
            emit_scalar_fsu_success(
                row,
                fsu_totality_case_index,
                "totality_flags",
                witness,
                left,
                right,
                addend,
                expected,
                flags,
                sticky_flags=seed,
            )
            fsu_totality_case_index += 1
    expected_non_alias_totality = (
        scalar_fsu_type_case_count
        + scalar_fsu_boundary_case_count
        + scalar_fsu_rounding_case_count
        + scalar_fsu_sticky_case_count
    )
    if fsu_totality_case_index != expected_non_alias_totality:
        raise ValueError("scalar FSU non-alias totality count drift during emission")
    if fsu_fault_case_index != scalar_fsu_type_fault_case_count:
        raise ValueError("scalar FSU fault count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarFSUAliases()")
    print("begin")
    print("    ResetProfileState();")
    fsu_alias_case_index = 0
    for row in scalar_fsu_effect_rows:
        for label, field_values in scalar_fsu_alias_cases(row):
            emit_scalar_fsu_alias_case(
                row, family_constraints, fsu_alias_case_index, label, field_values
            )
            fsu_alias_case_index += 1
    if fsu_alias_case_index != scalar_fsu_alias_case_count:
        raise ValueError("scalar FSU alias count drift during emission")
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarFSUFlagAndRoundingHelpers()")
    print("begin")
    print("    ResetProfileState();")
    direct_flag_case_index = 0
    for seed in (0, 1, 2, 4, 8, 16, 31):
        for incoming in (1, 2, 4, 8, 16):
            print(f"    // FSU-FLAG-HELPER: seed-{seed}-incoming-{incoming}")
            print("    _SystemRegisters.core_state = Zeros{PTO_XLEN};")
            print(f"    _SystemRegisters.core_state[36:32] = {bit_literal(seed, 5)};")
            print(f"    ScalarFPRecordFlags({bit_literal(incoming, 5)});")
            print(f"    assert ScalarFPFlags() == {bit_literal(seed | incoming, 5)};")
            direct_flag_case_index += 1
    if direct_flag_case_index != 35:
        raise ValueError("scalar FSU direct flag-helper count drift during emission")
    scalar_active_rounding = {
        0: "NumericRound_RNE",
        1: "NumericRound_RTM",
        2: "NumericRound_RTP",
        3: "NumericRound_RTZ",
        4: "NumericRound_RNE",
        5: "NumericRound_RNE",
        6: "NumericRound_RNE",
        7: "NumericRound_RNE",
    }
    for encoded in range(8):
        print("    _SystemRegisters.core_state = Zeros{PTO_XLEN};")
        print(f"    _SystemRegisters.core_state[39:37] = {bit_literal(encoded, 3)};")
        print(
            "    assert ScalarFPActiveRoundingMode() == "
            f"{scalar_active_rounding[encoded]};"
        )
    for operation, rounding_mode in (
        ("FCVTA", "NumericRound_RNA"),
        ("FCVTM", "NumericRound_RTM"),
        ("FCVTN", "NumericRound_RNE"),
        ("FCVTP", "NumericRound_RTP"),
        ("FCVTZ", "NumericRound_RTZ"),
    ):
        print(
            "    assert ScalarFPFixedConversionRoundingMode("
            f"ScalarOperation_{operation}) == {rounding_mode};"
        )
    print("    ResetProfileState();")
    print("end;")
    print()
    print("func ValidateCanonicalScalarSYSEffects()")
    print("begin")
    print("    ResetProfileState();")
    sys_source_sentinel = 0x123456789ABCDEF0
    sys_destination_sentinel = 0x5555555555555555
    sys_control_sentinel = 0xAAAAAAAAAAAAAAAA
    for effect_index, row in enumerate(scalar_sys_effect_rows):
        class_id = scalar_sys_effect_class(row)
        if class_id is None:
            raise ValueError(f"missing SYS effect metadata: {row['form_id']}")
        mnemonic = row["mnemonic"]
        overrides: dict[str, int] = {}
        if field_by_name(row, "RegDst") is not None:
            overrides["RegDst"] = 3
        if field_by_name(row, "SrcL") is not None:
            overrides["SrcL"] = 5
        if field_by_name(row, "SSR_ID") is not None:
            overrides["SSR_ID"] = 0
        if field_by_name(row, "LSR_ID") is not None:
            overrides["LSR_ID"] = 0
        if field_by_name(row, "SSRID") is not None:
            overrides["SSRID"] = 0
        if field_by_name(row, "RST_Type") is not None:
            overrides["RST_Type"] = 1
        if field_by_name(row, "RRA_Type") is not None:
            overrides["RRA_Type"] = 1
        if field_by_name(row, "imm5") is not None:
            overrides["imm5"] = 0x15
        if field_by_name(row, "imm4") is not None:
            overrides["imm4"] = 0xB
        if field_by_name(row, "PRED_IMM") is not None:
            overrides["PRED_IMM"] = 0xA
        if field_by_name(row, "SUCC_IMM") is not None:
            overrides["SUCC_IMM"] = 0x5
        if mnemonic == "HL.SSRSET":
            overrides["SSR_ID"] = 0x1F10
        if mnemonic == "SSRSWAP":
            overrides["RegDst"] = 5
            overrides["SrcL"] = 5
        witness = scalar_sys_witness(row, family_constraints, overrides)
        print(f"    // {row['form_id']}: {mnemonic} [{class_id}]")
        print("    ResetProfileState();")
        print("    SetCurrentACR(0);")
        print("    ClearFault();")
        print("    StopMemoryEventCapture();")
        print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
        print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
        print("    WriteBPC(Zeros{PTO_XLEN} + 0x200);")
        print(f"    _CommitArgument = {bit_literal(sys_control_sentinel, 64)};")
        print(f"    _ReturnAddress = {bit_literal(sys_control_sentinel, 64)};")
        print("    _DataCacheEpoch = 10;")
        print("    _InstructionCacheEpoch = 20;")
        print("    _BundleCacheEpoch = 30;")
        print("    _TLBEpoch = 40;")
        print("    _ArchitectureRequestEpoch = 50;")
        print("    _ReservationValid = FALSE;")
        print(f"    WriteGPR(3, {bit_literal(sys_destination_sentinel, 64)});")
        print(f"    WriteGPR(5, {bit_literal(sys_source_sentinel, 64)});")

        if class_id == "scalar-system-register-read":
            print("    _SystemRegisters.thread_ptr = Zeros{PTO_XLEN} + 0x111;")
            if mnemonic == "C.SSRGET":
                print(
                    f"    PushTemporaryQueue(TRUE, {bit_literal(sys_destination_sentinel, 64)});"
                )
            print(
                f"    let scalar_sys_status_{effect_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
            )
            print(
                f"    assert scalar_sys_status_{effect_index} == ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            if mnemonic == "C.SSRGET":
                print(
                    "    assert ReadTemporaryQueue(TRUE, 0) == Zeros{PTO_XLEN} + 0x111;"
                )
                print(
                    f"    assert ReadTemporaryQueue(TRUE, 1) == {bit_literal(sys_destination_sentinel, 64)};"
                )
                print(
                    f"    assert ReadGPR(3) == {bit_literal(sys_destination_sentinel, 64)};"
                )
            else:
                print("    assert ReadGPR(3) == Zeros{PTO_XLEN} + 0x111;")
            print(
                "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                f"{0x100 + row['length_bits'] // 8};"
            )
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")
            print("    assert _DataCacheEpoch == 10;")
            print("    assert _InstructionCacheEpoch == 20;")
            print("    assert _BundleCacheEpoch == 30;")
            print("    assert _TLBEpoch == 40;")

            if mnemonic == "SSRGET":
                invalid_witness = scalar_sys_witness(
                    row,
                    family_constraints,
                    {
                        "RegDst": 3,
                        "SSR_ID": 0x0F0A,
                    },
                )
                print("    ResetProfileState();")
                print("    SetCurrentACR(0);")
                print("    ClearFault();")
                print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
                print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
                print(f"    WriteGPR(3, {bit_literal(sys_destination_sentinel, 64)});")
                print(
                    "    let scalar_sys_read_access_status = "
                    f"ExecuteScalarInstruction({bit_literal(invalid_witness, 48)}, "
                    f"{row['length_bits']});"
                )
                print(
                    "    assert scalar_sys_read_access_status == ScalarExecution_Rejected;"
                )
                print("    assert _LastFault == Fault_IllegalInstruction;")
                print(
                    f"    assert ReadGPR(3) == {bit_literal(sys_destination_sentinel, 64)};"
                )
                print("    assert _TrapContexts[[0]].valid;")
                print("    assert _TrapContexts[[0]].tpc == Zeros{PTO_XLEN} + 0x100;")
                print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

        elif class_id == "scalar-system-register-write":
            if mnemonic == "HL.SSRSET":
                expected_address = "Zeros{24} + 0x1f10"
            else:
                expected_address = "Zeros{24}"
            print("    WriteGPR(5, Zeros{PTO_XLEN} + 0x222);")
            print(
                f"    let scalar_sys_status_{effect_index} = "
                f"ExecuteScalarInstruction({bit_literal(witness, 48)}, {row['length_bits']});"
            )
            print(
                f"    assert scalar_sys_status_{effect_index} == ScalarExecution_Executed;"
            )
            print("    assert _LastFault == Fault_None;")
            print(
                f"    let scalar_sys_written_value_{effect_index} = "
                f"ReadSystemRegisterAddress({expected_address});"
            )
            print(
                f"    assert scalar_sys_written_value_{effect_index} == Zeros{{PTO_XLEN}} + 0x222;"
            )
            print("    assert _LastFault == Fault_None;")
            print("    assert ReadGPR(5) == Zeros{PTO_XLEN} + 0x222;")
            print(
                f"    assert ReadGPR(3) == {bit_literal(sys_destination_sentinel, 64)};"
            )
            print(
                "    assert ReadTPC() == Zeros{PTO_XLEN} + "
                f"{0x100 + row['length_bits'] // 8};"
            )
            print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

            if mnemonic == "SSRSET":
                invalid_witness = scalar_sys_witness(
                    row,
                    family_constraints,
                    {
                        "SrcL": 5,
                        "SSR_ID": 0x10,
                    },
                )
                print("    ResetProfileState();")
                print("    SetCurrentACR(0);")
                print("    ClearFault();")
                print("    _SystemRegisters.cycle = Zeros{PTO_XLEN};")
                print("    WriteTPC(Zeros{PTO_XLEN} + 0x100);")
                print("    WriteGPR(5, Zeros{PTO_XLEN} + 0x333);")
                print(
                    "    let scalar_sys_write_access_status = "
                    f"ExecuteScalarInstruction({bit_literal(invalid_witness, 48)}, "
                    f"{row['length_bits']});"
                )
                print(
                    "    assert scalar_sys_write_access_status == ScalarExecution_Rejected;"
                )
                print("    assert _LastFault == Fault_IllegalInstruction;")
                print("    assert ReadGPR(5) == Zeros{PTO_XLEN} + 0x333;")
                print("    assert _SystemRegisters.cycle == Zeros{PTO_XLEN} + 1;")

        elif class_id == "scalar-system-register-swap":
