    print()
    print("pure func TileOperationDATRFieldsLegal(")
    print("    operation: integer {0..PTO_TILE_OPERATION_COUNT-1},")
    print("    c_mode: bits(3), pad_value_or_byte_id: bits(2),")
    print("    saturating: boolean, canonicalize: boolean,")
    print("    data_type: bits(5), rounding_mode: bits(3),")
    print("    data_layout: bits(5)) => boolean")
    print("begin")
    datr_checks = (
        ("c_mode != Zeros{3}", "CMode"),
        ("pad_value_or_byte_id != Zeros{2}", "PadValueOrByteId"),
        ("saturating", "Sat"),
        ("canonicalize", "Canonicalize"),
        ("data_type != Zeros{5}", "DataType"),
        ("rounding_mode != Zeros{3}", "RMode"),
        ("data_layout != Zeros{5}", "Layout"),
    )
    for nonzero, field in datr_checks:
        print(
            f"    if {nonzero} && !TileOperationDATRFieldApplicable(operation, "
            f"TileDATRField_{field}) then return FALSE; end;"
        )
    print("    return TRUE;")
    print("end;")
    print()
    print("pure func CommandFormSelectsTileOperation(")
    print("    form: integer {0..PTO_COMMAND_FORM_COUNT-1}) => boolean")
    print("begin")
    for command_index, _, _ in tile_command_rows:
        print(f"    if form == {command_index} then return TRUE; end;")
    print("    return FALSE;")
    print("end;")
    print()
    print("pure func CommandTileFamilyOfForm(")
    print("    form: integer {0..PTO_COMMAND_FORM_COUNT-1}) => TileDecodeFamily")
    print("begin")
    for command_index, _, family in tile_command_rows:
        print(
            f"    if form == {command_index} then return TileDecode_{family}; end;"
        )
    print("    unreachable;")
    print("end;")
    print()
    print("pure func CommandTileCodeOfForm(")
    print("    instruction: bits(64),")
    print("    form: integer {0..PTO_COMMAND_FORM_COUNT-1}) => bits(12)")
    print("begin")
    for command_index, command_row, family in tile_command_rows:
        if family == "TEPL":
            print(f"    if form == {command_index} then")
            print("        var code = Zeros{12};")
            print(
                "        code[6:5] = DecodeCommandOperandRaw(instruction, form, "
                "CommandField_Mode)[1:0];"
            )
            print(
                "        code[4:0] = DecodeCommandOperandRaw(instruction, form, "
                "CommandField_Function)[4:0];"
            )
            print("        return code;")
            print("    end;")
        else:
            operation = next(
                row for row in tile
                if row["command_mnemonic"] == command_row["mnemonic"]
            )
            print(
                f"    if form == {command_index} then return "
                f"{bit_literal(operation['function'], 12)}; end;"
            )
    print("    unreachable;")
    print("end;")
    print()
    print("pure func CommandTileDataTypeOfForm(")
    print("    instruction: bits(64),")
    print("    form: integer {0..PTO_COMMAND_FORM_COUNT-1}) => bits(5)")
    print("begin")
    for command_index, _, _ in tile_command_rows:
        print(
            f"    if form == {command_index} then return "
            "DecodeCommandOperandRaw(instruction, form, "
            "CommandField_DataType)[4:0]; end;"
        )
    print("    unreachable;")
    print("end;")
    print()
    print(
        "pure func TileOperationOfIndex(operation: integer {0..PTO_TILE_OPERATION_COUNT-1})"
    )
    print("                               => TileOperation")
    print("begin")
    for index, operation in enumerate(tile_operations):
        print(f"    if operation == {index} then return {operation}; end;")
    print("    unreachable;")
    print("end;")
    print()
    print("pure func TileHandlerOfIndex(")
    print("    operation: integer {0..PTO_TILE_OPERATION_COUNT-1})")
    print("    => TileSemanticHandler")
    print("begin")
    for index, row in enumerate(tile):
        print(
            f"    if operation == {index} then return TileHandler_{row['semantic_handler']}; end;"
        )
    print("    unreachable;")
    print("end;")
    print()
    print("pure func TileOperandPresent(")
    print("    operation: integer {0..PTO_TILE_OPERATION_COUNT-1},")
    print("    field: TileOperandField) => boolean")
    print("begin")
    for index, row in enumerate(tile):
        for operand in row["operands"]:
            print(
                f"    if operation == {index} && field == TileOperand_{operand['field']} "
                "then return TRUE; end;"
            )
    print("    return FALSE;")
    print("end;")
    print()
    print("pure func TileOperationRejectedByAcceptedApplicabilityRules(")
    print("    rules: NumericApplicabilityRuleSet,")
    print("    operation: integer {0..PTO_TILE_OPERATION_COUNT-1}) => boolean")
    print("begin")
    for rule in numeric_applicability_rules:
        rule_set = applicability_rule_set_asl[rule["profile_id"]]
        operation = tile_indices_by_key[rule["operation_key"]]
        print(
            f"    if rules == {rule_set} && operation == {operation} then "
            "return TRUE; end;"
        )
    print("    return FALSE;")
    print("end;")
    print()
    print("func ExecuteTileInstructionWithoutTimeWithAcceptedApplicabilityRules(")
    print("    rules: NumericApplicabilityRuleSet,")
    print("    family: TileDecodeFamily,")
    print("    code: bits(12),")
    print("    operands: TileInstructionOperands)")
    print("    => (TileExecutionStatus, Word)")
    print("begin")
    print("    let operation = DecodeTileOperation(family, code);")
    print("    if operation == PTO_TILE_OPERATION_COUNT then")
    print("        SetFault(Fault_IllegalInstruction, ReadPC());")
    print("        return (TileExecution_Rejected, Zeros{PTO_XLEN});")
    print("    end;")
    print(
        "    let accepted_operation = operation as integer {0..PTO_TILE_OPERATION_COUNT-1};"
    )
    print(
        "    if TileOperationRejectedByAcceptedApplicabilityRules("
        "rules, accepted_operation) then"
    )
    print("        SetFault(Fault_IllegalInstruction, ReadPC());")
    print("        return (TileExecution_Rejected, Zeros{PTO_XLEN});")
    print("    end;")
    print("    let numeric_control = ResolveTileNumericExecutionControl(")
    print("        accepted_operation, operands);")
    print("    case TileOperationOfIndex(accepted_operation) of")
    if len(tile) != len(tile_operations):
        raise ValueError("tile operation binding count drift")
    for row, operation_name in zip(tile, tile_operations):
        arguments = ", ".join(
            tile_argument_expression(argument) for argument in row["arguments"]
        )
        print(f"        when {operation_name} =>")
        source_fields = [
            operand["field"]
            for operand in row["operands"]
            if operand["field"].startswith("source") or operand["role"] == "bias"
        ]
        if source_fields:
            undefined_sources = " || ".join(
                f"!TileSourceContentsDefined(operands.{field})"
                for field in source_fields
            )
            print(f"            if {undefined_sources} then")
            print("                SetFault(Fault_TileLegality, ReadPC());")
            print("                return (TileExecution_Rejected, Zeros{PTO_XLEN});")
            print("            end;")
        print(
            f"            if !TileOperandsLegal_{row['semantic_handler']}({arguments}) then"
        )
        print("                SetFault(Fault_TileLegality, ReadPC());")
        print("                return (TileExecution_Rejected, Zeros{PTO_XLEN});")
        print("            end;")
        if row.get("result") == "value":
            print(f"            let value = {row['semantic_handler']}({arguments});")
            print("            if _LastFault != Fault_None then")
            print("                return (TileExecution_Rejected, Zeros{PTO_XLEN});")
            print("            end;")
            print("            return (TileExecution_Executed, value);")
        else:
            print(f"            {row['semantic_handler']}({arguments});")
            print("            if _LastFault != Fault_None then")
            print("                return (TileExecution_Rejected, Zeros{PTO_XLEN});")
            print("            end;")
            print("            return (TileExecution_Executed, Zeros{PTO_XLEN});")
    print("    end;")
    print("end;")
    print()
    print("func ExecuteTileInstructionWithoutTime(family: TileDecodeFamily,")
    print("                                       code: bits(12),")
    print("                                       operands: TileInstructionOperands)")
    print("                                       => (TileExecutionStatus, Word)")
    print("begin")
    print("    return ExecuteTileInstructionWithoutTimeWithAcceptedApplicabilityRules(")
    print("        NumericApplicabilityRules_None, family, code, operands);")
    print("end;")
    print()
    print("func ExecuteTileInstruction(family: TileDecodeFamily, code: bits(12),")
    print("                            operands: TileInstructionOperands)")
    print("                            => (TileExecutionStatus, Word)")
    print("begin")
    print("    BeginArchitecturalInstructionAttempt();")
    print("    return ExecuteTileInstructionWithoutTimeWithAcceptedApplicabilityRules(")
    print("        NumericApplicabilityRules_None, family, code, operands);")
    print("end;")
    print()
    print("func ValidateCanonicalDecoders()")
    print("begin")
    print("    ValidateCommandCatalogDecode();")
    for index, row in enumerate(scalar):
        match = bit_literal(int(row["encoding"][0]["match"], 16), 48)
        legal_instruction = legal_scalar_witness(row, family_constraints)
        print(f"    assert DecodeScalarForm({match}, {row['length_bits']}) == {index};")
        print(
            f"    assert ScalarFamilyOfForm({index}) == ScalarSemantic_{row['semantic_family']};"
        )
        print(
            f"    assert ScalarOperationOfForm({index}) == {scalar_operations[index]};"
        )
        print(
            f"    assert ScalarHandlerOfForm({index}) == ScalarHandler_{row['semantic_handler']};"
        )
        for field in row["fields"]:
            expected = bit_literal((1 << field["width"]) - 1, 48)
            signedness = signedness_names[field["signedness"]]
            print(
                f"    assert ScalarOperandPresent({index}, ScalarField_{field['name']});"
            )
            print(
                f"    assert ScalarOperandWidth({index}, ScalarField_{field['name']}) == {field['width']};"
            )
            print(
                f"    assert ScalarOperandSignedness({index}, ScalarField_{field['name']}) "
                f"== ScalarField_{signedness};"
            )
            print(
                f"    assert DecodeScalarOperandRaw(Ones{{48}}, {index}, ScalarField_{field['name']}) "
                f"== {expected};"
            )
        print(
            f"    assert ScalarFormOperandsLegal({bit_literal(legal_instruction, 48)}, {index});"
        )
        for constraint in row["constraints"]:
            invalid_instruction = encode_field(
                row,
                constraint["field"],
                legal_instruction,
                constraint["value"],
            )
            print(
                f"    assert !ScalarFormOperandsLegal({bit_literal(invalid_instruction, 48)}, {index});"
            )
        for constraint in family_constraints:
            if not family_constraint_applies(row, constraint):
                continue
            invalid_instruction = encode_field(
                row,
                constraint["right_field"],
                legal_instruction,
                decode_field(row, constraint["left_field"], legal_instruction),
            )
            print(
                f"    assert !ScalarFormOperandsLegal({bit_literal(invalid_instruction, 48)}, {index});"
            )
    for index, row in enumerate(tile):
        value = tile_operation_code(row)
        print(
            f"    assert DecodeTileOperation(TileDecode_{row['family']}, {bit_literal(value, 12)}) == {index};"
        )
        print(f"    assert TileOperationOfIndex({index}) == {tile_operations[index]};")
        print(
            f"    assert TileHandlerOfIndex({index}) == TileHandler_{row['semantic_handler']};"
        )
        for operand in row["operands"]:
            print(
                f"    assert TileOperandPresent({index}, TileOperand_{operand['field']});"
            )
        allowed_datr = set(row["datr_contract"]["allowed_nonzero_fields"])
        print(
            f"    assert TileOperationDATRPadUnion({index}) == "
            f"{TILE_DATR_PAD_UNION_ENUM[row['datr_contract']['pad_union']]};"
        )
        datr_values = {
            "CMode": "'001'",
            "PadValueOrByteId": "'01'",
            "Sat": "TRUE",
            "Canonicalize": "TRUE",
            "DataType": "'00001'",
            "RMode": "'001'",
            "Layout": "'00001'",
        }
        datr_defaults = {
            "CMode": "Zeros{3}",
            "PadValueOrByteId": "Zeros{2}",
            "Sat": "FALSE",
            "Canonicalize": "FALSE",
            "DataType": "Zeros{5}",
            "RMode": "Zeros{3}",
            "Layout": "Zeros{5}",
        }
        for field in TILE_DATR_FIELD_ORDER:
            print(
                f"    assert TileOperationDATRFieldApplicable({index}, "
                f"TileDATRField_{field}) == "
                f"{'TRUE' if field in allowed_datr else 'FALSE'};"
            )
            arguments = [
                datr_values[item] if item == field else datr_defaults[item]
                for item in TILE_DATR_FIELD_ORDER
            ]
            print(
                f"    assert {'' if field in allowed_datr else '!'}"
                f"TileOperationDATRFieldsLegal({index}, {', '.join(arguments)});"
            )
        command_index = command_indices_by_mnemonic[row["command_mnemonic"]][0]
        command_row = command[command_index]
        if row["family"] == "TEPL":
            command_raw = (value << 20) | 0x00019181
        else:
            command_raw = int(command_row["encoding"][0]["match"], 16)
        command_literal = bit_literal(command_raw, 64)
        print(
            f"    assert DecodeCommandForm({command_literal}, 32) == {command_index};"
        )
        print(f"    assert CommandFormSelectsTileOperation({command_index});")
        print(
            f"    assert CommandTileFamilyOfForm({command_index}) == "
            f"TileDecode_{row['family']};"
        )
        print(
            f"    assert CommandTileCodeOfForm({command_literal}, {command_index}) == "
            f"{bit_literal(value, 12)};"
        )
        print(
            f"    assert CommandTileDataTypeOfForm({command_literal}, {command_index}) "
            "== '00000';"
        )
        print(
            f"    assert DecodeTileOperation(TileDecode_{row['family']}, "
            f"CommandTileCodeOfForm({command_literal}, {command_index})) == {index};"
        )
    for row in system_registers:
        access = access_names[row["access"]]
        if row["scope"] == "base":
            address = int(row["address"], 0)
        else:
            context = row.get("fixed_context", 0)
            address = (context << 12) | int(row["low_index"], 0)
        print(
            f"    assert SystemRegisterAccessOf({bit_literal(address, 24)}) "
            f"== SystemRegisterAccess_{access};"
        )
    for length in (16, 32, 48):
        print(
            f"    assert DecodeScalarForm({bit_literal(0, 48)}, {length}) == PTO_SCALAR_FORM_COUNT;"
        )
    for encoding, length in RESERVED_SCALAR_ENCODINGS:
        print(
            f"    assert DecodeScalarForm({bit_literal(encoding, 48)}, {length}) "
            "== PTO_SCALAR_FORM_COUNT;"
        )
    rejected_codes = {
        family: [
            int(value, 0) if isinstance(value, str) else value
            for value in tile_catalog["rejected_review_only_codes"][family]
        ]
        for family in ("TEPL", "TMA", "CUBE")
    }
    for family, key in (
        ("TEPL", "tepl_selector_ranges"),
        ("TMA", "tma_functions"),
        ("CUBE", "cube_functions_without_named_alias"),
    ):
        for entry in tile_catalog["reserved"][key]:
            if isinstance(entry, int):
                rejected_codes[family].append(entry)
            else:
                start = int(entry[0], 0) if isinstance(entry[0], str) else entry[0]
                end = int(entry[1], 0) if isinstance(entry[1], str) else entry[1]
                rejected_codes[family].extend(range(start, end + 1))
    for family, values in rejected_codes.items():
        for value in sorted(set(values)):
            print(
                f"    assert DecodeTileOperation(TileDecode_{family}, {bit_literal(value, 12)}) "
                "== PTO_TILE_OPERATION_COUNT;"
            )
    for function in (8, 9, 10, 11, 12):
        print(
            f"    assert DecodeTileOperation(TileDecode_TMA, {bit_literal(function, 12)}) "
            "== PTO_TILE_OPERATION_COUNT;"
        )
    print(
        f"    assert DecodeTileOperation(TileDecode_TEPL, {bit_literal(0x400, 12)}) == PTO_TILE_OPERATION_COUNT;"
    )
    print(
        f"    assert DecodeTileOperation(TileDecode_TMA, {bit_literal(32, 12)}) == PTO_TILE_OPERATION_COUNT;"
    )
    print(
        f"    assert DecodeTileOperation(TileDecode_CUBE, {bit_literal(32, 12)}) == PTO_TILE_OPERATION_COUNT;"
    )
    print(
        f"    assert SystemRegisterAccessOf({bit_literal(0x00FFFF, 24)}) == SystemRegisterAccess_Unknown;"
    )
    print(
        f"    assert SystemRegisterAccessOf({bit_literal(0x100000, 24)}) == SystemRegisterAccess_Unknown;"
    )
    print("end;")


if __name__ == "__main__":
    main()
