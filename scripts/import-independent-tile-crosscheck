#!/usr/bin/env python3
"""Record a non-redistributive independent tile-document cross-check."""

from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--documents-dir", type=Path, required=True)
    parser.add_argument(
        "--pto-manifest", type=Path, default=Path("spec/catalog/tile-operations.json")
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=Path("spec/evidence/independent-tile-crosscheck.json"),
    )
    args = parser.parse_args()

    docs = args.documents_dir.resolve()
    root = Path(
        subprocess.run(
            ["git", "-C", str(docs), "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    )
    operations = json.loads(args.pto_manifest.read_text(encoding="utf-8"))["operations"]
    commit = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    dirty = bool(
        subprocess.run(
            ["git", "-C", str(root), "status", "--porcelain"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout
    )

    results = []
    for operation in operations:
        name = operation["name"]
        path = docs / f"{name}.md"
        result = {"name": name}
        if not path.exists():
            result.update(
                {
                    "disposition": "incomplete",
                    "reason": "no matching English instruction page in the independent reference",
                }
            )
        else:
            body = path.read_text(encoding="utf-8-sig")
            result.update(
                {
                    "document": f"{name}.md",
                    "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
                }
            )
            if name == "TPREFETCH":
                result.update(
                    {
                        "disposition": "conflict",
                        "reason": (
                            "the independent reference documents a destination tile while the higher-precedence "
                            "canonical PTO contract makes TPREFETCH destination-free"
                        ),
                    }
                )
            elif "Semantics are instruction-specific" in body:
                result.update(
                    {
                        "disposition": "incomplete",
                        "reason": "page has placeholder rather than operation-specific mathematics",
                    }
                )
            elif (
                "## Math Interpretation" in body
                or "## Mathematical Interpretation" in body
            ):
                result.update(
                    {
                        "disposition": "agree",
                        "reason": (
                            "operation identity, operand role, and mathematical description agree; "
                            "backend-only constraints are non-normative"
                        ),
                    }
                )
            else:
                result.update(
                    {
                        "disposition": "incomplete",
                        "reason": "page lacks a mathematical interpretation section",
                    }
                )
        results.append(result)

    output = {
        "schema_version": 1,
        "source_class": "private-independent-tile-reference",
        "commit": commit,
        "worktree_dirty": dirty,
        "license": "proprietary-no-project-license",
        "policy": (
            "semantic cross-check only; no private prose, code, diagrams, names, or repository paths are redistributed"
        ),
        "operation_count": len(results),
        "operations": results,
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(
        json.dumps(output, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    counts: dict[str, int] = {}
    for result in results:
        counts[result["disposition"]] = counts.get(result["disposition"], 0) + 1
    print(f"wrote {len(results)} cross-check rows: {counts}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
