#!/usr/bin/env python3
"""Generate the fail-closed S5-T2 numeric-conformance readiness ledger."""

from __future__ import annotations

import argparse
import json
from collections import Counter
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
NUMERIC_CONTRACTS = ROOT / "spec/evidence/numeric-contracts.json"
NUMERIC_PROFILE_IDENTITIES = ROOT / "spec/catalog/numeric-profile-identities.json"
NUMERIC_VARIATION_OWNERSHIP = (
    ROOT / "spec/evidence/numeric-variation-point-ownership.json"
)
PUBLIC_NUMERIC_TYPE_BASELINE = (
    ROOT / "spec/evidence/public-numeric-type-baseline.json"
)
PUBLIC_INTEGER_CONVERSION = (
    ROOT / "spec/evidence/public-integer-conversion-contract.json"
)
NUMERIC_SUBNORMAL_CONTRACT = ROOT / "spec/evidence/numeric-subnormal-contract.json"
NUMERIC_SPECIAL_VALUE_CONTRACT = (
    ROOT / "spec/evidence/numeric-special-value-contract.json"
)
DEFAULT_OUTPUT = ROOT / "spec/evidence/numeric-conformance-readiness.json"


LANE_SPECS: tuple[dict[str, Any], ...] = (
    {
        "id": "N1",
        "title": "scalar arithmetic",
        "contract_domains": ["scalar-binary", "scalar-unary", "scalar-fused"],
        "unbound_hooks": ["FloatingExponential"],
        "required_vector_classes": [
            "normal",
            "boundary",
            "signed-zero",
            "subnormal",
            "infinity",
            "NaN",
            "rounding-tie",
            "overflow",
            "underflow",
            "divide-by-zero",
            "domain-error",
            "exception-flags",
        ],
        "oracle_requirement": "Use a versioned independent arithmetic oracle where the selected profile matches it; otherwise use reviewed, immutable target capture for the divergent rule.",
    },
    {
        "id": "N2",
        "title": "scalar conversion",
        "contract_domains": [
            "scalar-fp-to-integer",
            "scalar-fp-convert",
            "scalar-integer-to-fp",
        ],
        "unbound_hooks": ["FloatingRoundNearest"],
        "required_vector_classes": [
            "normal",
