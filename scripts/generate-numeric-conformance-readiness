            "underflow",
            "saturation-or-indefinite",
            "exception-flags",
        ],
        "oracle_requirement": "Use a versioned independent format-conversion oracle plus reviewed target capture for saturation, indefinite, payload, or flag rules that the selected profile makes target-specific.",
    },
    {
        "id": "N3",
        "title": "tile elementwise",
        "contract_domains": [
