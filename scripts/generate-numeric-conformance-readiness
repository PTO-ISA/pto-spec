            "divide-by-zero",
            "domain-error",
            "saturation",
            "ordered-unordered-compare",
        ],
        "oracle_requirement": "Use independent elementwise and elementary-function oracles with explicit accuracy bounds, augmented by immutable target capture for carrier or saturation rules outside those oracle contracts.",
    },
    {
        "id": "N4",
        "title": "tile conversion",
        "contract_domains": ["tile-convert"],
        "unbound_hooks": [],
