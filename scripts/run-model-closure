#!/usr/bin/env python3
"""Run ASL-MODEL's exact LLVM-to-ASL closure from PTO-SPEC release CI."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.model_closure import invocation_path  # noqa: E402
from scripts.release_preflight import affected_pto_ids, approved_release_identity  # noqa: E402
GITHUB_REPOSITORY = re.compile(
    r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\Z"
)


def _git(root: Path, *arguments: str) -> str:
    return subprocess.run(
        ["git", "-C", str(root), *arguments],
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    ).stdout.strip()


def _canonical_repository_url(repository: str) -> str:
    if GITHUB_REPOSITORY.fullmatch(repository) is None:
        raise ValueError("repository origin is not a canonical GitHub HTTPS URL")
    if repository.endswith(".git"):
        return repository
    return repository + ".git"


def _repository(root: Path) -> str:
    return _canonical_repository_url(_git(root, "remote", "get-url", "origin"))


def _identity() -> dict[str, str]:
    return approved_release_identity(ROOT)


def _affected_pto_ids(document: object) -> list[str]:
    return affected_pto_ids(document)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--asl-model-root", required=True, type=Path)
    parser.add_argument("--llvm-root", required=True, type=Path)
    parser.add_argument("--ndf-root", required=True, type=Path)
    parser.add_argument("--aslref-root", required=True, type=Path)
    parser.add_argument("--asl-spec", required=True, type=Path)
    parser.add_argument("--clang", required=True, type=Path)
    parser.add_argument("--llvm-mc", required=True, type=Path)
    parser.add_argument("--ld-lld", required=True, type=Path)
    parser.add_argument("--aslref", required=True, type=Path)
    parser.add_argument("--impact", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument(
        "--selection",
        type=Path,
        default=ROOT / "spec/model-closure-selection.json",
    )
    parser.add_argument("--mandatory-case-id", action="append", default=[])
    parser.add_argument("--workflow-commit", required=True)
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--run-attempt", required=True, type=int)
    parser.add_argument("--timestamp", required=True)
    parser.add_argument("--runner-image", required=True)
    parser.add_argument("--builder-identity", required=True)
    parser.add_argument("--target", default="linx64-unknown-none-elf")
    arguments = parser.parse_args()
    try:
        impact_path = arguments.impact.resolve()
        asl_model_root = arguments.asl_model_root.resolve()
        llvm_root = arguments.llvm_root.resolve()
        output_root = arguments.output.resolve()
        impact = json.loads(impact_path.read_text(encoding="utf-8"))
        affected = _affected_pto_ids(impact)
        selection = json.loads(arguments.selection.read_text(encoding="utf-8"))
        if (
            selection.get("schema") != "pto.model-closure-selection.v1"
            or selection.get("release") != _identity()["release"]
        ):
            raise ValueError("model closure selection identity mismatch")
        selected_mandatory = selection.get("mandatory_case_ids")
        if (
            not isinstance(selected_mandatory, list)
            or not selected_mandatory
            or selected_mandatory != sorted(set(selected_mandatory))
        ):
            raise ValueError("model closure selection has invalid mandatory cases")
        if arguments.mandatory_case_id and (
            sorted(set(arguments.mandatory_case_id)) != selected_mandatory
        ):
            raise ValueError("command-line mandatory cases differ from release selection")
        request = {
            "schema": "pto-closure-request-v1",
            "identity": _identity(),
            "repositories": {
                "pto_spec": {
                    "repository": _repository(ROOT),
                    "commit": _git(ROOT, "rev-parse", "HEAD"),
                    "path": str(ROOT),
                },
                "llvm": {
                    "repository": _repository(llvm_root),
                    "commit": _git(llvm_root, "rev-parse", "HEAD"),
                    "path": str(llvm_root),
                },
                "asl_model": {
                    "repository": _repository(asl_model_root),
                    "commit": _git(asl_model_root, "rev-parse", "HEAD"),
                    "path": str(asl_model_root),
                },
            },
            "policy": {
                "affected_pto_ids": affected,
                "mandatory_case_ids": selected_mandatory,
            },
        }
        output_root.mkdir(parents=True, exist_ok=False)
        request_path = output_root / "closure-request.json"
        request_path.write_text(
            json.dumps(request, sort_keys=True, separators=(",", ":")) + "\n",
            encoding="utf-8",
        )
        evidence = output_root / "evidence"
        subprocess.run(
            [
                str(asl_model_root / "scripts/pto-closure"),
                "--request", str(request_path),
                "--ndf-impact", str(impact_path),
                "--ndf-root", str(invocation_path(arguments.ndf_root)),
                "--aslref-root", str(invocation_path(arguments.aslref_root)),
                "--asl-spec", str(invocation_path(arguments.asl_spec)),
                "--clang", str(invocation_path(arguments.clang)),
                "--llvm-mc", str(invocation_path(arguments.llvm_mc)),
                "--ld-lld", str(invocation_path(arguments.ld_lld)),
                "--aslref", str(invocation_path(arguments.aslref)),
                "--target", arguments.target,
                "--output", str(evidence),
                "--workflow-repository", "PTO-ISA/pto-spec",
                "--workflow-path", ".github/workflows/release.yml",
                "--workflow-commit", arguments.workflow_commit,
                "--run-id", arguments.run_id,
                "--run-attempt", str(arguments.run_attempt),
                "--timestamp", arguments.timestamp,
                "--runner-image", arguments.runner_image,
                "--builder-identity", arguments.builder_identity,
            ],
            check=True,
            cwd=asl_model_root,
        )
        subprocess.run(
            [
                str(ROOT / "scripts/check-model-closure"),
                "--semantic-payload", str(evidence / "closure-semantic-payload.json"),
                "--run-envelope", str(evidence / "closure-run-envelope.json"),
                "--pto-commit", _git(ROOT, "rev-parse", "HEAD"),
                "--llvm-repository", _repository(llvm_root),
                "--llvm-commit", _git(llvm_root, "rev-parse", "HEAD"),
                "--asl-model-commit", _git(asl_model_root, "rev-parse", "HEAD"),
                "--workflow-commit", arguments.workflow_commit,
                "--run-id", arguments.run_id,
                "--run-attempt", str(arguments.run_attempt),
            ],
            check=True,
            cwd=ROOT,
        )
    except (OSError, ValueError, json.JSONDecodeError, subprocess.CalledProcessError) as error:
        print(f"error: model closure failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
