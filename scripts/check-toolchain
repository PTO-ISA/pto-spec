#!/usr/bin/env bash
# Canary checks for the pinned ASLRef.
#
# Every other ASL check in this repository reduces to "ASLRef exited zero".
# While the specification is empty that claim is vacuous, and a broken wrapper,
# a mis-resolved pin, or a build that silently stopped producing a real binary
# would still report success. These canaries assert that the pinned toolchain
# accepts valid ASL1, rejects invalid ASL1, and propagates execution outcomes.
#
# A rejection is matched against the diagnostic ASLRef emits for that error
# class, not merely against a nonzero exit. A fixture that failed in the wrong
# phase would otherwise still satisfy the canary: a parse error would pass the
# type-checking canary and prove nothing about type-checking.
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

aslref=${ASLREF:-./scripts/aslref}

# The pinned ASLRef may append a stable error code in parentheses while
# preserving the diagnostic class. Match the complete class prefix and the
# optional code, never merely a nonzero exit.
parse_error='ASL Grammar error( \([[:alnum:]_]+\))?:'
type_error='ASL Type error( \([[:alnum:]_]+\))?:'
dynamic_error='ASL Dynamic error( \([[:alnum:]_]+\))?:'

captured=""
captured_status=0

run_aslref() {
    set +e
    captured=$("$aslref" "$@" 2>&1)
    captured_status=$?
    set -e
}

report() {
    echo "error: $1" >&2
    echo "the validation gate cannot be trusted; ASLRef reported:" >&2
    printf '%s\n' "$captured" >&2
    exit 1
}

expect_accept() {
    local fixture=$1
    run_aslref --type-check-strict --no-exec "$fixture"
    [[ $captured_status -eq 0 ]] ||
        report "ASLRef rejected known-good $fixture"
}

expect_reject() {
    local fixture=$1 diagnostic_pattern=$2
    run_aslref --type-check-strict --no-exec "$fixture"
    [[ $captured_status -ne 0 ]] ||
        report "ASLRef accepted known-bad $fixture"
    printf '%s' "$captured" | grep -qE "$diagnostic_pattern" ||
        report "$fixture was rejected, but not with '$diagnostic_pattern', so it does not exercise that error class"
}

expect_exec_success() {
    local fixture=$1
    run_aslref --type-check-strict "$fixture"
    [[ $captured_status -eq 0 ]] ||
        report "ASLRef failed to execute $fixture, which returns zero from main"
}

expect_exec_failure() {
    local fixture=$1 diagnostic_pattern=$2
    run_aslref --type-check-strict "$fixture"
    [[ $captured_status -ne 0 ]] ||
        report "ASLRef reported success for $fixture, which fails at run time"
    printf '%s' "$captured" | grep -qE "$diagnostic_pattern" ||
        report "$fixture failed, but not with '$diagnostic_pattern', so the failure did not come from execution"
}

echo "toolchain canary: pinned ASLRef $(cat .aslref-version)"

expect_accept tests/canary/accept.asl
expect_reject tests/canary/reject-parse.asl "$parse_error"
expect_reject tests/canary/reject-type.asl "$type_error"
expect_exec_success tests/canary/exec-pass.asl
expect_exec_failure tests/canary/exec-fail.asl "$dynamic_error"

echo "toolchain canary: accept, parse-reject, type-reject, exec-pass, and exec-fail all behaved as expected"
