#!/usr/bin/env python3
"""Prove the ASL test shards partition the reachable canonical tests exactly once."""

from __future__ import annotations

import re
import subprocess
from collections import Counter
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CALL_RE = re.compile(r"^\s*([A-Za-z][A-Za-z0-9_]*)\(\);\s*$")
MAIN_RE = re.compile(r"^func\s+main\(\)\s*=>\s*integer\s*$")
SUBPROGRAM_RE = re.compile(
    r"^(?:func|procedure)\s+([A-Za-z][A-Za-z0-9_]*)\s*\(", re.MULTILINE
)
RESET = "ResetProfileState"


def main_calls(path: Path) -> list[str]:
    """Return direct zero-argument calls from the file's sole main body."""
    lines = path.read_text(encoding="utf-8").splitlines()
    starts = [index for index, line in enumerate(lines) if MAIN_RE.match(line)]
    if len(starts) != 1:
        fail(f"{path.relative_to(ROOT)} must define exactly one integer main")

    index = starts[0] + 1
    while index < len(lines) and not lines[index].strip():
        index += 1
    if index >= len(lines) or lines[index].strip() != "begin":
        fail(f"{path.relative_to(ROOT)} main must begin with begin")

    result: list[str] = []
    saw_return = False
    index += 1
    while index < len(lines):
        statement = lines[index].strip()
        index += 1
        if not statement or statement.startswith("//"):
            continue
        if statement == "return 0;":
            if saw_return:
                fail(f"{path.relative_to(ROOT)} main contains duplicate returns")
            saw_return = True
            continue
        if statement == "end;":
            if not saw_return:
                fail(f"{path.relative_to(ROOT)} main must return 0")
            if any(line.strip() for line in lines[index:]):
                fail(f"{path.relative_to(ROOT)} contains content after main")
            return result
        if saw_return:
            fail(f"{path.relative_to(ROOT)} main executes after return 0")
        match = CALL_RE.fullmatch(statement)
        if not match:
            fail(
                f"{path.relative_to(ROOT)} main contains an unsupported statement: {statement}"
            )
        result.append(match.group(1))

    fail(f"{path.relative_to(ROOT)} main is missing end;")


def test_subprogram_graph(paths: list[Path]) -> tuple[set[str], dict[str, set[str]]]:
    """Build a conservative zero-argument call graph for test subprograms."""
    definitions: set[str] = set()
    graph: dict[str, set[str]] = {}
    for path in paths:
        body = path.read_text(encoding="utf-8")
        matches = list(SUBPROGRAM_RE.finditer(body))
        for position, match in enumerate(matches):
            name = match.group(1)
            if name in definitions:
                fail(f"duplicate test subprogram definition: {name}")
            definitions.add(name)
            end = (
                matches[position + 1].start()
                if position + 1 < len(matches)
                else len(body)
            )
            graph[name] = {
                call.group(1)
                for line in body[match.end() : end].splitlines()
                if (call := CALL_RE.match(line))
            }
    return definitions, graph


def fail(message: str) -> None:
    raise SystemExit(f"error: {message}")


def main() -> None:
    canonical_path = ROOT / "tests/asl/main.asl"
    canonical_calls = main_calls(canonical_path)
    if not canonical_calls or canonical_calls[0] != RESET:
        fail(f"{canonical_path.relative_to(ROOT)} must reset profile state first")
    canonical_body = canonical_calls[1:]
    duplicate_canonical = sorted(
        name for name, count in Counter(canonical_body).items() if count != 1
    )
    if duplicate_canonical:
        fail(
            f"canonical main contains duplicate calls: {', '.join(duplicate_canonical)}"
        )

    listed = subprocess.check_output(
        ["make", "--no-print-directory", "print-asl-test-shards"],
        cwd=ROOT,
        text=True,
    ).splitlines()
    if not listed:
        fail("ASL_TEST_SHARD_MAINS is empty")
    duplicate_paths = sorted(
        path for path, count in Counter(listed).items() if count != 1
    )
    if duplicate_paths:
        fail(f"ASL_TEST_SHARD_MAINS contains duplicates: {', '.join(duplicate_paths)}")
    discovered = sorted(
        str(path.relative_to(ROOT))
        for path in (ROOT / "tests/asl/shards").glob("*.asl")
    )
    if sorted(listed) != discovered:
        missing_listed = sorted(set(discovered) - set(listed))
        missing_files = sorted(set(listed) - set(discovered))
        details = []
        if missing_listed:
            details.append(f"unlisted files: {', '.join(missing_listed)}")
        if missing_files:
            details.append(f"listed but absent: {', '.join(missing_files)}")
        fail(
            f"ASL shard list does not match the checked-in files ({'; '.join(details)})"
        )

    shard_calls: list[str] = []
    for relative in listed:
        path = ROOT / relative
        if not path.is_file():
            fail(f"ASL_TEST_SHARD_MAINS lists a missing file: {relative}")
        current = main_calls(path)
        if not current or current[0] != RESET:
            fail(f"{relative} must reset profile state first")
        if len(current) == 1:
            fail(f"{relative} has no canonical test calls")
        shard_calls.extend(current[1:])

    counts = Counter(shard_calls)
    duplicates = sorted(name for name, count in counts.items() if count != 1)
    missing = sorted(set(canonical_body) - set(shard_calls))
    extra = sorted(set(shard_calls) - set(canonical_body))
    if duplicates:
        fail(f"test shard calls are duplicated: {', '.join(duplicates)}")
    if missing:
        fail(f"canonical test calls are absent from shards: {', '.join(missing)}")
    if extra:
        fail(
            f"test shards call functions absent from canonical main: {', '.join(extra)}"
        )

    test_sources = subprocess.check_output(
        ["make", "--no-print-directory", "print-asl-tests"],
        cwd=ROOT,
        text=True,
    ).splitlines()
    library_paths = [
        ROOT / relative for relative in test_sources if relative != "tests/asl/main.asl"
    ]
    definitions, graph = test_subprogram_graph(library_paths)
    reachable = set(canonical_body)
    pending = list(canonical_body)
    while pending:
        current = pending.pop()
        for target in graph.get(current, set()):
            if target not in reachable:
                reachable.add(target)
                pending.append(target)
    required = {name for name in definitions if name.startswith(("Test", "Validate"))}
    unreachable = sorted(required - reachable)
    if unreachable:
        fail(
            f"test subprograms are unreachable from canonical main: {', '.join(unreachable)}"
        )

    print(
        f"ASL test shards passed: {len(listed)} shards partition "
        f"{len(canonical_body)} canonical calls and reach {len(required)} test subprograms"
    )


if __name__ == "__main__":
    main()
