#!/usr/bin/env python3
"""Generate the checked-in PTO instruction reference from canonical catalogs."""

from __future__ import annotations

import argparse
import json
import sys
from collections import Counter, defaultdict
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
OUT_DIR = ROOT / "docs" / "instructions"


SCALAR_FAMILY_ORDER = ("AGU", "ALU", "AMO", "BRU", "FSU", "SYS")

SCALAR_FAMILY_DESCRIPTIONS = {
    "AGU": "Address generation, scalar memory transfer, pair transfer, and prefetch forms.",
    "ALU": "Integer arithmetic, logical, multiply, divide, and bitfield forms.",
    "AMO": "Atomic memory operation, reservation, conditional store, compare-and-swap, and DMA forms.",
    "BRU": "Branch, jump, compare, and commit-control forms.",
    "FSU": "Floating and carrier-format arithmetic, comparison, conversion, and fused forms.",
    "SYS": "System-register, maintenance, request, and architecture-control forms.",
}

COMMAND_GROUP_ORDER = (
    "General",
    "General Manager",
    "Bundle Argument",
    "Bundle Dimension",
    "Bundle Data Attribute",
    "Bundle Control Attribute",
    "Bundle Offset",
    "Bundle Input & Output",
    "Bundle Hint",
    "BSTART",
    "C.BSTART",
    "Bundle Split",
)

TILE_FAMILY_DESCRIPTIONS = {
    "TEPL": "Element, scalar, reduction, expansion, generation, conversion, rearrangement, and utility operations.",
    "TLSU": "Tile memory, movement, gather, scatter, and prefetch operations.",
    "CUBE": "Matrix operations.",
}


def load(relative: str) -> dict:
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def md_escape(value: object) -> str:
    text = "" if value is None else str(value)
    return (
        text.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("|", "\\|")
        .replace("\n", "<br>")
    )


def link(label: str, target: str) -> str:
    return f"[{md_escape(label)}]({target})"


def table(headers: list[str], rows: list[list[object]]) -> str:
    lines = [
        "| " + " | ".join(md_escape(header) for header in headers) + " |",
        "| " + " | ".join("---" for _ in headers) + " |",
    ]
    lines.extend(
        "| " + " | ".join(md_escape(cell) for cell in row) + " |" for row in rows
    )
    return "\n".join(lines)


def format_encoding(row: dict) -> str:
    parts = []
    for part in row.get("encoding", []):
        index = part.get("index", 0)
        width = part["width_bits"]
        parts.append(f"{index}:{width}b mask={part['mask']} match={part['match']}")
    for variant in row.get("encoding_variants", []):
        encoded = ", ".join(
            f"{part.get('index', 0)}:{part['width_bits']}b mask={part['mask']} match={part['match']}"
            for part in variant["encoding"]
        )
        parts.append(f"{variant['name']} (Function {variant['function']}): {encoded}")
    return "<br>".join(parts)


def format_fields(row: dict) -> str:
    fields = []
    for field in row.get("fields", []):
        pieces = ",".join(
            f"i{piece['instruction_lsb']}:{piece['width']}→v{piece['value_lsb']}"
            for piece in field.get("pieces", [])
        )
        fields.append(
            f"{field['name']}[{field['width']}] {field.get('signedness', 'encoding-defined')} ({pieces})"
        )
    return "<br>".join(fields) if fields else "none"


def format_constraints(row: dict) -> str:
    constraints = []
    for constraint in row.get("constraints", []):
        if constraint["operator"] == "not-equal":
            value = constraint["value"]
        elif constraint["operator"] == "one-of":
            value = "{" + ", ".join(str(item) for item in constraint["values"]) + "}"
        else:
            raise ValueError(f"unsupported form constraint: {constraint['operator']}")
        constraints.append(f"{constraint['field']} {constraint['operator']} {value}")
    return "<br>".join(constraints) if constraints else "none"


def format_operands(row: dict) -> str:
    operands = []
    for operand in row.get("operands", []):
        operands.append(f"{operand['field']}:{operand['role']}")
    return "<br>".join(operands) if operands else "none"


def format_arguments(row: dict) -> str:
    arguments = []
    for argument in row.get("arguments", []):
        if "constant" in argument:
            arguments.append(argument["constant"])
        elif "operand" in argument:
            arguments.append(argument["operand"])
        else:
            arguments.append(json.dumps(argument, sort_keys=True))
    return "<br>".join(arguments) if arguments else "none"


def tile_selector(row: dict) -> str:
    if row["family"] == "TEPL":
        return (
            f"mode={row['mode']}, function={row['function']}, "
            f"selector={row['selector']}"
        )
    return f"function={row['function']}"


def tile_sort_key(row: dict) -> tuple[int, str]:
    if row["family"] == "TEPL":
        return ((row["mode"] << 5) | row["function"], row["name"])
    return (int(row["function"]), row["name"])


def register_address(row: dict) -> str:
    if "address" in row:
        return row["address"]
    low_index = int(row["low_index"], 16)
    if "fixed_context" in row:
        return f"0x{row['fixed_context']:X}{low_index:03X}"
    return f"0x{{n}}{low_index:03X}"


def register_sort_key(row: dict) -> tuple[int, int, str]:
    base = int(row.get("address", row.get("low_index", "0x0")), 16)
    context = int(row.get("fixed_context", -1))
    return (base, context, row["name"])


def generated_header(title: str) -> list[str]:
    return [
        f"# {title}",
        "",
        "<!-- GENERATED by scripts/generate-instruction-reference; do not edit by hand. -->",
        "",
        "This page is generated from the canonical PTO catalogs under `spec/catalog/`.",
        "",
    ]


def scalar_page_rows(forms: list[dict]) -> list[list[object]]:
    return [
        [
            row["mnemonic"],
            row["asm"],
            row["length_bits"],
            row["encoding_kind"],
            row["semantic_group"],
            row["semantic_handler"],
            format_encoding(row),
            format_fields(row),
            format_constraints(row),
        ]
        for row in sorted(
            forms, key=lambda item: (item["mnemonic"], item["asm"], item["form_id"])
        )
    ]


def render_index(scalar: dict, command: dict, tile: dict, system: dict) -> str:
    scalar_forms = scalar["forms"]
    command_forms = command["forms"]
    tile_ops = tile["operations"]
    system_regs = system["registers"]
    scalar_family_counts = Counter(row["semantic_family"] for row in scalar_forms)
    command_family_counts = Counter(row["semantic_family"] for row in command_forms)
    tile_family_counts = Counter(row["family"] for row in tile_ops)
    lines = generated_header("PTO instruction reference")
    lines.extend(
        [
            "## Accepted surfaces",
            "",
            table(
                ["Surface", "Count", "Reference"],
                [
                    [
                        "Scalar encoded forms",
                        len(scalar_forms),
                        link("scalar summary", "scalar.md"),
                    ],
                    [
                        "Bundle/command encoded forms",
                        len(command_forms),
                        link("block/command", "block-command.md"),
                    ],
                    [
                        "Direct tile operations",
                        len(tile_ops),
                        link("tile operations", "tile.md"),
                    ],
                    [
                        "System registers",
                        len(system_regs),
                        link("system registers", "system-registers.md"),
                    ],
                ],
            ),
            "",
            f"The PTO encoded instruction catalog contains {len(scalar_forms) + len(command_forms)} forms: "
            f"{len(scalar_forms)} scalar forms and {len(command_forms)} bundle/command forms. "
            "Direct tile operations are selector-catalog operations with explicit decoded operands and effects. "
            "The separate vector execution instruction class is outside the PTO ISA scope.",
            "",
            "Bundle is the grouped-execution term used throughout this specification. The stable `BSTART`, "
            "`BSTOP`, `B.*`, and BPC spellings use `B` for bundle. Separately, `BLOCKNUM`, `BLOCKID`, and "
            "`CROSS_BID` identify virtual core blocks. Their encodings and operand layouts are unchanged.",
            "",
            "## Scalar families",
            "",
            table(
                ["Family", "Forms", "Page"],
                [
                    [
                        family,
                        scalar_family_counts[family],
                        link(family, f"scalar-{family.lower()}.md"),
                    ]
                    for family in SCALAR_FAMILY_ORDER
                ],
            ),
            "",
            "## Bundle/command families",
            "",
            table(
                ["Family", "Forms"],
                [
                    [family, command_family_counts[family]]
                    for family in sorted(command_family_counts)
                ],
            ),
            "",
            "## Tile families",
            "",
            table(
                ["Family", "Operations", "Role"],
                [
                    [
                        family,
                        tile_family_counts[family],
                        TILE_FAMILY_DESCRIPTIONS[family],
                    ]
                    for family in ("TEPL", "TLSU", "CUBE")
                ],
            ),
            "",
        ]
    )
    return "\n".join(lines)


def render_scalar_summary(scalar: dict) -> str:
    forms = scalar["forms"]
    family_counts = Counter(row["semantic_family"] for row in forms)
    handler_counts = Counter(row["semantic_handler"] for row in forms)
    length_counts = Counter(row["length_bits"] for row in forms)
    lines = generated_header("Scalar instruction forms")
    lines.extend(
        [
            "## Summary",
            "",
            table(
                ["Metric", "Value"],
                [
                    ["Accepted forms", len(forms)],
                    ["Operand fields", scalar["operand_field_count"]],
                    ["Operand pieces", scalar["operand_piece_count"]],
                    ["Semantic handlers", scalar["semantic_handler_count"]],
                    [
                        "Lengths",
                        ", ".join(
                            f"{bits}b={length_counts[bits]}"
                            for bits in sorted(length_counts)
                        ),
                    ],
                ],
            ),
            "",
            "## Families",
            "",
            table(
                ["Family", "Forms", "Description", "Page"],
                [
                    [
                        family,
                        family_counts[family],
                        SCALAR_FAMILY_DESCRIPTIONS[family],
                        link(f"scalar-{family.lower()}", f"scalar-{family.lower()}.md"),
                    ]
                    for family in SCALAR_FAMILY_ORDER
                ],
            ),
            "",
            "## Handler coverage",
            "",
            table(
                ["Handler", "Forms"],
                [[handler, count] for handler, count in sorted(handler_counts.items())],
            ),
            "",
        ]
    )
    return "\n".join(lines)


def render_scalar_family(scalar: dict, family: str) -> str:
    forms = [row for row in scalar["forms"] if row["semantic_family"] == family]
    group_counts = Counter(row["semantic_group"] for row in forms)
    lines = generated_header(f"Scalar {family} forms")
    lines.extend(
        [
            SCALAR_FAMILY_DESCRIPTIONS[family],
            "",
            "## Groups",
            "",
            table(
                ["Group", "Forms"],
                [[group, count] for group, count in sorted(group_counts.items())],
            ),
            "",
            "## Forms",
            "",
            table(
                [
                    "Mnemonic",
                    "Assembly",
                    "Length",
                    "Kind",
                    "Group",
                    "Handler",
                    "Encoding",
                    "Fields",
                    "Constraints",
                ],
                scalar_page_rows(forms),
            ),
            "",
        ]
    )
    return "\n".join(lines)


def render_command(command: dict) -> str:
    forms = command["forms"]
    group_counts = Counter(row["semantic_group"] for row in forms)
    handler_counts = Counter(row["semantic_handler"] for row in forms)
    by_group = defaultdict(list)
    for row in forms:
        by_group[row["semantic_group"]].append(row)
    ordered_groups = [group for group in COMMAND_GROUP_ORDER if group in by_group]
    ordered_groups.extend(sorted(set(by_group) - set(ordered_groups)))
    lines = generated_header("Bundle/command instruction forms")
    lines.extend(
        [
            "Bundle/command forms update the bundle descriptor, bundle arguments, bundle-visible attributes, "
            "and bundle-control transfer state. They are encoded instruction forms, not direct tile selectors.",
            "",
            "The `B` prefix in `BSTART`, `BSTOP`, `C.BSTART`, `C.BSTOP`, and `B.*` means bundle. BPC is the "
            "bundle-body program counter. `BID` in `CROSS_BID` instead means virtual core-block identifier. "
            "These are stable ISA spellings.",
            "",
            f"The active PTO ISA freezes this {len(forms)}-form command ABI. `BSTART.TEPL` carries the two-bit Mode and "
            "five-bit Function fields; named TLSU and CUBE starts each have one command encoding. `B.IOT`, "
            "`B.DATR`, and `B.CATR` define tile lifetime, data attributes, and bundle-control attributes. "
            "The removed `B.ARG`, generic `BSTART.CUBE`, and generic `BSTART.FIXP` forms are not accepted. "
            "See [ADR 0052](../architecture-decisions/0052-pto-isa-0580-davincioo-catalog.md).",
            "",
            "## Summary",
            "",
            table(
                ["Metric", "Value"],
                [
                    ["Accepted forms", len(forms)],
                    ["Operand fields", command["operand_field_count"]],
                    ["Operand pieces", command["operand_piece_count"]],
                    ["Semantic handlers", command["semantic_handler_count"]],
                ],
            ),
            "",
            "## Groups",
            "",
            table(
                ["Group", "Forms"],
                [[group, group_counts[group]] for group in ordered_groups],
            ),
            "",
            "## Handler coverage",
            "",
            table(
                ["Handler", "Forms"],
                [[handler, count] for handler, count in sorted(handler_counts.items())],
            ),
            "",
        ]
    )
    for group in ordered_groups:
        lines.extend(
            [
                f"## {group}",
                "",
                table(
                    [
                        "Mnemonic",
                        "Assembly",
                        "Length",
                        "Kind",
                        "Handler",
                        "Summary",
                        "Encoding",
                        "Fields",
                        "Constraints",
                    ],
                    [
                        [
                            row["mnemonic"],
                            row["asm"],
                            row["length_bits"],
                            row["encoding_kind"],
                            row["semantic_handler"],
                            row.get("semantic_summary", ""),
                            format_encoding(row),
                            format_fields(row),
                            format_constraints(row),
                        ]
                        for row in sorted(
                            by_group[group],
                            key=lambda item: (
                                item["mnemonic"],
                                item["asm"],
                                item["form_id"],
                            ),
                        )
                    ],
                ),
                "",
            ]
        )
    return "\n".join(lines)


def render_tile(tile: dict) -> str:
    operations = tile["operations"]
    by_family = defaultdict(list)
    for row in operations:
        by_family[row["family"]].append(row)
    lines = generated_header("Direct tile operations")
    lines.extend(
        [
            "Direct tile operations are selected by the tile operation catalog and execute against explicit "
            "tile, scalar, memory, and descriptor operands. The selector catalog is normative for operation "
            "identity, operand roles, semantic handler, and argument order.",
            "",
            "In the active PTO ISA, TEPL identity is `Mode[1:0] : Function[4:0]`. Named TLSU and CUBE operations "
            "bind directly to their corresponding `BSTART.*` command forms. CUBE operations carry an explicit Local "
            "destination D; ACC variants also carry an explicit Local input C, with `D == C` defined as read-old/write-new. "
            "Accepted `B.IOT` forms encode `PE_MASK`, `TSize`, and a 2-bit destination Tile field without reuse bits. `B.DATR` fields "
            "apply only to the operation sets recorded in the catalog. See "
            "[ADR 0052](../architecture-decisions/0052-pto-isa-0580-davincioo-catalog.md).",
            "",
            "## Families",
            "",
            table(
                ["Family", "Operations", "Role"],
                [
                    [family, len(by_family[family]), TILE_FAMILY_DESCRIPTIONS[family]]
                    for family in ("TEPL", "TLSU", "CUBE")
                ],
            ),
            "",
        ]
    )
    for family in ("TEPL", "TLSU", "CUBE"):
        lines.extend(
            [
                f"## {family}",
                "",
                table(
                    [
                        "Name",
                        "Selector",
                        "Handler",
                        "Operands",
                        "Arguments",
                    ],
                    [
                        [
                            row["name"],
                            tile_selector(row),
                            row["semantic_handler"],
                            format_operands(row),
                            format_arguments(row),
                        ]
                        for row in sorted(by_family[family], key=tile_sort_key)
                    ],
                ),
                "",
            ]
        )
    return "\n".join(lines)


def render_system_registers(system: dict) -> str:
    registers = system["registers"]
    traps = system["trap_numbers"]
    behavior_by_register = {
        register: behavior
        for behavior in system["behavior_classes"]
        for register in behavior["registers"]
    }
    scope_counts = Counter(row["scope"] for row in registers)
    access_counts = Counter(row["access"] for row in registers)
    lines = generated_header("System registers and trap numbers")
    lines.extend(
        [
            "## Register summary",
            "",
            table(
                ["Metric", "Value"],
                [
                    ["Address bits", system["address_bits"]],
                    ["Canonical address bits", system["canonical_address_bits"]],
                    ["Register definitions", system["register_definition_count"]],
                    ["Trap numbers", system["trap_count"]],
                    [
                        "Scopes",
                        ", ".join(
                            f"{scope}={scope_counts[scope]}"
                            for scope in sorted(scope_counts)
                        ),
                    ],
                    [
                        "Access classes",
                        ", ".join(
                            f"{access}={access_counts[access]}"
                            for access in sorted(access_counts)
                        ),
                    ],
                ],
            ),
            "",
            "## Registers",
            "",
            table(
                [
                    "Name",
                    "Address",
                    "Access",
                    "Scope",
                    "Reset",
                    "Read",
                    "Write",
                    "Profile status",
                ],
                [
                    [
                        row["name"],
                        register_address(row),
                        row["access"],
                        row["scope"],
                        behavior_by_register[row["name"]]["reset"],
                        behavior_by_register[row["name"]]["read"],
                        behavior_by_register[row["name"]]["write"],
                        behavior_by_register[row["name"]]["profile_status"],
                    ]
                    for row in sorted(registers, key=register_sort_key)
                ],
            ),
            "",
            "## Behavior classes",
            "",
            table(
                ["Class", "Registers", "Side effects"],
                [
                    [
                        behavior["id"],
                        ", ".join(behavior["registers"]),
                        ", ".join(behavior["side_effects"]) or "none",
                    ]
                    for behavior in system["behavior_classes"]
                ],
            ),
            "",
            "## Trap numbers",
            "",
            table(
                [
                    "Name",
                    "Value",
                    "PTO v0 status",
                    "Producer",
                    "Cause",
                    "Argument",
                    "Restart",
                ],
                [
                    [
                        row["name"],
                        row["number"],
                        row["pto_v0_status"],
                        ", ".join(row["producers"]),
                        row["cause"],
                        row["argument"],
                        row["restart"],
                    ]
                    for row in sorted(traps, key=lambda item: item["number"])
                ],
            ),
            "",
        ]
    )
    return "\n".join(lines)


def build_pages() -> dict[Path, str]:
    scalar = load("spec/catalog/scalar-forms.json")
    command = load("spec/catalog/command-forms.json")
    tile = load("spec/catalog/tile-operations.json")
    system = load("spec/catalog/system-registers.json")
    pages = {
        OUT_DIR / "index.md": render_index(scalar, command, tile, system),
        OUT_DIR / "scalar.md": render_scalar_summary(scalar),
        OUT_DIR / "block-command.md": render_command(command),
        OUT_DIR / "tile.md": render_tile(tile),
        OUT_DIR / "system-registers.md": render_system_registers(system),
    }
    for family in SCALAR_FAMILY_ORDER:
        pages[OUT_DIR / f"scalar-{family.lower()}.md"] = render_scalar_family(
            scalar, family
        )
    return pages


def check_generated(pages: dict[Path, str]) -> list[Path]:
    stale = []
    for path, expected in pages.items():
        expected_text = expected.rstrip() + "\n"
        current = path.read_text(encoding="utf-8") if path.exists() else None
        if current != expected_text:
            stale.append(path)
    return stale


def write_generated(pages: dict[Path, str]) -> None:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    for path, content in pages.items():
        path.write_text(content.rstrip() + "\n", encoding="utf-8")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--check",
        action="store_true",
        help="fail if generated instruction docs are stale",
    )
    args = parser.parse_args(argv)

    pages = build_pages()
    if args.check:
        stale = check_generated(pages)
        if stale:
            for path in stale:
                print(
                    f"stale generated instruction reference: {path.relative_to(ROOT)}",
                    file=sys.stderr,
                )
            print("run scripts/generate-instruction-reference", file=sys.stderr)
            return 1
        return 0

    write_generated(pages)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
