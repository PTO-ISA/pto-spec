#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

# shellcheck source=scripts/check-ui
source "$repo_root/scripts/check-ui"

source_commands=(
    "./scripts/check-adrs"
    "make --no-print-directory check-decoder-partition"
    "./scripts/check-release-event-schema"
    "./scripts/check-model-closure-schema"
    "./scripts/check-release-workflow"
    "./scripts/check-repository --structure-only"
    "./scripts/generate-readme-inventory --check"
    "python3 scripts/manual_semantic_audit.py"
    "git diff --check"
)
tooling_commands=(
    "./scripts/run-python-tests --exclude-module tests.scripts.test_release_closure --exclude-module tests.scripts.test_release_selection"
)

run_source_checks() {
    check_ui_section "Source contracts"
    check_ui_step "ADR records" bash -c "${source_commands[0]}"
    check_ui_step "Decoder partition" bash -c "${source_commands[1]}"
    check_ui_step "Release event schema" bash -c "${source_commands[2]}"
    check_ui_step "Model closure schema" bash -c "${source_commands[3]}"
    check_ui_step "Release workflow" bash -c "${source_commands[4]}"
    check_ui_step "Repository structure and projections" bash -c "${source_commands[5]}"
    check_ui_step "README development inventory" bash -c "${source_commands[6]}"
    check_ui_step "Formal review field completeness" bash -c "${source_commands[7]}"
    check_ui_step "Patch whitespace" bash -c "${source_commands[8]}"
}

run_tooling_checks() {
    check_ui_section "Tooling tests"
    check_ui_step "Python test suite" bash -c "${tooling_commands[0]}"
}

case ${1:-} in
    --list)
        printf '%s\n' "${source_commands[@]}" "${tooling_commands[@]}"
        exit 0
        ;;
    --source)
        [[ $# -eq 1 ]] || { echo "usage: $0 [--list|--source|--tooling]" >&2; exit 2; }
        check_ui_begin "PTO PR source validation"
        run_source_checks
        check_ui_finish
        exit 0
        ;;
    --tooling)
        [[ $# -eq 1 ]] || { echo "usage: $0 [--list|--source|--tooling]" >&2; exit 2; }
        check_ui_begin "PTO PR tooling validation"
        run_tooling_checks
        check_ui_finish
        exit 0
        ;;
    "")
        ;;
    *)
        echo "usage: $0 [--list|--source|--tooling]" >&2
        exit 2
        ;;
esac

check_ui_begin "PTO PR validation"
run_source_checks
run_tooling_checks
check_ui_finish
