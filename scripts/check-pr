#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

source_commands=(
    "./scripts/check-adrs"
    "make --no-print-directory check-decoder-partition"
    "./scripts/check-release-event-schema"
    "./scripts/check-model-closure-schema"
    "./scripts/check-release-workflow"
    "./scripts/check-repository --structure-only"
    "git diff --check"
)
tooling_commands=(
    "./scripts/run-python-tests"
)

run_commands() {
    local lane=$1
    shift
    local command started finished
    for command in "$@"; do
        started=$(date +%s)
        printf '+ [%s] %s\n' "$lane" "$command"
        bash -c "$command"
        finished=$(date +%s)
        printf 'PASS [%s] %ss %s\n' "$lane" "$((finished - started))" "$command"
    done
}

case ${1:-} in
    --list)
        printf '%s\n' "${source_commands[@]}" "${tooling_commands[@]}"
        exit 0
        ;;
    --source)
        [[ $# -eq 1 ]] || { echo "usage: $0 [--list|--source|--tooling]" >&2; exit 2; }
        run_commands source "${source_commands[@]}"
        exit 0
        ;;
    --tooling)
        [[ $# -eq 1 ]] || { echo "usage: $0 [--list|--source|--tooling]" >&2; exit 2; }
        run_commands tooling "${tooling_commands[@]}"
        exit 0
        ;;
    "")
        ;;
    *)
        echo "usage: $0 [--list|--source|--tooling]" >&2
        exit 2
        ;;
esac

run_commands source "${source_commands[@]}" &
source_pid=$!
run_commands tooling "${tooling_commands[@]}" &
tooling_pid=$!

source_status=0
tooling_status=0
wait "$source_pid" || source_status=$?
wait "$tooling_pid" || tooling_status=$?

if [[ $source_status -ne 0 || $tooling_status -ne 0 ]]; then
    printf 'PR check failed: source=%s tooling=%s\n' "$source_status" "$tooling_status" >&2
    exit 1
fi

echo "PR check passed"
