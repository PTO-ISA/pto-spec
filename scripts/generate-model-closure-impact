#!/usr/bin/env python3
"""Project NDF PTO release impact into the ASL-MODEL closure input."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
def validate_envelope(document: object) -> dict[str, object]:
    if not isinstance(document, dict):
        raise ValueError("NDF impact envelope must be an object")
    if (
        document.get("schema_version") != "0.1"
        or document.get("command") != "impact pto-release"
        or document.get("ok") is not True
        or document.get("diagnostics") != []
        or not isinstance(document.get("data"), dict)
    ):
        raise ValueError("NDF impact command did not produce a clean v0.1 result")
    report = document["data"]
    if report.get("schema_version") != "1":
        raise ValueError("unsupported NDF PTO impact schema")
    changes = report.get("changes")
    if not isinstance(changes, list):
        raise ValueError("NDF PTO impact changes must be an array")
    for change in changes:
        if (
            not isinstance(change, dict)
            or not isinstance(change.get("uri"), str)
            or not isinstance(change.get("kind"), str)
        ):
            raise ValueError("NDF PTO impact change must be an object")
    return document


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--before", required=True, type=Path)
    parser.add_argument("--after", required=True, type=Path)
    parser.add_argument("--consumer-index", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--ndf", type=Path, default=ROOT / "tools/ndf/scripts/ndf")
    arguments = parser.parse_args()
    completed = subprocess.run(
        [
            str(arguments.ndf),
            "impact",
            "pto-release",
            "--before",
            str(arguments.before),
            "--after",
            str(arguments.after),
            "--consumer-index",
            str(arguments.consumer_index),
            "--format",
            "json",
        ],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0:
        print(completed.stderr.strip() or "NDF PTO impact failed", file=sys.stderr)
        return completed.returncode
    try:
        output = validate_envelope(json.loads(completed.stdout))
    except (ValueError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    arguments.output.parent.mkdir(parents=True, exist_ok=True)
    arguments.output.write_text(
        json.dumps(output, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
