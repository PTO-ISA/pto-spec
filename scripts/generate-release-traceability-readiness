#!/usr/bin/env python3
"""Project release traceability from the four-surface ASL and AVS owners."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from collections import defaultdict
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.asl_tests import _repository, validate_test_coverage  # noqa: E402
from scripts.ndf import instruction_clause_id, parse_ndf_regions  # noqa: E402


DEFAULT_OUTPUT = ROOT / "spec/evidence/release-traceability-readiness.json"
INSTRUCTION_CONTRACT_PATH = Path("spec/evidence/instruction-contract-closure.json")
SEMANTIC_TEST_KINDS = frozenset(
    {
        "execution",
        "boundary",
        "fault",
        "state-transition",
        "ordering",
        "atomicity",
    }
)


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def build_document(root: Path = ROOT) -> dict[str, object]:
    units, points, requirements = _repository(root)
    errors = validate_test_coverage(points, units, requirements)
    if errors:
        raise ValueError("\n".join(errors))

    instruction_contract = json.loads(
        (root / INSTRUCTION_CONTRACT_PATH).read_text(encoding="utf-8")
    )
    if instruction_contract.get("schema") != "pto.instruction-contract-closure.v1":
        raise ValueError("instruction contract closure has the wrong schema")
    contract_by_mnemonic = {
        row["mnemonic"]: row for row in instruction_contract["instructions"]
    }

    tests_by_source: dict[Path, list[str]] = defaultdict(list)
    semantic_tests_by_source: dict[Path, list[str]] = defaultdict(list)
    tests_by_requirement: dict[str, list[str]] = defaultdict(list)
    for point in points:
        tests_by_source[point.source].append(point.test_id)
        if point.kind in SEMANTIC_TEST_KINDS:
            semantic_tests_by_source[point.source].append(point.test_id)
        for requirement in point.requirements:
            tests_by_requirement[requirement].append(point.test_id)

    owners_by_requirement: dict[str, list[str]] = defaultdict(list)
    unit_rows: list[dict[str, object]] = []
    source_paths: set[Path] = {INSTRUCTION_CONTRACT_PATH}
    for unit in units:
        absolute = root / unit.source_path
        document = Path("docs") / unit.source_path.relative_to("asl").with_suffix(".md")
        document_absolute = root / document
        if not document_absolute.is_file():
            raise ValueError(f"missing mirrored documentation page: {document}")
        source_paths.update({unit.source_path, document})
        requirement_ids = [
            clause.clause_id
            for clause in parse_ndf_regions(
                absolute.read_text(encoding="utf-8"), unit.source_path
            )
        ]
        if unit.mnemonic is not None:
            requirement_ids.append(instruction_clause_id(unit.surface, unit.mnemonic))
        for requirement in requirement_ids:
            owners_by_requirement[requirement].append(unit.source_path.as_posix())
        row: dict[str, object] = {
            "id": unit.unit_id,
            "surface": unit.surface,
            "classification": list(unit.classification),
            "source": unit.source_path.as_posix(),
            "documentation": document.as_posix(),
            "mnemonic": unit.mnemonic,
            "tests": sorted(tests_by_source[unit.source_path]),
            "semantic_tests": sorted(semantic_tests_by_source[unit.source_path]),
        }
        if unit.mnemonic is not None:
            contract = contract_by_mnemonic.get(unit.mnemonic)
            if contract is None:
                raise ValueError(
                    f"instruction contract closure is missing {unit.mnemonic}"
                )
            expected = {
                "source": unit.source_path.as_posix(),
                "documentation": document.as_posix(),
                "ndf_clause": instruction_clause_id(unit.surface, unit.mnemonic),
            }
            for field, value in expected.items():
                if contract.get(field) != value:
                    raise ValueError(
                        f"instruction contract closure {unit.mnemonic} has stale {field}"
                    )
            row["instruction_contract"] = {
                "artifact": INSTRUCTION_CONTRACT_PATH.as_posix(),
                "mnemonic": unit.mnemonic,
                "ndf_clause": expected["ndf_clause"],
            }
        unit_rows.append(row)

    unit_mnemonics = {unit.mnemonic for unit in units if unit.mnemonic is not None}
    if set(contract_by_mnemonic) != unit_mnemonics:
        raise ValueError("instruction contract closure mnemonic set is stale")

    test_rows: list[dict[str, object]] = []
    for point in points:
        source_paths.add(point.path)
        test_rows.append(
            {
                "id": point.test_id,
                "path": point.path.as_posix(),
                "source": point.source.as_posix(),
                "requirements": list(point.requirements),
                "kind": point.kind,
                "sha256": point.sha256,
            }
        )

    requirement_rows = [
        {
            "id": requirement,
            "executable": executable,
            "owners": sorted(owners_by_requirement[requirement]),
            "tests": sorted(tests_by_requirement[requirement]),
        }
        for requirement, executable in sorted(requirements.items())
    ]
    uncovered_units = [
        unit.source_path.as_posix()
        for unit in units
        if not tests_by_source[unit.source_path]
    ]
    uncovered_executable = [
        requirement
        for requirement, executable in sorted(requirements.items())
        if executable and not tests_by_requirement[requirement]
    ]
    mnemonics_without_semantic_tests = sorted(
        unit.mnemonic
        for unit in units
        if unit.mnemonic is not None
        and not semantic_tests_by_source[unit.source_path]
    )
    if mnemonics_without_semantic_tests:
        raise ValueError(
            "mnemonic owners require owner-local semantic evidence beyond "
            "decode/static linkage: "
            + ", ".join(mnemonics_without_semantic_tests)
        )
    return {
        "schema": "pto.release-traceability.v2",
        "derivation": {
            "architecture_owner": "asl/{arch,block,scalar,tile}",
            "documentation_projection": "docs/{arch,block,scalar,tile}",
            "test_projection": "tests/asl/{arch,block,scalar,tile}",
            "instruction_contract_projection": INSTRUCTION_CONTRACT_PATH.as_posix(),
        },
        "sources": {
            path.as_posix(): _sha256(root / path) for path in sorted(source_paths)
        },
        "units": unit_rows,
        "requirements": requirement_rows,
        "tests": test_rows,
        "summary": {
            "unit_count": len(units),
            "documentation_page_count": len(units),
            "mnemonic_count": sum(unit.mnemonic is not None for unit in units),
            "requirement_count": len(requirements),
            "executable_requirement_count": sum(requirements.values()),
            "test_count": len(points),
            "uncovered_unit_count": len(uncovered_units),
            "uncovered_units": uncovered_units,
            "uncovered_executable_requirement_count": len(uncovered_executable),
            "uncovered_executable_requirements": uncovered_executable,
            "mnemonic_semantic_gap_count": len(
                mnemonics_without_semantic_tests
            ),
            "mnemonics_without_semantic_tests": (
                mnemonics_without_semantic_tests
            ),
            "status": "closed"
            if not uncovered_units
            and not uncovered_executable
            and not mnemonics_without_semantic_tests
            else "open",
        },
    }


def render(document: dict[str, object]) -> str:
    return json.dumps(document, indent=2, sort_keys=True) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    arguments = parser.parse_args()
    try:
        generated = render(build_document())
        if arguments.check:
            if not arguments.output.is_file():
                raise ValueError(f"missing generated artifact {arguments.output}")
            if arguments.output.read_text(encoding="utf-8") != generated:
                raise ValueError(f"stale generated artifact {arguments.output}")
        else:
            arguments.output.write_text(generated, encoding="utf-8")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    if arguments.check:
        print("release traceability projection passed")
    else:
        print(f"wrote {arguments.output.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
