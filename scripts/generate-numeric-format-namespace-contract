#!/usr/bin/env python3
"""Generate the fail-closed ADR-NUM-0014 numeric format namespace checkpoint."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from collections import Counter
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.evidence_sources import source_rows  # noqa: E402

DECISION_INPUTS = ROOT / "spec/evidence/numeric-profile-decision-inputs.json"
SCALAR_FSU_TOTALITY = ROOT / "spec/evidence/scalar-fsu-totality.json"
TLSU_TOTALITY = ROOT / "spec/evidence/tlsu-totality.json"
COMMAND_CATALOG = ROOT / "spec/catalog/command-forms.json"
EXECUTABLE_COMPARISON = ROOT / "spec/evidence/executable-model-comparison.json"
HARDWARE_PROFILE = ROOT / "spec/hardware-conformance-profile.json"
OUTPUT = ROOT / "spec/evidence/numeric-format-namespace-contract.json"
ACCEPTANCE_RECORD = (
    "docs/status/decisions/NUM-0004-numeric-format-namespace-ownership.md"
)
CLASSIFICATION_ACCEPTANCE_RECORD = (
    "docs/status/decisions/NUM-0009-numeric-format-value-classification.md"
)

NAN_CAPABLE_TYPES = {
    "FP64",
    "FP32",
    "TF32",
    "HF32",
    "FP16",
    "BF16",
    "HiF8",
    "E4M3",
    "E5M2",
    "E8M0",
}
INFINITY_CAPABLE_TYPES = {
    "FP64",
    "FP32",
    "TF32",
    "HF32",
    "FP16",
    "BF16",
    "HiF8",
    "E5M2",
}
SUBNORMAL_CAPABLE_TYPES = {
    "FP64",
    "FP32",
    "TF32",
    "HF32",
    "FP16",
    "BF16",
    "HiF8",
    "E4M3",
    "E5M2",
    "E3M2",
    "E2M3",
}
SIGNED_ZERO_TYPES = {
    "FP64",
    "FP32",
    "TF32",
    "HF32",
    "FP16",
    "BF16",
    "E4M3",
    "E5M2",
    "E3M2",
    "E2M3",
    "E2M1X2",
    "E1M2X2",
    "HiF4X2",
}
SIGNALING_NAN_TYPES = {
    "FP64",
    "FP32",
    "TF32",
    "HF32",
    "FP16",
    "BF16",
    "E5M2",
}
INTERNAL_ENCODING_CONSTRAINTS = {
    "TF32": "bits[12:0] are zero",
    "HF32": "bits[11:0] are zero",
    "E3M2": "bits[7:6] are zero",
    "E2M3": "bits[7:6] are zero",
}

TILE_DATA_TYPES = (
    ("FP64", 64, "floating-raw-carrier", 0, "format-contract-defined-conformance-open"),
    ("FP32", 32, "floating-raw-carrier", 1, "format-contract-defined-conformance-open"),
    ("TF32", 32, "floating-raw-carrier", 2, "format-contract-defined-conformance-open"),
    ("HF32", 32, "floating-raw-carrier", 3, "format-contract-defined-conformance-open"),
    ("FP16", 16, "floating-raw-carrier", 4, "format-contract-defined-conformance-open"),
    ("BF16", 16, "floating-raw-carrier", 5, "format-contract-defined-conformance-open"),
    ("HiF8", 8, "floating-raw-carrier", 6, "format-contract-defined-conformance-open"),
    ("E4M3", 8, "floating-raw-carrier", 7, "format-contract-defined-conformance-open"),
    ("E5M2", 8, "floating-raw-carrier", 8, "format-contract-defined-conformance-open"),
    ("E3M2", 8, "floating-raw-carrier", 9, "format-contract-defined-conformance-open"),
    ("E2M3", 8, "floating-raw-carrier", 10, "format-contract-defined-conformance-open"),
    (
        "E2M1X2",
        4,
        "packed-floating-raw-carrier",
        11,
        "format-contract-defined-conformance-open",
    ),
    (
        "E1M2X2",
        4,
        "packed-floating-raw-carrier",
        12,
        "format-contract-defined-conformance-open",
    ),
    ("E8M0", 8, "scale-raw-carrier", 13, "format-contract-defined-conformance-open"),
    (
        "HiF4X2",
        4,
        "packed-floating-raw-carrier",
        14,
        "format-contract-defined-conformance-open",
    ),
    ("S64", 64, "signed-integer", 16, "width-and-signedness-closed"),
    ("S32", 32, "signed-integer", 17, "width-and-signedness-closed"),
    ("S16", 16, "signed-integer", 18, "width-and-signedness-closed"),
    ("S8", 8, "signed-integer", 19, "width-and-signedness-closed"),
    ("S4X2", 4, "signed-integer", 20, "width-and-signedness-closed"),
    ("U64", 64, "unsigned-integer", 24, "width-and-signedness-closed"),
    ("U32", 32, "unsigned-integer", 25, "width-and-signedness-closed"),
    ("U16", 16, "unsigned-integer", 26, "width-and-signedness-closed"),
    ("U8", 8, "unsigned-integer", 27, "width-and-signedness-closed"),
    ("U4X2", 4, "unsigned-integer", 28, "width-and-signedness-closed"),
)


def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"numeric format namespace generation failed: {message}")


def source(path: str) -> dict[str, str]:
    absolute = ROOT / path
    return {"path": path, "sha256": hashlib.sha256(absolute.read_bytes()).hexdigest()}


def code_rows(
    namespace: str, width: int, mapping: dict[int, str]
) -> list[dict[str, Any]]:
    return [
        {
            "namespace": namespace,
            "code": code,
            "bits": format(code, f"0{width}b"),
            "status": "mapped" if code in mapping else "reserved-before-effects",
            "tile_data_type": mapping.get(code),
        }
        for code in range(1 << width)
    ]


def generate() -> dict[str, Any]:
    inputs = load(DECISION_INPUTS)
    scalar_totality = load(SCALAR_FSU_TOTALITY)
    tlsu_totality = load(TLSU_TOTALITY)
    command_catalog = load(COMMAND_CATALOG)
    executable_comparison = load(EXECUTABLE_COMPARISON)
    hardware_profile = load(HARDWARE_PROFILE)

    adr0087 = next(row for row in inputs["decisions"] if row["adr"] == "ADR-NUM-0014")
    require(adr0087["status"] == "draft", "ADR-NUM-0014 status drift")
    require(
        adr0087["acceptance_record"] is None,
        "ADR-NUM-0014 must remain unaccepted while format and legality rules are open",
    )
    require(
        scalar_totality["status"] == "closed" and scalar_totality["target"] == "S4-T5",
        "scalar FSU totality drift",
    )
    require(
        tlsu_totality["status"] == "closed" and tlsu_totality["target"] == "S4-T9",
        "TLSU totality drift",
    )
    require(
        executable_comparison["status"]
        == "comparison-matrix-closed-clean-gates-passed:S5-T3"
        and executable_comparison["closure_judgment"]["can_close_s5_t3"] is True
        and executable_comparison["closure_judgment"]["remaining_blockers"] == [],
        "independent comparison is not closed",
    )

    tile_rows = [
        {
            "name": name,
            "asl_enumerator": f"TileDataType_{name}",
            "storage_bits": bits,
            "raw_class": raw_class,
            "tlsu_talloc_code": code,
            "bundle_code": code,
            "numeric_semantics_status": status,
        }
        for name, bits, raw_class, code, status in TILE_DATA_TYPES
    ]

    tlsu_mapping = {code: name for name, _, _, code, _ in TILE_DATA_TYPES}
    bundle_mapping = {code: name for name, _, _, code, _ in TILE_DATA_TYPES}
    require(len(tlsu_mapping) == 25, "TLSU/TALLOC mapping count drift")
    require(len(bundle_mapping) == 25, "bundle mapping count drift")
    hardware_types = {
        (row["name"], row["code"]) for row in hardware_profile["data_types"]
    }
    require(
        hardware_types == {(name, code) for name, _, _, code, _ in TILE_DATA_TYPES},
        "hardware numeric profile type namespace drift",
    )
    hardware_types_by_name = {
        row["name"]: row for row in hardware_profile["data_types"]
    }
    value_classification_rows = []
    for name, bits, raw_class, code, _ in TILE_DATA_TYPES:
        profile_row = hardware_types_by_name[name]
        canonical_nan = profile_row.get("canonical_qnan")
        require(
            (canonical_nan is not None) == (name in NAN_CAPABLE_TYPES),
            f"canonical NaN capability drift for {name}",
        )
        value_classification_rows.append(
            {
                "name": name,
                "asl_enumerator": f"TileDataType_{name}",
                "logical_element_bits": bits,
                "profile_class": profile_row["class"],
                "nan_capable": name in NAN_CAPABLE_TYPES,
                "signaling_nan_capable": name in SIGNALING_NAN_TYPES,
                "infinity_capable": name in INFINITY_CAPABLE_TYPES,
                "subnormal_capable": name in SUBNORMAL_CAPABLE_TYPES,
                "signed_zero": name in SIGNED_ZERO_TYPES,
                "canonical_nan": canonical_nan,
                "internal_encoding_constraint": INTERNAL_ENCODING_CONSTRAINTS.get(name),
            }
        )

    data_type_forms = [
        form
        for form in command_catalog["forms"]
        if any(field["name"] == "DataType" for field in form["fields"])
    ]
    require(data_type_forms, "command DataType form inventory is empty")
    require(
        all(
            next(field for field in form["fields"] if field["name"] == "DataType")[
                "width"
            ]
            == 5
            for form in data_type_forms
        ),
        "command DataType field width drift",
    )

    format_codes = scalar_totality["format_code_contract"]
    source_codes = {row["code"]: row for row in format_codes["source_codes"]}
    scalar_source_rows = []
    for code in range(4):
        source_row = source_codes.get(code)
        scalar_source_rows.append(
            {
                "namespace": "scalar-fsu-source-type",
                "code": code,
                "bits": format(code, "02b"),
                "status": "mapped" if source_row else "reserved-before-effects",
                "carrier_width": source_row["carrier_width"] if source_row else None,
                "meaning": source_row["meaning"] if source_row else None,
            }
        )

    floating_by_code = {
        row["code"]: row for row in format_codes["floating_destination_codes"]
    }
    integer_by_code = {
        row["code"]: row for row in format_codes["integer_destination_codes"]
    }
    scalar_fp_destination_rows = [
        {
            "namespace": "scalar-fsu-floating-destination-type",
            "code": code,
            "bits": format(code, "05b"),
            "status": "mapped"
            if code in floating_by_code
            else "reserved-before-effects",
            "carrier_width": (
                floating_by_code[code]["carrier_width"]
                if code in floating_by_code
                else None
            ),
            "stage4_name": (
                floating_by_code[code]["stage4_name"]
                if code in floating_by_code
                else None
            ),
        }
        for code in range(32)
    ]
    scalar_integer_destination_rows = [
        {
            "namespace": "scalar-fsu-integer-destination-type",
            "code": code,
            "bits": format(code, "05b"),
            "status": "mapped"
            if code in integer_by_code
            else "reserved-before-effects",
            "carrier_width": (
                integer_by_code[code]["carrier_width"]
                if code in integer_by_code
                else None
            ),
            "signed": integer_by_code[code]["signed"]
            if code in integer_by_code
            else None,
            "stage4_name": (
                integer_by_code[code]["stage4_name"]
                if code in integer_by_code
                else None
            ),
        }
        for code in range(32)
    ]

    width_counts = Counter(row["storage_bits"] for row in tile_rows)
    four_bit_types = [row["name"] for row in tile_rows if row["storage_bits"] == 4]

    return {
        "schema_version": 1,
        "target": "S5-T2-A2:ADR-NUM-0014",
        "decision_id": "ADR-NUM-0014",
        "checkpoint_id": "ADR-NUM-0014-SC1",
        "status": "namespace-carrier-and-value-classification-closed-operation-rules-open",
        "acceptance_record": ACCEPTANCE_RECORD,
        "classification_acceptance_record": CLASSIFICATION_ACCEPTANCE_RECORD,
        "classification_checkpoint_id": "ADR-NUM-0014-SC2:ADR-NUM-0015-SC1",
        "policy": {
            "namespace_locality": "Scalar source, scalar floating destination, scalar integer destination, TLSU/TALLOC, and bundle DataType codes are distinct namespaces. Equal integers do not imply equal types across namespaces.",
            "reserved_codes": "Every unmapped code rejects before architectural effects; helper fallback values are unreachable after legality succeeds and are not architectural aliases.",
            "raw_carrier_boundary": "Widths and signedness describe Stage 4 raw carriers only. Floating bit layouts and target numeric results remain S5-T2 rules.",
            "four_bit_packing": "E2M1X2, E1M2X2, HiF4X2, S4X2, and U4X2 use low-index/low-nibble and odd-index/high-nibble packing with sibling preservation on stores.",
            "adr0087_boundary": "The 0.58.0 type identities and format contract are fixed, while operation/type legality, target execution results, and implementation conformance remain open under S5-T2.",
            "value_class_boundary": "TileNumericValueClass defines only bit-exact encoding classes and canonical NaN values. It does not select arithmetic results, exception flags, operation/type support, or target conformance.",
        },
        "tile_data_types": tile_rows,
        "value_classification": {
            "classifier": "TileNumericValueClass",
            "encoding_validity": "TileNumericEncodingValid",
            "canonical_nan": "TileNumericCanonicalNaN",
            "class_type": "NumericValueClass",
            "invalid_encoding_result": "NumericValue_InvalidEncoding",
            "formats": value_classification_rows,
            "status": "closed",
        },
        "scalar_source_type": scalar_source_rows,
        "scalar_floating_destination_type": scalar_fp_destination_rows,
        "scalar_integer_destination_type": scalar_integer_destination_rows,
        "tlsu_talloc_data_type": code_rows("tlsu-talloc-data-type", 6, tlsu_mapping),
        "bundle_data_type": code_rows("bundle-data-type", 5, bundle_mapping),
        "four_bit_packing": {
            "types": four_bit_types,
            "even_element": "low-nibble[3:0]",
            "odd_element": "high-nibble[7:4]",
            "indexed_selector": "index_value[0]",
            "load_extension": "zero-extend-selected-nibble",
            "store_rule": "replace-selected-nibble-preserve-sibling-nibble",
            "status": "closed",
        },
        "public_evidence": {
            "pinned_repository": inputs["public_repository"],
            "pinned_commit": inputs["public_commit"],
            "status": "names-and-target-availability-observed-format-bindings-open",
        },
        "independent_comparison": {
            "status": "scalar-carrier-structure-corroborated-tile-format-oracle-unavailable",
            "provenance_sha256": executable_comparison["snapshot"]["revision_sha256"],
            "matched_contracts": [
                "scalar-source-type-code-legality",
                "scalar-destination-type-code-legality",
                "scalar-floating-and-integer-carrier-widths",
                "bundle-DataType-field-width",
                "FP32-and-FP64-NaN-zero-signed-zero-classification",
                "FP32-and-FP64-canonical-quiet-NaN-values",
            ],
            "limits": [
                "independent-tile-decode-does-not-bind-DataType-to-PTO-numeric-formats",
                "independent-numeric-helpers-are-not-a-PTO-oracle",
                "independent-comparison-does-not-cover-PTO-low-precision-value-classes",
                "target-operation-type-support-remains-unvalidated",
            ],
        },
        "open_residuals": [
            {
                "id": "ADR-NUM-0014-R1",
                "rule": "close every operation/type/profile legality tuple against the 0.58.0 type namespace",
            },
            {
                "id": "ADR-NUM-0014-R2",
                "rule": "publish independently checked result vectors for every supported floating type",
            },
            {
                "id": "ADR-NUM-0014-R3",
                "rule": "apply the accepted value classes and canonical NaNs to every supported operation and prove each exceptional result rule",
            },
            {
                "id": "ADR-NUM-0014-R4",
                "rule": "prove packed-lane ordering and sibling preservation for every packed four-bit operation",
            },
            {
                "id": "ADR-NUM-0014-R5",
                "rule": "prove E8M0 scale-carrier legality and MX scale application",
            },
            {
                "id": "ADR-NUM-0014-R6",
                "rule": "prove target availability and rejection before effects for unsupported tuples",
            },
            {
                "id": "ADR-NUM-0014-R7",
                "rule": "obtain accepted architecture and formal-model review of the numeric result contract",
            },
            {
                "id": "ADR-NUM-0014-R8",
                "rule": "record downstream byte-and-effect parity for the immutable profile contract",
            },
        ],
        "tests": [
            "tests/asl/arch/profile/reference-profile/arch-exec-concrete-001.asl:ValidateNumericFormatClassification",
            "tests/asl/arch/programming-model/tile-registers/arch-state-register-mapping-001.asl:TestTileRegisterMapping",
            "tests/asl/scalar/model/fsu/arithmetic/scalar-exec-floating-001.asl:TestScalarFloating",
            "tests/asl/block/model/state/descriptor-state/block-exec-operation-fields-001.asl:TestBundleOperationDescriptorFields",
            "tests/asl/tile/model/memory/load-store/tile-bound-tlsu-totality-001.asl:TestTlsuAllFourBitTypes",
            "scripts/generate-asl-decoders:emit_scalar_fsu_type_validation",
            "scripts/generate-asl-decoders:emit_scalar_fsu_bounds_validation",
        ],
        "sources": [
            source("spec/evidence/numeric-profile-decision-inputs.json"),
            source("spec/evidence/scalar-fsu-totality.json"),
            source("spec/evidence/tlsu-totality.json"),
            source("spec/evidence/executable-model-comparison.json"),
            source("spec/hardware-conformance-profile.json"),
            source("spec/catalog/command-forms.json"),
            *source_rows(ROOT, "asl/arch/data-types/*.asl"),
            *source_rows(ROOT, "asl/tile/model/numeric/formats.asl"),
            *source_rows(ROOT, "asl/scalar/model/fsu/*.asl"),
            *source_rows(ROOT, "asl/tile/model/state/*.asl"),
            *source_rows(ROOT, "asl/tile/model/memory/*.asl"),
            *source_rows(ROOT, "asl/block/model/dispatch/*.asl"),
            source(
                "docs/status/decisions/SCALAR-0004-scalar-fsu-totality-and-profile-boundary.md"
            ),
            source("docs/status/decisions/MEM-0006-tlsu-four-bit-memory-packing.md"),
            source(
                "docs/status/decisions/NUM-0001-numeric-profile-identity-and-variation-framework.md"
            ),
            source(
                "docs/status/decisions/NUM-0009-numeric-format-value-classification.md"
            ),
        ],
        "summary": {
            "tile_data_type_count": len(tile_rows),
            "tile_storage_width_counts": {
                str(key): width_counts[key] for key in sorted(width_counts)
            },
            "scalar_source_mapped_count": len(source_codes),
            "scalar_source_reserved_count": 4 - len(source_codes),
            "scalar_floating_destination_mapped_count": len(floating_by_code),
            "scalar_floating_destination_reserved_count": 32 - len(floating_by_code),
            "scalar_integer_destination_mapped_count": len(integer_by_code),
            "scalar_integer_destination_reserved_count": 32 - len(integer_by_code),
            "tlsu_talloc_mapped_count": len(tlsu_mapping),
            "tlsu_talloc_reserved_count": 64 - len(tlsu_mapping),
            "bundle_mapped_count": len(bundle_mapping),
            "bundle_reserved_count": 32 - len(bundle_mapping),
            "four_bit_type_count": len(four_bit_types),
            "value_classified_type_count": len(value_classification_rows),
            "nan_capable_type_count": len(NAN_CAPABLE_TYPES),
            "signaling_nan_capable_type_count": len(SIGNALING_NAN_TYPES),
            "infinity_capable_type_count": len(INFINITY_CAPABLE_TYPES),
            "subnormal_capable_type_count": len(SUBNORMAL_CAPABLE_TYPES),
            "signed_zero_type_count": len(SIGNED_ZERO_TYPES),
            "internally_constrained_type_count": len(INTERNAL_ENCODING_CONSTRAINTS),
            "open_residual_count": 8,
            "adr0087_complete": False,
        },
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    args = parser.parse_args()
    expected = serialized()
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.is_file() or OUTPUT.read_text(encoding="utf-8") != expected:
        raise SystemExit(f"stale generated evidence: {OUTPUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
