#!/usr/bin/env python3
"""Validate the declared library and executable surfaces under scripts/."""

from __future__ import annotations

import argparse
import ast
import subprocess
import sys
from pathlib import Path


PYTHON_LAUNCHED = frozenset(
    {
        "__init__.py",
        "asl_tests.py",
        "encoding_witness.py",
        "evidence_sources.py",
        "generate-mnemonic-avs.py",
    }
)
PYTHON_SHEBANG = "#!/usr/bin/env python3"
BASH_SHEBANG = "#!/usr/bin/env bash"


def _is_executable(path: Path) -> bool:
    return bool(path.stat().st_mode & 0o111)


def _parse_python(path: Path) -> None:
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))


def validate(scripts: Path) -> list[str]:
    errors: list[str] = []
    for path in sorted(
        candidate for candidate in scripts.iterdir() if candidate.is_file()
    ):
        if path.name in PYTHON_LAUNCHED:
            try:
                _parse_python(path)
            except (OSError, SyntaxError) as error:
                errors.append(f"invalid Python module {path}: {error}")
            continue
        if not _is_executable(path):
            errors.append(f"script is not executable: {path}")
            continue
        try:
            first_line = path.open(encoding="utf-8").readline().rstrip("\n")
            if first_line == PYTHON_SHEBANG:
                _parse_python(path)
            elif first_line == BASH_SHEBANG:
                result = subprocess.run(
                    ["bash", "-n", str(path)],
                    text=True,
                    capture_output=True,
                    check=False,
                )
                if result.returncode != 0:
                    errors.append(
                        f"invalid Bash script {path}: {result.stderr.strip()}"
                    )
            else:
                errors.append(f"script has an unsupported interpreter: {path}")
        except (OSError, SyntaxError) as error:
            errors.append(f"invalid script {path}: {error}")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--scripts", type=Path, default=Path("scripts"))
    arguments = parser.parse_args()
    try:
        errors = validate(arguments.scripts.resolve())
    except OSError as error:
        print(f"error: cannot inspect scripts: {error}", file=sys.stderr)
        return 1
    if errors:
        print("\n".join(f"error: {error}" for error in errors), file=sys.stderr)
        return 1
    print("script entrypoint checks passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
