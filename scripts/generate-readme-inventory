#!/usr/bin/env python3
"""Project live development inventory into one bounded README region."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
import tomllib


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.asl_units import load_units  # noqa: E402


BEGIN = "<!-- PTO-INVENTORY-BEGIN -->"
END = "<!-- PTO-INVENTORY-END -->"


def render_inventory() -> str:
    release = tomllib.loads((ROOT / "specification.toml").read_text())["release"]
    rows = []
    for filename, key, label in (
        ("scalar-forms.json", "forms", "Scalar instruction forms"),
        ("command-forms.json", "forms", "Active bundle and command forms"),
        ("tile-operations.json", "operations", "Direct Tile operations"),
    ):
        entries = json.loads((ROOT / "spec/catalog" / filename).read_text())[key]
        if not isinstance(entries, list) or not entries:
            raise ValueError(f"{filename}: expected a non-empty {key} list")
        rows.append(f"| {label} | {len(entries):,} |")
    rows.append(f"| Architecture and instruction ASL units | {len(load_units(ROOT / 'asl')):,} |")
    return "\n".join([
        BEGIN,
        "<!-- Generated by scripts/generate-readme-inventory; edit its source inputs. -->",
        "",
        f"Working-tree identity: architecture `{release['architecture_version']}`, "
        f"publication candidate `{release['publication_version']}`.",
        "This development inventory is generated from the live catalogs and ASL owners;",
        "it does not establish publication or release readiness.",
        "",
        "| Surface | Current executable inventory |",
        "| --- | ---: |",
        *rows,
        "",
        END,
    ])


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--readme", type=Path, default=ROOT / "README.md")
    arguments = parser.parse_args()
    try:
        text = arguments.readme.read_text(encoding="utf-8")
        if text.count(BEGIN) != 1 or text.count(END) != 1 or text.index(BEGIN) > text.index(END):
            raise ValueError("README requires exactly one ordered PTO-INVENTORY region")
        before, rest = text.split(BEGIN, 1)
        _, after = rest.split(END, 1)
        expected = before + render_inventory() + after
        if expected == text:
            print("README development inventory is current")
            return 0
        if arguments.check:
            raise ValueError("README inventory is stale; run ./scripts/generate-readme-inventory")
        arguments.readme.write_text(expected, encoding="utf-8")
        print("README development inventory regenerated")
        return 0
    except (OSError, ValueError, KeyError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
