#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
pin=$(tr -d '[:space:]' < "$repo_root/.aslref-version")
origin=$(tr -d '[:space:]' < "$repo_root/.aslref-origin")
aslref_root=${PTO_ASLREF_ROOT:-"$repo_root/.cache/herdtools7"}

if [[ ! $pin =~ ^[0-9a-f]{40}$ ]]; then
    echo "error: .aslref-version must contain one full Git commit SHA" >&2
    exit 1
fi

if ! command -v opam >/dev/null 2>&1; then
    echo "error: opam is required; run 'make setup' after installing opam" >&2
    exit 1
fi

if [[ ! -d "$aslref_root/.git" ]]; then
    echo "error: pinned ASLRef is not prepared; run 'make setup' before executing tests" >&2
    exit 1
fi

if [[ $(git -C "$aslref_root" remote get-url origin) != "$origin" ]]; then
    echo "error: cached ASLRef origin is not $origin" >&2
    exit 1
fi

current=$(git -C "$aslref_root" rev-parse HEAD 2>/dev/null || true)
if [[ $current != "$pin" ]]; then
    echo "error: pinned ASLRef is not prepared at $pin; run 'make setup' before executing tests" >&2
    exit 1
fi

if [[ -n $(git -C "$aslref_root" status --porcelain=v1 --untracked-files=all) ]]; then
    echo "error: pinned ASLRef checkout is not clean; run 'make setup' after repairing the cache" >&2
    exit 1
fi

aslref_binary="$aslref_root/_build/default/asllib/aslref.exe"
if [[ ! -x $aslref_binary ]]; then
    echo "error: pinned ASLRef binary is not prepared; run 'make setup' before executing tests" >&2
    exit 1
fi

# Execute the pinned binary directly once built. `dune exec` holds one workspace
# lock for the lifetime of ASLRef, which serializes otherwise independent test
# shards and defeats `make test-parallel`.
aslref_stack_limit=$(ulimit -Hs)
ulimit -s "$aslref_stack_limit"
if [[ -z ${OCAMLRUNPARAM:-} ]]; then
    # Eight million words keeps short-lived interpreter values in the minor
    # heap long enough to avoid repeated promotion and major-heap marking on
    # reset-heavy points. Preserve an explicit caller override.
    export OCAMLRUNPARAM=s=8M,o=200
fi
exec "$aslref_binary" "$@"
