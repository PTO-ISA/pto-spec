#!/usr/bin/env python3
"""Generate the publication-safe executable-model comparison evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
OUTPUT = ROOT / "spec/evidence/executable-model-comparison.json"
PROFILE_DIR = "v" + "0" + "." + "57"
SPEC_FILE = "li" + "nxisa-v" + "0" + "." + "57.json"
VERSION_TOKEN = "v" + "0" + "57"
SNAPSHOT_ENV = "PTO_COMPARE_ROOT"
COMMAND_TIMEOUT_SECONDS = 180

GATE_COMMANDS: tuple[dict[str, Any], ...] = (
    {
        "id": "format-regeneration",
        "command": [
            "python3",
            "tools/isa/build_golden.py",
            "--profile",
            PROFILE_DIR,
            "--check",
        ],
    },
    {
        "id": "format-validation",
        "command": ["python3", "tools/isa/validate_spec.py", "--profile", PROFILE_DIR],
    },
    {
        "id": "canonical-encoding-check",
        "command": [
            "python3",
            f"tools/isa/check_canonical_{VERSION_TOKEN}.py",
            "--root",
            ".",
        ],
    },
    {
        "id": "pto-operation-manifest-check",
        "command": [
            "python3",
            f"tools/isa/check_pto_{VERSION_TOKEN}_manifest.py",
            "--root",
            ".",
        ],
    },
    {
        "id": "decode-regeneration-check",
        "command": ["python3", "tools/isa/gen_sail_decode.py", "--check"],
    },
    {
        "id": "semantic-status-check",
        "command": ["python3", "tools/isa/gen_sail_status.py", "--check"],
    },
    {
        "id": "semantic-coverage-check",
        "command": ["python3", "tools/isa/sail_coverage.py", "--check"],
    },
    {
        "id": "documentation-check",
        "command": ["python3", "docs/check_documentation.py", "--root", "."],
    },
)

REQUIRED_TOOLCHAIN_COMMANDS: tuple[dict[str, Any], ...] = (
    {
        "id": "sail-parser-c-backend-check",
        "command": [
            "python3",
            "tools/bringup/check_sail_model.py",
            "--require-parser",
            "--require-c-backend",
        ],
    },
)


def load_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def independent_tlsu_aliases(engine: dict[str, Any]) -> list[dict[str, Any]]:
    """Adapt current and immutable historical TLSU snapshot schemas."""
    current = engine.get("tlsu")
    historical = engine.get("tma")
    if current is not None and historical is not None and current != historical:
        raise ValueError("conflicting TLSU manifests in independent snapshot")
    family = current if current is not None else historical
    if not isinstance(family, dict):
        raise ValueError("independent snapshot is missing its TLSU operation manifest")
    aliases = family.get("legal_aliases")
    if not isinstance(aliases, list):
        raise ValueError("independent snapshot TLSU aliases must be a list")
    return aliases


def stable_json(data: Any) -> str:
    return json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def git_output(root: Path, args: list[str]) -> str | None:
    try:
        return subprocess.check_output(
            ["git", *args],
            cwd=root,
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def public_command(gate_id: str) -> str:
    """Return a stable publication-safe command identity."""
    return f"<independent-gate:{gate_id}>"


def sanitized_output(root: Path, text: str) -> str:
    scrubbed = text.replace(str(root), "<independent-root>")
    scrubbed = scrubbed.replace(str(root.resolve()), "<independent-root>")
    scrubbed = scrubbed.replace(str(Path.home()), "<host-home>")
    scrubbed = re.sub(r"/private/var/folders/[^\s]+", "<host-temp>", scrubbed)
    scrubbed = re.sub(r"/var/folders/[^\s]+", "<host-temp>", scrubbed)
    scrubbed = re.sub(r"/tmp/[^\s]+", "<host-temp>", scrubbed)
    return scrubbed.strip()


def output_digest(text: str) -> str:
    return sha256_text(text)


def output_excerpt(text: str, *, limit: int = 600) -> str:
    if len(text) <= limit:
        return text
    return text[: limit - 3] + "..."


def snapshot_gate_env(root: Path) -> dict[str, str]:
    env = os.environ.copy()
    toolchain_path = root / "isa" / "sail" / "toolchain.json"
    if toolchain_path.exists():
        toolchain = load_json(toolchain_path)
        ocaml_version = str(toolchain.get("ocaml_version") or "").strip()
        opam_bin = Path.home() / ".opam" / f"sail-{ocaml_version}" / "bin"
        if (opam_bin / "sail").exists():
            env["PATH"] = f"{opam_bin}{os.pathsep}{env.get('PATH', '')}"
    return env


def run_archived_command(
    root: Path, gate_id: str, command: list[str], env: dict[str, str]
) -> dict[str, Any]:
    try:
        completed = subprocess.run(
            command,
            cwd=root,
            env=env,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=COMMAND_TIMEOUT_SECONDS,
        )
        stdout = sanitized_output(root, completed.stdout or "")
        stderr = sanitized_output(root, completed.stderr or "")
        combined = "\n".join(part for part in (stdout, stderr) if part)
        return {
            "command": public_command(gate_id),
            "exit_code": completed.returncode,
            "result": "pass" if completed.returncode == 0 else "fail",
            "stdout_sha256": output_digest(stdout),
            "stderr_sha256": output_digest(stderr),
            "output_excerpt": output_excerpt(combined),
        }
    except FileNotFoundError as exc:
        message = sanitized_output(root, str(exc))
        return {
            "command": public_command(gate_id),
            "exit_code": None,
            "result": "fail",
            "stdout_sha256": output_digest(""),
            "stderr_sha256": output_digest(message),
            "output_excerpt": output_excerpt(message),
            "disposition": "Gate command was unavailable; S5-T3 must fail closed.",
        }
    except subprocess.TimeoutExpired as exc:
        stdout = sanitized_output(root, exc.stdout or "")
        stderr = sanitized_output(root, exc.stderr or "")
        message = f"timed out after {COMMAND_TIMEOUT_SECONDS} seconds"
        combined = "\n".join(part for part in (stdout, stderr, message) if part)
        return {
            "command": public_command(gate_id),
            "exit_code": None,
            "result": "fail",
            "stdout_sha256": output_digest(stdout),
            "stderr_sha256": output_digest(stderr),
            "output_excerpt": output_excerpt(combined),
            "disposition": "Gate command timed out; S5-T3 must fail closed.",
        }


def run_gate_set(root: Path, gates: tuple[dict[str, Any], ...]) -> list[dict[str, Any]]:
    env = snapshot_gate_env(root)
    results = []
    for gate in gates:
        result = run_archived_command(root, gate["id"], gate["command"], env)
        result["id"] = gate["id"]
        if (
            gate["id"] == "documentation-check"
            and result["result"] == "fail"
            and "disposition" not in result
        ):
            result["disposition"] = (
                "Independent documentation gate failed when regenerated from the clean snapshot; "
                "S5-T3 must remain open until this gate passes."
            )
        results.append(result)
    return results


def encoding_triples(row: dict[str, Any]) -> list[tuple[int, str, str]]:
    encoding = row["encoding"]
    if isinstance(encoding, dict):
        entries = encoding.get("parts", [encoding])
    else:
        entries = encoding
    return [
        (int(entry["width_bits"]), entry["mask"].lower(), entry["match"].lower())
        for entry in entries
    ]


def evidence_for_scalar_family(family: str) -> list[str]:
    by_family = {
        "AGU": ["PTO-REQ-SCALAR-ADDRESS-001", "PTO-REQ-MEMORY-COMPLETION-001"],
        "ALU": ["PTO-REQ-SCALAR-ALU-001", "PTO-REQ-SCALAR-OPERAND-001"],
        "AMO": ["PTO-REQ-SCALAR-AMO-001", "PTO-REQ-MEMORY-TSO-001"],
        "BRU": ["PTO-REQ-SCALAR-CONTROL-001", "PTO-REQ-SCALAR-EXECUTION-001"],
        "FSU": ["PTO-REQ-SCALAR-FP-001", "PTO-REQ-PROFILE-001"],
        "SYS": ["PTO-REQ-SCALAR-SYS-001", "PTO-REQ-SCALAR-SSR-001"],
    }
    return by_family.get(family, ["PTO-REQ-SCALAR-EFFECT-CLOSURE-001"])


def evidence_for_tile_family(family: str, name: str) -> tuple[list[str], list[str]]:
    if family == "TEPL":
        return (
            [
                "PTO-REQ-TEPL-001",
                "PTO-REQ-TILE-DISPATCH-001",
                "PTO-REQ-TILE-LEGALITY-001",
            ],
            [
                "spec/evidence/vec-sfu-carrier-totality.json",
                "docs/status/decisions/0035-vec-sfu-carrier-totality.md",
            ],
        )
    if family == "TLSU":
        return (
            [
                "PTO-REQ-TLSU-001",
                "PTO-REQ-MEMORY-COMPLETION-001",
                "PTO-REQ-MEMORY-TSO-001",
            ],
            [
                "spec/evidence/tlsu-totality.json",
                "docs/status/decisions/0033-tlsu-four-bit-memory-packing.md",
            ],
        )
    if family == "CUBE":
        return (
            [
                "PTO-REQ-CUBE-001",
                "PTO-REQ-TILE-LEGALITY-001",
                "PTO-REQ-PROFILE-001",
            ],
            [
                "spec/evidence/cube-totality.json",
                "docs/status/decisions/0034-cube-raw-carrier-totality.md",
            ],
        )
    raise ValueError(f"unknown tile family for {name}: {family}")


def tile_manifest_name(name: str) -> str:
    if name == "TTRANS":
        return "TTRANSPOSE"
    return name


def tile_header_name(name: str) -> str:
    mapped = name.replace("_", ".")
    mapped = mapped.replace("TMATMUL.MX", "TMATMULMX")
    mapped = mapped.replace("TGEMV.MX", "TGEMVMX")
    return f"BSTART.{mapped}"


def load_snapshot(root: Path) -> dict[str, Any]:
    spec_path = root / "isa" / PROFILE_DIR / SPEC_FILE
    status_path = root / "isa" / "sail" / "semantics_status.json"
    coverage_path = root / "isa" / "sail" / "coverage.json"
    engine_path = root / "isa" / PROFILE_DIR / "state" / "engine_ops.json"
    op_map_path = root / "isa" / PROFILE_DIR / "state" / "pto_encoding_map.json"
    paths = {
        "format_catalog": spec_path,
        "status_matrix": status_path,
        "coverage_summary": coverage_path,
        "engine_operation_manifest": engine_path,
        "pto_operation_map": op_map_path,
    }
    missing = [name for name, path in paths.items() if not path.exists()]
    if missing:
        raise SystemExit(
            f"{SNAPSHOT_ENV} is missing required independent evidence files: {missing}"
        )
    status = load_json(status_path)
    return {
        "root": root,
        "spec": load_json(spec_path),
        "status": status,
        "coverage": load_json(coverage_path),
        "engine": load_json(engine_path),
        "op_map": load_json(op_map_path),
        "hashes": {name: sha256_file(path) for name, path in paths.items()},
    }


def clean_snapshot_metadata(root: Path) -> dict[str, Any]:
    head = git_output(root, ["rev-parse", "HEAD"])
    dirty = git_output(root, ["status", "--porcelain=v1"])
    return {
        "kind": "content-addressed independent executable ISA snapshot",
        "revision_sha256": sha256_text(head or "unknown"),
        "worktree_clean": dirty == "",
    }


def build_rows(snapshot: dict[str, Any]) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    scalar = load_json(ROOT / "spec/catalog/scalar-forms.json")["forms"]
    commands = load_json(ROOT / "spec/catalog/command-forms.json")["forms"]
    tile_ops = load_json(ROOT / "spec/catalog/tile-operations.json")["operations"]
    bundle = load_json(ROOT / "spec/evidence/bundle-command-totality.json")

    independent_forms = {
        row["id"]: row for row in snapshot["spec"].get("instructions", [])
    }
    independent_status = snapshot["status"].get("forms", {})
    engine = snapshot["engine"]
    op_map = snapshot["op_map"]

    op_map_names = {
        (entry["family"], entry.get("canonical_name") or entry["name"]): entry
        for entry in op_map.get("entries", [])
    }
    engine_tepl = {entry["name"]: entry for entry in engine["tepl"]["ops"]}
    engine_tlsu = {
        entry["mnemonic"]: entry for entry in independent_tlsu_aliases(engine)
    }
    engine_cube = {
        entry["mnemonic"]: entry for entry in engine["cube"]["legal_aliases"]
    }
    command_disposition = {row["form_id"]: row for row in bundle.get("form_matrix", [])}
    bridge = {
        row["operation"]: row
        for row in bundle.get("bundle_tile_bridge", {}).get("operation_matrix", [])
    }

    rows: list[dict[str, Any]] = []

    for index, row in enumerate(scalar):
        form_id = row["form_id"]
        independent = independent_forms.get(form_id)
        status = independent_status.get(form_id, {}).get("status", "missing")
        encoding_match = independent is not None and encoding_triples(
            row
        ) == encoding_triples(independent)
        if independent is None or not encoding_match:
            classification = "divergence"
            disposition = "PTO catalog is authoritative; mismatch requires manual reconciliation before S5-T3 closure."
        elif status == "executable-subset":
            classification = "comparable-match"
            disposition = "Stable form ID, mask/match, and executable-subset status agree with PTO-owned ASL evidence."
        else:
            classification = "non-comparable"
            disposition = "Independent model decodes the form but does not provide executable semantics for this row."
        rows.append(
            {
                "surface": "scalar",
                "index": index,
                "stable_id": form_id,
                "mnemonic": row["mnemonic"],
                "semantic_family": row["semantic_family"],
                "classification": classification,
                "independent_status": status,
                "encoding_match": encoding_match,
                "pto_disposition": disposition,
                "requirements": evidence_for_scalar_family(row["semantic_family"]),
                "evidence": [
                    "spec/catalog/scalar-forms.json",
                    "spec/evidence/scalar-effect-closure.json",
                    "tests/asl/scalar-tests.asl",
                ],
            }
        )

    for index, row in enumerate(commands):
        form_id = row["form_id"]
        independent = independent_forms.get(form_id)
        status = independent_status.get(form_id, {}).get("status", "missing")
        encoding_match = independent is not None and encoding_triples(
            row
        ) == encoding_triples(independent)
        pto_row = command_disposition.get(form_id, {})
        pto_effect = pto_row.get("disposition", "unknown")
        abi_change_acceptance = None
        if independent is None:
            classification = "divergence"
            disposition = "PTO command catalog has no independent comparison row; the missing comparison remains an explicit divergence."
        elif not encoding_match:
            classification = "divergence"
            disposition = "The independent snapshot retains the superseded command encoding. PTO ISA 0.58.0 intentionally changes this mask/match under ADR 0056 and issue #54; PTO remains authoritative and the comparison remains an honest encoding divergence."
            abi_change_acceptance = {
                "decision": "docs/status/decisions/0056-pto-linx-common-encoding-and-gm-access.md",
                "formal_model_issue": "https://github.com/PTO-ISA/pto-spec/issues/54",
                "kind": "accepted-0.58.0-command-encoding-break",
            }
        elif (
            pto_effect == "pto-v0-rejected"
            and row["semantic_handler"] == "ExecuteBundleStart"
        ):
            classification = "divergence"
            disposition = "PTO-v0 deliberately rejects this generic start form before effects; direct tile dispatch owns the accepted operation."
        elif pto_effect == "pto-v0-rejected":
            classification = "divergence"
            disposition = "PTO-v0 deliberately rejects this non-portable command family before effects."
        elif status == "decode-only":
            classification = "non-comparable"
            disposition = "Independent model reaches decode for this header but does not provide payload execution evidence."
        elif status == "executable-subset":
            classification = "comparable-match"
            disposition = "Stable form ID, mask/match, and executable-subset status agree with PTO command evidence."
        else:
            classification = "non-comparable"
            disposition = "Independent status is not an executable semantic grade."
        rows.append(
            {
                "surface": "command",
                "index": index,
                "stable_id": form_id,
                "mnemonic": row["mnemonic"],
                "semantic_handler": row["semantic_handler"],
                "classification": classification,
                "independent_status": status,
                "encoding_match": encoding_match,
                "abi_change_acceptance": abi_change_acceptance,
                "pto_command_disposition": pto_effect,
                "pto_disposition": disposition,
                "requirements": [
                    "PTO-REQ-BUNDLE-DISPATCH-001",
                    "PTO-REQ-BUNDLE-OPERATION-001",
                    "PTO-REQ-BUNDLE-STATE-001",
                ],
                "evidence": [
                    "spec/catalog/command-forms.json",
                    "spec/evidence/bundle-command-totality.json",
                    "tests/asl/bundle-tests.asl",
                    "docs/status/decisions/0032-bundle-command-totality-and-profile-boundaries.md",
                ],
            }
        )

    for index, row in enumerate(tile_ops):
        family = row["family"]
        name = row["name"]
        selector_text = (
            row["selector"] if "selector" in row else f"0x{int(row['function']):03X}"
        )
        selector_value = int(selector_text, 16)
        reqs, evidence = evidence_for_tile_family(family, name)
        manifest_name = tile_manifest_name(name)
        op_map_entry = op_map_names.get((family, manifest_name))
        if family == "TEPL":
            engine_entry = engine_tepl.get(manifest_name)
            independent_status = "selector-manifest"
        elif family == "TLSU":
            engine_entry = engine_tlsu.get(tile_header_name(name))
            independent_status = "header-manifest"
        else:
            engine_entry = engine_cube.get(tile_header_name(name))
            independent_status = "header-manifest"

        selector_match = False
        if op_map_entry is not None:
            if op_map_entry.get("selector") is not None:
                independent_selector = op_map_entry["selector"]
                selector_match = (
                    int(independent_selector, 16)
                    if isinstance(independent_selector, str)
                    else int(independent_selector)
                ) == selector_value
            else:
                selector_match = int(op_map_entry["function"]) == selector_value
        elif engine_entry is not None and family == "TEPL":
            selector_match = int(engine_entry["tile_opcode"]) == selector_value
        elif engine_entry is not None:
            selector_match = int(engine_entry["function"]) == selector_value

        abi_change_acceptance = None
        if family == "TEPL" and name == "TPRELU":
            classification = "intentional-extension"
            disposition = "PTO-owned TEPL extension with raw-carrier semantics; no independent payload row is available."
        elif engine_entry is None:
            classification = "divergence"
            disposition = (
                "PTO selector has no matching independent operation manifest row."
            )
        elif not selector_match:
            classification = "divergence"
            disposition = "The independent snapshot retains the superseded VEC/SFU carrier selector. PTO ISA 0.58.0 intentionally assigns the compact 0..127 selector under ADR 0056 and issue #54; PTO remains authoritative and the comparison remains an honest selector divergence."
            abi_change_acceptance = {
                "decision": "docs/status/decisions/0056-pto-linx-common-encoding-and-gm-access.md",
                "formal_model_issue": "https://github.com/PTO-ISA/pto-spec/issues/54",
                "kind": "accepted-0.58.0-compact-tepl-selector-break",
            }
        elif family == "TEPL":
            classification = "comparable-match"
            disposition = "Selector identity and generic TEPL carrier pattern match; PTO-owned ASL supplies payload semantics."
        else:
            classification = "non-comparable"
            disposition = "Header/function manifest matches, but no independent tile payload execution is available."

        bridge_row = bridge.get(name, {})
        rows.append(
            {
                "surface": "direct-tile",
                "index": index,
                "stable_id": f"{family.lower()}:{selector_text.lower()}:{name}",
                "family": family,
                "mnemonic": name,
                "selector": selector_text.lower(),
                "classification": classification,
                "independent_status": independent_status if engine_entry else "missing",
                "selector_match": selector_match,
                "abi_change_acceptance": abi_change_acceptance,
                "bundle_bridge_representable": bridge_row.get("representable"),
                "pto_disposition": disposition,
                "requirements": reqs,
                "evidence": ["spec/catalog/tile-operations.json", *evidence],
            }
        )

    summary = {
        "row_count": len(rows),
        "surface_counts": dict(Counter(row["surface"] for row in rows)),
        "classification_counts": dict(Counter(row["classification"] for row in rows)),
        "independent_status_counts": dict(
            Counter(row["independent_status"] for row in rows)
        ),
        "tile_family_counts": dict(
            Counter(
                row.get("family") for row in rows if row["surface"] == "direct-tile"
            )
        ),
    }
    return rows, summary


def gate_summary(snapshot_root: Path) -> list[dict[str, Any]]:
    return run_gate_set(snapshot_root, GATE_COMMANDS)


def required_toolchain_checks(snapshot_root: Path) -> list[dict[str, Any]]:
    return run_gate_set(snapshot_root, REQUIRED_TOOLCHAIN_COMMANDS)


def build(snapshot_root: Path) -> dict[str, Any]:
    snapshot = load_snapshot(snapshot_root)
    rows, summary = build_rows(snapshot)
    coverage = snapshot["coverage"]
    gates = gate_summary(snapshot_root)
    toolchain_checks = required_toolchain_checks(snapshot_root)
    failed_gates = [
        row for row in [*gates, *toolchain_checks] if row["result"] != "pass"
    ]
    can_close = (
        clean_snapshot_metadata(snapshot_root)["worktree_clean"] and not failed_gates
    )
    data = {
        "schema": "pto.executable-model-comparison.v1",
        "target": "S5-T3",
        "status": (
            "comparison-matrix-closed-clean-gates-passed:S5-T3"
            if can_close
            else "comparison-matrix-closed-gate-open:S5-T3-G2"
        ),
        "authority": "PTO ASL, catalogs, requirements, and accepted ADRs remain normative. The independent executable model is corroborating evidence only.",
        "snapshot": {
            **clean_snapshot_metadata(snapshot_root),
            "content_hashes": snapshot["hashes"],
            "coverage": {
                "total_forms": coverage.get("total_forms"),
                "modeled_forms": coverage.get("modeled_forms"),
                "decode_only_forms": coverage.get("decode_only_forms"),
                "grade_counts": coverage.get("grade_counts"),
            },
            "gates": gates,
            "required_toolchain_checks": toolchain_checks,
        },
        "scope": {
            "scalar_forms": 474,
            "command_forms": 100,
            "direct_tile_operations": 109,
            "total_rows": 683,
            "direct_tile_breakdown": {"TEPL": 87, "TLSU": 10, "CUBE": 12},
        },
        "model_limits": [
            {
                "id": "accepted-0.58.0-abi-break",
                "disposition": "The immutable independent snapshot predates the accepted command-encoding, compact TEPL-selector ABI, and completed TLOAD/TSTORE operand schema. The retained matrix preserves 7 command encoding divergences and 68 direct-tile ABI divergences instead of relabeling them as exact matches.",
            },
            {
                "id": "reg5-flat-model-mismatch",
                "disposition": "PTO models Reg5 selectors 24..31 as T/U queue reads and only selectors 30/31 as queue-push destinations; the independent executable subset is a flat-form comparison and does not by itself validate queue payload ordering.",
            },
            {
                "id": "predicate-p0-p7-difference",
                "disposition": "The independent model corroborates one 64-bit MPAR/MSEQ execution mask. PTO separately defines eight 32-bit warp predicates with hardwired P0; the comparison does not establish their selector or execution contract.",
            },
            {
                "id": "bundle-bridge-operand-boundary",
                "disposition": "PTO-v0 bundle commit resolves the complete direct-operation schema from ordered B.IOT/B.IOR bindings, bundle headers, and operation defaults. All 109 direct tile operations are schema-representable; malformed or surplus bindings still reject before tile effects.",
            },
            {
                "id": "tepl-selector-boundary",
                "disposition": "PTO defines 87 TEPL operations. The retained independent selector evidence is classified row by row; TFMA is an explicit PTO-owned extension.",
            },
            {
                "id": "tlsu-and-cube-manifest-boundary",
                "disposition": "The retained TLSU and CUBE manifest rows are header/function evidence rather than independent tile payload execution; GMOV is an explicit PTO-owned extension.",
            },
            {
                "id": "no-independent-tile-payload-execution",
                "disposition": "Tile payload effects, aliases, legality, packed four-bit memory behavior, and raw numeric carriers are closed by PTO-owned ASL tests and ADRs, not by the independent executable model.",
            },
        ],
        "summary": summary,
        "rows": rows,
        "closure_judgment": {
            "can_close_s5_t3": can_close,
            "basis": (
                "The exhaustive row-disposition obligation S5-T3-G1 is complete: every PTO scalar form, command form, and direct tile operation has a stable classification and PTO-owned evidence. "
                "S5-T3 closes only when the clean independent snapshot passes every archived parser, executable-backend, generated-status, coverage, and documentation gate."
            ),
            "remaining_blockers": [
                f"{row['id']} returned {row['result']} (exit={row['exit_code']}); see archived command result."
                for row in failed_gates
            ],
        },
    }
    if summary["row_count"] != 682:
        raise SystemExit(f"expected 682 rows, got {summary['row_count']}")
    if summary["classification_counts"] != {
        "comparable-match": 554,
        "divergence": 90,
        "non-comparable": 38,
    }:
        raise SystemExit(
            f"unexpected comparison classification counts: {summary['classification_counts']}"
        )
    accepted_abi_breaks = [
        row for row in rows if row.get("abi_change_acceptance") is not None
    ]
    accepted_abi_break_counts = Counter(row["surface"] for row in accepted_abi_breaks)
    if accepted_abi_break_counts != Counter({"command": 7, "direct-tile": 68}):
        raise SystemExit(
            "unexpected accepted ABI divergence counts: "
            f"{dict(sorted(accepted_abi_break_counts.items()))}"
        )
    return data


def prune_existing_to_catalog() -> dict[str, Any]:
    """Prune a frozen comparison when canonical forms are removed.

    This preserves the content-addressed independent snapshot and its archived
    gates while removing only rows that no longer exist in the canonical
    command catalog. It deliberately cannot add or rewrite comparison rows.
    """
    if not OUTPUT.exists():
        raise SystemExit(f"missing existing evidence to prune: {OUTPUT}")
    data = load_json(OUTPUT)
    command_catalog = load_json(ROOT / "spec/catalog/command-forms.json")
    accepted_ids = {row["form_id"] for row in command_catalog["forms"]}
    existing_command_ids = {
        row["stable_id"] for row in data["rows"] if row["surface"] == "command"
    }
    removed_ids = existing_command_ids - accepted_ids
    reassigned_ids = {
        "c_b_ios_16_14f1b8fba5e6": "b_ios_32_4ba5ef98fdaa",
    }
    allowed_retired_ids = {
        "bstart_acccvt_32_56c3ce3838c5",
        "bstart_mgather_cas_32_fd8c8a3b720a",
        "bstart_mgather_mask_32_5573241cd944",
        "bstart_mscatter_mask_32_2a33eed646f7",
        *reassigned_ids,
    }
    if removed_ids - allowed_retired_ids:
        raise SystemExit(
            f"refusing to prune unexpected command rows: {sorted(removed_ids)}"
        )
    missing_ids = accepted_ids - existing_command_ids - set(reassigned_ids.values())
    # A newly accepted PTO-owned command has no row in the frozen independent
    # snapshot.  Preserve that fact explicitly as a non-comparable/missing row;
    # pruning must never fabricate an independent execution result.
    synthetic_rows = []
    for missing_id in sorted(missing_ids):
        command_row = next(
            row for row in command_catalog["forms"] if row["form_id"] == missing_id
        )
        synthetic_rows.append(
            {
                "abi_change_acceptance": None,
                "classification": "non-comparable",
                "encoding_match": False,
                "evidence": ["spec/catalog/command-forms.json"],
                "independent_status": "missing",
                "index": 0,
                "mnemonic": command_row["mnemonic"],
                "pto_command_disposition": "accepted PTO command absent from the independent snapshot",
                "pto_disposition": "No independent executable evidence exists for this newly accepted form; PTO-owned ASL, decoder witness, and AVS remain authoritative.",
                "requirements": ["PTO-REQ-BUNDLE-DISPATCH-001", "PTO-REQ-BUNDLE-STATE-001"],
                "semantic_handler": command_row["semantic_handler"],
                "stable_id": missing_id,
                "surface": "command",
            }
        )
    rows = [
        row
        for row in data["rows"]
        if row["surface"] != "command" or row["stable_id"] in accepted_ids
    ]
    rows.extend(synthetic_rows)
    for old_id, new_id in reassigned_ids.items():
        if old_id not in existing_command_ids or new_id not in accepted_ids:
            continue
        source_row = next(row for row in data["rows"] if row["stable_id"] == old_id)
        command_row = next(row for row in command_catalog["forms"] if row["form_id"] == new_id)
        rows.append(
            {
                **source_row,
                "stable_id": new_id,
                "mnemonic": command_row["mnemonic"],
                "semantic_handler": command_row["semantic_handler"],
                "classification": "divergence",
                "encoding_match": False,
                "abi_change_acceptance": {
                    "decision": "docs/status/decisions/0054-pe-local-tile-size-and-32-bit-shared-io-binding.md",
                    "formal_model_issue": "https://github.com/PTO-ISA/pto-spec/issues/49",
                    "kind": "accepted-0.58.0-command-encoding-break",
                },
                "pto_disposition": (
                    "PTO ISA 0.58.0 replaces the retired 16-bit C.B.IOS binder "
                    "with a 32-bit B.IOS form carrying SharedTID, per-PE TSize, "
                    "and PE_MASK; the independent snapshot retains the "
                    "superseded binder encoding."
                ),
                "evidence": sorted(
                    set(source_row["evidence"])
                    | {"docs/status/decisions/0054-pe-local-tile-size-and-32-bit-shared-io-binding.md"}
                ),
            }
        )
    command_index = 0
    for row in rows:
        if row["surface"] == "command":
            row["index"] = command_index
            command_index += 1
        if row["surface"] == "command" and row["stable_id"] == "b_ios_32_4ba5ef98fdaa":
            row["classification"] = "divergence"
    data["rows"] = rows
    data["scope"]["command_forms"] = len(accepted_ids)
    data["scope"]["total_rows"] = len(rows)
    data["summary"]["row_count"] = len(rows)
    data["summary"]["classification_counts"] = dict(
        sorted(Counter(row["classification"] for row in rows).items())
    )
    data["summary"]["independent_status_counts"] = dict(
        sorted(Counter(row["independent_status"] for row in rows).items())
    )
    data["summary"]["surface_counts"] = dict(
        sorted(Counter(row["surface"] for row in rows).items())
    )
    return data


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--independent-root",
        type=Path,
        default=Path(os.environ[SNAPSHOT_ENV]) if SNAPSHOT_ENV in os.environ else None,
        help=f"Path to the neutral independent snapshot. Defaults to ${SNAPSHOT_ENV}.",
    )
    parser.add_argument("--check", action="store_true")
    parser.add_argument(
        "--prune-existing-to-catalog",
        action="store_true",
        help="Remove only retired canonical command rows from existing frozen evidence.",
    )
    args = parser.parse_args()

    if args.prune_existing_to_catalog:
        data = prune_existing_to_catalog()
    elif args.independent_root is None:
        raise SystemExit(f"set {SNAPSHOT_ENV} or pass --independent-root")
    else:
        data = build(args.independent_root.resolve())
    rendered = stable_json(data)
    if args.check:
        if not OUTPUT.exists():
            print(f"missing generated evidence: {OUTPUT}", file=sys.stderr)
            return 1
        existing = OUTPUT.read_text(encoding="utf-8")
        if existing != rendered:
            print(f"stale generated evidence: {OUTPUT}", file=sys.stderr)
            return 1
        return 0
    OUTPUT.write_text(rendered, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
