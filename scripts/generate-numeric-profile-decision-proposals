        "isa_profile": "pto-v0",
        "role": "A5 support restrictions and explicitly bounded numeric variation points",
        "normative": True,
        "selection": "named target profile plus a complete operation/type legality and rule table",
        "status": "review-required",
        "acceptance_record": None,
    },
)


