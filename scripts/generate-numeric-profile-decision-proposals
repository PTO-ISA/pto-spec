def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"numeric profile proposal generation failed: {message}")


def generate() -> dict[str, Any]:
    inputs = load(INPUT)
    readiness = load(READINESS)
    require(inputs["target"] == "S5-T2-A", "decision-input target drift")
    require(
        inputs["status"] == "decision-inputs-closed-profile-decisions-open",
        "decision-input status drift",
    )
    questions = inputs["decision_questions"]
    domains = inputs["domain_matrix"]
    require(
        {row["id"] for row in questions} == set(PROPOSALS),
        "question proposal coverage drift",
    )
    require(
        len(PROFILE_PROPOSALS) == len(inputs["profile_partition_inputs"]),
        "profile partition count drift",
    )
    require(
        {row["partition_id"] for row in PROFILE_PROPOSALS}
        == {row["id"] for row in inputs["profile_partition_inputs"]},
        "profile partition identity drift",
    )

    decision_proposals = []
    for question in questions:
        proposal = PROPOSALS[question["id"]]
        require(
            set(proposal["proposed_dispositions"]).issubset(
                question["permitted_dispositions"]
            ),
            f"{question['id']} proposes a forbidden disposition",
        )
        require(
            question["selected_disposition"] is None
            and question["decision_record"] is None,
            f"{question['id']} was accepted outside this proposal layer",
        )
        decision_proposals.append(
            {
                "id": question["id"],
                "title": question["title"],
                "classification": question["classification"],
                "source_ids": question["source_ids"],
                "affected_domains": question["domains"],
                **proposal,
                "acceptance_evidence": question["acceptance_evidence"],
                "status": "review-required",
                "accepted": False,
                "acceptance_record": None,
            }
        )

    proposed_profile_ids = [row["proposed_id"] for row in PROFILE_PROPOSALS]
    domain_proposals = []
    for domain in domains:
        require(
            domain["selected_profile_rule"] is None,
            f"{domain['domain']} was accepted outside this proposal layer",
        )
        domain_proposals.append(
            {
                "domain": domain["domain"],
                "lane": domain["lane"],
                "operation_count": domain["operation_count"],
                "operation_keys": domain["operation_keys"],
                "hooks": domain["hooks"],
                "decision_question_ids": domain["decision_question_ids"],
                "proposed_profile_ids": proposed_profile_ids,
                "portable_rule_status": "rule-required",
                "a2a3_support_status": "operation-type-matrix-required",
                "a5_support_status": "operation-type-matrix-required",
                "cpu_observation_status": "capture-plan-required-not-oracle",
                "independent_oracle_status": "qualification-required",
                "vector_status": "generation-required",
                "result_status": "capture-required",
                "review_status": "acceptance-required",
                "accepted_profile_rule": None,
                "status": "proposal-mapped-conformance-open",
            }
        )

    operation_count = sum(row["operation_count"] for row in domain_proposals)
    profile_hooks = sorted(
        {hook for lane in readiness["lanes"] for hook in lane["hooks"]}
    )
    require(len(domain_proposals) == 20, "numeric domain count drift")
    require(operation_count == 108, "numeric operation count drift")
    require(len(profile_hooks) == 29, "numeric hook count drift")
    require(
        readiness["summary"]["operation_count"] == operation_count,
        "readiness operation count drift",
    )

    return {
        "schema_version": 1,
        "target": "S5-T2-A",
        "status": "proposal-complete-decisions-open",
        "input": {
            "path": "spec/evidence/numeric-profile-decision-inputs.json",
            "sha256": hashlib.sha256(INPUT.read_bytes()).hexdigest(),
            "public_repository": inputs["public_repository"],
            "public_commit": inputs["public_commit"],
        },
        "policy": {
            "proposal_not_authority": "This package proposes reviewable dispositions; it does not accept a numeric rule or change PTO ASL semantics.",
            "support_boundary": "A target profile may narrow support. An accepted operation has portable semantics unless an accepted named rule bounds a visible variation point.",
            "cpu_boundary": "CPU results are observations from an implementation under test, never an independent oracle.",
            "fail_closed": "Unknown profiles, modes, formats, operation/type tuples, and missing numeric rules reject before architectural effects.",
            "promotion": "S5-T2-A remains open until every proposal has an accepted PTO decision record and every domain has an accepted rule.",
        },
        "profile_proposals": list(PROFILE_PROPOSALS),
        "profile_hooks": profile_hooks,
        "decision_proposals": decision_proposals,
        "domain_proposals": domain_proposals,
        "promotion_residuals": [
            {
                "id": "S5-T2-A1",
                "target": "accept all profile identities and all 12 decision records",
                "current": 0,
                "required": 16,
            },
            {
                "id": "S5-T2-A2",
                "target": "populate accepted rules for every numeric domain",
                "current": 0,
                "required": 20,
            },
            {
                "id": "S5-T2-B",
                "target": "qualify an independent oracle for every conformance lane",
                "current": 0,
                "required": 6,
            },
            {
                "id": "S5-T2-C",
                "target": "publish normal, boundary, exceptional, and adversarial vectors for every domain",
                "current": 0,
                "required": 20,
            },
            {
                "id": "S5-T2-D",
                "target": "record local CPU plus independent A2A3 and A5 target results",
                "current": 0,
                "required": 60,
            },
            {
                "id": "S5-T2-E",
                "target": "adjudicate every differential and obtain architecture/formal review",
                "current": 0,
                "required": 22,
            },
        ],
        "summary": {
            "profile_proposal_count": len(PROFILE_PROPOSALS),
            "accepted_profile_count": 0,
            "decision_proposal_count": len(decision_proposals),
            "accepted_decision_count": 0,
            "numeric_domain_count": len(domain_proposals),
            "accepted_domain_rule_count": 0,
            "numeric_operation_count": operation_count,
            "numeric_hook_count": len(profile_hooks),
            "can_close_s5_t2_a": False,
            "can_close_s5_t2": False,
        },
    }


def serialized() -> str:
    return json.dumps(generate(), indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument("--check", action="store_true")
    action.add_argument("--write", action="store_true")
    args = parser.parse_args()
    expected = serialized()
    if args.write:
        OUTPUT.write_text(expected, encoding="utf-8")
        return 0
    if not OUTPUT.exists() or OUTPUT.read_text(encoding="utf-8") != expected:
        raise SystemExit(
            "numeric profile decision proposals are stale; run scripts/generate-numeric-profile-decision-proposals --write"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
