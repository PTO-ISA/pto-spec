#!/usr/bin/env python3
"""Generate the fail-closed S5-T2-A numeric profile proposal package."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
INPUT = ROOT / "spec/evidence/numeric-profile-decision-inputs.json"
READINESS = ROOT / "spec/evidence/numeric-conformance-readiness.json"
IDENTITY_CATALOG = ROOT / "spec/catalog/numeric-profile-identities.json"
SCALAR_FLAG_CONTRACT = ROOT / "spec/evidence/scalar-numeric-flag-contract.json"
ROUNDING_SELECTOR_CONTRACT = (
    ROOT / "spec/evidence/numeric-rounding-selector-contract.json"
)
SUBNORMAL_CONTRACT = ROOT / "spec/evidence/numeric-subnormal-contract.json"
SPECIAL_VALUE_CONTRACT = ROOT / "spec/evidence/numeric-special-value-contract.json"
FORMAT_NAMESPACE_CONTRACT = (
    ROOT / "spec/evidence/numeric-format-namespace-contract.json"
)
PUBLIC_TYPE_BASELINE = ROOT / "spec/evidence/public-numeric-type-baseline.json"
PUBLIC_INTEGER_CONVERSION = (
    ROOT / "spec/evidence/public-integer-conversion-contract.json"
)
PROFILE_APPLICABILITY_CONTRACT = (
    ROOT / "spec/evidence/numeric-profile-applicability-closure.json"
)
VARIATION_POINT_CONTRACT = (
    ROOT / "spec/evidence/numeric-variation-point-ownership.json"
)
OUTPUT = ROOT / "spec/evidence/numeric-profile-decision-proposals.json"


