def load(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def require(condition: bool, message: str) -> None:
    if not condition:
        raise SystemExit(f"numeric profile proposal generation failed: {message}")


def generate() -> dict[str, Any]:
    inputs = load(INPUT)
    readiness = load(READINESS)
    identity_catalog = load(IDENTITY_CATALOG)
    scalar_flag_contract = load(SCALAR_FLAG_CONTRACT)
    rounding_selector_contract = load(ROUNDING_SELECTOR_CONTRACT)
    subnormal_contract = load(SUBNORMAL_CONTRACT)
    special_value_contract = load(SPECIAL_VALUE_CONTRACT)
    format_namespace_contract = load(FORMAT_NAMESPACE_CONTRACT)
    public_type_baseline = load(PUBLIC_TYPE_BASELINE)
    public_integer_conversion = load(PUBLIC_INTEGER_CONVERSION)
    profile_applicability_contract = load(PROFILE_APPLICABILITY_CONTRACT)
    variation_point_contract = load(VARIATION_POINT_CONTRACT)

    require(
        subnormal_contract["schema_version"] == 1
        and subnormal_contract["decision_id"] == "PD-04"
        and subnormal_contract["status"]
        == "named-hardware-profile-subnormal-policy-accepted-other-numeric-decisions-open"
        and subnormal_contract["acceptance_record"]
        == "docs/status/decisions/0049-hardware-subnormal-policy.md"
        and subnormal_contract["summary"]
        == {
            "subnormal_capable_type_count": 11,
            "boundary_vector_count": 55,
            "configuration_vector_count": 8,
            "non_applicable_type_count": 14,
            "affected_domain_count": 14,
            "affected_operation_count": 93,
            "operation_applicability_row_count": 93,
            "conditional_operation_type_tuple_count": 1023,
            "affected_hook_count": 23,
            "accepted_decision_count": 1,
            "accepted_complete_domain_rule_count": 0,
            "pd04_complete": True,
            "s5_t2_a_complete": False,
            "s5_t2_complete": False,
        },
        "numeric subnormal contract drift",
    )
    require(
        special_value_contract["schema_version"] == 1
        and special_value_contract["decision_id"] == "PD-05"
        and special_value_contract["checkpoint_id"] == "PD-05-SC2"
        and special_value_contract["status"]
        == "named-hardware-special-value-checkpoint-accepted-pd05-open"
        and special_value_contract["acceptance_record"]
        == "docs/status/decisions/0050-hardware-special-value-checkpoint.md"
        and special_value_contract["summary"]
        == {
            "format_count": 25,
            "nan_capable_type_count": 10,
            "signaling_nan_capable_type_count": 7,
            "signed_zero_type_count": 13,
            "comparison_operation_count": 2,
            "minmax_operation_count": 6,
            "operation_scope_count": 8,
            "conditional_operation_type_tuple_count": 154,
            "accepted_special_result_rule_count": 3,
            "accepted_complete_domain_rule_count": 0,
            "accepted_complete_decision_count": 0,
            "pd05_complete": False,
            "s5_t2_complete": False,
        },
        "numeric special-value contract drift",
    )
    require(inputs["target"] == "S5-T2-A", "decision-input target drift")
    require(
        inputs["status"]
        == "decision-inputs-and-identities-closed-profile-decisions-open",
        "decision-input status drift",
    )
    questions = inputs["decision_questions"]
    domains = inputs["domain_matrix"]
    require(
        {row["id"] for row in questions} == set(PROPOSALS),
        "question proposal coverage drift",
    )
    require(identity_catalog["schema_version"] == 1, "identity catalog schema drift")
    require(
        identity_catalog["status"] == "identity-framework-closed-rules-open",
        "identity framework status drift",
    )
    require(
        scalar_flag_contract["schema_version"] == 1
        and scalar_flag_contract["decision_id"] == "PD-06"
        and scalar_flag_contract["status"]
        == "state-owner-matrix-closed-profile-production-open"
        and scalar_flag_contract["summary"]["producer_owner_closed_form_count"] == 30
        and scalar_flag_contract["summary"]["architecture_condition_closed_form_count"]
        == 11
        and scalar_flag_contract["summary"]["profile_condition_open_form_count"] == 19
        and scalar_flag_contract["summary"]["pd06_complete"] is False,
        "scalar numeric flag contract drift",
    )
    require(
        rounding_selector_contract["schema_version"] == 1
        and rounding_selector_contract["decision_id"] == "PD-03"
        and rounding_selector_contract["status"]
        == "rounding-selection-and-domain-rules-accepted-other-numeric-dimensions-open"
        and rounding_selector_contract["summary"]
        == {
            "scalar_active_selector_count": 8,
            "scalar_fixed_override_count": 5,
            "bundle_rmode_selector_count": 8,
            "external_selector_class_count": 4,
            "affected_domain_count": 16,
            "affected_operation_count": 100,
            "affected_hook_count": 25,
            "accepted_domain_rounding_rule_count": 16,
            "pd03_complete": True,
        },
        "numeric rounding selector contract drift",
    )
    require(
        format_namespace_contract["schema_version"] == 1
        and format_namespace_contract["decision_id"] == "PD-02"
        and format_namespace_contract["status"]
        == "namespace-carrier-and-value-classification-closed-operation-rules-open"
        and format_namespace_contract["classification_checkpoint_id"]
        == "PD-02-SC2:PD-05-SC1"
        and format_namespace_contract["value_classification"]["status"] == "closed"
        and len(format_namespace_contract["value_classification"]["formats"])
        == 25
        and format_namespace_contract["summary"]
        == {
            "tile_data_type_count": 25,
            "tile_storage_width_counts": {
                "4": 5,
                "8": 8,
                "16": 4,
                "32": 5,
                "64": 3,
            },
            "scalar_source_mapped_count": 2,
            "scalar_source_reserved_count": 2,
            "scalar_floating_destination_mapped_count": 15,
            "scalar_floating_destination_reserved_count": 17,
            "scalar_integer_destination_mapped_count": 15,
            "scalar_integer_destination_reserved_count": 17,
            "tlsu_talloc_mapped_count": 25,
            "tlsu_talloc_reserved_count": 39,
            "bundle_mapped_count": 25,
            "bundle_reserved_count": 7,
            "four_bit_type_count": 5,
            "value_classified_type_count": 25,
            "nan_capable_type_count": 10,
            "signaling_nan_capable_type_count": 7,
            "infinity_capable_type_count": 8,
            "subnormal_capable_type_count": 11,
            "signed_zero_type_count": 13,
            "internally_constrained_type_count": 4,
            "open_residual_count": 8,
            "pd02_complete": False,
        },
        "numeric format namespace contract drift",
    )
    require(
        public_type_baseline["schema_version"] == 1
        and public_type_baseline["decision_id"] == "PD-02"
        and public_type_baseline["checkpoint_id"] == "PD-02-SC2"
        and public_type_baseline["status"]
        == "public-type-identity-catalog-binding-and-target-availability-closed-result-and-legality-open"
        and public_type_baseline["summary"]
        == {
            "public_type_count": 16,
            "public_floating_type_count": 8,
            "public_integer_type_count": 8,
            "a2a3_available_type_count": 11,
            "a5_available_type_count": 16,
            "accepted_catalog_binding_count": 16,
            "non_public_catalog_type_count": 9,
            "accepted_result_rule_count": 0,
            "accepted_domain_rule_count": 0,
            "open_residual_count": 4,
            "pd02_complete": False,
            "s5_t2_a_complete": False,
            "s5_t2_complete": False,
        },
        "public numeric type baseline drift",
    )
    require(
        public_integer_conversion["schema_version"] == 1
        and public_integer_conversion["target"] == "S5-T2-A6:PD-07-SC1"
        and public_integer_conversion["decision_id"] == "PD-07"
        and public_integer_conversion["checkpoint_id"] == "PD-07-SC1"
        and public_integer_conversion["status"]
        == "public-integer-conversion-result-subset-closed-profile-support-and-other-results-open"
        and public_integer_conversion["summary"]
        == {
            "public_integer_type_count": 8,
            "candidate_ordered_pair_count": 64,
            "same_width_pair_count": 16,
            "accepted_unequal_width_tuple_count": 48,
            "accepted_widening_tuple_count": 24,
            "accepted_narrowing_tuple_count": 24,
            "accepted_result_rule_count": 3,
            "accepted_domain_rule_count": 0,
            "accepted_profile_support_rule_count": 0,
            "open_residual_count": 6,
            "pd07_complete": False,
            "tile_convert_domain_complete": False,
            "s5_t2_a_complete": False,
            "s5_t2_complete": False,
        },
        "public integer conversion contract drift",
    )
    require(
        profile_applicability_contract["schema_version"] == 1
        and profile_applicability_contract["artifact_id"]
        == "numeric-profile-applicability-closure"
        and profile_applicability_contract["status"]
        == "a2a3-mx-unsupported-profile-tuples-closed-results-open"
        and profile_applicability_contract["summary"]
        == {
            "rule_count": 6,
            "operation_count": 6,
            "selector_count": 6,
            "tile_data_type_count": 25,
            "tuple_count": 150,
            "bundle_execution_tuple_count": 150,
            "bundle_command_form_count": 6,
            "accepted_command_form_count": 74,
            "result_rule_count": 0,
            "parent_pd01_complete": False,
            "cube_matrix_complete": False,
            "s5_t2_complete": False,
        },
        "numeric profile applicability contract drift",
    )
    profile_proposals = [
        {
            "partition_id": row["partition_id"],
            "proposed_id": row["id"],
            "kind": row["kind"],
            "role": row["role"],
            "normative": row["normative_identity"],
            "selection": row["selection"],
            "relation_to_pto_v0": row["relation_to_pto_v0"],
            "rule_status": row["rule_status"],
            "source_ids": row["source_ids"],
            "status": "identity-accepted-rules-open",
            "acceptance_record": row["acceptance_record"],
        }
        for row in identity_catalog["identities"]
    ]
    require(
        len(profile_proposals) == len(inputs["profile_partition_inputs"]),
        "profile partition count drift",
    )
    require(
        {row["partition_id"] for row in profile_proposals}
        == {row["id"] for row in inputs["profile_partition_inputs"]},
        "profile partition identity drift",
    )

    decision_proposals = []
    for question in questions:
        proposal = PROPOSALS[question["id"]]
        require(
            set(proposal["proposed_dispositions"]).issubset(
                question["permitted_dispositions"]
            ),
            f"{question['id']} proposes a forbidden disposition",
        )
        accepted = question["status"] == "accepted"
        require(
            (
                accepted
                and question["selected_disposition"] in proposal["proposed_dispositions"]
                and isinstance(question["decision_record"], str)
                and question["decision_record"]
            )
            or (
                not accepted
                and question["selected_disposition"] is None
                and question["decision_record"] is None
            ),
            f"{question['id']} acceptance state drift",
        )
        decision_proposals.append(
            {
                "id": question["id"],
                "title": question["title"],
                "classification": question["classification"],
                "source_ids": question["source_ids"],
                "affected_domains": question["domains"],
                **proposal,
                "acceptance_evidence": question["acceptance_evidence"],
                "status": "accepted" if accepted else "review-required",
                "accepted": accepted,
                "acceptance_record": question["decision_record"],
            }
        )

    proposed_profile_ids = [row["proposed_id"] for row in profile_proposals]
    domain_proposals = []
    for domain in domains:
        require(
            domain["selected_profile_rule"] is None,
            f"{domain['domain']} was accepted outside this proposal layer",
        )
        domain_proposals.append(
            {
                "domain": domain["domain"],
                "lane": domain["lane"],
                "operation_count": domain["operation_count"],
                "operation_keys": domain["operation_keys"],
                "hooks": domain["hooks"],
                "decision_question_ids": domain["decision_question_ids"],
                "proposed_profile_ids": proposed_profile_ids,
                "portable_rule_status": "rule-required",
                "a2a3_support_status": "operation-type-matrix-required",
                "a5_support_status": "operation-type-matrix-required",
                "cpu_observation_status": "capture-plan-required-not-oracle",
                "independent_oracle_status": "qualification-required",
                "vector_status": "generation-required",
                "result_status": "capture-required",
                "review_status": "acceptance-required",
                "accepted_profile_rule": None,
                "status": "proposal-mapped-conformance-open",
            }
        )

    operation_count = sum(row["operation_count"] for row in domain_proposals)
    profile_hooks = sorted(
        {hook for lane in readiness["lanes"] for hook in lane["hooks"]}
    )
    require(len(domain_proposals) == 18, "numeric domain count drift")
    require(operation_count == 104, "numeric operation count drift")
    require(len(profile_hooks) == 30, "numeric hook count drift")
    require(
        readiness["summary"]["operation_count"] == operation_count,
        "readiness operation count drift",
    )

    return {
        "schema_version": 11,
        "target": "S5-T2-A",
        "status": "proposal-complete-two-decisions-accepted",
        "input": {
            "path": "spec/evidence/numeric-profile-decision-inputs.json",
            "sha256": hashlib.sha256(INPUT.read_bytes()).hexdigest(),
            "public_repository": inputs["public_repository"],
            "public_commit": inputs["public_commit"],
        },
        "identity_catalog": {
            "path": "spec/catalog/numeric-profile-identities.json",
            "sha256": hashlib.sha256(IDENTITY_CATALOG.read_bytes()).hexdigest(),
            "status": identity_catalog["status"],
            "acceptance_record": "docs/status/decisions/0037-numeric-profile-identity-and-variation-framework.md",
        },
        "scalar_flag_contract": {
            "path": "spec/evidence/scalar-numeric-flag-contract.json",
            "sha256": hashlib.sha256(SCALAR_FLAG_CONTRACT.read_bytes()).hexdigest(),
            "status": scalar_flag_contract["status"],
            "acceptance_record": scalar_flag_contract["acceptance_record"],
            "producer_owner_closed_form_count": 30,
            "architecture_condition_closed_form_count": 11,
            "profile_condition_open_form_count": 19,
            "pd06_complete": False,
        },
        "rounding_selector_contract": {
            "path": "spec/evidence/numeric-rounding-selector-contract.json",
            "sha256": hashlib.sha256(
                ROUNDING_SELECTOR_CONTRACT.read_bytes()
            ).hexdigest(),
            "status": rounding_selector_contract["status"],
            "acceptance_record": rounding_selector_contract["acceptance_record"],
            **rounding_selector_contract["summary"],
        },
        "subnormal_contract": {
            "path": "spec/evidence/numeric-subnormal-contract.json",
            "sha256": hashlib.sha256(SUBNORMAL_CONTRACT.read_bytes()).hexdigest(),
            "status": subnormal_contract["status"],
            "acceptance_record": subnormal_contract["acceptance_record"],
            **subnormal_contract["summary"],
        },
        "special_value_contract": {
            "path": "spec/evidence/numeric-special-value-contract.json",
            "sha256": hashlib.sha256(SPECIAL_VALUE_CONTRACT.read_bytes()).hexdigest(),
            "status": special_value_contract["status"],
            "acceptance_record": special_value_contract["acceptance_record"],
            **special_value_contract["summary"],
        },
        "format_namespace_contract": {
            "path": "spec/evidence/numeric-format-namespace-contract.json",
            "sha256": hashlib.sha256(
                FORMAT_NAMESPACE_CONTRACT.read_bytes()
            ).hexdigest(),
            "status": format_namespace_contract["status"],
            "acceptance_record": format_namespace_contract["acceptance_record"],
            "classification_checkpoint_id": format_namespace_contract[
                "classification_checkpoint_id"
