#!/usr/bin/env python3
"""Validate publication hygiene and repository-local Markdown references."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote, urlsplit


ROOT = Path(__file__).resolve().parent.parent
FORBIDDEN_TERMS = (
    "v" + "call",
    "m" + "call",
    "heng" + "liao1972",
)
ALLOWED_EXTERNAL_REFERENCES = (
    "https://github.com/hengliao1972/normative_language/blob/main/normative_language.md",
)
MIGRATED_DOCUMENT_ROOTS = (
    Path("docs/arch"),
    Path("docs/block"),
    Path("docs/scalar"),
    Path("docs/tile"),
    Path("docs/status/legacy"),
)
LEGACY_RELEASE = re.compile(r"(?<![0-9.])v?0\.57(?!\.1(?:\b|[^0-9]))")
STALE_URL_PREFIXES = (
    "https://developer." + "arm.com/architectures/architecture-specification-language",
    "https://developer." + "arm.com/documentation/",
)
MARKDOWN_LINK = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
NUMBERED_HEADING = re.compile(r"^#{1,6}\s+\d+(?:[.)]|\s)")
ACTIVE_GUIDANCE = (
    Path("README.md"),
    Path("CONTRIBUTING.md"),
    Path("GOVERNANCE.md"),
    Path("AGENTS.md"),
    Path(".codex/skills/pto-asl/SKILL.md"),
    Path(".codex/skills/pto-asl/references/source-map.md"),
    Path("docs/governance/adr-process.md"),
    Path("docs/governance/validation.md"),
    Path("docs/development/getting-started.md"),
    Path("docs/development/repository-layout.md"),
    Path("docs/releases/index.md"),
)
MACHINE_DEPENDENCY_LOCKS = (Path("docs/site/pnpm-lock.yaml"),)
STALE_GUIDANCE_ROUTES = (
    "spec/requirements.json",
    "PRD-",
    "PD-",
    "manual exact-head release lane",
    "manually dispatched",
)


def repository_files() -> list[Path]:
    result = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        cwd=ROOT,
        check=True,
        capture_output=True,
    )
    return [ROOT / item.decode() for item in result.stdout.split(b"\0") if item]


def markdown_target(raw: str) -> str:
    value = raw.strip()
    if not value:
        return ""
    if value.startswith("<") and ">" in value:
        return value[1 : value.index(">")]
    return value.split(maxsplit=1)[0]


def canonical_markdown_source(path: Path) -> Path:
    relative = path.relative_to(ROOT)
    parts = relative.parts
    marker = ("docusaurus-plugin-content-docs-reference", "current")
    if len(parts) >= 7 and parts[:3] == ("docs", "site", "i18n") and parts[4:6] == marker:
        return ROOT / "docs" / Path(*parts[6:])
    return path


def main() -> int:
    failures: list[str] = []
    markdown_link_count = 0
    files = repository_files()

    readme = ROOT / "README.md"
    if readme.is_file() and len(readme.read_text(encoding="utf-8").splitlines()) > 220:
        failures.append("README.md exceeds the 220-line source limit")
    codeowners = ROOT / ".github/CODEOWNERS"
    if not codeowners.is_file() or codeowners.read_text(encoding="utf-8") != "* @zhoubot\n":
        failures.append(".github/CODEOWNERS must contain exactly '* @zhoubot'")
    for relative in ACTIVE_GUIDANCE:
        path = ROOT / relative
        if not path.is_file():
            failures.append(f"missing active guidance: {relative}")
            continue
        text = path.read_text(encoding="utf-8")
        for route in STALE_GUIDANCE_ROUTES:
            if route in text:
                failures.append(f"stale active-guidance route: {relative}: {route}")

    for path in files:
        relative = path.relative_to(ROOT)
        lower_path = str(relative).lower()
        migrated = any(
            relative == root or root in relative.parents
            for root in MIGRATED_DOCUMENT_ROOTS
        )
        if any(term in lower_path for term in FORBIDDEN_TERMS) or (
            LEGACY_RELEASE.search(lower_path) and not migrated
        ):
            failures.append(f"forbidden source identity in path: {relative}")
            continue
        if not path.is_file():
            continue
        try:
            body = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue

        lower_body = body.lower()
        identity_body = lower_body
        for allowed_reference in ALLOWED_EXTERNAL_REFERENCES:
            identity_body = identity_body.replace(allowed_reference.lower(), "")
        if any(term in identity_body for term in FORBIDDEN_TERMS) or (
            LEGACY_RELEASE.search(identity_body)
            and not migrated
            and relative not in MACHINE_DEPENDENCY_LOCKS
        ):
            failures.append(f"forbidden source identity in file: {relative}")
        for prefix in STALE_URL_PREFIXES:
            if prefix in body:
                failures.append(f"stale external URL in file: {relative}: {prefix}")

        if path.suffix != ".md":
            continue

        # Imported and generated instruction-reference pages intentionally
        # retain source formatting and source-relative references needed to
        # reproduce the Complete site. Their rendered headings, links, and
        # fragments are checked by the HTML builder.
        if migrated:
            continue

        for line_number, line in enumerate(body.splitlines(), start=1):
            if NUMBERED_HEADING.match(line):
                failures.append(
                    f"manually numbered Markdown heading: {relative}:{line_number}"
                )

        for match in MARKDOWN_LINK.finditer(body):
            markdown_link_count += 1
            target = markdown_target(match.group(1))
            line_number = body.count("\n", 0, match.start()) + 1
            if not target:
                failures.append(
                    f"empty Markdown link target: {relative}:{line_number}"
                )
                continue
            parsed = urlsplit(target)
            if parsed.scheme or target.startswith("#"):
                continue
            if not parsed.path:
                continue
            if parsed.path.startswith("/"):
                failures.append(
                    f"absolute local Markdown link: {relative}:{line_number}: {target}"
                )
                continue
            destination = (
                canonical_markdown_source(path).parent / unquote(parsed.path)
            ).resolve()
            try:
                destination.relative_to(ROOT)
            except ValueError:
                failures.append(
                    f"Markdown link escapes repository: {relative}:{line_number}: {target}"
                )
                continue
            if not destination.exists():
                failures.append(
                    f"broken local Markdown link: {relative}:{line_number}: {target}"
                )

    changelog = subprocess.run(
        [str(ROOT / "scripts/generate-changelog"), "--check"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    if changelog.returncode != 0:
        failures.append(changelog.stderr.strip() or "generated changelog is stale")

    if failures:
        print("\n".join(failures), file=sys.stderr)
        return 1
    print(
        f"publication hygiene passed: {len(files)} files, "
        f"{markdown_link_count} Markdown links checked"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
