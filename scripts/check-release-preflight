#!/usr/bin/env python3
"""Validate and record the immutable tuple before expensive release jobs."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.release_preflight import canonical_bytes, validate_preflight  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--pto-root", type=Path, default=ROOT)
    parser.add_argument("--llvm-root", required=True, type=Path)
    parser.add_argument("--asl-model-root", required=True, type=Path)
    parser.add_argument("--pto-commit", required=True)
    parser.add_argument("--llvm-commit", required=True)
    parser.add_argument("--asl-model-commit", required=True)
    parser.add_argument("--workflow-commit", required=True)
    parser.add_argument("--impact", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--diagnostics", required=True, type=Path)
    arguments = parser.parse_args()
    try:
        result = validate_preflight(
            pto_root=arguments.pto_root.resolve(),
            llvm_root=arguments.llvm_root.resolve(),
            asl_model_root=arguments.asl_model_root.resolve(),
            pto_commit=arguments.pto_commit,
            llvm_commit=arguments.llvm_commit,
            asl_model_commit=arguments.asl_model_commit,
            workflow_commit=arguments.workflow_commit,
            impact_path=arguments.impact.resolve(),
        )
        arguments.output.parent.mkdir(parents=True, exist_ok=True)
        arguments.output.write_bytes(canonical_bytes(result))
        diagnostics = {"schema": "pto.release-preflight-diagnostics.v1", "ok": True}
        arguments.diagnostics.parent.mkdir(parents=True, exist_ok=True)
        arguments.diagnostics.write_bytes(canonical_bytes(diagnostics))
    except (
        ImportError,
        OSError,
        ValueError,
        json.JSONDecodeError,
        subprocess.CalledProcessError,
    ) as error:
        diagnostics = {
            "schema": "pto.release-preflight-diagnostics.v1",
            "ok": False,
            "error": str(error),
            "next_action": (
                "Fix the reported candidate identity, manifest freshness, pin, or AVS "
                "coverage mismatch; commit the fix before one new manual verification."
            ),
        }
        arguments.diagnostics.parent.mkdir(parents=True, exist_ok=True)
        arguments.diagnostics.write_bytes(canonical_bytes(diagnostics))
        print(f"release preflight failed: {error}", file=sys.stderr)
        return 1
    print("release preflight passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
