#!/usr/bin/env python3
"""Generate the deterministic PTO architecture-decision index."""

from __future__ import annotations

import argparse
from dataclasses import asdict
import json
from pathlib import Path
import re
import sys


ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from scripts.adr_records import (  # noqa: E402
    ADR_TYPE_ORDER,
    AdrRecord,
    load_adrs,
    validate_adr_graph,
)


DEFAULT_OUTPUT = ROOT / "spec/evidence/adr-index.json"
DEFAULT_OPEN_OUTPUT = ROOT / "docs/status/open/index.md"


def _record_row(record: AdrRecord) -> dict[str, object]:
    row = asdict(record)
    row["id"] = row.pop("adr_id")
    row["path"] = record.path.relative_to(ROOT).as_posix()
    if not record.release_boundary:
        row.pop("release_boundary")
    if not record.interface_change:
        row.pop("interface_change")
    if not record.amendments:
        row.pop("amendments")
    return row


def _index() -> dict[str, object]:
    records = load_adrs(ROOT / "docs/status/decisions")
    errors = validate_adr_graph(records)
    if errors:
        raise ValueError("; ".join(errors))
    legacy_map = {
        legacy_id: record.adr_id
        for record in records
        for legacy_id in record.legacy_ids
    }
    legacy_adr_map = {
        legacy_id: record.adr_id
        for record in records
        for legacy_id in record.legacy_ids
        if re.fullmatch(r"ADR-[0-9]{4}", legacy_id)
    }
    type_counts = {
        adr_type: sum(
            record.adr_id.startswith(f"ADR-{adr_type}-") for record in records
        )
        for adr_type in ADR_TYPE_ORDER
    }
    drafts = [record.adr_id for record in records if record.status == "draft"]
    return {
        "schema": "pto.adr-index",
        "records": [_record_row(record) for record in records],
        "legacy_map": dict(sorted(legacy_map.items())),
        "legacy_adr_map": dict(sorted(legacy_adr_map.items())),
        "type_order": list(ADR_TYPE_ORDER),
        "open": drafts,
        "summary": {
            "record_count": len(records),
            "draft_count": len(drafts),
            "legacy_id_count": len(legacy_map),
            "type_counts": type_counts,
        },
    }


def _render() -> str:
    return json.dumps(_index(), indent=2, sort_keys=True) + "\n"


def _blockers(record: AdrRecord) -> tuple[str, ...]:
    body = record.path.read_text(encoding="utf-8").split("---", 2)[2]
    match = re.search(
        r"^## Blockers\n+(.*?)(?=^## |\Z)", body, flags=re.MULTILINE | re.DOTALL
    )
    if match is None:
        return ()
    return tuple(
        line.removeprefix("- ").strip()
        for line in match.group(1).splitlines()
        if line.startswith("- ")
    )


def _render_open_index() -> str:
    numeric_drafts = [
        record
        for record in load_adrs(ROOT / "docs/status/decisions")
        if record.status == "draft"
        and any(re.fullmatch(r"PD-[0-9]{2}", item) for item in record.legacy_ids)
    ]
    lines = [
        "<!-- GENERATED FILE: run scripts/generate-adr-index; do not edit. -->",
        "# Open architecture decisions",
        "",
        "Draft numeric decisions are generated from ADR records. They are review inputs and do not define architecture semantics or promote maturity.",
        "",
        "Implementation, AVS, validation, and release stages are derived in the "
        "[architecture-readiness projection]"
        "(../../../spec/evidence/architecture-readiness.json).",
        "",
    ]
    for record in numeric_drafts:
        path = f"../decisions/{record.path.name}"
        blockers = _blockers(record)
        lines.extend(
            [
                f"## [{record.adr_id}: {record.title}]({path})",
                "",
                f"- Target release: {', '.join(record.target_releases)}",
                f"- Implementation issue: {record.implementation_issue or 'not assigned'}",
                f"- Affected NDF clauses: {', '.join(record.affected_ndf) or 'not assigned'}",
                "- Blockers:",
            ]
        )
        lines.extend(f"  - {blocker}" for blocker in blockers)
        if not blockers:
            lines.append("  - none recorded")
        lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--open-output", type=Path, default=DEFAULT_OPEN_OUTPUT)
    arguments = parser.parse_args()
    output = arguments.output
    open_output = arguments.open_output
    try:
        rendered = _render()
        rendered_open = _render_open_index()
        if arguments.check:
            if not output.is_file() or output.read_text(encoding="utf-8") != rendered:
                print(f"error: {output} is out of date", file=sys.stderr)
                return 1
            if (
                not open_output.is_file()
                or open_output.read_text(encoding="utf-8") != rendered_open
            ):
                print(f"error: {open_output} is out of date", file=sys.stderr)
                return 1
            print(f"ADR indexes are current: {output}, {open_output}")
            return 0
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(rendered, encoding="utf-8")
        open_output.parent.mkdir(parents=True, exist_ok=True)
        open_output.write_text(rendered_open, encoding="utf-8")
    except (OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    print(f"wrote {output} and {open_output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
