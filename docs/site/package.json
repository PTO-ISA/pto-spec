    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "plotly.js": "npm:plotly.js-gl2d-dist-min@4.0.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wavedrom": "3.6.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
