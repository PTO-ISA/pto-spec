{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pto-isa.org/schemas/pto-functional-model-corpus-v1.schema.json",
  "title": "PTO functional-model checked corpus case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case", "toolchain"],
  "properties": {
    "schema": {"const": "pto-functional-model-corpus-v1"},
    "case": {"$ref": "#/$defs/case"},
    "toolchain": {"$ref": "#/$defs/toolchain"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clang", "clang_sha256", "clang_version",
        "lld", "lld_sha256", "lld_version",
        "readelf", "readelf_sha256", "readelf_version"
      ],
      "properties": {
        "clang": {"type": "string"},
        "clang_sha256": {"$ref": "#/$defs/sha256"},
        "clang_version": {"type": "string"},
        "lld": {"type": "string"},
        "lld_sha256": {"$ref": "#/$defs/sha256"},
        "lld_version": {"type": "string"},
        "readelf": {"type": "string"},
        "readelf_sha256": {"$ref": "#/$defs/sha256"},
        "readelf_version": {"type": "string"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "filesz", "memsz", "align", "flags"],
      "properties": {
        "address": {"type": "integer", "minimum": 0, "maximum": 65535},
        "filesz": {"type": "integer", "minimum": 0, "maximum": 65536},
        "memsz": {"type": "integer", "minimum": 1, "maximum": 65536},
        "align": {"type": "integer", "minimum": 0},
        "flags": {"enum": ["R", "RW", "RX"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "isa", "requirements", "avs_ids", "inputs", "elf",
        "initial_gprs", "stack", "stop_policy", "allowed_requests",
        "expected_length_sequence", "expected_trace", "trace_requirements", "result", "golden"
      ],
      "properties": {
        "id": {
          "enum": [
            "scalar_stop_pc",
            "block_64_stop_pc",
            "tile_tadd_stop_pc",
            "host_exit_group"
          ]
        },
        "isa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile", "model_profile", "version", "encoding_abi",
            "encoding_projection_sha256"
          ],
          "properties": {
            "profile": {"const": "pto-functional-reference-v1"},
            "model_profile": {"const": "pto-functional-model-experimental-v1"},
            "version": {"const": "0.58.5"},
            "encoding_abi": {"const": "pto-isa-0.58.5-mode-function-v1"},
            "encoding_projection_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "avs_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_sha256", "linker_sha256", "builder_sha256", "schema_sha256",
            "build_recipe", "profile", "release_manifest_sha256",
            "clang_sha256", "lld_sha256"
          ],
          "properties": {
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "linker_sha256": {"$ref": "#/$defs/sha256"},
            "builder_sha256": {"$ref": "#/$defs/sha256"},
            "schema_sha256": {"$ref": "#/$defs/sha256"},
            "build_recipe": {"const": "linx-clang-assemble-lld-static-et-exec-v1"},
            "profile": {"const": "pto-functional-reference-v1"},
            "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "clang_sha256": {"$ref": "#/$defs/sha256"},
            "lld_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "elf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "sha256", "entry", "segments"],
          "properties": {
            "filename": {"type": "string", "pattern": "^[a-z0-9_-]+\\.elf$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "entry": {"type": "integer", "minimum": 0, "maximum": 65535},
            "segments": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/segment"}}
          }
        },
        "initial_gprs": {"type": "object", "maxProperties": 0},
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "size"],
          "properties": {
            "top": {"type": "integer", "minimum": 1, "maximum": 65536},
            "size": {"type": "integer", "minimum": 1, "maximum": 65536}
          }
        },
        "stop_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stop_pc", "max_steps"],
          "properties": {
            "kind": {"enum": ["stop_pc", "exit_group"]},
            "stop_pc": {"type": "integer", "minimum": 0, "maximum": 65535},
            "max_steps": {"type": "integer", "minimum": 1},
            "exit_status": {"type": "integer", "minimum": 0, "maximum": 255}
          },
          "allOf": [{
            "if": {"properties": {"kind": {"const": "exit_group"}}},
            "then": {"required": ["exit_status"]}
          }]
        },
        "allowed_requests": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1,
          "items": {"const": 94}
        },
        "expected_length_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": [16, 32, 48, 64]}
        },
        "expected_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pre_tpc", "post_tpc", "pre_bpc", "post_bpc",
              "raw_instruction_le", "length_bits", "sequence",
              "memory_write_count", "memory_write_sha256", "memory_writes"
            ],
            "properties": {
              "pre_tpc": {"type": "integer", "minimum": 0, "maximum": 65535},
              "post_tpc": {"type": "integer", "minimum": 0, "maximum": 65535},
              "pre_bpc": {"type": "integer", "minimum": 0, "maximum": 65535},
              "post_bpc": {"type": "integer", "minimum": 0, "maximum": 65535},
              "raw_instruction_le": {"type": "integer", "minimum": 0},
              "length_bits": {"enum": [16, 32, 48, 64]},
              "sequence": {"type": "integer", "minimum": 1}
              ,"step_state": {"enum": [1, 3]}
              ,"instruction_status": {"enum": [0, 1, 2]}
              ,"request_token": {"type": "integer", "minimum": 0}
              ,"request_type": {"type": "integer", "minimum": 0, "maximum": 65535}
              ,"request_argument0": {"type": "integer", "minimum": 0}
              ,"memory_write_count": {"type": "integer", "minimum": 0}
              ,"memory_write_sha256": {"$ref": "#/$defs/sha256"}
              ,"memory_writes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["address", "value"],
                  "properties": {
                    "address": {"type": "integer", "minimum": 0, "maximum": 65535},
                    "value": {"type": "integer", "minimum": 0, "maximum": 255}
                  }
                }
              }
            }
          }
        },
        "trace_requirements": {"type": "object"},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "size_symbol", "address", "size"],
          "properties": {
            "symbol": {"const": "cross_model_result"},
            "size_symbol": {"const": "cross_model_result_size"},
            "address": {"type": "integer", "minimum": 0, "maximum": 65535},
            "size": {"const": 4}
          }
        },
        "golden": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "sha256", "size", "derivation"],
          "properties": {
            "filename": {"type": "string", "pattern": "^[a-z0-9_-]+\\.golden\\.bin$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "size": {"const": 4},
            "derivation": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
