{
  "$id": "https://github.com/PTO-ISA/pto-spec/blob/main/spec/schemas/pto-release-selection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "spec/schemas/pto-release-selection.schema.json"
    },
    "architecture_version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "publication_version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "baseline_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "excluded_draft_adrs": {
      "items": {
        "pattern": "^ADR-(GOV|STATE|MEM|BLOCK|SCALAR|TILE|CUBE|NUM)-[0-9]{4}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "included_ndf_statuses": {
      "const": [
        "accepted"
      ]
    },
    "required_readiness_floor": {
      "enum": [
        "executable",
        "validated",
        "released"
      ]
    }
  },
  "required": [
    "$schema",
    "architecture_version",
    "publication_version",
    "baseline_commit",
    "excluded_draft_adrs",
    "included_ndf_statuses",
    "required_readiness_floor"
  ],
  "title": "PTO release selection",
  "type": "object"
}
