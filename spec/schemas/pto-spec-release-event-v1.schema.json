{
  "$id": "https://github.com/PTO-ISA/pto-spec/blob/main/spec/schemas/pto-spec-release-event-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "release_id": {
      "minimum": 1,
      "type": "integer"
    },
    "release_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "release_url": {
      "pattern": "^https://github\\.com/PTO-ISA/pto-spec/releases/tag/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}$",
      "type": "string"
    },
    "repository": {
      "const": "PTO-ISA/pto-spec"
    },
    "schema_version": {
      "const": "1"
    },
    "tag": {
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "tag",
    "commit",
    "release_id",
    "release_url",
    "release_manifest_sha256",
    "published_at"
  ],
  "title": "PTO-SPEC stable release event v1",
  "type": "object"
}
