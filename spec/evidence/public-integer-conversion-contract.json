  },
  "result_rules": [
    {
      "id": "PTO-NUM-INT-SIGN-EXTEND",
      "applicability": "source and destination are public integer types and destination is wider than a signed source",
      "result": "sign-extend the source-width bit pattern to the destination width",
      "status": "accepted-portable-result-rule"
    },
    {
      "id": "PTO-NUM-INT-ZERO-EXTEND",
      "applicability": "source and destination are public integer types and destination is wider than an unsigned source",
      "result": "zero-extend the source-width bit pattern to the destination width",
      "status": "accepted-portable-result-rule"
    },
    {
      "id": "PTO-NUM-INT-TRUNCATE-HIGH",
      "applicability": "source and destination are public integer types and destination is narrower",
      "result": "retain the low destination-width bits and discard all higher source bits",
      "status": "accepted-portable-result-rule"
    }
  ],
