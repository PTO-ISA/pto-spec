// PTO-UNIT: {"id":"PTO-ARCH-OVERVIEW-INSTRUCTION-CLASSIFICATION","surface":"arch","classification":["overview","instruction-classification"],"depends_on":["PTO-ARCH-DATA-TYPES-PACKED"]}

// NDF-BEGIN: PTO-ARCH-TILE-INSTRUCTION-CLASS-001
// ndf: kind=contract level=L1 layer=tile status=accepted
// Every direct Tile operation MUST belong to exactly one PTO instruction class:
// Elementwise Tile-Tile, Tile-Scalar and Immediate, Reduce and Expand,
// Memory and Data Movement, Matrix and Matrix-Vector, Layout and
// Rearrangement, or Irregular and Complex. Sync and Config is a PTO Tile
// programming class but has no direct Tile operation in the current binary
// carrier. Classification MUST remain independent of execution-engine choice.
// NDF-END: PTO-ARCH-TILE-INSTRUCTION-CLASS-001

// NDF-BEGIN: PTO-ARCH-TILE-EXECUTION-ENGINE-001
// ndf: kind=contract level=L1 layer=tile status=accepted
// Every direct Tile operation MUST select exactly one of VEC, TLSU, CUBE, or
// SFU. VEC MUST execute only elementwise operations. Specialized complex
// operations use SFU, global-memory and data-transfer operations use TLSU, and
// matrix and matrix-vector operations use CUBE.
// NDF-END: PTO-ARCH-TILE-EXECUTION-ENGINE-001

// NDF-BEGIN: PTO-ARCH-TEPL-ALIAS-001
// ndf: kind=contract level=L1 layer=block status=accepted
// BSTART.VEC and BSTART.SFU MUST use the unchanged TEPL Mode/Function carrier.
// BSTART.TEPL remains an accepted compatibility spelling. Canonical assembly
// and disassembly MUST render BSTART.VEC or BSTART.SFU according to the selected
// Tile operation and MUST NOT render BSTART.TEPL.
// NDF-END: PTO-ARCH-TEPL-ALIAS-001

// NDF-BEGIN: PTO-AS-TILEOP-MACRO-001
// ndf: kind=contract level=L1 layer=architecture status=accepted
// The PTO-TILEOP-MACRO records in this unit are the sole owners of canonical
// TileOp macro spelling and macro-to-physical field mapping. Every active direct
// Tile operation MUST have at least one such form, and every mapping MUST close
// against that operation's owning PTO-INSTRUCTION physical contract. Each macro
// instruction MUST occupy exactly one source line and is itself one Block
// instruction. It MUST expand to exactly one accepted physical BSTART bundle;
// the next non-modifier Block instruction or end of section closes its command
// range. Source MUST NOT require an extra BSTOP, BSTART, or C.BSTART. Expansion
// MUST preserve all attributes, dimensions, bindings, range
// modifiers, defaults, legality, faults, ordering, restart, and publication
// behavior without adding an opcode or hidden state. Canonical folding MUST
// accept every complete exact physical schema without consulting runtime Tile
// descriptors. Clock-hand register names MUST NOT be used to infer runtime
// descriptor state or carrier kind. Physically identical source forms MUST use
// the first catalog form as their canonical disassembly spelling.
// Local-versus-Shared placement is expressed only by the typed Tile operands.
// A canonical macro mnemonic MUST equal the TileOp mnemonic and MUST NOT
// append form labels such as SHARED, SHARED_RIGHT, SHARED_BOTH, CUBE, or
// WEIGHT. The selected form is determined from its configuration and typed
// operand bindings.
//
// Rectangular macro forms MUST expose programmer-facing Row and Col names and
// MUST NOT expose physical LB0, LB1, or LB2 names. Row has no independent
// physical encoding and MUST obey the selected form's Row resolution record.
// An ordinary row-major form with a sized numeric destination derives Row from
// that destination TSize, Col, and the form's element type. Predicate
// destination TSize and CUBE destination TSize are capacity bounds and MUST NOT
// independently determine Row. A mixed RowMajor/CUBE form MUST derive Row from
// destination TSize, Col, and element type only when Layout selects RowMajor;
// when Layout selects CUBE it MUST derive Row from encoded ValidRow. If Layout
// is omitted and the RowMajor capacity equation has no integral solution, the
// form is necessarily CUBE and canonical disassembly MUST use encoded ValidRow.
// Predicate and descriptor-preserving forms derive Row from source descriptor
// state. Because Row has no encoded carrier, stateless canonical disassembly
// MUST omit that runtime-derived field rather than invent a value or retain the
// physical bundle. The CUBE-layout TLOAD and TSTORE forms, together with
// TGPR2T, instead derive and print Row from their encoded ValidRow. Each form's
// declared ValidRow and ValidCol defaults are
// authoritative; canonical assembly MUST omit a Valid field only when it
// equals that selected-form
// default and MUST retain it when equality is not statically provable.
// Attributes and PE masks MUST use symbolic names rather than raw carrier
// numbers. Canonical disassembly MUST omit every exact selected-form attribute
// default, including DTYPE_NONE, Null PadValue, AllPE, and each default-valued
// B.FPATR field. Nondefault B.FPATR fields are ordinary entries in the same
// angle-bracket attribute list as B.DATR fields; no FPAttrs wrapper exists.
// Enabled boolean fields use bare symbolic names such as TransposeB, while
// valued fields use named assignments such as PreMode=2.
// A ranged input or output MUST append `[base=GPR, offset=uimm11]` to its
// binding. Input direction derives B.SUBVIEW and SrcSelect from the owning
// source role. Output direction derives B.ASSEMBLE INIT_LAST. Both modifiers
// use the fixed 128-byte range SizeCode 1 and remain contiguous with their
// owning B.IOT or B.IOS group.
// TLOAD and TSTORE address operands derived from B.IOR MUST use named entries:
// `[base=GPR, stride=GPR]`. A missing default base or omitted stride is not
// printed.
// NDF-END: PTO-AS-TILEOP-MACRO-001

// PTO-TILEOP-MACRO: {"forms":[{"configuration_bindings":[{"field":"DataType","syntax":"DataType","targets":[{"command":"BSTART.GMOV","group":null,"slot":"DataType"}]},{"field":"Layout","syntax":"Layout?","targets":[{"command":"B.DATR","group":null,"slot":"Layout"}]},{"field":"PEMask","syntax":"PEMask=AllPE","targets":[{"command":"B.IOT","group":0,"slot":"PE_MASK"},{"command":"B.IOT","group":1,"slot":"PE_MASK"}]}],"macro_format":"GMOV <DataType, Layout?, PEMask=AllPE>, SrcTile0, PeerTid?, ->DstTile<Size>","operand_bindings":[{"binding_kind":"tile-source-binding","command":"B.IOT","field":"SrcTile0","members":[{"command_group":0,"condition":null,"default":null,"eligible_modifiers":[{"evidence_case":"RANGE-MATRIX-CASE-0195","modifier":"B.SUBVIEW"}],"optional":false,"physical_role":"source0","slot":"Role0","syntax":"SrcTile0"}],"role_kind":"source","syntax":"SrcTile0"},{"binding_kind":"scalar-binding","command":"B.IOR","field":"PeerTid","members":[{"command_group":0,"condition":null,"default":null,"eligible_modifiers":[],"optional":true,"physical_role":"scalar0","slot":"RegSrc0","syntax":"PeerTid?"}],"role_kind":"source","syntax":"PeerTid?"},{"binding_kind":"tile-destination-binding","command":"B.IOT","field":"DstTile","members":[{"command_group":1,"condition":null,"default":null,"eligible_modifiers":[{"evidence_case":"RANGE-MATRIX-CASE-0196","modifier":"B.ASSEMBLE INIT_LAST"}],"optional":false,"physical_role":"destination0","slot":"Role0","syntax":"->DstTile<Size>"}],"role_kind":"destination","syntax":"->DstTile<Size>"}],"spelling":"GMOV"}],"mnemonic":"GMOV"}
