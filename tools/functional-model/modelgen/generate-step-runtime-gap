#!/usr/bin/env python3
"""Generate exact static runtime-gap evidence for functional-model step roots."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[3]
MODELGEN = Path(__file__).resolve().parent
if str(MODELGEN) not in sys.path:
    sys.path.insert(0, str(MODELGEN))

from pto_executable_mir import ModelgenError  # noqa: E402
from runtime_gap import build_runtime_gap, render_runtime_gap  # noqa: E402


DEFAULT_IMAGE = ROOT / "build/functional-model/share/pto/pto-executable-mir-v1.json"
DEFAULT_CAPABILITY = MODELGEN / "runtime-capabilities-v1.json"
DEFAULT_SCALAR_CATALOG = ROOT / "spec/catalog/scalar-forms.json"
DEFAULT_COMMAND_CATALOG = ROOT / "spec/catalog/command-forms.json"
DEFAULT_OUTPUT = ROOT / "spec/evidence/functional-model-step-runtime-gap.json"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--image", type=Path, default=DEFAULT_IMAGE)
    parser.add_argument("--capability", type=Path, default=DEFAULT_CAPABILITY)
    parser.add_argument("--scalar-catalog", type=Path, default=DEFAULT_SCALAR_CATALOG)
    parser.add_argument("--command-catalog", type=Path, default=DEFAULT_COMMAND_CATALOG)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    try:
        image_bytes = arguments.image.read_bytes()
        capability_bytes = arguments.capability.read_bytes()
        document = build_runtime_gap(
            json.loads(image_bytes),
            image_bytes=image_bytes,
            capability_bytes=capability_bytes,
            scalar_catalog=json.loads(arguments.scalar_catalog.read_bytes()),
            command_catalog=json.loads(arguments.command_catalog.read_bytes()),
        )
        if len(document["arbitrary_choice_sites"]) != 2:
            raise ModelgenError(
                "full step closure must retain exactly two path-controlled "
                "E_Arbitrary sites"
            )
        rendered = render_runtime_gap(document)
        if arguments.check:
            if not arguments.output.is_file():
                raise ModelgenError(f"missing generated artifact {arguments.output}")
            if arguments.output.read_text(encoding="utf-8") != rendered:
                raise ModelgenError(f"stale generated artifact {arguments.output}")
            print(f"functional-model runtime-gap evidence is current: {arguments.output}")
        else:
            arguments.output.parent.mkdir(parents=True, exist_ok=True)
            arguments.output.write_text(rendered, encoding="utf-8")
            print(f"wrote {arguments.output}")
    except (ModelgenError, OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
