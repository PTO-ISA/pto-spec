#!/usr/bin/env python3
"""Generate and verify the linked PTO executable MIR v1 model image."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[3]
MODELGEN = Path(__file__).resolve().parent
if str(MODELGEN) not in sys.path:
    sys.path.insert(0, str(MODELGEN))

from pto_executable_mir import (  # noqa: E402
    ModelgenError,
    build_executable_readiness,
    lower_executable_module,
    render_executable_module,
    render_executable_readiness,
)


DEFAULT_INPUT = ROOT / "build/functional-model/share/pto/pto-mir-v1.json"
DEFAULT_SCHEMA = ROOT / "spec/schemas/pto-executable-mir-v1.schema.json"
DEFAULT_OUTPUT = ROOT / "build/functional-model/share/pto/pto-executable-mir-v1.json"
DEFAULT_READINESS = (
    ROOT / "spec/evidence/functional-model-executable-mir-readiness.json"
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--input", type=Path, default=DEFAULT_INPUT)
    parser.add_argument("--schema", type=Path, default=DEFAULT_SCHEMA)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--readiness-output", type=Path, default=DEFAULT_READINESS)
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    try:
        mir_bytes = arguments.input.read_bytes()
        schema_bytes = arguments.schema.read_bytes()
        mir = json.loads(mir_bytes)
        image = lower_executable_module(
            mir, mir_bytes=mir_bytes, schema_bytes=schema_bytes
        )
        image_bytes = render_executable_module(image)
        readiness = render_executable_readiness(
            build_executable_readiness(
                mir_bytes=mir_bytes,
                schema_bytes=schema_bytes,
                image_bytes=image_bytes,
                image=image,
            )
        ).encode("utf-8")
        outputs = (
            (arguments.output, image_bytes),
            (arguments.readiness_output, readiness),
        )
        if arguments.check:
            for path, content in outputs:
                if not path.is_file():
                    raise ModelgenError(f"missing generated artifact {path}")
                if path.read_bytes() != content:
                    raise ModelgenError(f"stale generated artifact {path}")
            print(f"executable MIR artifacts are current: {arguments.output}")
        else:
            for path, content in outputs:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(content)
                print(f"wrote {path}")
    except (ModelgenError, OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
