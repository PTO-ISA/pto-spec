    assert dim_101043 == CommandExecution_Executed;
    let dim_102043 = ExecuteCommandInstruction(Zeros{64} + 0x00102043, 32);
    assert dim_102043 == CommandExecution_Executed;
    let bind_0 = ExecuteCommandInstruction(Zeros{64} + 0x08104e13, 32);
    assert bind_0 == CommandExecution_Executed;
    let bind_1 = ExecuteCommandInstruction(Zeros{64} + 0x0038de13, 32);
    assert bind_1 == CommandExecution_Executed;
    let modifier_1_0 = ExecuteCommandInstruction(Zeros{64} + 0x000000d3, 32);
    assert modifier_1_0 == CommandExecution_Executed;
    assert BundleOperationBindingsComplete(98);
    let prepared_stage2 = PrepareSelectedBundleStage2();
    assert prepared_stage2;
    assert SelectedBundleClosedBinarySchemaLegal(98);
    assert SelectedBundleClosedUnarySchemaLegal(98);
    assert SelectedBundleClosedTFMASchemaLegal(98);
    assert SelectedBundleClosedQuantizationSchemaLegal(98);
    assert SelectedBundleClosedGenerationSchemaLegal(98);
    assert SelectedBundleClosedHistogramSchemaLegal(98);
    assert SelectedBundleClosedReductionSchemaLegal(98);
    assert SelectedBundleClosedSortingSchemaLegal(98);
    assert SelectedBundleClosedPartialSchemaLegal(98);
    assert SelectedBundleClosedExpansionSchemaLegal(98);
    assert SelectedBundleClosedTCVTSchemaLegal(98);
