    assert dim_101043 == CommandExecution_Executed;
    let dim_102043 = ExecuteCommandInstruction(Zeros{64} + 0x00102043, 32);
    assert dim_102043 == CommandExecution_Executed;
    let bind_0 = ExecuteCommandInstruction(Zeros{64} + 0x08104e13, 32);
    assert bind_0 == CommandExecution_Executed;
    let bind_1 = ExecuteCommandInstruction(Zeros{64} + 0x10304e13, 32);
    assert bind_1 == CommandExecution_Executed;
    let modifier_1_1 = ExecuteCommandInstruction(Zeros{64} + 0x800000d3, 32);
    assert modifier_1_1 == CommandExecution_Executed;
    let bind_2 = ExecuteCommandInstruction(Zeros{64} + 0x0058de13, 32);
    assert bind_2 == CommandExecution_Executed;
    assert BundleOperationBindingsComplete(108);
    let completed = ExecuteBundleTileOperation();
    assert completed;
    if !completed then assert _LastFault == Fault_TileLegality; end;
    assert _LastFault == Fault_None;
    var observed_destination: TileIndex = 0;
    for binding = 0 to PTO_BUNDLE_TILE_BINDING_COUNT - 1 do
