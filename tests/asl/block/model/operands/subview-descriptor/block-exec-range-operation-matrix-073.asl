                (if tile == 1 then TileDataType_FP32 else (if tile == 3 then TileDataType_E8M0 else (if tile == 5 then TileDataType_E8M0 else TileDataType_E4M3))), (if tile == 4 then TileLayout_CUBE_N8 else TileLayout_CUBE_M16), TileLocation_Matrix, '1111')
