    assert SelectedBundleClosedTCMPSSchemaLegal(105);
    assert SelectedBundleClosedTSELSSchemaLegal(105);
    assert SelectedBundleClosedTEXPANDSSchemaLegal(105);
    assert SelectedBundleTileMasksLegal();
