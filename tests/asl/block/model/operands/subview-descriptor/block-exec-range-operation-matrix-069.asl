    assert bind_0 == CommandExecution_Executed;
    let bind_1 = ExecuteCommandInstruction(Zeros{64} + 0x0038de13, 32);
    assert bind_1 == CommandExecution_Executed;
    let modifier_1_0 = ExecuteCommandInstruction(Zeros{64} + 0x000000d3, 32);
    assert modifier_1_0 == CommandExecution_Executed;
    assert BundleOperationBindingsComplete(105);
    let prepared_stage2 = PrepareSelectedBundleStage2();
    assert prepared_stage2;
    assert SelectedBundleClosedBinarySchemaLegal(105);
    assert SelectedBundleClosedUnarySchemaLegal(105);
    assert SelectedBundleClosedTFMASchemaLegal(105);
    assert SelectedBundleClosedQuantizationSchemaLegal(105);
    assert SelectedBundleClosedGenerationSchemaLegal(105);
    assert SelectedBundleClosedHistogramSchemaLegal(105);
    assert SelectedBundleClosedReductionSchemaLegal(105);
