    assert assemble_0 == CommandExecution_Executed;
    assert BundleOperationBindingsComplete(37);
    let prepared_stage2 = PrepareSelectedBundleStage2();
    assert prepared_stage2;
    assert SelectedBundleClosedBinarySchemaLegal(37);
    assert SelectedBundleClosedUnarySchemaLegal(37);
    assert SelectedBundleClosedTFMASchemaLegal(37);
