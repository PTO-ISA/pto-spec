    let dim_101043 = ExecuteCommandInstruction(Zeros{64} + 0x00101043, 32);
    assert dim_101043 == CommandExecution_Executed;
    let dim_102043 = ExecuteCommandInstruction(Zeros{64} + 0x00102043, 32);
    assert dim_102043 == CommandExecution_Executed;
    let bind_0 = ExecuteCommandInstruction(Zeros{64} + 0x08104e13, 32);
    assert bind_0 == CommandExecution_Executed;
    let modifier_0_1 = ExecuteCommandInstruction(Zeros{64} + 0x800000d3, 32);
    assert modifier_0_1 == CommandExecution_Executed;
    let bind_1 = ExecuteCommandInstruction(Zeros{64} + 0x10304e13, 32);
    assert bind_1 == CommandExecution_Executed;
    let bind_2 = ExecuteCommandInstruction(Zeros{64} + 0x0058de13, 32);
    assert bind_2 == CommandExecution_Executed;
    assert BundleOperationBindingsComplete(107);
    let prepared_stage2 = PrepareSelectedBundleStage2();
    assert prepared_stage2;
    assert SelectedBundleClosedBinarySchemaLegal(107);
    assert SelectedBundleClosedUnarySchemaLegal(107);
    assert SelectedBundleClosedTFMASchemaLegal(107);
    assert SelectedBundleClosedQuantizationSchemaLegal(107);
    assert SelectedBundleClosedGenerationSchemaLegal(107);
    assert SelectedBundleClosedHistogramSchemaLegal(107);
    assert SelectedBundleClosedReductionSchemaLegal(107);
    assert SelectedBundleClosedSortingSchemaLegal(107);
    assert SelectedBundleClosedPartialSchemaLegal(107);
    assert SelectedBundleClosedExpansionSchemaLegal(107);
    assert SelectedBundleClosedTCVTSchemaLegal(107);
    assert SelectedBundleClosedTCMPSchemaLegal(107);
    assert SelectedBundleClosedTSELSchemaLegal(107);
    assert SelectedBundleClosedTileScalarBinarySchemaLegal(107);
    assert SelectedBundleClosedTCMPSSchemaLegal(107);
    assert SelectedBundleClosedTSELSSchemaLegal(107);
    assert SelectedBundleClosedTEXPANDSSchemaLegal(107);
    assert SelectedBundleTileMasksLegal();
    let completed = ExecuteBundleTileOperation();
    assert completed;
    if !completed then assert _LastFault == Fault_TileLegality; end;
    assert _LastFault == Fault_None;
    var observed_destination: TileIndex = 0;
    for binding = 0 to PTO_BUNDLE_TILE_BINDING_COUNT - 1 do
        if _BundleTileBindings[[binding]].valid &&
           _BundleTileBindings[[binding]].destination_valid then
            observed_destination = _BundleTileBindings[[binding]].destination;
        end;
    end;
    assert _Tiles[[observed_destination]].allocated &&
           _Tiles[[observed_destination]].contents_defined;
    return TRUE;
end;

